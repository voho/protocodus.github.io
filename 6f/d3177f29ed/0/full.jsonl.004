weather.drawLate(aa ? G.effects.late.scene : null, G.effects.depthUniforms);\n    renderer.setEffects([...(quality.volumetric ? [G.effects.pass] : []), ...(ao ? [ssao] : []), ...(refl ? [ssr] : []), ...(shaft ? [shafts] : []), ...(quality.volumetric ? [volumetric, taa, G.effects.late, dof] : []), ...(quality.bloom ? [bloom] : []), grade]);\"\"\"),\n(\"\"\"  renderer.info.reset();\n  renderer.render(scene, camera);\"\"\",\n \"\"\"  renderer.info.reset();\n  taa?.jitter();\n  renderer.render(scene, camera);\n  taa?.restore();\"\"\"),\n(\"\"\"  get fx() { return { volumetric, bloom, grade, ssao, dof, ssr, shafts }; },\"\"\",\n \"\"\"  get fx() { return { volumetric, bloom, grade, ssao, dof, ssr, shafts, taa }; },\"\"\"),\n]\nfor a, b in rep:\n    assert a in s, a[:60]\n    s = s.replace(a, b)\nopen(p, 'w').write(s)\nprint('ok')\nPYEOF\nnode --check js/main.js && node --check js/taa.js && echo parsed && grep -n \"renderer.render(\" js/main.js | head","description":"Wire TAA, the late pass and the jitter into main"},"caller":{"type":"direct"}}]}}
