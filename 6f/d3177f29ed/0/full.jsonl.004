ixed(2);\n  out[name] = { allFps: med(A), noShaftsFps: med(B), noCrownsFps: med(C), shaftsMs: +(msOf(med(A)) - msOf(med(B))).toFixed(2), crownsMs: +(msOf(med(A)) - msOf(med(C))).toFixed(2) };\n}\nreturn out;\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"965d919c-5513-4f35-9bd3-d2cb2ea5211f","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
