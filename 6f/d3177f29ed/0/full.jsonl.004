    const map = l?.shadow?.map?.depthTexture;\n88\t      this.enabled = !!(flares?.shadowing && map);\n89\t      light = this.enabled ? l : null;\n90\t    },\n91\t    setSize(w, h) {\n92\t      const tw = Math.max(1, Math.round(w * scale)), th = Math.max(1, Math.round(h * scale));\n93\t      target.setSize(tw, th);\n94\t      texel.set(1 / tw, 1 / th);\n95\t    },\n96\t    render(renderer, writeBuffer, readBuffer) {\n97\t      if (!readBuffer.depthTexture || !light) return;\n98\t      camera.updateMatrixWorld();\n99\t      u.uProjInv.value.copy(camera.projectionMatrixInverse);\n100\t      u.uViewInv.value.copy(camera.matrixWorld);\n101\t      u.uCam.value.setFromMatrixPosition(camera.matrixWorld);\n102\t      u.tDepth.value = readBuffer.depthTexture;\n103\t      u.tShadow.value = light.shadow.map.depthTexture;\n104\t      u.uShadowMatrix.value.copy(light.shadow.matrix);\n105\t      u.uLightDir.value.copy(light.position).sub(light.target.position).normalize();\n106\t      const prev = renderer.getRenderTarget();\n107\t      renderer.setRenderTarget(target);"}]},"uuid":"c5ede6de-60fa-40ee-83f7-6ac5e334521e","timestamp":"2026-10-21T14:21:28.617Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/shafts.js","content":"export function createShafts(camera, { scale = 0.5, maxDist = 45 } = {}) {\n  const geometry = new THREE.BufferGeometry();\n  geometry.setAttribute('position', new THREE.Float32BufferAttribute([-1, 3, 0, -1, -1, 0, 3, -1, 0], 3));\n  geometry.setAttribute('uv', new THREE.Float32BufferAttribute([0, 2, 0, 0, 2, 0], 2));\n  const material = new THREE.ShaderMaterial({\n    vertexShader: VERT, fragmentShader: FRAG,\n    uniforms: {\n      tDepth: { value: null }, tShadow: { value: null },\n      uProjInv: { value: new THREE.Matrix4() }, uViewInv: { value: new THREE.Matrix4() }, uShadowMatrix: { value: new THREE.Matrix4() },\n      uCam: { value: new THREE.Vector3() }, uLightDir: { value: new THREE.Vector3(0, 1, 0) },\n      uMaxDist: { value: maxDist }, uG: { value: 0.6 },\n    },\n    depthTest: false, depthWrite: false, toneMapped: false,\n  });\n  const quad = new THREE.Mesh(geometry, material);\n  quad.frustumCulled = false;\n  const ortho = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);\n  const target = new THREE.WebGLRenderTarget(4, 4, { type: THREE.HalfFloatType, format: THREE.RedFormat, depthBuffer: false, stencilBuffer: false });\n  target.texture.minFilter = target.texture.magFilter = THREE.LinearFilter;\n  const u = material.uniforms;\n  const texel = new THREE.Vector2(1, 1);\n  let light = null;\n\n  return {\n    enabled: false, needsSwap: false, uniforms: u, texture: target.texture,\n    texel,                // of the half-resolution target, for the upsample\n    /* the flares (flares.js): on while one's shadow map is being drawn */\n    set(flares) {\n      const l = flares?.light;\n      const map = l?.shadow?.map?.depthTexture;\n      this.enabled = !!(flares?.shadowing && map);\n      light = this.enabled ? l : null;\n    },\n    setSize(w, h) {\n      const tw = Math.max(1, Math.round(w * scale)), th = Math.max(1, Math.round(h * scale));\n      target.setSize(tw, th);\n      texel.set(1 / tw, 1 / th);\n    },\n    render(renderer, writeBuffer, readBuffer) {\n      if (!readBuffer.depthTexture || !light) return;\n      camera.updateMatrixWorld();\n      u.uProjInv.value.copy(camera.projectionMatrixInverse);\n      u.uViewInv.value.copy(camera.matrixWorld);\n      u.uCam.value.setFromMatrixPosition(camera.matrixWorld);\n      u.tDepth.value = readBuffer.depthTexture;\n      u.tShadow.value = light.shadow.map.depthTexture;\n      u.uShadowMatrix.value.copy(light.shadow.matrix);\n      u.uLightDir.value.copy(light.position).sub(light.target.position).normalize();\n      const prev = renderer.getRenderTarget();\n      renderer.setRenderTarget(target);","numLines":50,"startLine":58,"totalLines":113}},"sourceToolAssistantUUID":"fc6c3768-5647-4fd8-b2d9-5d1335123357","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
