 anyway)","         float blades = floor(mix(${TUFT}.5, 2.5, smoothstep(5.0, uRadius * 0.75, dist)));","         tuftH *= step(position.z, blades - 0.5);"]},{"oldStart":105,"oldLines":7,"newStart":108,"newLines":7,"lines":["         // parted round the player's legs","         vec2 away = xz - uPlayer.xz;","         float pd = length(away);","-        lean += away / max(pd, 0.01) * (1.0 - smoothstep(0.15, 0.8, pd)) * step(abs(uPlayer.y - gd.x), 1.5) * 1.6;","+        lean += away / max(pd, 0.01) * (1.0 - smoothstep(0.15, 0.8, pd)) * step(abs(uPlayer.y - gy), 1.5) * 1.6;","         // bent along an arc (the lean sets how far over the tip is), keeping its length","         float lm = length(lean);","         vec2 ld = lean / max(lm, 1e-4);"]},{"oldStart":113,"oldLines":7,"newStart":116,"newLines":7,"lines":["         float arc = th * t;","         float bx = th > 1e-3 ? (1.0 - cos(arc)) / th : 0.0;","         float by = th > 1e-3 ? sin(arc) / th : t;","-        bladePos = vec3(xz.x, gd.x, xz.y);","+        bladePos = vec3(xz.x, gy, xz.y);","         bladePos.xz += perp * position.x * w + ld * bx * hgt;","         bladePos.y += by * hgt;","         // across the blade, rounded towards the sky (lit like the sward, not like planks)"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/terrain.js","hunks":[{"oldStart":310,"oldLines":7,"newStart":310,"newLines":7,"lines":["         // under the meadow grass the ground is the shaded sward: dark, rough, no standing water","         tSwardK = 0.0;","         if (uSwardR > 0.0) {","-          tSwardK = texture2D(tSward, (vWPos.xz - uSwardMin) / uSwardSize).y","+          tSwardK = texture2D(tSward, (vWPos.xz - uSwardMin) / uSwardSize).x","             * (1.0 - smoothstep(uSwardR * 0.6, uSwardR * 0.95, length(vWPos.xz - cameraPosition.xz)));","           tPuddle *= 1.0 - tSwardK;","           tRim *= 1.0 - tSwardK;"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodu