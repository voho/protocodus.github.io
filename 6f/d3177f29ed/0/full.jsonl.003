w').write(s)\n\np = 'js/config.js'\ns = open(p).read()\nfor q, v in (('high', 1), ('medium', 1), ('low', 0)):\n    i = s.index(f'  {q}: {{')\n    j = s.index('treeNear', i)\n    s = s[:j] + f'clutter: {v}, ' + s[j:]\nopen(p, 'w').write(s)\nprint('ok')\nPYEOF\nfor f in js/main.js js/config.js js/clutter.js js/groundmap.js js/grass.js; do node --check $f || echo FAIL $f; done; grep -c \"clutter\" js/config.js","description":"Wire the ground map and clutter into main and config"},"caller":{"type":"direct"}}]}}
