e drops' tilt, in view space (added to the normal)` : ''}","-        ${GLSL_HELPERS}","-        ${beads ? BEADS_GLSL : ''}`)","+        ${GLSL_HELPERS}`)","       .replace('#include <map_fragment>', `#include <map_fragment>","         ${beads ? `beadM = 0.0; beadT = vec3(0.0);","         {"]},{"oldStart":364,"oldLines":6,"newStart":365,"newLines":7,"lines":["         #ifdef OPAQUE","           gl_FragColor.a = mirrorAlpha(roughnessFactor, mWetUp);","         #endif`);","+    if (beads) shader.fragmentShader = shader.fragmentShader.replace('void main() {', BEADS_GLSL + '\\nvoid main() {');","     if (foliage) {","       // foliage: some light comes through the leaves, and a card lights the","       // same from both sides (its normals point out of the crown)"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/materials.js"]}},"serverClassifierContext":{"request":"a3ff4672-38f5-4057-a61c-90553b9240e5","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"55be306c-6bf6-4e5c-b7cc-de35c11961ac","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entry