 0.14, 0.1), vec3(0.32, 0.28, 0.22), vTint.x);","+        diffuseColor.rgb = col * mix(0.7, 1.0, vTint.y) * mix(1.0, 0.78, uWet);`)","       .replace('#include <roughnessmap_fragment>', `#include <roughnessmap_fragment>","         roughnessFactor = mix(roughnessFactor, ${stone ? '0.38' : '0.55'}, uWet);`);","   };"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/clutter.js"]}},"serverClassifierContext":{"request":"fb433811-9a7b-4c78-9c60-47648d048e1b","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"49c29e92-b096-48b5-bdbb-2b30ed2af33b","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
