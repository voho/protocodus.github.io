x }, uBark: { value: bark.k }, uMoss: { value: bark.moss } } : {}),","+      ...(beads ? { uBeads: shared.beads || { value: 1 } } : {}),","     });","     shader.vertexShader = shader.vertexShader","       .replace('#include <common>', `#include <common>"]},{"oldStart":300,"oldLines":6,"newStart":301,"newLines":7,"lines":["         vec4 barkA, barkB;","         float barkK, barkW;` : ''}","         ${beads ? `varying vec3 vBeadP, vBeadN;","+        uniform float uBeads;","         float beadM;","         vec3 beadT;      // the drops' tilt, in view space (added to the normal)` : ''}","         ${GLSL_HELPERS}`)"]},{"oldStart":309,"oldLines":13,"newStart":311,"newLines":12,"lines":["           float near = 1.0 - smoothstep(2.5, 4.0, length(vViewPosition));","           if (near > 0.0 && uWet > 0.0) {","             // more drops on what faces the sky; each drop comes and goes as the rain keeps falling","-            float den = mix(0.3, 0.75, smoothstep(-0.3, 0.8, vWNormalM.y)) * uWet * near;","+            float den = mix(0.18, 0.55, smoothstep(-0.3, 0.8, vWNormalM.y)) * uWet * near * uBeads;","             vec3 wt = pow(abs(vBeadN), vec3(6.0));","             wt /= dot(wt, vec3(1.0));","             beads(vBeadP.zy, wt.x, den, uTime);","             beads(vBeadP.xz, wt.y, den, uTime + 7.0);","             beads(vBeadP.xy, wt.z, den, uTime + 13.0);","-            diffuseColor.rgb *= 1.0 - 0.15 * beadM;","           }","         }` : ''}","         ${bark ? `{"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/materials.js"]}},"serverClassifierContext":{"request":"995d2d11-e68a-41e5-91e9-eca278e5a781","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branc