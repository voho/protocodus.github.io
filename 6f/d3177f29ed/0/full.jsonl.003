tning * 3.0;\n    key.intensity = 1.2 + lightning * 2.5;\n    key.position.set(cam.x + 60, 25 + lightning * 40, cam.z + 30);\n    key.target.position.set(cam.x, 0, cam.z);\n\n    const flick = (s) => {\n      if (!s.flicker) return s.intensity;\n      const t = time * 9 + s.phase;\n      return s.intensity * (1 - s.flicker * (0.5 + 0.5 * Math.sin(t) * Math.sin(t * 2.31 + 1.3) * Math.sin(t * 0.73)));\n    };\n    // the shadow caster: the strongest marked light within 45 m\n    shadowOf = null;\n    let best = 0;\n    for (const s of statics) {\n      if (!s.on || !s.shadow) continue;\n      const d2 = (s.x - cam.x) ** 2 + (s.y - cam.y) ** 2 + (s.z - cam.z) ** 2;\n      if (d2 > 45 * 45) continue;\n      const sc = s.intensity * s.range / (1 + d2);\n      if (sc > best) { best = sc; shadowOf = s; }\n    }\n    if (shadowOf) {\n      shadowLight.position.set(shadowOf.x, shadowOf.y, shadowOf.z);\n      shadowLight.color.copy(shadowOf.color);\n      shadowLight.intensity = flick(shadowOf);\n      shadowLight.distance = shadowOf.range;\n      if (shadowLight.shadow.camera.far !== shadowOf.range) { shadowLight.shadow.camera.far = shadowOf.range; shadowLight.shadow.camera.updateProjectionMatrix(); }\n    } else {\n      shadowLight.intensity = 0;\n      shadowLight.position.set(cam.x, -1000, cam.z);\n    }\n\n    cand.length = 0;\n    for (let i = flashes.length - 1; i >= 0; i--) {\n      const f = flashes[i];\n      f.age += dt;\n      if (f.age >= f.life) { flashes.splice(i, 1); continue; }\n      const k = 1 - f.age / f.life;\n      cand.push({ x: f.x, y: f.y, z: f.z, color: f.color, intensity: f.intensity * k, range: f.range, score: 1e9 });\n    }\n    for (const s of statics) {\n425:let fpsAcc = 0, fpsFrames = 0, fps = 0, distantTimer = 12, artyFlash = 0;\n506:    distantTimer -= dt;\n507:    if (distantTimer < 0) {\n512:        artyFlash = 1;\n513:        setTimeout(() => audio.distant('artillery'), km * 2900 / 3);\n514:      } else audio.distant('mg');\n515:      distantTimer = 12 + R() * 22;\n530:    artyFlash = Math.max(0, artyFlash - dt * 2.2);\n531:    G.sky.uniforms.uArty.value = artyFlash * (0.6 + 0.4 * Math.sin(G.time * 40));","is_error":false}]},"uuid":"1b86ce0b-0fea-4c5a-8657-330872a9d14b","timestamp":"2026-10-21T13:49:39.930Z","toolUseResult":{"stdout":"17:uniform vec3 uZenith, uHorizon, uGlow, uFog;\n18:uniform vec3 uGlowDir;\n19:uniform float uTime, uFlash;\n20:uniform vec3 uFlashDir;\n21:uniform vec2 uWind;\n22:uniform float uArty;\n23:uniform vec3 uArtyDir;\n26:float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\n30:  return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);\n35:  return s;\n57:  float fd = max(dot(d, uFlashDir), 0.0);\n58:  col += vec3(0.75, 0.8, 1.0) * uFlash * (0.25 + 1.6 * pow(fd, 6.0) * (0.4 + cloud));\n60:  float ad = max(dot(normalize(vec3(d.x, 0.0, d.z)), uArtyDir), 0.0);\n61:  col += vec3(1.0, 0.55, 0.25) * uArty * pow(ad, 24.0) * exp(-max(el, 0.0) * 14.0) * 1.6;\n69:export function createSky({ zenith = '#161b21', horizon = '#3b4148', glow = '#a2643a', fog = '#3a4047', glowAzimuth = 1.0 } = {}) {\n70:  const uniforms = {\n77:    uFlash: { value: 0 },\n78:    uFlashDir: { value: new THREE.Vector3(0, 0.4, 1).normalize() },\n80:    uArty: { value: 0 },\n81:    uArtyDir: { value: new THREE.Vector3(0, 0, 1) },\n84:    vertexShader: VERT, fragmentShader: FRAG, uniforms,\n91:  return {\n92:    mesh, uniforms,\n93:    update(dt, time, camera, flash, flashDir) {\n95:      uniforms.uTime.value = time;\n96:      uniforms.uFlash.value = flash;\n97:      if (flashDir) uniforms.uFlashDir.value.copy(flashDir);\n\n  function flash(x, y, z, color = '#ffb060', intensity = 30, range = 14, life = 0.06) {\n    if (flashes.length > 12) flashes.shift();\n    flashes.push({ x, y, z, color: new THREE.Color(color), intensity, range, life, age: 0 });\n  }\n\n  const cand = [];\n  const active = [];\n  function update(dt, time, cam