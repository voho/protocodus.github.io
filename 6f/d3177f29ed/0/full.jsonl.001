{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"b6cdfeaab5078ec74dcd2ab1368b861178df9ce8164e442b87b8b819cac9208e","message":{"role":"user","content":[{"tool_use_id":"toolu_01E1XyXayTiRBj2AmtkGAKhB","type":"tool_result","content":"    metallic-roughness map goes to half size (it is smooth data), and the\n    AO / edge masks are dropped.\"\"\"\n    import bake\n    # 2 samples per texel on the channels: crack and joint lines stay whole\n    r = bake.bake_model(obj, tpm=tpm or 110, size=size, keep=keep, scale_islands=scale_islands_facing, samples_channels=2)\n    obj = r['object']\n    mr = r['mr']","is_error":false}]}}
