ver && e.cover !== c) e.cover.taken = null;\n    e.cover = c; c.taken = e;\n    e.state = 'ambush';\n    e.amb = { x: pred.x, z: pred.z, phase: 'move', timer: 30 + R() * 20, peekSpot: spot.peek };\"\"\")\nrep(\"\"\"    // crouched behind the cover, rifle on the place he will come through,\n    // rising every few seconds to look over it\n    e.vel.set(0, 0, 0);\n    a.peek = (a.peek ?? 1.5 + R() * 2) - dt;\n    if (a.peek < -1.2) a.peek = 2.5 + R() * 2.5;\n    e.stance = e.cover.low && a.peek > 0 ? 'crouch' : 'stand';\n    face(e, a.x, a.z, 4, dt);\"\"\",\"\"\"    // crouched behind the cover, rifle on the place he will come through,\n    // every few seconds rising over it (or stepping out past the corner)\n    // to look\n    a.peek = (a.peek ?? 1.5 + R() * 2) - dt;\n    if (a.peek < -1.4) a.peek = 2.5 + R() * 2.5;\n    const looking = a.peek <= 0;\n    const at = looking && a.peekSpot ? a.peekSpot : e.cover;\n    if (Math.hypot(at.x - e.pos.x, at.z - e.pos.z) > 0.15) moveTowards(e, at.x, at.z, ENEMY.walk, dt);\n    else e.vel.set(0, 0, 0);\n    e.stance = looking || !e.cover.low ? (a.peekSpot && !looking ? 'crouch' : 'stand') : 'crouch';\n    face(e, a.x, a.z, 4, dt);\"\"\")\nopen(p,'w').write(s)\nEOF\nnode --check js/ai.js && node tests/ai-check.mjs 2>&1 | grep -v \"^    at \\|node:internal\\|triggerUncaught\\|^\\s*\\^$\\|^$\" | head -12","description":"Let ambushers step out past wall corners to look","timeout":300000}},"wireIngestContext":{"toolu_01JrzPvWgQczJpLdsSi6XYsP":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow"}},"serverClassifierRequest":"e5772106-89d1-427d-8375-236c5aed8ad6","apiBlockIndex":2,"requestId":"req_011CgFDM5eAMmvLw4zX3Lao9","requestRef":"427c0aa2-6bcb-44dc-afe7-dc11ea2124f4","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"ce2de20b-3598-41ac-8379-ada5c68c825c","timestamp":"2026-10-21T10:20:28.925Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external"