 justify-content: space-between; align-items: center; gap: 16px; width: min(440px, 100%); margin: 0 auto 14px; font-size: 14px; text-align: left; }\"),\n(\".stats { display: grid; grid-template-columns: 1fr max-content; gap: 6px 18px; margin: 4px 0 6px; font-size: 15px; }\",\n \".stats { display: grid; grid-template-columns: 1fr max-content; gap: 6px 18px; width: min(360px, 100%); margin: 4px auto 6px; font-size: 15px; text-align: left; }\"),\n]\nfor a,b in reps:\n    assert s.count(a)==1, a[:70]\n    s=s.replace(a,b)\nopen(p,'w').write(s)\nEOF\necho ok","description":"Center the menu panels and their content"},"caller":{"type":"direct"}}]}}
