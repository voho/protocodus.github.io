ers throw shadows only near the shadow light (each one costs six\n   renders of his body into its cube map). */\nfunction castShadows() {\n  const sl = G.lights.shadowLight;\n  if (!sl || !sl.castShadow) return;\n  const lit = sl.intensity > 0;\n  const r2 = (sl.distance + 3) ** 2;\n  const near = (p) => lit && (p.x - sl.position.x) ** 2 + (p.z - sl.position.z) ** 2 < r2;\n  for (const e of G.enemies || []) {\n    const on = e.char.root.visible && near(e.pos);\n    for (const m of e.char.meshes) m.castShadow = on;\n  }\n  if (player) for (const m of player.char.meshes) m.castShadow = near(player.pos);\n}\n\n\"\"\"+a)\nopen('js/main.js','w').write(s)\nedit('js/character.js', [\n(\"\"\"      if (!o.name.endsWith('_merged')) o.material = matlib.resolve(o.material);\n      o.frustumCulled = false;\"\"\",\"\"\"      if (!o.name.endsWith('_merged')) o.material = matlib.resolve(o.material);\n      o.frustumCulled = false;\n      o.receiveShadow = true;\"\"\"),\n])\nEOF\nnode --check js/main.js && node --check js/character.js && node --check js/config.js && echo ok","description":"Enable shadow maps and per-frame soldier shadow casting"}},"wireIngestContext":{"toolu_018vqmHt9HwqJ4V5gt89QsHo":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow"}},"serverClassifierRequest":"0ee5d647-3122-4092-b330-bb93c85cfac3","apiBlockIndex":2,"requestId":"req_011CgFE5toFAkEDFHMgSg7AT","requestRef":"c9b2e3c3-404c-4dfd-83e8-e2fcda0e0624","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"a42d6069-a167-4398-8c48-c4720fe08667","timestamp":"2026-10-21T10:30:01.396Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
