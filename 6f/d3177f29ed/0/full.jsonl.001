ts wet roughness.","+   Everything else writes 1, and transparent things drawn over (rain, mist,","+   decals) only raise it, so a value under 0.25 means \"reflect here\". */"," export const GLSL_HELPERS = /* glsl */ `","+  float mirrorAlpha(float rough, float wet) {","+    return 0.25 * (1.0 - wet * clamp((0.5 - rough) / 0.43, 0.0, 1.0));","+  }","   mat3 cotangentFrame(vec3 N, vec3 p, vec2 uv) {","     vec3 dp1 = dFdx(p), dp2 = dFdy(p);","     vec2 duv1 = dFdx(uv), duv2 = dFdy(uv);"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"49ac9375-571d-4f83-a3ed-c07fa9c3bfb4","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow","branch":"hedgerow-poc","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"3743aa6d-b1c3-4a30-8872-b9f040ad0965","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
