:/* key: [detail texture, metres per tile, normal strength, wet porosity, extra] */\njs/materials.js:118:    mat.envMapIntensity = extra.env ?? 1.0;\njs/materials.js:129:     textures (made wet here); untextured ones map to the palette by name. */\njs/materials.js:151:      m.envMapIntensity = 1.0;\njs/materials.js:164:   glossier, faces turned to the sky hold a film of water with ripples.\njs/materials.js:174:      uWet: shared.wet, uTime: shared.time, uRain: shared.rain,\njs/materials.js:220:        uniform float uPorosity, uWet, uTime, uRain;\njs/materials.js:225:        float mWetUp;\njs/materials.js:234:          mWetUp = ${foliage ? '0.0' : 'up * uWet * smoothstep(0.35, 0.6, detail + 0.15)'};\njs/materials.js:235:          diffuseColor.rgb *= mix(1.0, 0.62, uWet * uPorosity);\njs/materials.js:236:          diffuseColor.rgb *= mix(1.0, 0.82, mWetUp);\njs/materials.js:239:        roughnessFactor = mix(roughnessFactor, ${foliage ? 'max(roughnessFactor * 0.75, 0.42)' : 'roughnessFactor * 0.5 + 0.06'}, uWet);\njs/materials.js:240:        roughnessFactor = mix(roughnessFactor, 0.08, mWetUp * 0.8);`)\njs/materials.js:242:        if (mWetUp > 0.01) {\njs/materials.js:243:          vec2 rip = rainRipples(vWPosM.xz * 1.9, uTime) * uRain * mWetUp;\njs/materials.js:252:        reflectedLight.indirectDiffuse += diffuseColor.rgb * 0.12;`)\njs/materials.js:258:/* The river: opaque, murky, reflective, with flowing normals and rain rings. */\njs/materials.js:265:  mat.envMapIntensity = 1.3;\njs/materials.js:286:          nts.xy += rainRipples(p * 1.5, uTime) * uRain * 0.8;\n     314 js/materials.js\n     287 js/terrain.js\n     100 js/sky.js\n     701 total","is_error":false}]},"uuid":"1ac900cf-a2f5-4673-87ba-03d306d0eeb0","timestamp":"2026-10-21T10:42:21.594Z","toolUseResult":{"stdout":"js/main.js:77:const shared = { wet: { value: 1 }, time: { value: 0 }, rain: { value: 1 } };\njs/main.js:159:  // reflections: the dusk sky as an environment map\njs/main.js:165:  scene.environ