":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
{"parentUuid":"33859ff6-b25c-416f-90e5-1941e9bd01b9","isSidechain":false,"promptId":"ca86ac74-b393-4b38-8e69-5ddecc3498f5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01422av1D1haCijw7e99KChd","type":"tool_result","content":"636\t  function updateIdle(e, dt) {\n637\t    if (e.alertAt > 0 && G.time >= e.alertAt) { e.alertAt = -1; enterCombat(e); return; }\n638\t    if (e.state === 'alert') {\n639\t      e.vel.set(0, 0, 0);\n640\t      if (e.lastKnown) face(e, e.lastKnown.x, e.lastKnown.z, 3, dt);\n641\t      e.awareness = Math.max(0, e.awareness - dt * 0.05);\n642\t      if (e.awareness < 0.2) e.state = e.patrol ? 'patrol' : 'idle';\n643\t      return;\n644\t    }\n645\t    e.awareness = Math.max(0, e.awareness - dt * 0.08);\n646\t    if (e.state === 'patrol' && e.patrol) {\n647\t      if (e.patrolWait > 0) { e.patrolWait -= dt; e.vel.set(0, 0, 0); return; }\n648\t      const [tx, tz] = e.patrol[e.patrolIdx];\n649\t      face(e, tx, tz, 4, dt);\n650\t      if (moveTowards(e, tx, tz, ENEMY.walk * 0.8, dt)) {\n651\t        e.patrolIdx = (e.patrolIdx + 1) % e.patrol.length;\n652\t        e.patrolWait = 2 + R() * 3;\n653\t      }\n654\t      return;\n655\t    }\n656\t    // standing guard: return to the post, look around a little\n657\t    e.vel.set(0, 0, 0);\n658\t    if (e.type !== 'mg' && e.type !== 'sniper' && Math.hypot(e.home.x - e.pos.x, e.home.z - e.pos.z) > 0.6) {\n659\t      face(e, e.home.x, e.home.z, 4, dt);\n660\t      moveTowards(e, e.home.x, e.home.z, ENEMY.walk, dt);\n661\t      return;\n662\t    }\n663\t    const look = e.home.yaw + Math.sin(G.time * 0.21 + e.home.x) * 0.5;\n664\t    e.yaw = dampAngle(e.yaw, look, 0.8, dt);\n665\t    if (e.mg) e.mg.mesh.rotation.y = e.yaw;\n666\t  }\n667\t\n668\t  function updateSearch(e, dt) {\n669\t    e.searchTimer -= dt;\n670\t    const lk = e.lastKnown;\n671\t    if (e.sees) { e.state = 'combat'; e.phase = 'move'; return; }\n672\t    if (!lk || e.searchTimer <= 0) { e.state = 'alert'; e.awareness = 0.6; return; }\n673\t    face(e, lk.x, lk.z, 5, dt);\n674\t    const h = e.home;\n675\t    if (Math.hypot(lk.x - h.x, lk.z - h.z) > e.leash + 10) { e.state = 'alert'; return; }\n676\t    if (moveTowards(e, lk.x, lk.z, ENEMY.walk * 1.2, dt)) e.searchTimer = Math.min(e.searchTimer, 3);\n677\t  }\n678\t\n679\t  /* ---------- animation ---------- */\n680\t\n681\t  function animate(e, dt) {\n682\t    const ch = e.char;\n683\t    const speed = Math.hypot(e.vel.x, e.vel.z);\n684\t    let move;\n685\t    const crouch = e.stance === 'crouch';\n686\t    if (crouch) move = speed > 0.3 ? 'crouch_walk' : 'crouch_idle';\n687\t    else if (speed < 0.3) move = 'idle';\n688\t    else if (speed > 3) move = 'run';\n689\t    else {\n690\t      const mv = Math.atan2(e.vel.x, e.vel.z) - e.yaw;\n691\t      const f = Math.cos(mv), s = Math.sin(mv);\n692\t      if (f > 0.5) move = 'walk'; else if (f < -0.5) move = 'walk_back'; else move = s > 0 ? 'strafe_l' : 'strafe_r';\n693\t    }\n694\t    const gait = GAIT[move] ? clamp(speed / GAIT[move], 0.6, 2.6) : 1;\n695\t    const firing = e.state === 'combat' && (e.phase === 'peek' || e.phase === 'open' || e.type === 'mg' || e.type === 'sniper') && speed < 3;\n696\t    let upper = firing ? (crouch ? 'crouch_aim' : 'aim') : crouch ? move : move;\n697\t    if (e.type === 'mg') upper = crouch ? 'crouch_idle' : 'crouch_aim';\n698\t    if (e.type === 'mg' && !crouch) move = 'crouch_idle';\n699\t    ch.animate(move, upper, gait);\n700\t    if (firing && e.lastKnown) {\n701\t      const p = G.player;\n702\t      const dy = (p.pos.y + 1.2) - (e.pos.y + 1.4);\n703\t      const dh = Math.hypot(e.lastKnown.x - e.pos.x, e.lastKnown.z - e.pos.z);\n704\t      ch.aimPitch = clamp(Math.atan2(dy, dh), -0.8, 0.8);\n705\t    } else ch.aimPitch = 0;\n706\t    ch.root.position.copy(e.pos);\n707\t    ch.root.rotation.y = e.yaw;\n708\t    // out of view and not close: the skeleton is posed five times a second\n709\t    // (the body still moves every frame, so muzzle flashes and tracers start\n710\t    // where he stands)\n711\t    e.animAcc = (e.animAcc || 0) + dt;\n712\t    if (!e.inView && e.dCam > 30 && e.animAcc < 0.2) return;\n713\t    ch.update(e.animAcc, e.fixedY != null ? e.fixedY : G.world.groundAt(e.pos.x, e.pos.z, e.pos.y + 0.2));\n714\t    e.animAcc = 0;\n715\t  }\n716\t\n717\t  /* Is the soldier in the camera's view? A sphere round the body (wider for\n718\t     the dead, whose ragdoll can lie a couple of metres from where he fell). */\n719\t  const frustum = new THREE.Frustum(), projView = new THREE.Matrix4(), sphere = new THREE.Sphere();\n720\t  function inView(e) {\n721\t    const p = e.char.ragdoll ? e.char.ragdoll.pelvis : e.pos;\n722\t    sphere.center.set(p.x, (e.char.ragdoll ? p.y : e.pos.y + 1.0), p.z);\n723\t    sphere.radius = e.dead ? 2.4 : 1.6;\n724\t    return frustum.intersectsSphere(sphere);\n725\t  }\n726\t\n727\t  /* ---------- frame ---------- */\n728\t\n729\t  function update(dt) {\n730\t    const p = G.player;\n731\t    const cam = G.camera.position;\n732\t    const aware = [];\n733\t    G.camera.updateMatrixWorld();\n734\t    projView.multiplyMatrices(G.camera.projectionMatrix, G.camera.matrixWorldInverse);\n735\t    frustum.setFromProjectionMatrix(projView);\n736\t    for (const e of enemies) {\n737\t      const dCam = Math.hypot(e.pos.x - cam.x, e.pos.z - cam.z);\n738\t      const dPl = Math.hypot(e.pos.x - p.pos.x, e.pos.z - p.pos.z);\n739\t      e.dCam = dCam;\n740\t      // drawn only when in view and inside the fog; the low-detail mesh from LOD_FAR\n741\t      e.inView = dCam < 220 && inView(e);\n742\t      e.char.root.visible = e.inView;\n743\t      e.char.setDistance(Math.hypot(e.pos.x - cam.x, e.pos.y - cam.y, e.pos.z - cam.z));\n744\t      if (e.dead) {\n745\t        // a falling body keeps falling out of view; it comes to rest in seconds\n746\t        if (dCam < 220 && (e.inView || (e.char.ragdoll && !e.char.ragdoll.asleep))) e.char.update(dt, e.fixedY ?? G.world.groundAt(e.pos.x, e.pos.z, e.pos.y + 0.2));\n747\t        e.char.shadow.visible = e.inView;\n748\t        continue;\n749\t      }\n750\t      e.active = dPl < 170;\n751\t      if (!e.active) { e.char.shadow.visible = false; continue; }\n752\t      e.lastPos.copy(e.pos);\n753\t      if (e.reloadT > 0) reloadSteps(e, dt);\n754\t      e.perceiveTimer -= dt;\n755\t      if (e.perceiveTimer <= 0) {\n756\t        const step = 0.12;\n757\t        perceive(e, step - e.perceiveTimer);\n758\t        e.perceiveTimer = step;\n759\t      }\n760\t      if (e.state === 'combat') {\n761\t        if (e.type === 'mg') updateMG(e, dt);\n762\t        else if (e.type === 'sniper') updateSniper(e, dt);\n763\t        else updateCombatRifle(e, dt);\n764\t      } else if (e.state === 'search') updateSearch(e, dt);\n765\t      else updateIdle(e, dt);\n766\t      if (e.fixedY != null) e.pos.y = e.fixedY;\n767\t      if (dCam < 220) animate(e, dt);\n768\t      if (!e.inView) e.char.shadow.visible = false;\n769\t      // awareness hint for the HUD\n770\t      if ((e.state === 'alert' || (e.state !== 'combat' && e.awareness > 0.15)) && dPl < 70) {\n771\t        const ang = wrapAngle(Math.atan2(e.pos.x - p.pos.x, e.pos.z - p.pos.z) - G.rig.yaw);\n772\t        aware.push({ angle: ang, level: clamp(e.awareness, 0, 1), alert: false, d: dPl });\n773\t      } else if (e.state === 'combat' && e.sees && dPl < 60 && (e.type === 'sniper' || e.type === 'mg')) {\n774\t        const ang = wrapAngle(Math.atan2(e.pos.x - p.pos.x, e.pos.z - p.pos.z) - G.rig.yaw);\n775\t        aware.push({ angle: ang, level: 1, alert: true, d: dPl });\n776\t      }\n777\t    }\n778\t    aware.sort((a, b) => a.d - b.d);\n779\t    G.hud.awareness(aware);\n780\t  }\n781\t\n782\t  /* Back to their posts after the player respawns (the dead stay dead). */\n783\t  function resetLiving() {\n784\t    for (const e of enemies) {\n785\t      if (e.dead) continue;\n786\t      e.pos.set(e.home.x, e.fixedY ?? G.world.groundAt(e.home.x, e.home.z, 1e4, 0.5), e.home.z);\n787\t      e.yaw = e.home.yaw;\n788\t      e.state = e.patrol ? 'patrol' : 'idle';\n789\t      e.awareness = 0; e.lastKnown = null; e.lastSeen = -99; e.alertAt = -1;\n790\t      if (e.cover) { e.cover.taken = null; e.cover = null; }\n791\t      e.phase = 'hide'; e.suppressed = 0; e.vel.set(0, 0, 0); e.health = ENEMY.health * (e.def.tough || 1);\n792\t      e.mag = e.wdef.mag || 30; e.reloadT = 0; e.reloadRun?.end(); e.reloadRun = null; e.char.holdLeft(null);\n793\t      if (e.glint) e.glint.visible = false;\n794\t      if (e.mg) e.mg.mesh.rotation.y = e.mg.baseYaw;\n795\t    }"}]},"uuid":"6f31119f-3d69-467a-9fc8-8caa35374ce5","timestamp":"2026-10-21T10:11:36.819Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow/js/ai.js","content":"  function updateIdle(e, dt) {\n    if (e.alertAt > 0 && G.time >= e.alertAt) { e.alertAt = -1; enterCombat(e); return; }\n    if (e.state === 'alert') {\n      e.vel.set(0, 0, 0);\n      if (e.lastKnown) face(e, e.lastKnown.x, e.lastKnown.z, 3, dt);\n      e.awareness = Math.max(0, e.awareness - dt * 0.05);\n      if (e.awareness < 0.2) e.state = e.patrol ? 'patrol' : 'idle';\n      return;\n    }\n    e.awareness = Math.max(0, e.awareness - dt * 0.08);\n    if (e.state === 'patrol' && e.patrol) {\n      if (e.patrolWait > 0) { e.patrolWait -= dt; e.vel.set(0, 0, 0); return; }\n      const [tx, tz] = e.patrol[e.patrolIdx];\n      face(e, tx, tz, 4, dt);\n      if (moveTowards(e, tx, tz, ENEMY.walk * 0.8, dt)) {\n        e.patrolIdx = (e.patrolIdx + 1) % e.patrol.length;\n        e.patrolWait = 2 + R() * 3;\n      }\n      return;\n    }\n    // standing guard: return to the post, look around a little\n    e.vel.set(0, 0, 0);\n    if (e.type !== 'mg' && e.type !== 'sniper' && Math.hypot(e.home.x - e.pos.x, e.home.z - e.pos.z) > 0.6) {\n      face(e, e.home.x, e.home.z, 4, dt);\n      moveTowards(e, e.home.x, e.home.z, ENEMY.walk, dt);\n      return;\n    }\n    const look = e.home.yaw + Math.sin(G.time * 0.21 + e.home.x) * 0.5;\n    e.yaw = dampAngle(e.yaw, look, 0.8, dt);\n    if (e.mg) e.mg.mesh.rotation.y = e.yaw;\n  }\n\n  function updateSearch(e, dt) {\n    e.searchTimer -= dt;\n    const lk = e.lastKnown;\n    if (e.sees) { e.state = 'combat'; e.phase = 'move'; return; }\n    if (!lk || e.searchTimer <= 0) { e.state = 'alert'; e.awareness = 0.6; return; }\n    face(e, lk.x, lk.z, 5, dt);\n    const h = e.home;\n    if (Math.hypot(lk.x - h.x, lk.z - h.z) > e.leash + 10) { e.state = 'alert'; return; }\n    if (moveTowards(e, lk.x, lk.z, ENEMY.walk * 1.2, dt)) e.searchTimer = Math.min(e.searchTimer, 3);\n  }\n\n  /* ---------- animation ---------- */\n\n  function animate(e, dt) {\n    const ch = e.char;\n    const speed = Math.hypot(e.vel.x, e.vel.z);\n    let move;\n    const crouch = e.stance === 'crouch';\n    if (crouch) move = speed > 0.3 ? 'crouch_walk' : 'crouch_idle';\n    else if (speed < 0.3) move = 'idle';\n    else if (speed > 3) move = 'run';\n    else {\n      const mv = Math.atan2(e.vel.x, e.vel.z) - e.yaw;\n      const f = Math.cos(mv), s = Math.sin(mv);\n      if (f > 0.5) move = 'walk'; else if (f < -0.5) move = 'walk_back'; else move = s > 0 ? 'strafe_l' : 'strafe_r';\n    }\n    const gait = GAIT[move] ? clamp(speed / GAIT[move], 0.6, 2.6) : 1;\n    const firing = e.state === 'combat' && (e.phase === 'peek' || e.phase === 'open' || e.type === 'mg' || e.type === 'sniper') && speed < 3;\n    let upper = firing ? (crouch ? 'crouch_aim' : 'aim') : crouch ? move : move;\n    if (e.type === 'mg') upper = crouch ? 'crouch_idle' : 'crouch_aim';\n    if (e.type === 'mg' && !crouch) move = 'crouch_idle';\n    ch.animate(move, upper, gait);\n    if (firing && e.lastKnown) {\n      const p = G.player;\n      const dy = (p.pos.y + 1.2) - (e.pos.y + 1.4);\n      const dh = Math.hypot(e.lastKnown.x - e.pos.x, e.lastKnown.z - e.pos.z);\n      ch.aimPitch = clamp(Math.atan2(dy, dh), -0.8, 0.8);\n    } else ch.aimPitch = 0;\n    ch.root.position.copy(e.pos);\n    ch.root.rotation.y = e.yaw;\n    // out of view and not close: the skeleton is posed five times a second\n    // (the body still moves every frame, so muzzle flashes and tracers start\n    // where he stands)\n    e.animAcc = (e.animAcc || 0) + dt;\n    if (!e.inView && e.dCam > 30 && e.animAcc < 0.2) return;\n    ch.update(e.animAcc, e.fixedY != null ? e.fixedY : G.world.groundAt(e.pos.x, e.pos.z, e.pos.y + 0.2));\n    e.animAcc = 0;\n  }\n\n  /* Is the soldier in the camera's view? A sphere round the body (wider for\n     the dead, whose ragdoll can lie a couple of metres from where he fell). */\n  const frustum = new THREE.Frustum(), projView = new THREE.Matrix4(), sphere = new THREE.Sphere();\n  function inView(e) {\n    const p = e.char.ragdoll ? e.char.ragdoll.pelvis : e.pos;\n    sphere.center.set(p.x, (e.char.ragdoll ? p.y : e.pos.y + 1.0), p.z);\n    sphere.radius = e.dead ? 2.4 : 1.6;\n    return frustum.intersectsSphere(sphere);\n  }\n\n  /* ---------- frame ---------- */\n\n  function update(dt) {\n    const p = G.player;\n    const cam = G.camera.position;\n    const aware = [];\n    G.camera.updateMatrixWorld();\n    projView.multiplyMatrices(G.camera.projectionMatrix, G.camera.matrixWorldInverse);\n    frustum.setFromProjectionMatrix(projView);\n    for (const e of enemies) {\n      const dCam = Math.hypot(e.pos.x - cam.x, e.pos.z - cam.z);\n      const dPl = Math.hypot(e.pos.x - p.pos.x, e.pos.z - p.pos.z);\n      e.dCam = dCam;\n      // drawn only when in view and inside the fog; the low-detail mesh from LOD_FAR\n      e.inView = dCam < 220 && inView(e);\n      e.char.root.visible = e.inView;\n      e.char.setDistance(Math.hypot(e.pos.x - cam.x, e.pos.y - cam.y, e.pos.z - cam.z));\n      if (e.dead) {\n        // a falling body keeps falling out of view; it comes to rest in seconds\n        if (dCam < 220 && (e.inView || (e.char.ragdoll && !e.char.ragdoll.asleep))) e.char.update(dt, e.fixedY ?? G.world.groundAt(e.pos.x, e.pos.z, e.pos.y + 0.2));\n        e.char.shadow.visible = e.inView;\n        continue;\n      }\n      e.active = dPl < 170;\n      if (!e.active) { e.char.shadow.visible = false; continue; }\n      e.lastPos.copy(e.pos);\n      if (e.reloadT > 0) reloadSteps(e, dt);\n      e.perceiveTimer -= dt;\n      if (e.perceiveTimer <= 0) {\n        const step = 0.12;\n        perceive(e, step - e.perceiveTimer);\n        e.perceiveTimer = step;\n      }\n      if (e.state === 'combat') {\n        if (e.type === 'mg') updateMG(e, dt);\n        else if (e.type === 'sniper') updateSniper(e, dt);\n        else updateCombatRifle(e, dt);\n      } else if (e.state === 'search') updateSearch(e, dt);\n      else updateIdle(e, dt);\n      if (e.fixedY != null) e.pos.y = e.fixedY;\n      if (dCam < 220) animate(e, dt);\n      if (!e.inView) e.char.shadow.visible = false;\n      // awareness hint for the HUD\n      if ((e.state === 'alert' || (e.state !== 'combat' && e.awareness > 0.15)) && dPl < 70) {\n        const ang = wrapAngle(Math.atan2(e.pos.x - p.pos.x, e.pos.z - p.pos.z) - G.rig.yaw);\n        aware.push({ angle: ang, level: clamp(e.awareness, 0, 1), alert: false, d: dPl });\n      } else if (e.state === 'combat' && e.sees && dPl < 60 && (e.type === 'sniper' || e.type === 'mg')) {\n        const ang = wrapAngle(Math.atan2(e.pos.x - p.pos.x, e.pos.z - p.pos.z) - G.rig.yaw);\n        aware.push({ angle: ang, level: 1, alert: true, d: dPl });\n      }\n    }\n    aware.sort((a, b) => a.d - b.d);\n    G.hud.awareness(aware);\n  }\n\n  /* Back to their posts after the player respawns (the dead stay dead). */\n  function resetLiving() {\n    for (const e of enemies) {\n      if (e.dead) continue;\n      e.pos.set(e.home.x, e.fixedY ?? G.world.groundAt(e.home.x, e.home.z, 1e4, 0.5), e.home.z);\n      e.yaw = e.home.yaw;\n      e.state = e.patrol ? 'patrol' : 'idle';\n      e.awareness = 0; e.lastKnown = null; e.lastSeen = -99; e.alertAt = -1;\n      if (e.cover) { e.cover.taken = null; e.cover = null; }\n      e.phase = 'hide'; e.suppressed = 0; e.vel.set(0, 0, 0); e.health = ENEMY.health * (e.def.tough || 1);\n      e.mag = e.wdef.mag || 30; e.reloadT = 0; e.reloadRun?.end(); e.reloadRun = null; e.char.holdLeft(null);\n      if (e.glint) e.glint.visible = false;\n      if (e.mg) e.mg.mesh.rotation.y = e.mg.baseYaw;\n    }","numLines":160,"startLine":636,"totalLines":800}},"sourceToolAssistantUUID":"33859ff6-b25c-416f-90e5-1941e9bd01b9","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
