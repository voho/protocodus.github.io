{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"bff45913b9e8cb452d2fbb28706f292056eeca8a7d5a0d168ee3cce1b1e05e03","message":{"role":"assistant","content":[{"type":"text","text":"Applying the font switch to the stylesheet and the page's font preload."},{"type":"tool_use","id":"toolu_01QSi3dZiUfdBfNPAKqsQnXV","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow && python3 -I - <<'EOF'\np='hedgerow.css'\ns=open(p).read()\nreps=[\n(\"\"\"/* Hedgerow — screens and HUD. Space Grotesk (site font, OFL) for the\n   interface, the system's typewriter face for orders and briefings. */\n@font-face {\n  font-family: 'Space Grotesk';\n  src: url('/assets/fonts/space-grotesk-latin.woff2') format('woff2');\n  font-weight: 300 700;\n  font-display: swap;\n}\n\"\"\",\n\"\"\"/* Hedgerow — screens and HUD, all set on the typewriter: Courier Prime\n   (OFL) for every word of the interface, Special Elite (Apache 2.0), a worn\n   field typewriter, for the wordmark and the headings. */\n@font-face {\n  font-family: 'Courier Prime';\n  src: url('./assets/fonts/courier-prime-latin-400.woff2') format('woff2');\n  font-weight: 400;\n  font-display: swap;\n}\n@font-face {\n  font-family: 'Courier Prime';\n  src: url('./assets/fonts/courier-prime-latin-700.woff2') format('woff2');\n  font-weight: 700;\n  font-display: swap;\n}\n@font-face {\n  font-family: 'Special Elite';\n  src: url('./assets/fonts/special-elite-latin.woff2') format('woff2');\n  font-weight: 400;\n  font-display: swap;\n}\n\"\"\"),\n(\"  --type: 'American Typewriter', 'Courier Prime', 'Courier New', ui-monospace, monospace;\\n\",\n \"  --type: 'Courier Prime', 'American Typewriter', 'Courier New', ui-monospace, monospace;\\n  --stamp: 'Special Elite', 'Courier Prime', 'American Typewriter', 'Courier New', monospace;\\n\"),\n(\"  font-family: 'Space Grotesk', system-ui, sans-serif;\\n\", \"  font-family: var(--type);\\n\"),\n(\"  font-size: clamp(44px, 10vw, 92px); font-weight: 700; letter-spacing: 0.16em;\\n\",\n \"  font-family: var(--stamp); font-size: clamp(44px, 10vw, 92px); font-weight: 400; letter-spacing: 0.12em;\\n\"),\n(\"h2 { margin: 0 0 14px; font-size: 28px; font-weight: 600; letter-spacing: 0.02em; }\",\n \"h2 { margin: 0 0 14px; font-family: var(--stamp); font-size: 30px; font-weight: 400; letter-spacing: 0.04em; }\"),\n(\".menu-item.primary { background: var(--brass); border-color: var(--brass); color: #16130c; font-weight: 600; }\",\n \".menu-item.primary { background: var(--brass); border-color: var(--brass); color: #16130c; font-weight: 700; }\"),\n(\".keys dt { color: var(--brass); font-weight: 600; }\", \".keys dt { color: var(--brass); font-weight: 700; }\"),\n(\".compass-strip span.major { color: var(--ink); font-weight: 600; }\", \".compass-strip span.major { color: var(--ink); font-weight: 700; }\"),\n(\".ammo { margin: 0; font-size: 34px; font-weight: 600; line-height: 1.1; }\", \".ammo { margin: 0; font-size: 34px; font-weight: 700; line-height: 1.1; }\"),\n]\nfor a,b in reps:\n    assert s.count(a)==1, a[:70]\n    s=s.replace(a,b)\nopen(p,'w').write(s)\np='index.html'\ns=open(p).read()\na='  <link rel=\"preload\" href=\"/assets/fonts/space-grotesk-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\\n'\nassert a in s\ns=s.replace(a,'  <link rel=\"preload\" href=\"./assets/fonts/courier-prime-latin-400.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\\n  <link rel=\"preload\" href=\"./assets/fonts/special-elite-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\\n')\nopen(p,'w').write(s)\nEOF\ngrep -n \"Space Grotesk\\|font-weight: 600\" hedgerow.css index.html; grep -rn \"font\\b\\|fontFamily\\|ctx.font\\|\\.font =\" js/*.js | grep -v \"^js/.*://\" | head","description":"Switch the stylesheet and preloads to the typewriter fonts"},"caller":{"type":"direct"}}]}}
