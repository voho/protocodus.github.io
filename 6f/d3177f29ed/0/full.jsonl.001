d":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
