{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"e97467903b1831b92a3fd56b77f52760545aa7d5e7c1f1a2e7206536707b2293","message":{"role":"user","content":[{"tool_use_id":"toolu_014Esr2eUGTBgBRK1ujBa6Lz","type":"tool_result","content":"158\t/* Rain on a standard material: porous surfaces darken, everything gets\n159\t   glossier, faces turned to the sky hold a film of water with ripples.\n160\t   With `detailTex` (palette materials) a tiling detail texture (RGB normal,\n161\t   A albedo detail) in metre UVs adds the surface grain. */\n162\tfunction addWeather(mat, shared, { porosity = 0.75, detailTex = null, tile = 1, foliage = false }) {\n163\t  const detail = !!detailTex;\n164\t  const tileScale = 1 / tile;\n165\t  mat.customProgramCacheKey = () => 'hedgerow-' + (detail ? 'd' : 'b') + (foliage ? 'f' : '') + (mat.normalMap ? 'n' : '');\n166\t  mat.onBeforeCompile = (shader) => {\n167\t    Object.assign(shader.uniforms, {\n168\t      uTile: { value: tileScale }, uPorosity: { value: porosity },\n169\t      uWet: shared.wet, uTime: shared.time, uRain: shared.rain,\n170\t      tDetail: { value: detailTex },\n171\t    });\n172\t    shader.vertexShader = shader.vertexShader\n173\t      .replace('#include <common>', `#include <common>\n174\t        uniform float uTile;\n175\t        uniform float uTime;\n176\t        varying vec3 vWNormalM;\n177\t        varying vec2 vDetailUv;"}]}}
