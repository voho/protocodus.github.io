{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"568d7fb11c272202725165dd09809393eae7b2b395798da65eee87b7a78749ad","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Wiring the renderer and presets in `main.js`, and the per-frame rule that only soldiers within the shadow light's reach cast shadows."},{"type":"tool_use","id":"toolu_018vqmHt9HwqJ4V5gt89QsHo","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow && sed -n 162,172p js/levelBuild.js && python3 -I - <<'EOF'\ndef edit(p, pairs):\n    s=open(p).read()\n    for a,b in pairs:\n        assert s.count(a)==1, (p, a[:80])\n        s=s.replace(a,b)\n    open(p,'w').write(s)\nedit('js/config.js', [\n(\"  high: { pixelRatio: 1.5, bloom: true, volumetric: true, grass: 1, rain: 9000, treeNear: 52 },\\n  medium: { pixelRatio: 1, bloom: true, volumetric: true, grass: 0.6, rain: 6000, treeNear: 48 },\\n  low: { pixelRatio: 0.75, bloom: false, volumetric: false, grass: 0.3, rain: 3500, treeNear: 36 },\",\n \"  high: { pixelRatio: 1.5, bloom: true, volumetric: true, shadows: 512, grass: 1, rain: 9000, treeNear: 52 },\\n  medium: { pixelRatio: 1, bloom: true, volumetric: true, shadows: 256, grass: 0.6, rain: 6000, treeNear: 48 },\\n  low: { pixelRatio: 0.75, bloom: false, volumetric: false, shadows: 0, grass: 0.3, rain: 3500, treeNear: 36 },\"),\n])\nedit('js/main.js', [\n(\"\"\"  renderer.toneMapping = THREE.ACESFilmicToneMapping;\"\"\",\n \"\"\"  // shadows from the lamp or fire nearest the camera (lights.js); the\n  // preset at load decides (switching it later would recompile everything)\n  renderer.shadowMap.enabled = !!quality.shadows;\n  renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n  renderer.toneMapping = THREE.ACESFilmicToneMapping;\"\"\"),\n(\"\"\"  G.lights = createLighting(scene, { pool: 8 });\"\"\",\n \"\"\"  G.lights = createLighting(scene, { pool: 8, shadows: !!quality.shadows, shadowSize: quality.shadows || 256 });\"\"\"),\n(\"\"\"    G.lights.update(dt, G.time, camera.position, flash);\"\"\",\n \"\"\"    G.lights.update(dt, G.time, camera.position, flash);\n    castShadows();\"\"\"),\n])\ns=open('js/main.js').read()\na=\"/* ---------- dynamic resolution ----------\"\nassert s.count(a)==1\ns=s.replace(a,\"\"\"/* Soldiers throw shadows only near the shadow light (each one costs six\n   renders of his body into its cube map). */\nfunction castShadows() {\n  const sl = G.lights.shadowLight;\n  if (!sl || !sl.castShadow) return;\n  const lit = sl.intensity > 0;\n  const r2 = (sl.distance + 3) ** 2;\n  const near = (p) => lit && (p.x - sl.position.x) ** 2 + (p.z - sl.position.z) ** 2 < r2;\n  for (const e of G.enemies || []) {\n    const on = e.char.root.visible && near(e.pos);\n    for (const m of e.char.meshes) m.castShadow = on;\n  }\n  if (player) for (const m of player.char.meshes) m.castShadow = near(player.pos);\n}\n\n\"\"\"+a)\nopen('js/main.js','w').write(s)\nedit('js/character.js', [\n(\"\"\"      if (!o.name.endsWith('_merged')) o.material = matlib.resolve(o.material);\n      o.frustumCulled = false;\"\"\",\"\"\"      if (!o.name.endsWith('_merged')) o.material = matlib.resolve(o.material);\n      o.frustumCulled = false;\n      o.receiveShadow = true;\"\"\"),\n])\nEOF\nnode --check js/main.js && node --check js/character.js && node --check js/config.js && echo ok","description":"Enable shadow maps and per-frame soldier shadow casting"},"caller":{"type":"direct"}}]}}
