 e.char.root.visible).length;\n({ dbg: document.querySelector('[data-debug]')?.textContent, drawn, total: G.enemies.length, inViewFlags: G.enemies.filter((e) => e.inView).length, gpu: (await gpuTime()).toFixed(2) })","tabId":"seed"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01KUapL1moLrcsTFzF8izbKa","name":"mcp__Claude_Browser__read_console_messages","input":{"tabId":"seed","onlyErrors":true},"caller":{"type":"direct"}}]}}
