nst g = c.getContext('2d'); const img = g.createImageData(w, h);\n  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {\n    const i = ((H - 1 - y * step) * W + x * step) * 4, o = (y * w + x) * 4;\n    const v = [0, 1, 2, 3].map(k => THREE.DataUtils.fromHalfFloat(buf[i + k]));\n    const px = fn(v);\n    img.data[o] = px[0]; img.data[o + 1] = px[1]; img.data[o + 2] = px[2]; img.data[o + 3] = 255;\n  }\n  g.putImageData(img, 0, 0);\n  return post(name, c);\n};\n// the scene target as the reflections pass sees it (before the chain writes over it)\nwindow.captureScene = () => {\n  const G = window.hedgerow.G, fx = window.hedgerow.fx;\n  let cap = null;\n  const prev = fx.ssr.render;\n  fx.ssr.render = function (renderer, w, r) {\n    if (!cap) { const buf = new Uint16Array(r.width * r.height * 4); renderer.readRenderTargetPixels(r, 0, 0, r.width, r.height, buf); cap = { W: r.width, H: r.height, buf }; }\n    return prev.call(this, renderer, w, r);\n  };\n  G.renderer.render(G.scene, G.camera);\n  fx.ssr.render = prev;\n  return cap;\n};\nwindow.mirrorMap = async (name) => {\n  const { W, H, buf } = captureScene();\n  return halfImage(name, W, H, buf, (v) => { const m = Math.max(0, Math.min(1, 1 - v[3] * 4)), q = Math.round(m * 255); return [q, q, v[3] > 0.25 ? 70 : q]; }, 2);\n};\nwindow.ssrMap = async (name) => {\n  const G = window.hedgerow.G, rt = window.hedgerow.fx.ssr.texture.renderTarget;\n  G.renderer.render(G.scene, G.camera);\n  const buf = new Uint16Array(rt.width * rt.height * 4);\n  G.renderer.readRenderTargetPixels(rt, 0, 0, rt.width, rt.height, buf);\n  return halfImage(name, rt.width, rt.height, buf, (v) => v[3] > 1e-4 ? [tm(v[0] / v[3]), tm(v[1] / v[3]), tm(v[2] / v[3])] : [0, 0, 60]);\n};\nwindow.ready = async () => { for (let i = 0; i < 60 && document.querySelector('[data-menu]').hidden; i++) await new Promise((r) => setTimeout(r, 1000)); };\n})()`;\nlocation.reload();","tabId":"seed"}},"serverClassifierRequest":"1fd60cf5-dfef-4adf-8465-100504ee