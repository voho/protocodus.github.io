n    s=s.replace(a,b)\nopen(p,'w').write(s)\nEOF\ngrep -n \"When you die\\|killcam\\|Killed by\" README.md | head -3; sed -n 40,56p README.md","description":"Remove the launch config and document the new AI in the README"},"caller":{"type":"direct"}}]}}
