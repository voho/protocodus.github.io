{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"d84c4602b7a7f2443ec601049015fd146a37fd9d9503bde3200d8f91e3529b2d","message":{"role":"user","content":[{"tool_use_id":"toolu_01GPL2foZhxVVAFoTGZhUKpP","type":"tool_result","content":"45:    def __init__(self, mat, clear=True):\n55:    def feed(self, sock, val):\n72:    def node(self, kind, inputs=None, **props):\n83:    def coord(self, kind='Object'):\n86:    def uvmap(self, name):\n89:    def geometry(self, kind):\n92:    def attribute(self, name, kind='Fac'):\n96:    def image(self, img, uv='bake', out='Color'):\n102:    def math(self, op, a, b=None, c=None, clamp=False):\n109:    def add(self, a, b, clamp=False): return self.math('ADD', a, b, clamp=clamp)\n110:    def sub(self, a, b, clamp=False): return self.math('SUBTRACT', a, b, clamp=clamp)\n111:    def mul(self, a, b, clamp=False): return self.math('MULTIPLY', a, b, clamp=clamp)\n112:    def madd(self, a, b, c, clamp=False): return self.math('MULTIPLY_ADD', a, b, c, clamp=clamp)\n113:    def maximum(self, a, b): return self.math('MAXIMUM', a, b)\n114:    def minimum(self, a, b): return self.math('MINIMUM', a, b)\n115:    def power(self, a, b): return self.math('POWER', a, b)\n116:    def absolute(self, a): return self.math('ABSOLUTE', a)\n117:    def sin(self, a): return self.math('SINE', a)\n118:    def fract(self, a): return self.math('FRACT', a)\n119:    def floor(self, a): return self.math('FLOOR', a)\n120:    def one_minus(self, a): return self.math('SUBTRACT', 1.0, a)\n122:    def vmath(self, op, a, b=None, scale=None, out=0):\n130:    def vscale(self, v, s):\n136:    def vadd(self, v, o):\n139:    def sep(self, v):\n143:    def combine(self, x, y, z):\n146:    def map_range(self, x, a, b, c=0.0, d=1.0, interp='LINEAR', clamp=True):\n152:    def smooth(self, x, a, b):\n155:    def mix(self, fac, a, b, blend='MIX'):\n162:    def mixf(self, fac, a, b):\n169:    def cmul(self, a, b):\n172:    def ramp(self, fac, stops, interp='LINEAR'):\n186:    def hsv(self, col, h=0.5, s=1.0, v=1.0):\n190:    def noise(self, vec, scale, detail=4.0, rough=0.5, distortion=0.0, kind='FBM', lac=2.0, out='Fac'):\n198:    def voronoi(self, vec, scale, feature='F1', rand=1.0, out='Distance', smooth=0.0, dims='3D', metric='EUCLIDEAN'):\n207:    def voronoi_edge(self, vec, scale, rand=1.0, dims='3D'):\n211:    def brick(self, vec, scale, mortar, width=0.5, height=0.25, bias=0.0, smooth=0.1, offset=0.5, out='Fac'):\n221:    def wave(self, vec, scale, kind='BANDS', direction='X', distortion=0.0, detail=2.0, profile='SIN'):\n229:    def bump(self, height, strength=1.0, distance=0.02, normal=None):\n237:    def bevel(self, radius, samples=8):\n242:    def emission(self, col):\n249:    def principled(self, albedo, rough, metal, normal=None, glow=None, alpha=None):\n422:    def restore():\n510:    def edge_graph(g):\n41:        self.P = g.vadd(raw, off)\n42:        self.Z = g.sep(raw)[2]\n47:        self.ao = g.image(ao_img) if ao_img else 1.0\n48:        self.edge = g.image(edge_img) if edge_img else 0.0\n52:    def n(self, scale, detail=4.0, rough=0.55, vec=None, stretch=None, kind='FBM', distortion=0.0):\n54:        v = vec if vec is not None else self.P\n62:    def col(self, hexcode):\n65:    def tint(self, color, amount_socket, lo=0.85, hi=1.15):","is_error":false}]}}
