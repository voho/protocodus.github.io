e5cb-5c17-4f78-8159-fe8e322bd52d","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
{"parentUuid":"a4633c8e-9fbc-4665-80e1-dfb38107a6fa","isSidechain":false,"promptId":"ca86ac74-b393-4b38-8e69-5ddecc3498f5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NfSi5QKni94P3gst7tvdsk","type":"tool_result","content":"250\t        if (e.state !== 'combat') { e.awareness = Math.max(e.awareness, 0.45); e.lastKnown = { x, z }; }\n251\t        continue;\n252\t      }\n253\t      e.lastKnown = { x, z };\n254\t      if (d < radius * 0.55 || kind === 'explosion') enterCombat(e);\n255\t      else { e.awareness = Math.max(e.awareness, 0.8); if (e.state !== 'combat') e.state = 'alert'; }\n256\t    }\n257\t  });\n258\t\n259\t  /* ---------- perception ---------- */\n260\t\n261\t  function eyePos(e, out) {\n262\t    const h = e.stance === 'crouch' ? 1.05 : 1.6;\n263\t    return out.set(e.pos.x, e.pos.y + h, e.pos.z);\n264\t  }\n265\t\n266\t  function perceive(e, dt) {\n267\t    const p = G.player;\n268\t    e.sees = false;\n269\t    e.exposure = 0;\n270\t    if (!p.alive) return;\n271\t    const eye = eyePos(e, tmp);\n272\t    const head = tmp2.set(p.pos.x, p.pos.y + (p.crouch ? 1.15 : 1.65), p.pos.z);\n273\t    const chest = tmp3.set(p.pos.x, p.pos.y + (p.crouch ? 0.8 : 1.2), p.pos.z);\n274\t    const dx = chest.x - eye.x, dz = chest.z - eye.z;\n275\t    const dist = Math.hypot(dx, dz);\n276\t    const combat = e.state === 'combat';\n277\t    let range = (e.type === 'sniper' ? 150 : e.type === 'mg' ? 95 : ENEMY.viewRange) * p.visible * (combat ? 1.7 : 1);\n278\t    if (G.lightning > 0.4) range *= 1.4;\n279\t    if (dist > range) return;\n280\t    const ang = Math.abs(wrapAngle(Math.atan2(dx, dz) - e.yaw));\n281\t    const fov = combat ? Math.PI : e.state === 'alert' ? ENEMY.viewFov * 1.4 : ENEMY.viewFov;\n282\t    if (ang > fov) return;\n283\t    const seeHead = G.world.clear(eye.x, eye.y, eye.z, head.x, head.y, head.z, SIGHT);\n284\t    const seeChest = G.world.clear(eye.x, eye.y, eye.z, chest.x, chest.y, chest.z, SIGHT);\n285\t    if (!seeHead && !seeChest) return;\n286\t    e.sees = true;\n287\t    e.exposure = seeChest ? 1 : 0.45;\n288\t    e.lastKnown = { x: p.pos.x, z: p.pos.z };\n289\t    e.lastSeen = G.time;\n290\t    if (!combat) {\n291\t      const near = 1 - dist / range;\n292\t      e.awareness += dt * ENEMY.awareRate * G.diff.aware * (0.35 + 2.2 * near * near) * (seeChest ? 1 : 0.6);\n293\t      if (e.awareness >= 1) enterCombat(e);\n294\t      else if (e.awareness > 0.35) e.state = 'alert';\n295\t    }\n296\t  }\n297\t\n298\t  /* ---------- movement ---------- */\n299\t\n300\t  function moveTowards(e, tx, tz, speed, dt) {\n301\t    const dx = tx - e.pos.x, dz = tz - e.pos.z;\n302\t    const d = Math.hypot(dx, dz);\n303\t    if (d < 0.25) { e.vel.set(0, 0, 0); return true; }\n304\t    const vx = (dx / d) * speed, vz = (dz / d) * speed;\n305\t    e.vel.x = damp(e.vel.x, vx, 8, dt);\n306\t    e.vel.z = damp(e.vel.z, vz, 8, dt);\n307\t    tmp.set(e.pos.x + e.vel.x * dt, 0, e.pos.z + e.vel.z * dt);\n308\t    G.world.pushOut(tmp, ENEMY.radius, e.pos.y, 1.7, 0.45);\n309\t    // keep apart from other soldiers and the player\n310\t    for (const o of enemies) {\n311\t      if (o === e || o.dead) continue;\n312\t      const ox = tmp.x - o.pos.x, oz = tmp.z - o.pos.z;\n313\t      const od = Math.hypot(ox, oz);\n314\t      if (od < 0.7 && od > 1e-4) { tmp.x += (ox / od) * (0.7 - od) * 0.5; tmp.z += (oz / od) * (0.7 - od) * 0.5; }\n315\t    }\n316\t    if (G.world.tooDeep(tmp.x, tmp.z, 1.0, e.pos.y)) { e.vel.set(0, 0, 0); return true; }\n317\t    e.pos.x = tmp.x; e.pos.z = tmp.z;\n318\t    e.pos.y = G.world.groundAt(e.pos.x, e.pos.z, e.pos.y, 0.5);\n319\t    return d < 0.5;\n320\t  }\n321\t\n322\t  function face(e, x, z, rate, dt) {\n323\t    const want = Math.atan2(x - e.pos.x, z - e.pos.z);\n324\t    e.yaw = dampAngle(e.yaw, want, rate, dt);\n325\t    return Math.abs(wrapAngle(want - e.yaw));\n326\t  }\n327\t\n328\t  /* Find a cover point near the post that hides a crouching man from the\n329\t     player's last known position but lets him fire standing. */\n330\t  function findCover(e) {\n331\t    const lk = e.lastKnown || { x: G.player.pos.x, z: G.player.pos.z };\n332\t    const py = G.player.pos.y + 1.2;\n333\t    const centre = e.leash > 0 ? e.home : e.pos;\n334\t    const cand = coverNear(centre.x, centre.z, Math.max(8, e.leash + 4));\n335\t    let best = null, bestScore = -Infinity;\n336\t    let tests = 0;\n337\t    cand.sort((a, b) => ((a.x - e.pos.x) ** 2 + (a.z - e.pos.z) ** 2) - ((b.x - e.pos.x) ** 2 + (b.z - e.pos.z) ** 2));\n338\t    for (const c of cand) {\n339\t      if (c.taken && c.taken !== e) continue;\n340\t      if (tests > 14) break;\n341\t      const toP = Math.hypot(lk.x - c.x, lk.z - c.z);\n342\t      if (toP < 6) continue;\n343\t      // the obstacle must be between the point and the player\n344\t      const facing = ((lk.x - c.x) * -c.nx + (lk.z - c.z) * -c.nz) / toP;\n345\t      if (facing < 0.35) continue;\n346\t      tests++;\n347\t      const hidden = !G.world.clear(c.x, c.y + 0.95, c.z, lk.x, py, lk.z, SHOT);\n348\t      if (!hidden) continue;\n349\t      const peek = c.low ? G.world.clear(c.x, c.y + 1.55, c.z, lk.x, py + 0.3, lk.z, SIGHT) : true;\n350\t      const dMe = Math.hypot(c.x - e.pos.x, c.z - e.pos.z);\n351\t      const pref = e.type === 'smg' ? 16 : 28;\n352\t      const score = (peek ? 6 : 0) - dMe * 0.45 - Math.abs(toP - pref) * 0.15 + facing * 2;\n353\t      if (score > bestScore) { bestScore = score; best = c; }\n354\t    }\n355\t    return best;\n356\t  }\n357\t\n358\t  /* ---------- shooting ---------- */\n359\t\n360\t  function muzzleOf(e, out) {\n361\t    if (e.mg) {\n362\t      const m = e.mg;\n363\t      const yaw = m.mesh.rotation.y;\n364\t      const c = Math.cos(yaw), s = Math.sin(yaw);\n365\t      return out.set(m.x + m.muzzle[0] * c + m.muzzle[2] * s, m.y + m.muzzle[1], m.z - m.muzzle[0] * s + m.muzzle[2] * c);\n366\t    }\n367\t    return e.char.muzzleWorld(out);\n368\t  }\n369\t\n370\t  function startReload(e) {\n371\t    const w = e.wdef;\n372\t    e.reloadT = e.reloadTotal = w.reload || 3;\n373\t    e.reloadStage = 0;\n374\t    e.burstLeft = 0;\n375\t    if (e.type !== 'mg') {\n376\t      const clip = e.type === 'smg' && e.char.hasClip('reload_smg') ? 'reload_smg' : 'reload';\n377\t      e.char.oneShot(clip, (e.char.clipLength(clip) || 1.6) / e.reloadTotal);\n378\t      e.reloadRun = reloadSequence(G, e.char, w, clip);\n379\t    }\n380\t    G.audio.reload?.(e.type === 'smg' ? 'thompson' : 'garand', e.pos);\n381\t  }\n382\t\n383\t  /* the hands during an enemy reload (the shared sequencer in reload.js) */\n384\t  function reloadSteps(e, dt) {\n385\t    e.reloadT -= dt;\n386\t    e.reloadRun?.update(1 - Math.max(0, e.reloadT) / e.reloadTotal);\n387\t    if (e.reloadT <= 0) { e.reloadT = 0; e.mag = e.wdef.mag || 30; e.reloadRun?.end(); e.reloadRun = null; }\n388\t  }\n389\t\n390\t  function shoot(e) {\n391\t    const p = G.player;\n392\t    const w = e.wdef;\n393\t    if (e.reloadT > 0) return;\n394\t    if (--e.mag <= 0) startReload(e);\n395\t    const muzzle = muzzleOf(e, new THREE.Vector3());\n396\t    const target = new THREE.Vector3(p.pos.x, p.pos.y + (p.crouch ? 0.85 : 1.25), p.pos.z);\n397\t    let hit = false;\n398\t    if (e.sees && p.alive) {\n399\t      const d = muzzle.distanceTo(target);\n400\t      const fall = clamp(1 - (d - 6) / (w.range * 1.1), 0.12, 1);\n401\t      let pHit = BASE_ACC[e.type] * fall * e.exposure * G.diff.accuracy;\n402\t      if (p.crouch) pHit *= 0.7;\n403\t      if (p.movingSpeed > 3) pHit *= 0.7;\n404\t      if (p.vault) pHit *= 0.5;\n405\t      if (e.suppressed > 0) pHit *= 0.35;\n406\t      if (e.firstShot) pHit *= 0.45;\n407\t      pHit *= Math.min(1.25, 0.85 + e.shotsAtTarget * 0.05);\n408\t      hit = R() < pHit;\n409\t    }\n410\t    e.firstShot = false;\n411\t    e.shotsAtTarget++;\n412\t    // visuals and sound\n413\t    const dir = new THREE.Vector3();\n414\t    let end;\n415\t    if (hit) {\n416\t      end = target;\n417\t    } else {\n418\t      // a miss lands around the player (or around where he was)\n419\t      const base = e.sees ? target : new THREE.Vector3(e.lastKnown?.x ?? p.pos.x, p.pos.y + 1, e.lastKnown?.z ?? p.pos.z);\n420\t      end = base.clone().add(new THREE.Vector3((R() - 0.5) * 3.2, (R() - 0.6) * 1.8, (R() - 0.5) * 3.2));\n421\t    }\n422\t    dir.subVectors(end, muzzle);\n423\t    const len = dir.length();\n424\t    dir.divideScalar(len || 1);\n425\t    G.effects.muzzle(muzzle.x, muzzle.y, muzzle.z, dir.x, dir.y, dir.z, e.type === 'mg' ? 1.1 : 0.9);\n426\t    G.lights.flash(muzzle.x + dir.x * 0.3, muzzle.y, muzzle.z + dir.z * 0.3, '#ffb36b', e.type === 'mg' ? 50 : 40, 8, 0.05);\n427\t    G.audio.gunshot(w.sound, muzzle.x, muzzle.y, muzzle.z);\n428\t    if (R() < w.tracer) G.effects.tracer(muzzle.x + dir.x * 0.6, muzzle.y + dir.y * 0.6, muzzle.z + dir.z * 0.6, dir.x, dir.y, dir.z, hit ? len : 150, 260, '#ffc070');\n429\t    if (hit) {\n430\t      const dmg = lerp(w.damage[0], w.damage[1], R()) * G.diff.damage;\n431\t      p.damage(dmg, e.pos);\n432\t      G.effects.blood(target.x, target.y, target.z, dir.x, dir.y, dir.z);\n433\t    } else {\n434\t      const wh = G.world.raycast(muzzle.x, muzzle.y, muzzle.z, dir.x, dir.y, dir.z, 200, SHOT);\n435\t      if (wh) {\n436\t        G.effects.impact(wh.x, wh.y, wh.z, wh.nx, wh.ny, wh.nz, wh.surface || 'stone');\n437\t        G.decals?.impact(wh.x, wh.y, wh.z, wh.nx, wh.ny, wh.nz, wh.surface || 'stone');\n438\t        G.audio.impact(wh.x, wh.y, wh.z, wh.surface);\n439\t      }\n440\t      // crack past the listener if close to the line\n441\t      const cam = G.camera.position;\n442\t      const toCam = tmp.subVectors(cam, muzzle);\n443\t      const along = toCam.dot(dir);\n444\t      if (along > 0 && (!wh || along < wh.t + 2)) {\n445\t        const closest = tmp2.copy(muzzle).addScaledVector(dir, along);\n446\t        const miss = closest.distanceTo(cam);\n447\t        if (miss < 4) G.audio.whizz(closest.x, closest.y, closest.z, 1 - miss / 4);\n448\t        if (miss < 1.5) G.rig.addShake(0.08);\n449\t      }\n450\t    }\n451\t  }\n452\t\n453\t  function tryGrenade(e) {\n454\t    const p = G.player;\n455\t    if (!e.lastKnown || e.grenades <= 0) return false;\n456\t    const d = Math.hypot(e.lastKnown.x - e.pos.x, e.lastKnown.z - e.pos.z);\n457\t    if (d < 8 || d > 26) return false;\n458\t    if (G.time - e.lastSeen < 3.5 || G.time - e.lastSeen > 25) return false;\n459\t    if (G.explosives.list.some(g => g.kind === 'enemy')) return false;\n460\t    if (R() > 0.45) return false;\n461\t    e.grenades--;\n462\t    e.char.oneShot('throw', 1.1);\n463\t    const tx = e.lastKnown.x + (R() - 0.5) * 3, tz = e.lastKnown.z + (R() - 0.5) * 3;\n464\t    setTimeout(() => {\n465\t      if (e.dead) return;\n466\t      const start = e.char.boneWorld('hand_r', new THREE.Vector3());\n467\t      // ballistic launch at ~40°\n468\t      const dx = tx - start.x, dz = tz - start.z;\n469\t      const horiz = Math.hypot(dx, dz);\n470\t      const ty = G.world.groundAt(tx, tz, 1e4, 0.5);\n471\t      const ang = 0.7;\n472\t      const dy = ty - start.y;\n473\t      const v2 = (9.8 * horiz * horiz) / (2 * Math.cos(ang) ** 2 * (horiz * Math.tan(ang) - dy));\n474\t      const v = Math.sqrt(Math.max(4, Math.min(400, v2)));\n475\t      const vel = new THREE.Vector3((dx / horiz) * v * Math.cos(ang), v * Math.sin(ang), (dz / horiz) * v * Math.cos(ang));\n476\t      G.explosives.throwGrenade('enemy', start, vel, 0.4 + R() * 0.6);\n477\t    }, 420);\n478\t    return true;\n479\t  }\n480\t\n481\t  /* ---------- per type behaviour ---------- */\n482\t\n483\t  function updateCombatRifle(e, dt) {\n484\t    const p = G.player;\n485\t    const lk = e.lastKnown || { x: p.pos.x, z: p.pos.z };\n486\t    e.phaseTimer -= dt;\n487\t    e.suppressed = Math.max(0, e.suppressed - dt);\n488\t    e.grenadeCheck -= dt;\n489\t\n490\t    // dug in (trench, foxhole): no running about, just duck and pop up\n491\t    if (e.def.hold && (e.phase === 'move' || e.phase === 'open')) { e.phase = 'hide'; e.phaseTimer = 0.3 + R() * 0.9; }\n492\t\n493\t    // choose / refresh cover\n494\t    if (e.phase === 'move') {\n495\t      if (!e.cover || e.phaseTimer < -6) {\n496\t        const c = findCover(e);\n497\t        if (e.cover) e.cover.taken = null;\n498\t        e.cover = c;\n499\t        if (c) c.taken = e;\n500\t        e.phaseTimer = 0;\n501\t        if (!c) { e.phase = 'open'; e.phaseTimer = 2 + R() * 2; }\n502\t      }\n503\t      if (e.cover) {\n504\t        e.stance = 'stand';\n505\t        const arrived = moveTowards(e, e.cover.x, e.cover.z, ENEMY.run, dt);\n506\t        face(e, e.cover.x, e.cover.z, 8, dt);\n507\t        if (arrived) { e.phase = 'hide'; e.phaseTimer = 0.8 + R() * 1.2; }\n508\t        // stuck?\n509\t        if (e.pos.distanceToSquared(e.lastPos) < 0.0004) e.stuck += dt; else e.stuck = 0;\n510\t        if (e.stuck > 1.2) { e.cover.taken = null; e.cover = null; e.phase = 'open'; e.phaseTimer = 2; e.stuck = 0; }\n511\t      }\n512\t      return;\n513\t    }\n514\t\n515\t    // cover compromised: the player can see us crouched\n516\t    if (e.cover && e.phase === 'hide' && e.sees && e.exposure >= 1 && e.stance === 'crouch' && R() < dt * 1.5) {\n517\t      e.phase = 'move';\n518\t      e.cover.taken = null; e.cover = null;\n519\t      return;\n520\t    }\n521\t\n522\t    face(e, lk.x, lk.z, 7, dt);\n523\t    if (e.phase === 'hide') {\n524\t      e.stance = e.def.hold || (e.cover && e.cover.low) ? 'crouch' : 'stand';\n525\t      e.vel.set(0, 0, 0);\n526\t      if (e.grenadeCheck <= 0) { e.grenadeCheck = 3 + R() * 2; if (tryGrenade(e)) { e.phaseTimer = 1.6; return; } }\n527\t      if (e.phaseTimer <= 0 && e.suppressed <= 0) {\n528\t        e.phase = 'peek';\n529\t        e.phaseTimer = 1.8 + R() * 2.2;\n530\t        e.aimTimer = e.reaction;\n531\t        e.burstLeft = 0;\n532\t      }\n533\t      return;\n534\t    }\n535\t    // peek / open: up and firing\n536\t    if (e.phase === 'peek' || e.phase === 'open') {\n537\t      e.stance = e.phase === 'open' && e.def.stance === 'crouch' ? 'crouch' : 'stand';\n538\t      if (e.phase === 'open') {\n539\t        // drift around a little in the open\n540\t        if (!e.target || e.phaseTimer < 0) {\n541\t          e.target = { x: e.pos.x + (R() - 0.5) * 4, z: e.pos.z + (R() - 0.5) * 4 };\n542\t          const h = e.leash > 0 ? e.home : e.pos;\n543\t          if (Math.hypot(e.target.x - h.x, e.target.z - h.z) > e.leash) e.target = { x: h.x, z: h.z };\n544\t          e.phaseTimer = 2.5 + R() * 2;\n545\t          if (R() < 0.4) { e.phase = 'move'; e.cover = null; return; }\n546\t        }\n547\t        if (e.sees) e.vel.set(0, 0, 0);\n548\t        else moveTowards(e, e.target.x, e.target.z, ENEMY.walk, dt);\n549\t      } else e.vel.set(0, 0, 0);\n550\t      if (e.suppressed > 0.5 && e.cover) { e.phase = 'hide'; e.phaseTimer = e.suppressed + 0.5; return; }\n551\t      if (e.reloadT > 0) {\n552\t        // out of ammunition: down behind cover while reloading\n553\t        if (e.cover || e.def.hold) { e.phase = 'hide'; e.phaseTimer = e.reloadT + 0.3; }\n554\t      } else if (e.sees || G.time - e.lastSeen < 1.5) {\n555\t        e.aimTimer -= dt;\n556\t        if (e.aimTimer <= 0) {\n557\t          e.fireTimer -= dt;\n558\t          if (e.fireTimer <= 0) {\n559\t            if (e.burstLeft <= 0) {\n560\t              const b = e.wdef.burst;\n561\t              e.burstLeft = Array.isArray(b) ? Math.round(lerp(b[0], b[1], R())) : b;\n562\t            }\n563\t            shoot(e);\n564\t            e.burstLeft--;\n565\t            e.fireTimer = e.burstLeft > 0 ? e.wdef.interval : (e.type === 'smg' ? 0.6 + R() * 0.8 : e.wdef.interval * (0.8 + R() * 0.6));\n566\t          }\n567\t        }\n568\t      } else {\n569\t        e.aimTimer = e.reaction * 0.6;\n570\t      }\n571\t      if (e.phase === 'peek' && e.phaseTimer <= 0) {\n572\t        e.phase = 'hide';\n573\t        e.phaseTimer = 1.0 + R() * 1.6 + e.suppressed;\n574\t      }\n575\t      // lost him for long: go and look\n576\t      if (G.time - e.lastSeen > 14 && e.leash > 0) { e.state = 'search'; e.searchTimer = 12; if (e.cover) { e.cover.taken = null; e.cover = null; } }\n577\t    }\n578\t  }\n579\t\n580\t  function updateMG(e, dt) {\n581\t    const p = G.player;\n582\t    e.suppressed = Math.max(0, e.suppressed - dt);\n583\t    const lk = e.lastKnown || { x: p.pos.x, z: p.pos.z };\n584\t    const want = Math.atan2(lk.x - e.pos.x, lk.z - e.pos.z);\n585\t    const base = e.mg ? e.mg.baseYaw : e.home.yaw;\n586\t    const arc = e.mg ? e.mg.arc : 1;\n587\t    const rel = clamp(wrapAngle(want - base), -arc, arc);\n588\t    e.yaw = dampAngle(e.yaw, base + rel, 2.2, dt);\n589\t    if (e.mg) e.mg.mesh.rotation.y = e.yaw;\n590\t    e.stance = e.suppressed > 0.6 ? 'crouch' : 'stand';\n591\t    const inArc = Math.abs(wrapAngle(want - base)) <= arc + 0.1;\n592\t    const recent = G.time - e.lastSeen < 2.5;\n593\t    if (e.reloadT > 0) { e.stance = 'crouch'; return; }\n594\t    if ((e.sees || recent) && inArc && e.suppressed < 0.6 && Math.abs(wrapAngle(want - e.yaw)) < 0.25) {\n595\t      e.aimTimer -= dt;\n596\t      if (e.aimTimer > 0) return;\n597\t      e.fireTimer -= dt;\n598\t      if (e.fireTimer <= 0) {\n599\t        if (e.burstLeft <= 0) e.burstLeft = Math.round(lerp(e.wdef.burst[0], e.wdef.burst[1], R()));\n600\t        shoot(e);\n601\t        e.burstLeft--;\n602\t        e.fireTimer = e.burstLeft > 0 ? e.wdef.interval : 0.9 + R() * 1.1;\n603\t      }\n604\t    } else e.aimTimer = Math.max(e.aimTimer, 0.4);\n605\t  }\n606\t\n607\t  function updateSniper(e, dt) {\n608\t    const p = G.player;\n609\t    const lk = e.lastKnown || { x: p.pos.x, z: p.pos.z };\n610\t    face(e, lk.x, lk.z, 3, dt);\n611\t    e.stance = e.suppressed > 0 ? 'crouch' : 'stand';\n612\t    e.suppressed = Math.max(0, e.suppressed - dt);\n613\t    e.fireTimer -= dt;\n614\t    const glint = e.glint;\n615\t    if (e.sees && e.suppressed <= 0) {\n616\t      e.aimTimer += dt;\n617\t      if (glint) {\n618\t        glint.visible = true;\n619\t        e.char.headWorld(glint.position);\n620\t        glint.position.y += 0.02;\n621\t        const k = Math.min(1, e.aimTimer / 1.8);\n622\t        glint.material.opacity = 0.35 + 0.65 * k * (0.75 + 0.25 * Math.sin(G.time * 18));\n623\t        glint.scale.setScalar(0.6 + k * 0.8);\n624\t      }\n625\t      if (e.aimTimer > 2.1 && e.fireTimer <= 0 && e.reloadT <= 0) {\n626\t        shoot(e);\n627\t        e.fireTimer = e.wdef.interval;\n628\t        e.aimTimer = 0.6;\n629\t      }\n630\t    } else {\n631\t      e.aimTimer = Math.max(0, e.aimTimer - dt * 2);\n632\t      if (glint) glint.visible = e.aimTimer > 0.2;\n633\t    }\n634\t  }\n635\t\n636\t  function updateIdle(e, dt) {\n637\t    if (e.alertAt > 0 && G.time >= e.alertAt) { e.alertAt = -1; enterCombat(e); return; }\n638\t    if (e.state === 'alert') {\n639\t      e.vel.set(0, 0, 0);\n640\t      if (e.lastKnown) face(e, e.lastKnown.x, e.lastKnown.z, 3, dt);\n641\t      e.awareness = Math.max(0, e.awareness - dt * 0.05);\n642\t      if (e.awareness < 0.2) e.state = e.patrol ? 'patrol' : 'idle';\n643\t      return;\n644\t    }\n645\t    e.awareness = Math.max(0, e.awareness - dt * 0.08);\n646\t    if (e.state === 'patrol' && e.patrol) {\n647\t      if (e.patrolWait > 0) { e.patrolWait -= dt; e.vel.set(0, 0, 0); return; }\n648\t      const [tx, tz] = e.patrol[e.patrolIdx];\n649\t      face(e, tx, tz, 4, dt);\n650\t      if (moveTowards(e, tx, tz, ENEMY.walk * 0.8, dt)) {\n651\t        e.patrolIdx = (e.patrolIdx + 1) % e.patrol.length;\n652\t        e.patrolWait = 2 + R() * 3;\n653\t      }\n654\t      return;\n655\t    }\n656\t    // standing guard: return to the post, look around a little\n657\t    e.vel.set(0, 0, 0);\n658\t    if (e.type !== 'mg' && e.type !== 'sniper' && Math.hypot(e.home.x - e.pos.x, e.home.z - e.pos.z) > 0.6) {\n659\t      face(e, e.home.x, e.home.z, 4, dt);\n660\t      moveTowards(e, e.home.x, e.home.z, ENEMY.walk, dt);\n661\t      return;\n662\t    }\n663\t    const look = e.home.yaw + Math.sin(G.time * 0.21 + e.home.x) * 0.5;\n664\t    e.yaw = dampAngle(e.yaw, look, 0.8, dt);\n665\t    if (e.mg) e.mg.mesh.rotation.y = e.yaw;\n666\t  }\n667\t\n668\t  function updateSearch(e, dt) {\n669\t    e.searchTimer -= dt;\n670\t    const lk = e.lastKnown;\n671\t    if (e.sees) { e.state = 'combat'; e.phase = 'move'; return; }\n672\t    if (!lk || e.searchTimer <= 0) { e.state = 'alert'; e.awareness = 0.6; return; }\n673\t    face(e, lk.x, lk.z, 5, dt);\n674\t    const h = e.home;\n675\t    if (Math.hypot(lk.x - h.x, lk.z - h.z) > e.leash + 10) { e.state = 'alert'; return; }\n676\t    if (moveTowards(e, lk.x, lk.z, ENEMY.walk * 1.2, dt)) e.searchTimer = Math.min(e.searchTimer, 3);\n677\t  }\n678\t\n679\t  /* ---------- animation ---------- */\n680\t\n681\t  function animate(e, dt) {\n682\t    const ch = e.char;\n683\t    const speed = Math.hypot(e.vel.x, e.vel.z);\n684\t    let move;\n685\t    const crouch = e.stance === 'crouch';\n686\t    if (crouch) move = speed > 0.3 ? 'crouch_walk' : 'crouch_idle';\n687\t    else if (speed < 0.3) move = 'idle';\n688\t    else if (speed > 3) move = 'run';\n689\t    else {\n690\t      const mv = Math.atan2(e.vel.x, e.vel.z) - e.yaw;\n691\t      const f = Math.cos(mv), s = Math.sin(mv);\n692\t      if (f > 0.5) move = 'walk'; else if (f < -0.5) move = 'walk_back'; else move = s > 0 ? 'strafe_l' : 'strafe_r';\n693\t    }\n694\t    const gait = GAIT[move] ? clamp(speed / GAIT[move], 0.6, 2.6) : 1;\n695\t    const firing = e.state === 'combat' && (e.phase === 'peek' || e.phase === 'open' || e.type === 'mg' || e.type === 'sniper') && speed < 3;\n696\t    let upper = firing ? (crouch ? 'crouch_aim' : 'aim') : crouch ? move : move;\n697\t    if (e.type === 'mg') upper = crouch ? 'crouch_idle' : 'crouch_aim';\n698\t    if (e.type === 'mg' && !crouch) move = 'crouch_idle';\n699\t    ch.animate(move, upper, gait);\n700\t    if (firing && e.lastKnown) {\n701\t      const p = G.player;\n702\t      const dy = (p.pos.y + 1.2) - (e.pos.y + 1.4);\n703\t      const dh = Math.hypot(e.lastKnown.x - e.pos.x, e.lastKnown.z - e.pos.z);\n704\t      ch.aimPitch = clamp(Math.atan2(dy, dh), -0.8, 0.8);\n705\t    } else ch.aimPitch = 0;\n706\t    ch.root.position.copy(e.pos);\n707\t    ch.root.rotation.y = e.yaw;\n708\t    // out of view and not close: the skeleton is posed five times a second\n709\t    // (the body still moves every frame, so muzzle flashes and tracers start"}]},"uuid":"baefb2d9-6a9d-4e29-92d4-d26ec177c825","timestamp":"2026-10-21T10:04:08.668Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow/js/ai.js","content":"        if (e.state !== 'combat') { e.awareness = Math.max(e.awareness, 0.45); e.lastKnown = { x, z }; }\n        continue;\n      }\n      e.lastKnown = { x, z };\n      if (d < radius * 0.55 || kind === 'explosion') enterCombat(e);\n      else { e.awareness = Math.max(e.awareness, 0.8); if (e.state !== 'combat') e.state = 'alert'; }\n    }\n  });\n\n  /* ---------- perception ---------- */\n\n  function eyePos(e, out) {\n    const h = e.stance === 'crouch' ? 1.05 : 1.6;\n    return out.set(e.pos.x, e.pos.y + h, e.pos.z);\n  }\n\n  function perceive(e, dt) {\n    const p = G.player;\n    e.sees = false;\n    e.exposure = 0;\n    if (!p.alive) return;\n    const eye = eyePos(e, tmp);\n    const head = tmp2.set(p.pos.x, p.pos.y + (p.crouch ? 1.15 : 1.65), p.pos.z);\n    const chest = tmp3.set(p.pos.x, p.pos.y + (p.crouch ? 0.8 : 1.2), p.pos.z);\n    const dx = chest.x - eye.x, dz = chest.z - eye.z;\n    const dist = Math.hypot(dx, dz);\n    const combat = e.state === 'combat';\n    let range = (e.type === 'sniper' ? 150 : e.type === 'mg' ? 95 : ENEMY.viewRange) * p.visible * (combat ? 1.7 : 1);\n    if (G.lightning > 0.4) range *= 1.4;\n    if (dist > range) return;\n    const ang = Math.abs(wrapAngle(Math.atan2(dx, dz) - e.yaw));\n    const fov = combat ? Math.PI : e.state === 'alert' ? ENEMY.viewFov * 1.4 : ENEMY.viewFov;\n    if (ang > fov) return;\n    const seeHead = G.world.clear(eye.x, eye.y, eye.z, head.x, head.y, head.z, SIGHT);\n    const seeChest = G.world.clear(eye.x, eye.y, eye.z, chest.x, chest.y, chest.z, SIGHT);\n    if (!seeHead && !seeChest) return;\n    e.sees = true;\n    e.exposure = seeChest ? 1 : 0.45;\n    e.lastKnown = { x: p.pos.x, z: p.pos.z };\n    e.lastSeen = G.time;\n    if (!combat) {\n      const near = 1 - dist / range;\n      e.awareness += dt * ENEMY.awareRate * G.diff.aware * (0.35 + 2.2 * near * near) * (seeChest ? 1 : 0.6);\n      if (e.awareness >= 1) enterCombat(e);\n      else if (e.awareness > 0.35) e.state = 'alert';\n    }\n  }\n\n  /* ---------- movement ---------- */\n\n  function moveTowards(e, tx, tz, speed, dt) {\n    const dx = tx - e.pos.x, dz = tz - e.pos.z;\n    const d = Math.hypot(dx, dz);\n    if (d < 0.25) { e.vel.set(0, 0, 0); return true; }\n    const vx = (dx / d) * speed, vz = (dz / d) * speed;\n    e.vel.x = damp(e.vel.x, vx, 8, dt);\n    e.vel.z = damp(e.vel.z, vz, 8, dt);\n    tmp.set(e.pos.x + e.vel.x * dt, 0, e.pos.z + e.vel.z * dt);\n    G.world.pushOut(tmp, ENEMY.radius, e.pos.y, 1.7, 0.45);\n    // keep apart from other soldiers and the player\n    for (const o of enemies) {\n      if (o === e || o.dead) continue;\n      const ox = tmp.x - o.pos.x, oz = tmp.z - o.pos.z;\n      const od = Math.hypot(ox, oz);\n      if (od < 0.7 && od > 1e-4) { tmp.x += (ox / od) * (0.7 - od) * 0.5; tmp.z += (oz / od) * (0.7 - od) * 0.5; }\n    }\n    if (G.world.tooDeep(tmp.x, tmp.z, 1.0, e.pos.y)) { e.vel.set(0, 0, 0); return true; }\n    e.pos.x = tmp.x; e.pos.z = tmp.z;\n    e.pos.y = G.world.groundAt(e.pos.x, e.pos.z, e.pos.y, 0.5);\n    return d < 0.5;\n  }\n\n  function face(e, x, z, rate, dt) {\n    const want = Math.atan2(x - e.pos.x, z - e.pos.z);\n    e.yaw = dampAngle(e.yaw, want, rate, dt);\n    return Math.abs(wrapAngle(want - e.yaw));\n  }\n\n  /* Find a cover point near the post that hides a crouching man from the\n     player's last known position but lets him fire standing. */\n  function findCover(e) {\n    const lk = e.lastKnown || { x: G.player.pos.x, z: G.player.pos.z };\n    const py = G.player.pos.y + 1.2;\n    const centre = e.leash > 0 ? e.home : e.pos;\n    const cand = coverNear(centre.x, centre.z, Math.max(8, e.leash + 4));\n    let best = null, bestScore = -Infinity;\n    let tests = 0;\n    cand.sort((a, b) => ((a.x - e.pos.x) ** 2 + (a.z - e.pos.z) ** 2) - ((b.x - e.pos.x) ** 2 + (b.z - e.pos.z) ** 2));\n    for (const c of cand) {\n      if (c.taken && c.taken !== e) continue;\n      if (tests > 14) break;\n      const toP = Math.hypot(lk.x - c.x, lk.z - c.z);\n      if (toP < 6) continue;\n      // the obstacle must be between the point and the player\n      const facing = ((lk.x - c.x) * -c.nx + (lk.z - c.z) * -c.nz) / toP;\n      if (facing < 0.35) continue;\n      tests++;\n      const hidden = !G.world.clear(c.x, c.y + 0.95, c.z, lk.x, py, lk.z, SHOT);\n      if (!hidden) continue;\n      const peek = c.low ? G.world.clear(c.x, c.y + 1.55, c.z, lk.x, py + 0.3, lk.z, SIGHT) : true;\n      const dMe = Math.hypot(c.x - e.pos.x, c.z - e.pos.z);\n      const pref = e.type === 'smg' ? 16 : 28;\n      const score = (peek ? 6 : 0) - dMe * 0.45 - Math.abs(toP - pref) * 0.15 + facing * 2;\n      if (score > bestScore) { bestScore = score; best = c; }\n    }\n    return best;\n  }\n\n  /* ---------- shooting ---------- */\n\n  function muzzleOf(e, out) {\n    if (e.mg) {\n      const m = e.mg;\n      const yaw = m.mesh.rotation.y;\n      const c = Math.cos(yaw), s = Math.sin(yaw);\n      return out.set(m.x + m.muzzle[0] * c + m.muzzle[2] * s, m.y + m.muzzle[1], m.z - m.muzzle[0] * s + m.muzzle[2] * c);\n    }\n    return e.char.muzzleWorld(out);\n  }\n\n  function startReload(e) {\n    const w = e.wdef;\n    e.reloadT = e.reloadTotal = w.reload || 3;\n    e.reloadStage = 0;\n    e.burstLeft = 0;\n    if (e.type !== 'mg') {\n      const clip = e.type === 'smg' && e.char.hasClip('reload_smg') ? 'reload_smg' : 'reload';\n      e.char.oneShot(clip, (e.char.clipLength(clip) || 1.6) / e.reloadTotal);\n      e.reloadRun = reloadSequence(G, e.char, w, clip);\n    }\n    G.audio.reload?.(e.type === 'smg' ? 'thompson' : 'garand', e.pos);\n  }\n\n  /* the hands during an enemy reload (the shared sequencer in reload.js) */\n  function reloadSteps(e, dt) {\n    e.reloadT -= dt;\n    e.reloadRun?.update(1 - Math.max(0, e.reloadT) / e.reloadTotal);\n    if (e.reloadT <= 0) { e.reloadT = 0; e.mag = e.wdef.mag || 30; e.reloadRun?.end(); e.reloadRun = null; }\n  }\n\n  function shoot(e) {\n    const p = G.player;\n    const w = e.wdef;\n    if (e.reloadT > 0) return;\n    if (--e.mag <= 0) startReload(e);\n    const muzzle = muzzleOf(e, new THREE.Vector3());\n    const target = new THREE.Vector3(p.pos.x, p.pos.y + (p.crouch ? 0.85 : 1.25), p.pos.z);\n    let hit = false;\n    if (e.sees && p.alive) {\n      const d = muzzle.distanceTo(target);\n      const fall = clamp(1 - (d - 6) / (w.range * 1.1), 0.12, 1);\n      let pHit = BASE_ACC[e.type] * fall * e.exposure * G.diff.accuracy;\n      if (p.crouch) pHit *= 0.7;\n      if (p.movingSpeed > 3) pHit *= 0.7;\n      if (p.vault) pHit *= 0.5;\n      if (e.suppressed > 0) pHit *= 0.35;\n      if (e.firstShot) pHit *= 0.45;\n      pHit *= Math.min(1.25, 0.85 + e.shotsAtTarget * 0.05);\n      hit = R() < pHit;\n    }\n    e.firstShot = false;\n    e.shotsAtTarget++;\n    // visuals and sound\n    const dir = new THREE.Vector3();\n    let end;\n    if (hit) {\n      end = target;\n    } else {\n      // a miss lands around the player (or around where he was)\n      const base = e.sees ? target : new THREE.Vector3(e.lastKnown?.x ?? p.pos.x, p.pos.y + 1, e.lastKnown?.z ?? p.pos.z);\n      end = base.clone().add(new THREE.Vector3((R() - 0.5) * 3.2, (R() - 0.6) * 1.8, (R() - 0.5) * 3.2));\n    }\n    dir.subVectors(end, muzzle);\n    const len = dir.length();\n    dir.divideScalar(len || 1);\n    G.effects.muzzle(muzzle.x, muzzle.y, muzzle.z, dir.x, dir.y, dir.z, e.type === 'mg' ? 1.1 : 0.9);\n    G.lights.flash(muzzle.x + dir.x * 0.3, muzzle.y, muzzle.z + dir.z * 0.3, '#ffb36b', e.type === 'mg' ? 50 : 40, 8, 0.05);\n    G.audio.gunshot(w.sound, muzzle.x, muzzle.y, muzzle.z);\n    if (R() < w.tracer) G.effects.tracer(muzzle.x + dir.x * 0.6, muzzle.y + dir.y * 0.6, muzzle.z + dir.z * 0.6, dir.x, dir.y, dir.z, hit ? len : 150, 260, '#ffc070');\n    if (hit) {\n      const dmg = lerp(w.damage[0], w.damage[1], R()) * G.diff.damage;\n      p.damage(dmg, e.pos);\n      G.effects.blood(target.x, target.y, target.z, dir.x, dir.y, dir.z);\n    } else {\n      const wh = G.world.raycast(muzzle.x, muzzle.y, muzzle.z, dir.x, dir.y, dir.z, 200, SHOT);\n      if (wh) {\n        G.effects.impact(wh.x, wh.y, wh.z, wh.nx, wh.ny, wh.nz, wh.surface || 'stone');\n        G.decals?.impact(wh.x, wh.y, wh.z, wh.nx, wh.ny, wh.nz, wh.surface || 'stone');\n        G.audio.impact(wh.x, wh.y, wh.z, wh.surface);\n      }\n      // crack past the listener if close to the line\n      const cam = G.camera.position;\n      const toCam = tmp.subVectors(cam, muzzle);\n      const along = toCam.dot(dir);\n      if (along > 0 && (!wh || along < wh.t + 2)) {\n        const closest = tmp2.copy(muzzle).addScaledVector(dir, along);\n        const miss = closest.distanceTo(cam);\n        if (miss < 4) G.audio.whizz(closest.x, closest.y, closest.z, 1 - miss / 4);\n        if (miss < 1.5) G.rig.addShake(0.08);\n      }\n    }\n  }\n\n  function tryGrenade(e) {\n    const p = G.player;\n    if (!e.lastKnown || e.grenades <= 0) return false;\n    const d = Math.hypot(e.lastKnown.x - e.pos.x, e.lastKnown.z - e.pos.z);\n    if (d < 8 || d > 26) return false;\n    if (G.time - e.lastSeen < 3.5 || G.time - e.lastSeen > 25) return false;\n    if (G.explosives.list.some(g => g.kind === 'enemy')) return false;\n    if (R() > 0.45) return false;\n    e.grenades--;\n    e.char.oneShot('throw', 1.1);\n    const tx = e.lastKnown.x + (R() - 0.5) * 3, tz = e.lastKnown.z + (R() - 0.5) * 3;\n    setTimeout(() => {\n      if (e.dead) return;\n      const start = e.char.boneWorld('hand_r', new THREE.Vector3());\n      // ballistic launch at ~40°\n      const dx = tx - start.x, dz = tz - start.z;\n      const horiz = Math.hypot(dx, dz);\n      const ty = G.world.groundAt(tx, tz, 1e4, 0.5);\n      const ang = 0.7;\n      const dy = ty - start.y;\n      const v2 = (9.8 * horiz * horiz) / (2 * Math.cos(ang) ** 2 * (horiz * Math.tan(ang) - dy));\n      const v = Math.sqrt(Math.max(4, Math.min(400, v2)));\n      const vel = new THREE.Vector3((dx / horiz) * v * Math.cos(ang), v * Math.sin(ang), (dz / horiz) * v * Math.cos(ang));\n      G.explosives.throwGrenade('enemy', start, vel, 0.4 + R() * 0.6);\n    }, 420);\n    return true;\n  }\n\n  /* ---------- per type behaviour ---------- */\n\n  function updateCombatRifle(e, dt) {\n    const p = G.player;\n    const lk = e.lastKnown || { x: p.pos.x, z: p.pos.z };\n    e.phaseTimer -= dt;\n    e.suppressed = Math.max(0, e.suppressed - dt);\n    e.grenadeCheck -= dt;\n\n    // dug in (trench, foxhole): no running about, just duck and pop up\n    if (e.def.hold && (e.phase === 'move' || e.phase === 'open')) { e.phase = 'hide'; e.phaseTimer = 0.3 + R() * 0.9; }\n\n    // choose / refresh cover\n    if (e.phase === 'move') {\n      if (!e.cover || e.phaseTimer < -6) {\n        const c = findCover(e);\n        if (e.cover) e.cover.taken = null;\n        e.cover = c;\n        if (c) c.taken = e;\n        e.phaseTimer = 0;\n        if (!c) { e.phase = 'open'; e.phaseTimer = 2 + R() * 2; }\n      }\n      if (e.cover) {\n        e.stance = 'stand';\n        const arrived = moveTowards(e, e.cover.x, e.cover.z, ENEMY.run, dt);\n        face(e, e.cover.x, e.cover.z, 8, dt);\n        if (arrived) { e.phase = 'hide'; e.phaseTimer = 0.8 + R() * 1.2; }\n        // stuck?\n        if (e.pos.distanceToSquared(e.lastPos) < 0.0004) e.stuck += dt; else e.stuck = 0;\n        if (e.stuck > 1.2) { e.cover.taken = null; e.cover = null; e.phase = 'open'; e.phaseTimer = 2; e.stuck = 0; }\n      }\n      return;\n    }\n\n    // cover compromised: the player can see us crouched\n    if (e.cover && e.phase === 'hide' && e.sees && e.exposure >= 1 && e.stance === 'crouch' && R() < dt * 1.5) {\n      e.phase = 'move';\n      e.cover.taken = null; e.cover = null;\n      return;\n    }\n\n    face(e, lk.x, lk.z, 7, dt);\n    if (e.phase === 'hide') {\n      e.stance = e.def.hold || (e.cover && e.cover.low) ? 'crouch' : 'stand';\n      e.vel.set(0, 0, 0);\n      if (e.grenadeCheck <= 0) { e.grenadeCheck = 3 + R() * 2; if (tryGrenade(e)) { e.phaseTimer = 1.6; return; } }\n      if (e.phaseTimer <= 0 && e.suppressed <= 0) {\n        e.phase = 'peek';\n        e.phaseTimer = 1.8 + R() * 2.2;\n        e.aimTimer = e.reaction;\n        e.burstLeft = 0;\n      }\n      return;\n    }\n    // peek / open: up and firing\n    if (e.phase === 'peek' || e.phase === 'open') {\n      e.stance = e.phase === 'open' && e.def.stance === 'crouch' ? 'crouch' : 'stand';\n      if (e.phase === 'open') {\n        // drift around a little in the open\n        if (!e.target || e.phaseTimer < 0) {\n          e.target = { x: e.pos.x + (R() - 0.5) * 4, z: e.pos.z + (R() - 0.5) * 4 };\n          const h = e.leash > 0 ? e.home : e.pos;\n          if (Math.hypot(e.target.x - h.x, e.target.z - h.z) > e.leash) e.target = { x: h.x, z: h.z };\n          e.phaseTimer = 2.5 + R() * 2;\n          if (R() < 0.4) { e.phase = 'move'; e.cover = null; return; }\n        }\n        if (e.sees) e.vel.set(0, 0, 0);\n        else moveTowards(e, e.target.x, e.target.z, ENEMY.walk, dt);\n      } else e.vel.set(0, 0, 0);\n      if (e.suppressed > 0.5 && e.cover) { e.phase = 'hide'; e.phaseTimer = e.suppressed + 0.5; return; }\n      if (e.reloadT > 0) {\n        // out of ammunition: down behind cover while reloading\n        if (e.cover || e.def.hold) { e.phase = 'hide'; e.phaseTimer = e.reloadT + 0.3; }\n      } else if (e.sees || G.time - e.lastSeen < 1.5) {\n        e.aimTimer -= dt;\n        if (e.aimTimer <= 0) {\n          e.fireTimer -= dt;\n          if (e.fireTimer <= 0) {\n            if (e.burstLeft <= 0) {\n              const b = e.wdef.burst;\n              e.burstLeft = Array.isArray(b) ? Math.round(lerp(b[0], b[1], R())) : b;\n            }\n            shoot(e);\n            e.burstLeft--;\n            e.fireTimer = e.burstLeft > 0 ? e.wdef.interval : (e.type === 'smg' ? 0.6 + R() * 0.8 : e.wdef.interval * (0.8 + R() * 0.6));\n          }\n        }\n      } else {\n        e.aimTimer = e.reaction * 0.6;\n      }\n      if (e.phase === 'peek' && e.phaseTimer <= 0) {\n        e.phase = 'hide';\n        e.phaseTimer = 1.0 + R() * 1.6 + e.suppressed;\n      }\n      // lost him for long: go and look\n      if (G.time - e.lastSeen > 14 && e.leash > 0) { e.state = 'search'; e.searchTimer = 12; if (e.cover) { e.cover.taken = null; e.cover = null; } }\n    }\n  }\n\n  function updateMG(e, dt) {\n    const p = G.player;\n    e.suppressed = Math.max(0, e.suppressed - dt);\n    const lk = e.lastKnown || { x: p.pos.x, z: p.pos.z };\n    const want = Math.atan2(lk.x - e.pos.x, lk.z - e.pos.z);\n    const base = e.mg ? e.mg.baseYaw : e.home.yaw;\n    const arc = e.mg ? e.mg.arc : 1;\n    const rel = clamp(wrapAngle(want - base), -arc, arc);\n    e.yaw = dampAngle(e.yaw, base + rel, 2.2, dt);\n    if (e.mg) e.mg.mesh.rotation.y = e.yaw;\n    e.stance = e.suppressed > 0.6 ? 'crouch' : 'stand';\n    const inArc = Math.abs(wrapAngle(want - base)) <= arc + 0.1;\n    const recent = G.time - e.lastSeen < 2.5;\n    if (e.reloadT > 0) { e.stance = 'crouch'; return; }\n    if ((e.sees || recent) && inArc && e.suppressed < 0.6 && Math.abs(wrapAngle(want - e.yaw)) < 0.25) {\n      e.aimTimer -= dt;\n      if (e.aimTimer > 0) return;\n      e.fireTimer -= dt;\n      if (e.fireTimer <= 0) {\n        if (e.burstLeft <= 0) e.burstLeft = Math.round(lerp(e.wdef.burst[0], e.wdef.burst[1], R()));\n        shoot(e);\n        e.burstLeft--;\n        e.fireTimer = e.burstLeft > 0 ? e.wdef.interval : 0.9 + R() * 1.1;\n      }\n    } else e.aimTimer = Math.max(e.aimTimer, 0.4);\n  }\n\n  function updateSniper(e, dt) {\n    const p = G.player;\n    const lk = e.lastKnown || { x: p.pos.x, z: p.pos.z };\n    face(e, lk.x, lk.z, 3, dt);\n    e.stance = e.suppressed > 0 ? 'crouch' : 'stand';\n    e.suppressed = Math.max(0, e.suppressed - dt);\n    e.fireTimer -= dt;\n    const glint = e.glint;\n    if (e.sees && e.suppressed <= 0) {\n      e.aimTimer += dt;\n      if (glint) {\n        glint.visible = true;\n        e.char.headWorld(glint.position);\n        glint.position.y += 0.02;\n        const k = Math.min(1, e.aimTimer / 1.8);\n        glint.material.opacity = 0.35 + 0.65 * k * (0.75 + 0.25 * Math.sin(G.time * 18));\n        glint.scale.setScalar(0.6 + k * 0.8);\n      }\n      if (e.aimTimer > 2.1 && e.fireTimer <= 0 && e.reloadT <= 0) {\n        shoot(e);\n        e.fireTimer = e.wdef.interval;\n        e.aimTimer = 0.6;\n      }\n    } else {\n      e.aimTimer = Math.max(0, e.aimTimer - dt * 2);\n      if (glint) glint.visible = e.aimTimer > 0.2;\n    }\n  }\n\n  function updateIdle(e, dt) {\n    if (e.alertAt > 0 && G.time >= e.alertAt) { e.alertAt = -1; enterCombat(e); return; }\n    if (e.state === 'alert') {\n      e.vel.set(0, 0, 0);\n      if (e.lastKnown) face(e, e.lastKnown.x, e.lastKnown.z, 3, dt);\n      e.awareness = Math.max(0, e.awareness - dt * 0.05);\n      if (e.awareness < 0.2) e.state = e.patrol ? 'patrol' : 'idle';\n      return;\n    }\n    e.awareness = Math.max(0, e.awareness - dt * 0.08);\n    if (e.state === 'patrol' && e.patrol) {\n      if (e.patrolWait > 0) { e.patrolWait -= dt; e.vel.set(0, 0, 0); return; }\n      const [tx, tz] = e.patrol[e.patrolIdx];\n      face(e, tx, tz, 4, dt);\n      if (moveTowards(e, tx, tz, ENEMY.walk * 0.8, dt)) {\n        e.patrolIdx = (e.patrolIdx + 1) % e.patrol.length;\n        e.patrolWait = 2 + R() * 3;\n      }\n      return;\n    }\n    // standing guard: return to the post, look around a little\n    e.vel.set(0, 0, 0);\n    if (e.type !== 'mg' && e.type !== 'sniper' && Math.hypot(e.home.x - e.pos.x, e.home.z - e.pos.z) > 0.6) {\n      face(e, e.home.x, e.home.z, 4, dt);\n      moveTowards(e, e.home.x, e.home.z, ENEMY.walk, dt);\n      return;\n    }\n    const look = e.home.yaw + Math.sin(G.time * 0.21 + e.home.x) * 0.5;\n    e.yaw = dampAngle(e.yaw, look, 0.8, dt);\n    if (e.mg) e.mg.mesh.rotation.y = e.yaw;\n  }\n\n  function updateSearch(e, dt) {\n    e.searchTimer -= dt;\n    const lk = e.lastKnown;\n    if (e.sees) { e.state = 'combat'; e.phase = 'move'; return; }\n    if (!lk || e.searchTimer <= 0) { e.state = 'alert'; e.awareness = 0.6; return; }\n    face(e, lk.x, lk.z, 5, dt);\n    const h = e.home;\n    if (Math.hypot(lk.x - h.x, lk.z - h.z) > e.leash + 10) { e.state = 'alert'; return; }\n    if (moveTowards(e, lk.x, lk.z, ENEMY.walk * 1.2, dt)) e.searchTimer = Math.min(e.searchTimer, 3);\n  }\n\n  /* ---------- animation ---------- */\n\n  function animate(e, dt) {\n    const ch = e.char;\n    const speed = Math.hypot(e.vel.x, e.vel.z);\n    let move;\n    const crouch = e.stance === 'crouch';\n    if (crouch) move = speed > 0.3 ? 'crouch_walk' : 'crouch_idle';\n    else if (speed < 0.3) move = 'idle';\n    else if (speed > 3) move = 'run';\n    else {\n      const mv = Math.atan2(e.vel.x, e.vel.z) - e.yaw;\n      const f = Math.cos(mv), s = Math.sin(mv);\n      if (f > 0.5) move = 'walk'; else if (f < -0.5) move = 'walk_back'; else move = s > 0 ? 'strafe_l' : 'strafe_r';\n    }\n    const gait = GAIT[move] ? clamp(speed / GAIT[move], 0.6, 2.6) : 1;\n    const firing = e.state === 'combat' && (e.phase === 'peek' || e.phase === 'open' || e.type === 'mg' || e.type === 'sniper') && speed < 3;\n    let upper = firing ? (crouch ? 'crouch_aim' : 'aim') : crouch ? move : move;\n    if (e.type === 'mg') upper = crouch ? 'crouch_idle' : 'crouch_aim';\n    if (e.type === 'mg' && !crouch) move = 'crouch_idle';\n    ch.animate(move, upper, gait);\n    if (firing && e.lastKnown) {\n      const p = G.player;\n      const dy = (p.pos.y + 1.2) - (e.pos.y + 1.4);\n      const dh = Math.hypot(e.lastKnown.x - e.pos.x, e.lastKnown.z - e.pos.z);\n      ch.aimPitch = clamp(Math.atan2(dy, dh), -0.8, 0.8);\n    } else ch.aimPitch = 0;\n    ch.root.position.copy(e.pos);\n    ch.root.rotation.y = e.yaw;\n    // out of view and not close: the skeleton is posed five times a second\n    // (the body still moves every frame, so muzzle flashes and tracers start","numLines":460,"startLine":250,"totalLines":800}},"sourceToolAssistantUUID":"a4633c8e-9fbc-4665-80e1-dfb38107a6fa","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
