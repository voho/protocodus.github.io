.position.set(0, -1000, 0);\n  scene.add(shadowLight);\n  let shadowOf = null;      // the static it is standing in for\n\n  const statics = [];       // {x,y,z,color,intensity,range,flicker,phase,shadow}\"\"\"),\n(\"\"\"      intensity: o.intensity ?? 6, range: o.range ?? 12, flicker: o.flicker ?? 0,\n      phase: Math.random() * 100, on: true,\n    };\"\"\",\"\"\"      intensity: o.intensity ?? 6, range: o.range ?? 12, flicker: o.flicker ?? 0,\n      phase: Math.random() * 100, on: true, shadow: !!o.shadow,\n    };\"\"\"),\n(\"\"\"    cand.length = 0;\n    for (let i = flashes.length - 1; i >= 0; i--) {\"\"\",\"\"\"    const flick = (s) => {\n      if (!s.flicker) return s.intensity;\n      const t = time * 9 + s.phase;\n      return s.intensity * (1 - s.flicker * (0.5 + 0.5 * Math.sin(t) * Math.sin(t * 2.31 + 1.3) * Math.sin(t * 0.73)));\n    };\n    // the shadow caster: the strongest marked light within 45 m\n    shadowOf = null;\n    let best = 0;\n    for (const s of statics) {\n      if (!s.on || !s.shadow) continue;\n      const d2 = (s.x - cam.x) ** 2 + (s.y - cam.y) ** 2 + (s.z - cam.z) ** 2;\n      if (d2 > 45 * 45) continue;\n      const sc = s.intensity * s.range / (1 + d2);\n      if (sc > best) { best = sc; shadowOf = s; }\n    }\n    if (shadowOf) {\n      shadowLight.position.set(shadowOf.x, shadowOf.y, shadowOf.z);\n      shadowLight.color.copy(shadowOf.color);\n      shadowLight.intensity = flick(shadowOf);\n      shadowLight.distance = shadowOf.range;\n      if (shadowLight.shadow.camera.far !== shadowOf.range) { shadowLight.shadow.camera.far = shadowOf.range; shadowLight.shadow.camera.updateProjectionMatrix(); }\n    } else {\n      shadowLight.intensity = 0;\n      shadowLight.position.set(cam.x, -1000, cam.z);\n    }\n\n    cand.length = 0;\n    for (let i = flashes.length - 1; i >= 0; i--) {\"\"\"),\n(\"\"\"    for (const s of statics) {\n      if (!s.on) continue;\n      const d2 = (s.x - cam.x) ** 2 + (s.y - cam.y) ** 2 + (s.z - cam.z) ** 2;\n      if (d2 > 90 * 90) continue;\n      let inten = s.intensity;\n      if (s.flicker) {\n        const t = time * 9 + s.phase;\n        inten *= 1 - s.flicker * (0.5 + 0.5 * Math.sin(t) * Math.sin(t * 2.31 + 1.3) * Math.sin(t * 0.73));\n      }\n      cand.push({ x: s.x, y: s.y, z: s.z, color: s.color, intensity: inten, range: s.range, score: s.intensity * s.range / (1 + d2) });\n    }\n    cand.sort((a, b) => b.score - a.score);\n    active.length = 0;\n    for (let i = 0; i < Math.min(8, cand.length); i++) active.push(cand[i]);\"\"\",\"\"\"    for (const s of statics) {\n      if (!s.on || s === shadowOf) continue;\n      const d2 = (s.x - cam.x) ** 2 + (s.y - cam.y) ** 2 + (s.z - cam.z) ** 2;\n      if (d2 > 90 * 90) continue;\n      cand.push({ x: s.x, y: s.y, z: s.z, color: s.color, intensity: flick(s), range: s.range, score: s.intensity * s.range / (1 + d2) });\n    }\n    cand.sort((a, b) => b.score - a.score);\n    active.length = 0;\n    // the shadow light is lit too (rain, light in the air): first in the list\n    if (shadowOf) active.push({ x: shadowOf.x, y: shadowOf.y, z: shadowOf.z, color: shadowOf.color, intensity: shadowLight.intensity, range: shadowOf.range, score: best });\n    for (let i = 0; active.length < 8 && i < cand.length; i++) active.push(cand[i]);\"\"\"),\n(\"\"\"  return { hemi, key, rim, addStatic, flash, update, statics, active };\"\"\",\n \"\"\"  return { hemi, key, rim, addStatic, flash, update, statics, active, shadowLight, get shadowOf() { return shadowOf; } };\"\"\"),\n])\nedit('js/levelBuild.js', [\n(\"\"\"        lamps.push(G.lights.addStatic({ x: a[0], y: a[1], z: a[2], color: '#ffb35c', intensity: 9, range: 14, flicker: 0.08 }));\"\"\",\n \"\"\"        lamps.push(G.lights.addStatic({ x: a[0], y: a[1], z: a[2], color: '#ffb35c', intensity: 9, range: 14, flicker: 0.08, shadow: true }));\"\"\"),\n(\"\"\"        lamps.push(G.lights.addStatic({ x: a[0], y: a[1], z: a[2], color: '#ffb35c', intensity: 6, range: 11, flicker: 0.0