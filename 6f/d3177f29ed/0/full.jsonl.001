{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"fc6090b1a8acf16d6b0779861b10eb1909a8f96a309c54eb36455c1b73b7a707","message":{"role":"user","content":[{"tool_use_id":"toolu_01MnnodzuZ8wnUvrqrnkhU6c","type":"tool_result","content":"2390\t    return ch\n2391\t\n2392\t\n2393\tdef r_render(S, key):\n2394\t    \"\"\"Lime render (crépi): blotchy, trowelled, crazed with cracks, blown\n2395\t    patches with a broken rim showing the rubble, vertical water stains,\n2396\t    green algae and splash at the foot.\"\"\"\n2397\t    g = S.g\n2398\t    base = S.col('#b9ae98') if key in ('plaster', 'render') else S.col('#9e927d')\n2399\t    alb = S.tint(base, S.n(0.7, 4, 0.6), 0.8, 1.1)\n2400\t    alb = S.tint(alb, S.n(4.5, 4, 0.6), 0.9, 1.07)\n2401\t    trowel = S.n(30.0, 4, 0.7, stretch=(1.0, 1.0, 0.6))\n2402\t    alb = S.tint(alb, trowel, 0.94, 1.04)\n2403\t    streak = g.smooth(S.n(1.2, 4, 0.55, stretch=(5, 5, 0.35)), 0.6, 0.8)\n2404\t    alb = g.mix(g.mul(streak, 0.28), alb, S.col('#5f5646'))\n2405\t    c1 = g.mul(g.smooth(g.voronoi_edge(S.P, 1.3, rand=1.0), 0.01, 0.0), g.smooth(S.n(1.1), 0.5, 0.62))\n2406\t    c2 = g.mul(g.smooth(S.n(2.0, 4, 0.5, kind='RIDGED_MULTIFRACTAL', stretch=(1.0, 1.0, 0.7)), 0.93, 0.985),\n2407\t               g.smooth(S.n(0.9), 0.45, 0.6))\n2408\t    crk = g.maximum(c1, c2)\n2409\t    alb = g.mix(g.mul(crk, 0.85), alb, S.col('#38322a'))\n2410\t    pn = g.add(S.n(1.0, 6, 0.65), g.mul(S.edge, 0.2))\n2411\t    patch = g.smooth(pn, 0.67, 0.69)\n2412\t    rim = g.sub(g.smooth(pn, 0.635, 0.665), patch)\n2413\t    st = r_rubble(S, 'stone')\n2414\t    alb = g.mix(g.mul(rim, 0.6), alb, S.col('#6e6555'))\n2415\t    alb = g.mix(patch, alb, st['albedo'])\n2416\t    algae = g.mul(g.smooth(S.Z, 0.8, 0.05), g.smooth(S.n(2.2, 5, 0.6), 0.3, 0.6))\n2417\t    alb = g.mix(g.mul(algae, 0.6), alb, g.mix(S.n(18.0), S.col('#34402a'), S.col('#56603a')))\n2418\t    h_pl = g.sub(g.add(0.8, g.mul(trowel, 0.08)), g.mul(crk, 0.35))\n2419\t    h = g.mixf(patch, h_pl, g.mul(st['height'], 0.55))\n2420\t    rough = g.mixf(patch, g.map_range(S.n(6.0), 0, 1, 0.83, 0.95), st['rough'])\n2421\t    return dict(albedo=alb, rough=rough, metal=0.0, height=h, bump=0.85, dist=0.03)\n2422\t\n2423\t\n2424\tdef r_glass_dirty(S, key):\n2425\t    \"\"\"Old window glass: near-black with reflections, a dust film, rain\n2426\t    streaks running down, grime caked in the corners.\"\"\"\n2427\t    g = S.g\n2428\t    alb = S.tint(S.col('#141a1f'), S.n(3.0), 0.8, 1.25)\n2429\t    dust = g.add(0.18, g.mul(S.n(4.0, 4, 0.6), 0.25))\n2430\t    streak = g.smooth(S.n(3.0, 4, 0.5, stretch=(9, 9, 0.25)), 0.5, 0.72)\n2431\t    corner = g.smooth(S.ao, 0.85, 0.45)\n2432\t    m_ = g.add(g.add(g.mul(dust, 0.6), g.mul(streak, 0.35)), g.mul(corner, 0.7))\n2433\t    alb = g.mix(g.minimum(m_, 0.85), alb, S.col('#57564c'))\n2434\t    rough = g.mixf(g.minimum(m_, 1.0), 0.04, 0.6)\n2435\t    return dict(albedo=alb, rough=rough, metal=0.0, height=g.mul(streak, 0.2), bump=0.1, dist=0.003)\n2436\t\n2437\t\n2438\tdef _painted_board_v3(hexcode, door=False):\n2439\t    \"\"\"Paint on boards: grain, chips and flakes at the edges down to grey\n2440\t    wood; doors also worn at handle height and rotting at the bottom.\"\"\"\n2441\t    def r(S, key):\n2442\t        g = S.g\n2443\t        grain = S.n(1.0, 6, 0.65, vec=g.combine(g.mul(S.U, 36.0), g.mul(S.V, 2.2), 0.0), distortion=0.4)\n2444\t        wood = g.mix(grain, S.col('#625a4e'), S.col('#8f8577'))\n2445\t        paint = S.tint(S.col(hexcode), S.n(2.5), 0.75, 1.12)\n2446\t        paint = S.tint(paint, grain, 0.9, 1.06)\n2447\t        flake = g.add(g.mul(S.edge, 0.95), S.n(6.0, 6, 0.7))\n2448\t        if door:\n2449\t            spot = g.smooth(S.n(2.0, 3, 0.5), 0.45, 0.7)\n2450\t            band = g.mul(g.mul(g.smooth(g.absolute(g.sub(S.Z, 1.05)), 0.16, 0.02), spot), 0.4)\n2451\t            foot = g.mul(g.mul(g.smooth(S.Z, 0.3, 0.02), g.smooth(S.n(4.0), 0.35, 0.65)), 0.45)\n2452\t            flake = g.add(flake, g.add(band, foot))\n2453\t        peel = g.smooth(flake, 0.68, 0.72)\n2454\t        alb = g.mix(peel, paint, wood)\n2455\t        if door:\n2456\t            grime = g.mul(g.mul(g.smooth(g.absolute(g.sub(S.Z, 1.05)), 0.18, 0.0), spot), 0.45)\n2457\t            alb = g.mix(grime, alb, S.col('#2c241c'))\n2458\t            rot = g.mul(g.smooth(S.Z, 0.35, 0.0), g.smooth(S.n(5.0), 0.3, 0.6))\n2459\t            alb = g.mix(g.mul(rot, 0.8), alb, S.col('#2a2118'))\n2460\t        h = g.mixf(peel, g.add(0.78, g.mul(grain, 0.08)), g.add(0.55, g.mul(grain, 0.3)))\n2461\t        return dict(albedo=alb, rough=g.mixf(peel, 0.55, 0.88), metal=0.0, height=h, bump=0.7, dist=0.015)\n2462\t    return r\n2463\t\n2464\t\n2465\tdef _mossy(base_fn, amount=0.75):\n2466\t    \"\"\"A roof recipe with heavy moss and lichen (north-facing slopes).\"\"\"\n2467\t    def r(S, key):\n2468\t        g = S.g\n2469\t        ch = base_fn(S, key)\n2470\t        m_ = g.mul(g.smooth(g.add(S.n(2.6, 6, 0.65), g.mul(S.n(9.0, 4, 0.6), 0.3)), 0.52, 0.7), amount)\n2471\t        mc = g.mix(S.n(25.0, 4, 0.7), S.col('#343c26'), S.col('#5c6436'))\n2472\t        ch['albedo'] = g.mix(m_, ch['albedo'], mc)\n2473\t        lich = g.smooth(g.voronoi(S.P, 9.0, rand=1.0), 0.12, 0.04)\n2474\t        ch['albedo'] = g.mix(g.mul(lich, 0.5), ch['albedo'], S.col('#a8a678'))\n2475\t        ch['rough'] = g.mixf(m_, ch['rough'], 0.95)\n2476\t        ch['height'] = g.add(ch['height'], g.mul(m_, 0.3))\n2477\t        return ch\n2478\t    return r\n2479\t\n2480\t\n2481\t# -------- weathering decals: a wall recipe with an effect on top, driven by\n2482\t# the 'stainuv' layer of the decal quad (u across 0..1, v up 0..1)\n2483\t\n2484\tdef _decal_recipe(base_key, effect):\n2485\t    import surfaces as SF\n2486\t\n2487\t    def r(S, key):\n2488\t        g = S.g\n2489\t        ch = SF.RECIPES[base_key](S, base_key)\n2490\t        su, sv, _ = g.sep(g.uvmap('stainuv'))\n2491\t        streaks = g.smooth(S.n(2.4, 4, 0.55, stretch=(8, 8, 0.25)), 0.4, 0.7)\n2492\t        if effect == 'stain':                  # run-off under a sill\n2493\t            across = g.smooth(g.sub(0.5, g.absolute(g.sub(su, 0.5))), 0.0, 0.3)\n2494\t            m_ = g.mul(g.mul(g.power(sv, 0.8), across), g.add(0.35, g.mul(streaks, 0.65)))\n2495\t            c = S.col('#433a2e')\n2496\t            k = 0.7\n2497\t        elif effect == 'eave':                 # overflow from the gutter\n2498\t            m_ = g.mul(g.power(sv, 1.6), g.add(0.25, g.mul(streaks, 0.75)))\n2499\t            c = g.mix(S.n(6.0), S.col('#2f3226'), S.col('#4a4a36'))\n2500\t            k = 0.75\n2501\t        else:                                  # soot above a burnt opening / chimney\n2502\t            w_ = g.mul(g.sub(1.0, g.mul(sv, 0.55)), 0.5)\n2503\t            shape = g.smooth(g.sub(w_, g.absolute(g.sub(su, 0.5))), 0.0, 0.16)\n2504\t            m_ = g.mul(g.mul(shape, g.power(g.sub(1.0, sv), 0.6)), g.add(0.6, g.mul(S.n(3.0, 4, 0.6), 0.6)))\n2505\t            c = S.col('#121110')\n2506\t            k = 0.95\n2507\t        mk = g.minimum(g.mul(m_, k), 1.0)\n2508\t        ch['albedo'] = g.mix(mk, ch['albedo'], c)\n2509\t        ch['rough'] = g.mixf(mk, ch['rough'], 0.7 if effect != 'soot' else 0.95)\n2510\t        return ch\n2511\t    return r\n2512\t\n2513\t\n2514\tdef decal_key(base_key, effect):\n2515\t    import surfaces as SF\n2516\t    k = f'{base_key}~{effect}'\n2517\t    if k not in kit.PALETTE:\n2518\t        kit.PALETTE[k] = kit.PALETTE[base_key]\n2519\t        SF.RECIPES[k] = _decal_recipe(base_key, effect)\n2520\t        SF.PROFILE[k] = SF.PROFILE.get(base_key, 'building')\n2521\t    return k\n2522\t\n2523\t\n2524\tdef decal(F, x0, x1, z0, z1, key, uv=None, y=-0.004, name='decal'):\n2525\t    \"\"\"A weathering decal quad in wall frame F (4 mm proud of the face) with\n2526\t    its own 'stainuv' coordinates: uv = ((u0, v0), (u1, v1)) at the corners\n2527\t    (default 0..1 across and up).\"\"\"\n2528\t    (u0, v0), (u1, v1) = uv or ((0.0, 0.0), (1.0, 1.0))\n2529\t    me = bpy.data.meshes.new(name)\n2530\t    me.from_pydata([(x0, y, z0), (x1, y, z0), (x1, y, z1), (x0, y, z1)], [], [(0, 1, 2, 3)])\n2531\t    me.update()\n2532\t    lay = me.uv_layers.new(name='stainuv')\n2533\t    vals = [(u0, v0), (u1, v0), (u1, v1), (u0, v1)]\n2534\t    for li, loop in enumerate(me.loops):\n2535\t        lay.data[li].uv = vals[loop.vertex_index]\n2536\t    me.uv_layers.new(name='UVMap')\n2537\t    me.materials.append(kit.material(key))\n2538\t    o = kit.link(bpy.data.objects.new(name, me))\n2539\t    xform([o], F)\n2540\t    return o\n2541\t\n2542\t\n2543\tV3_SURFACES = {\n2544\t    # key: (hex, rough, metal, recipe, profile)\n2545\t    'ashlar':        ('#bdb39b', 0.8, 0.0, r_ashlar, 'masonry'),\n2546\t    'ashlar_step':   ('#a9a08c', 0.7, 0.0, r_ashlar_step, 'step'),\n2547\t    'glass_dirty':   ('#151b20', 0.2, 0.0, r_glass_dirty, 'none'),\n2548\t    'stone_rubble':  ('#7d7468', 0.9, 0.0, lambda S, k: r_rubble(S, k, dark=True), 'rubble'),\n2549\t    'cobble_road':   ('#6c6862', 0.8, 0.0, None, 'step'),\n2550\t}\n2551\t\n2552\t\n2553\tdef register_v3():\n2554\t    \"\"\"Runtime-only upgrades for this build process: better masonry and\n2555\t    render for the existing wall keys, new keys for dressings, steps, glass,\n2556\t    painted boards, mossy north slopes; gentler moss on steps, decks and\n2557\t    fresh rubble (new weathering profiles).\"\"\"\n2558\t    import surfaces as SF\n2559\t    SF.WEATHER['masonry'] = (1.0, 0.4, 0.7, 0.22, 0.14, 0.2)\n2560\t    SF.WEATHER['step'] = (1.0, 0.45, 0.4, 0.1, 0.04, 0.3)\n2561\t    SF.WEATHER['rubble'] = (1.0, 0.45, 0.3, 0.0, 0.02, 0.25)\n2562\t    SF.WEATHER['roofn'] = (0.95, 0.35, 0.0, 0.25, 0.2, 0.1)\n2563\t    SF.RECIPES['stone'] = lambda S, k: r_rubble(S, k, dark=False)\n2564\t    SF.RECIPES['stone_dark'] = lambda S, k: r_rubble(S, k, dark=True)\n2565\t    SF.RECIPES['plaster'] = r_render\n2566\t    SF.RECIPES['plaster_dirty'] = r_render\n2567\t    for k in ('stone', 'stone_dark', 'plaster', 'plaster_dirty', 'brick'):\n2568\t        SF.PROFILE[k] = 'masonry'\n2569\t    SF.PROFILE['cobble'] = 'step'\n2570\t    for k, (hexcode, rough, metal, fn, prof) in V3_SURFACES.items():\n2571\t        kit.PALETTE[k] = (hexcode, rough, metal)\n2572\t        SF.RECIPES[k] = fn if fn is not None else SF.RECIPES['cobble']\n2573\t        SF.PROFILE[k] = prof\n2574\t    for k, hexcode in (('shutter_green', '#3b5140'), ('shutter_blue', '#4a5f72'), ('shutter_red', '#6a2820'),"}]}}
