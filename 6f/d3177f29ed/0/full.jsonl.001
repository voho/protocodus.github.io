e further out\\n    if (sz.y > 20) k.midD = midNear * 1.25;\\n\"),\n(\"      if (k.lod && !k.cover) k.farMeshes = meshesFor(k.lod, n);\\n\",\n \"      if (k.lod && !k.cover) k.farMeshes = meshesFor(k.lod, n);\\n      if (k.mid && !k.cover) k.midMeshes = meshesFor(k.mid, n);\\n\"),\n(\"\"\"    for (const k of kinds.values()) {\n      let nN = 0, nF = 0;\n      const limit = k.cover ? coverD : far;\"\"\",\n\"\"\"    for (const k of kinds.values()) {\n      let nN = 0, nM = 0, nF = 0;\n      const limit = k.cover ? coverD : far;\n      const midD2 = k.midMeshes ? Math.min(k.midD, nearD) ** 2 : Infinity;\"\"\"),\n(\"\"\"        if (!k.farMeshes || d2 < nearD * nearD) {\n          for (const m of k.nearMeshes) m.setMatrixAt(nN, it.m);\n          nN++;\n        } else {\"\"\",\n\"\"\"        if (!k.farMeshes || d2 < nearD * nearD) {\n          if (d2 < midD2) {\n            for (const m of k.nearMeshes) m.setMatrixAt(nN, it.m);\n            nN++;\n          } else {\n            for (const m of k.midMeshes) m.setMatrixAt(nM, it.m);\n            nM++;\n          }\n        } else {\"\"\"),\n(\"\"\"      for (const m of k.nearMeshes) { m.count = nN; m.instanceMatrix.needsUpdate = true; }\n      if (k.farMeshes) for (const m of k.farMeshes) { m.count = nF; m.instanceMatrix.needsUpdate = true; }\n    }\n  }\"\"\",\n\"\"\"      for (const m of k.nearMeshes) { m.count = nN; m.instanceMatrix.needsUpdate = true; }\n      if (k.midMeshes) for (const m of k.midMeshes) { m.count = nM; m.instanceMatrix.needsUpdate = true; }\n      if (k.farMeshes) for (const m of k.farMeshes) { m.count = nF; m.instanceMatrix.needsUpdate = true; }\n    }\n  }\"\"\"),\n(\"\"\"      for (const m of k.nearMeshes || []) { inst += m.count; tris += m.count * m.geometry.attributes.position.count / 3; }\n      for (const m of k.farMeshes || []) { inst += m.count; tris += m.count * m.geometry.attributes.position.count / 3; }\"\"\",\n\"\"\"      for (const m of [...(k.nearMeshes || []), ...(k.midMeshes || []), 