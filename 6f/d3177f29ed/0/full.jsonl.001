{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"95baeb4fb0833f90d82a47925af67cfb1e8c725ee6854a0fb91986894ea3ce3b","message":{"role":"user","content":[{"tool_use_id":"toolu_01SekeAWRXEC9MNqVaphneKE","type":"tool_result","content":"2219\tdef main():\n2220\t    args = kit.args_after_dashes()\n2221\t    flags = {a for a in args if a.startswith('--')}\n2222\t    names = [a for a in args if not a.startswith('--')]\n2223\t    dev = '--dev' in flags\n2224\t    do_prev = '--no-preview' not in flags\n2225\t    for n in names:\n2226\t        if n not in BUILDERS and n != 'overview':\n2227\t            raise SystemExit(f'unknown node {n!r}; known: {sorted(BUILDERS)}')\n2228\t    kit.reset()\n2229\t    # mathutils.noise.noise_vector() adds per-process offsets seeded from the\n2230\t    # clock unless a seed is set: fix it so the build is deterministic.\n2231\t    from mathutils import noise\n2232\t    noise.seed_set(1944)\n2233\t    P.register_surfaces()\n2234\t    P.register_v3()\n2235\t    P.BAKE = '--nobake' not in flags\n2236\t    t0 = time.time()\n2237\t    build = [n for n in ORDER if n in BUILDERS and (not dev or n in names)]\n2238\t    objs = {}\n2239\t    for n in build:\n2240\t        t = time.time()\n2241\t        objs[n] = BUILDERS[n]()\n2242\t        kit.log(f'{n}: {kit.tri_count(objs[n])} tris, {time.time() - t:.1f}s')\n2243\t    if not dev:\n2244\t        kit.export([objs[n] for n in build], os.path.join(kit.MODELS, 'village.glb'), images=P.BAKE, quality=QUALITY)\n2245\t    kit.log(f'built in {time.time() - t0:.1f}s')\n2246\t    if do_prev:\n2247\t        sc = bpy.context.scene\n2248\t        sc.cycles.use_denoising = True            # review renders only (bakes are done)\n2249\t        targets = names if names else build + ['overview']\n2250\t        for n in targets:\n2251\t            if n == 'overview':\n2252\t                houses = [objs[h] for h in ('house_a', 'house_b', 'house_c', 'house_d', 'house_e', 'house_f', 'house_g',\n2253\t                                            'barn', 'ruin', 'ruin_b') if h in objs]\n2254\t                if houses:\n2255\t                    overview(houses)\n2256\t            elif n in objs:\n2257\t                preview_node(objs[n], n)\n2258\t    if '--normals' in flags:\n2259\t        # review: every back face seen by the camera glows magenta\n2260\t        for mat in list(bpy.data.materials):\n2261\t            if not mat.use_nodes:\n2262\t                continue\n2263\t            nt = mat.node_tree\n2264\t            out = next((n for n in nt.nodes if n.type == 'OUTPUT_MATERIAL'), None)\n2265\t            bsdf = nt.nodes.get('Principled BSDF')\n2266\t            if out is None or bsdf is None:\n2267\t                continue\n2268\t            geo = nt.nodes.new('ShaderNodeNewGeometry')\n2269\t            em = nt.nodes.new('ShaderNodeEmission')\n2270\t            em.inputs['Color'].default_value = (1, 0, 1, 1)\n2271\t            em.inputs['Strength'].default_value = 3.0\n2272\t            mix = nt.nodes.new('ShaderNodeMixShader')\n2273\t            lp = nt.nodes.new('ShaderNodeLightPath')\n2274\t            mul = nt.nodes.new('ShaderNodeMath')\n2275\t            mul.operation = 'MULTIPLY'\n2276\t            nt.links.new(geo.outputs['Backfacing'], mul.inputs[0])\n2277\t            nt.links.new(lp.outputs['Is Camera Ray'], mul.inputs[1])\n2278\t            nt.links.new(mul.outputs['Value'], mix.inputs['Fac'])\n2279\t            nt.links.new(bsdf.outputs['BSDF'], mix.inputs[1])\n2280\t            nt.links.new(em.outputs['Emission'], mix.inputs[2])\n2281\t            nt.links.new(mix.outputs['Shader'], out.inputs['Surface'])\n2282\t        tmp = os.environ.get('TMPDIR', '/tmp')\n2283\t        for n in (names or build):\n2284\t            if n in objs:\n2285\t                for suffix, el, az in (('a', 20, -35), ('b', 25, 145), ('c', -8, 60)):\n2286\t                    kit.preview([objs[n]], os.path.join(tmp, f'nrm_{n}_{suffix}.png'), size=384, samples=8, elevation=el, azimuth=az)\n2287\t    if '--colliders' in flags:\n2288\t        tmp = os.environ.get('TMPDIR', '/tmp')\n2289\t        for n in names:\n2290\t            if n in objs:\n2291\t                collider_view(objs[n], n, os.path.join(tmp, f'col_{n}.png'))\n2292\t    if '--detail' in flags:\n2293\t        tmp = os.environ.get('TMPDIR', '/tmp')\n2294\t        shots = {\n2295\t            'church': [((7.0, -22.0, 9.0), (0.0, -9.1, 15.5), 50), ((-14.0, -26.0, 1.7), (0.0, -6.0, 6.0), 24)],\n2296\t            'bridge_stone': [((-14.0, -3.0, -2.6), (0.0, 0.0, -1.5), 24), ((-1.2, -16.0, 1.5), (0.0, 0.0, 0.3), 28)],\n2297\t            'barn': [((0.5, -8.5, 1.7), (0.0, 1.0, 1.8), 24)],\n2298\t            'ruin': [((1.5, -7.5, 1.7), (-0.5, 0.0, 1.8), 24), ((0.6, 7.5, 1.7), (0.3, 0.0, 1.5), 24)],\n2299\t        }\n2300\t        for n in names:\n2301\t            for i, (cam, tgt, lens) in enumerate(shots.get(n, [])):\n2302\t                obj = objs[n]\n2303\t                extra = []\n2304\t                if n == 'church':\n2305\t                    import json\n2306\t                    a = json.loads(obj['anchors'])['sniper']\n2307\t                    extra.append(kit.box((0.5, 0.3, 1.75), loc=(a[0], -a[2], a[1] + 0.875), mat='paint_red', name='_sniper'))\n2308\t                P.street_view([obj] + extra, os.path.join(tmp, f'det_{n}_{i}.png'), cam=cam, target=tgt, lens=lens)"}]}}
