ndingView: 0, ok: 0 };\nfor (const c of cover) {\n  const toP = Math.hypot(pred.x - c.x, pred.z - c.z);\n  if (toP > 26) continue; stats.near++;\n  if (toP < 8) { stats.dist++; continue; }\n  const facing = ((pred.x - c.x) * -c.nx + (pred.z - c.z) * -c.nz) / toP;\n  if (facing < 0.3) { stats.facing++; continue; }\n  const along = (c.x - pred.from.x) * pred.dx + (c.z - pred.from.z) * pred.dz;\n  if (along < 2) { stats.behind++; continue; }\n  if (world.clear(c.x, c.y + 0.95, c.z, pred.x, py, pred.z, 2)) { stats.visibleCrouched++; continue; }\n  if (!world.clear(c.x, c.y + 1.55, c.z, pred.x, py + 0.3, pred.z, 4)) { stats.noStandingView++; console.log('  no view from', c.low ? 'low' : 'tall', c.x.toFixed(1), c.z.toFixed(1)); continue; }\n  stats.ok++; console.log('  OK', c.low ? 'low' : 'tall', c.x.toFixed(1), c.z.toFixed(1));\n}\nconsole.log(stats);\nEOF\nnode $TMPDIR/ambdbg.mjs 2>&1 | tail -25","description":"Inspect ambush cover candidates near the predicted spot","timeout":120000},"caller":{"type":"direct"}}]}}
