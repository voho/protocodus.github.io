ax':maxs}\nprint('nodes', len(old), '->', len(new), 'same names', set(old)==set(new))\ndiff=[k for k in old if old[k]['extras']!=new.get(k,{}).get('extras')]\nprint('extras differ:', diff)\nbb=[k for k in old if max(abs(a-b) for a,b in zip(old[k]['min']+old[k]['max'], new[k]['min']+new[k]['max']))>0.002]\nprint('bounds differ:', bb)\nprint('size', len(b), 'alpha', [m['name'] for m in j['materials'] if m.get('alphaMode')])\nEOF","description":"Fix card alpha and compare village nodes with the previous build"},"caller":{"type":"direct"}}]}}
