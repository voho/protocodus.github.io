{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"cea68ede4aa2dca210f71fb2f516ba2b0a5c166eed308f66bdd981c2af2a9c0c","message":{"role":"user","content":[{"tool_use_id":"toolu_01EwbFiwSerXN1gAa9tRhvkK","type":"tool_result","content":"        uniform float uTime;\n        varying vec3 vWNormalM;\n        varying vec2 vDetailUv;\n        varying vec3 vWPosM;`)\n      .replace('#include <uv_vertex>', `#include <uv_vertex>\n        ${detail ? `#ifdef USE_NORMALMAP\n          vNormalMapUv = uv * uTile;\n        #endif` : ''}\n        vDetailUv = uv * uTile;`)\n      .replace('#include <begin_vertex>', `#include <begin_vertex>\n        ${foliage ? `{\n          // wind: the higher, the more it moves; phase from where it stands\n          vec3 root = vec3(0.0);\n          #ifdef USE_INSTANCING\n            root = instanceMatrix[3].xyz;\n          #endif\n          root += modelMatrix[3].xyz;\n          float hgt = max(0.0, position.y);\n          float ph = uTime * 1.3 + root.x * 0.21 + root.z * 0.17;\n          float gust = 0.6 + 0.4 * sin(uTime * 0.37 + root.x * 0.05);\n          float k = hgt * hgt * 0.0025 * gust;\n          transformed.x += (sin(ph) * 0.6 + sin(ph * 2.7 + position.z * 1.3) * 0.25) * k;\n          transformed.z += (cos(ph * 0.8) * 0.4 + sin(ph * 3.1 + position.x * 1.1) * 0.2) * k;\n        }` : ''}`)\n      .replace('#include <project_vertex>', `#include <project_vertex>\n        {","is_error":false}]}}
