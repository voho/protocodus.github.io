{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"aa2a87f692ba5af56af6308fb78e889717cb41e628cb1759f163d7e3b2a41d8a","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01E8hKsZceXWyqdXJoqPx5Xt","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow && sed -n 1,140p fun/hedgerow/hedgerow.css","description":"Read the game stylesheet top and menu styles"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"5506b81707a12da265668326bc4031ff395f1f41bf1fddbf4edeafe5bcf67e40","message":{"role":"user","content":[{"tool_use_id":"toolu_01E8hKsZceXWyqdXJoqPx5Xt","type":"tool_result","content":"/* Hedgerow — screens and HUD. Space Grotesk (site font, OFL) for the\n   interface, the system's typewriter face for orders and briefings. */\n@font-face {\n  font-family: 'Space Grotesk';\n  src: url('/assets/fonts/space-grotesk-latin.woff2') format('woff2');\n  font-weight: 300 700;\n  font-display: swap;\n}\n\n:root {\n  --ink: #e8e4d8;\n  --muted: #a39d8c;\n  --dim: #6d685c;\n  --line: rgba(232, 228, 216, 0.16);\n  --line-strong: rgba(232, 228, 216, 0.34);\n  --glass: rgba(14, 15, 13, 0.72);\n  --glass-deep: rgba(9, 10, 9, 0.86);\n  --brass: #d6a54a;\n  --brass-soft: rgba(214, 165, 74, 0.16);\n  --red: #e0442f;\n  --green: #9fc46a;\n  --night: #0b0d10;\n  --type: 'American Typewriter', 'Courier Prime', 'Courier New', ui-monospace, monospace;\n  color-scheme: dark;\n}\n\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\n\nhtml, body {\n  margin: 0;\n  height: 100%;\n  overflow: hidden;\n  background: var(--night);\n  color: var(--ink);\n  font-family: 'Space Grotesk', system-ui, sans-serif;\n  font-variant-numeric: tabular-nums;\n  -webkit-font-smoothing: antialiased;\n}\n\n#stage {\n  position: fixed;\n  inset: 0;\n  width: 100vw;\n  height: 100vh;\n  display: block;\n}\nbody.playing, body.playing #stage { cursor: none; }\n\n.fade {\n  position: fixed; inset: 0; background: #000; opacity: 0; pointer-events: none;\n  transition: opacity 0.7s ease; z-index: 30;\n}\n.fade.on { opacity: 1; }\n\n/* ---------- screens ---------- */\n\n.screen {\n  position: fixed; inset: 0; z-index: 40;\n  display: none; align-items: center; justify-content: center;\n  padding: 24px 16px;\n  background: radial-gradient(ellipse at 50% 40%, rgba(10, 12, 14, 0.35), rgba(5, 6, 7, 0.86));\n  overflow-y: auto;\n}\n.screen.on { display: flex; }\n.screen[data-screen=\"start\"] { background: radial-gradient(ellipse at 50% 35%, rgba(18, 22, 26, 0.2), rgba(4, 5, 6, 0.92)); }\n\n.panel {\n  width: min(560px, 100%);\n  padding: 32px 32px 28px;\n  background: var(--glass);\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  backdrop-filter: blur(6px);\n  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);\n}\n.title-panel { text-align: center; background: transparent; border: none; box-shadow: none; backdrop-filter: none; }\n\n.eyebrow {\n  margin: 0 0 6px;\n  font-size: 12px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--brass);\n}\n.wordmark {\n  margin: 0;\n  font-size: clamp(44px, 10vw, 92px); font-weight: 700; letter-spacing: 0.16em;\n  color: var(--ink);\n  text-shadow: 0 4px 30px rgba(0, 0, 0, 0.8);\n}\n.subtitle { margin: 4px 0 28px; font-family: var(--type); font-size: 18px; color: var(--muted); }\nh2 { margin: 0 0 14px; font-size: 28px; font-weight: 600; letter-spacing: 0.02em; }\n\n.loading { width: min(320px, 100%); margin: 0 auto; }\n.loading-track { height: 3px; background: var(--line); overflow: hidden; }\n.loading-fill { display: block; height: 100%; width: 0; background: var(--brass); transition: width 0.2s ease; }\n.loading-label { margin: 10px 0 0; font-size: 13px; color: var(--muted); letter-spacing: 0.06em; }\n.error p { color: var(--red); }\n\n.menu { display: flex; flex-direction: column; gap: 8px; align-items: stretch; width: min(320px, 100%); margin: 0 auto; }\n.panel .menu { margin: 18px 0 0; width: 100%; }\n.menu-item {\n  display: block; width: 100%;\n  padding: 12px 18px;\n  font: inherit; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; text-align: center;\n  color: var(--ink);\n  background: rgba(255, 255, 255, 0.04);\n  border: 1px solid var(--line-strong);\n  border-radius: 3px;\n  cursor: pointer;\n  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;\n}\n.menu-item:hover, .menu-item:focus-visible { background: var(--brass-soft); border-color: var(--brass); outline: none; }\n.menu-item.primary { background: var(--brass); border-color: var(--brass); color: #16130c; font-weight: 600; }\n.menu-item.primary:hover, .menu-item.primary:focus-visible { background: #e8b95c; }\n.ghost { font: inherit; color: var(--ink); background: none; border: 1px solid var(--line-strong); padding: 8px 14px; cursor: pointer; }\n.row { display: flex; gap: 10px; margin-top: 20px; }\n.row .menu-item { flex: 1; }\n.best { margin-top: 18px; font-size: 13px; color: var(--muted); }\n\n.briefing { width: min(640px, 100%); }\n.when { margin: -6px 0 16px; font-family: var(--type); color: var(--muted); }\n.briefing-text p { margin: 0 0 12px; font-family: var(--type); font-size: 15px; line-height: 1.55; color: #d8d2c2; }\n.briefing-goals { margin: 14px 0 0; padding: 0 0 0 18px; font-size: 14px; line-height: 1.7; color: var(--ink); }\n.briefing-goals li::marker { color: var(--brass); }\n.hint { margin: 14px 0 0; font-size: 12px; color: var(--dim); text-align: center; }\n\n.keys { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; margin: 0 0 20px; font-size: 14px; }\n.keys dt { color: var(--brass); font-weight: 600; }\n.keys dd { margin: 0; color: var(--ink); }\n\n.setting { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 0 0 14px; font-size: 14px; }\n.setting input[type=\"range\"] { width: 55%; accent-color: var(--brass); }\n.setting select { font: inherit; color: var(--ink); background: #1b1c19; border: 1px solid var(--line-strong); padding: 4px 8px; }\n\n.stats { display: grid; grid-template-columns: 1fr max-content; gap: 6px 18px; margin: 4px 0 6px; font-size: 15px; }\n.stats dt { color: var(--muted); }\n.stats dd { margin: 0; text-align: right; }\n.stats .score { font-size: 20px; color: var(--brass); font-weight: 700; }\n.objective-recap { font-family: var(--type); color: var(--muted); }\n\n/* ---------- HUD ---------- */","is_error":false}]}}
