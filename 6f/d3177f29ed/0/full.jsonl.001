{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"67febe3ffae8fbe97a2b97fc39308107bbeff48962d9aa0a200444a6239d1a01","message":{"role":"user","content":[{"tool_use_id":"toolu_01CqArguNsdjejBBPQAw1EuC","type":"tool_result","content":"10:  let locked = false;\n20:  window.addEventListener('keydown', (e) => {\n34:  canvas.addEventListener('mousedown', (e) => {\n36:    if (!locked) { requestLock(); return; }\n46:    if (!locked) return;\n51:  window.addEventListener('wheel', (e) => { if (locked) wheel += Math.sign(e.deltaY); }, { passive: true });\n54:    const now = document.pointerLockElement === canvas;\n55:    if (now === locked) return;\n56:    locked = now;\n57:    if (!locked) { mouseL = mouseR = false; down.clear(); }\n58:    for (const f of listeners[locked ? 'lock' : 'unlock']) f();\n69:    get locked() { return locked; },\n72:    enable(on) { enabled = on; if (!on) { down.clear(); mouseL = mouseR = false; } },\n74:    exitLock() { if (document.pointerLockElement) document.exitPointerLock(); },\n230:function startMission() {\n231-  audio.init();\n232-  if (!player) {\n233-    player = createPlayer(G);\n234-    G.player = player;\n235-    explosives = createExplosives(G);\n236-    G.explosives = explosives;\n237-    G.debris = createDebris(G);\n238-    enemies = createEnemies(G, built.enemyDefs);\n239-    G.enemies = enemies.list;\n240-    mission = createMission(G, LEVEL, built);\n241-    G.mission = mission;\n242-    G.events.on('playerDied', onDeath);\n243-    G.events.on('missionComplete', onComplete);\n244-    mission.start();\n245-  }\n246-  const spawn = AT ? [AT[0], AT[1], 0] : LEVEL.start;\n247-  player.reset(spawn);\n248-  hud.weapon('M1 Garand', player.ammo.garand, player.grenades);\n249-  missionTime = 0;\n250-  G.stats = freshStats();\n251-  resume();\n252-  hud.notice(LEVEL.title, LEVEL.when, 4);\n253-}\n254-\n255-function resume() {","is_error":false}]}}
