{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"4cd5b7c75a4dbc542d4d84e4a774d74073fa103b277b92465d926df7776cf439","message":{"role":"user","content":[{"tool_use_id":"toolu_01L447c2L3caNSy38myYHPsA","type":"tool_result","content":"1\t/* Hedgerow — the land beyond the level.\n2\t\n3\t   A coarse ring of terrain round the playable area (out to ~1 km): rolling\n4\t   Norman bocage — a patchwork of fields and woods, hedgerow lines along the\n5\t   field edges — covered with the trees' far LODs (crossed impostor cards, a\n6\t   few triangles each) and the level's own distant scenery (a neighbouring\n7\t   village on a hill). It sits a little below the real terrain where they\n8\t   overlap, so the seam never shows. Static: built once, never updated. */\n9\t\n10\timport * as THREE from 'three';\n11\timport { fbm2, lerp, rng, smoothstep, clamp } from './util.js';\n12\timport { createStaticBatcher } from './assets.js';\n13\t\n14\texport function buildDistance(G, L, { models, matlib, material }) {\n15\t  const group = new THREE.Group();\n16\t  group.name = 'distance';\n17\t  const B = L.bounds;\n18\t  const F = L.far || {};\n19\t  const cx0 = B.minX, cx1 = B.maxX, cz0 = B.minZ, cz1 = B.maxZ;\n20\t  const outside = (x, z) => Math.hypot(Math.max(0, cx0 - x, x - cx1), Math.max(0, cz0 - z, z - cz1));\n21\t\n22\t  /* the far ground */\n23\t  const hills = F.height || ((x, z) => 18 + 22 * fbm2(x / 420 + 1.3, z / 420 - 2.1, 4) + 8 * fbm2(x / 150, z / 150, 3));\n24\t  const woods = F.woods || ((x, z) => smoothstep(0.08, 0.22, fbm2(x / 230 + 7.7, z / 230 - 4.4, 3)));\n25\t  const height = (x, z) => {\n26\t    const d = outside(x, z);\n27\t    const edge = L.baseHeight(clamp(x, cx0, cx1), clamp(z, cz0, cz1));\n28\t    if (d <= 0) return L.baseHeight(x, z) - 2.5;          // under the real terrain\n29\t    return lerp(edge, hills(x, z), smoothstep(0, 140, d)) - 0.35;\n30\t  };\n31\t  // fields: rotated cells, each grass or ploughed; hedgerows along their edges\n32\t  const fieldCell = (x, z) => {\n33\t    const a = 0.35, c = Math.cos(a), s = Math.sin(a);\n34\t    const u = (x * c - z * s) / 70, v = (x * s + z * c) / 46;\n35\t    const iu = Math.floor(u), iv = Math.floor(v);\n36\t    const fu = u - iu, fv = v - iv;\n37\t    return { id: iu * 7919 + iv * 104729, edge: Math.min(fu, 1 - fu, fv, 1 - fv) };\n38\t  };\n39\t  const hash = (n) => { const x = Math.sin(n * 12.9898) * 43758.5453; return x - Math.floor(x); };\n40\t\n41\t  const R0 = F.radius || 1000, STEP = 25;\n42\t  const x0 = cx0 - R0, x1 = cx1 + R0, z0 = cz0 - R0, z1 = cz1 + R0;\n43\t  const nx = Math.ceil((x1 - x0) / STEP) + 1, nz = Math.ceil((z1 - z0) / STEP) + 1;\n44\t  const pos = new Float32Array(nx * nz * 3), nrm = new Float32Array(nx * nz * 3), spl = new Float32Array(nx * nz * 4);\n45\t  for (let j = 0; j < nz; j++) for (let i = 0; i < nx; i++) {\n46\t    const x = x0 + i * STEP, z = z0 + j * STEP, k = j * nx + i;\n47\t    pos[k * 3] = x; pos[k * 3 + 1] = height(x, z); pos[k * 3 + 2] = z;\n48\t    const w = woods(x, z), fc = fieldCell(x, z), plough = hash(fc.id) < 0.3 ? 1 : 0;\n49\t    spl[k * 4] = (1 - w) * plough * 0.8 + 0.05;\n50\t    spl[k * 4 + 1] = (1 - w) * (1 - plough * 0.8);\n51\t    spl[k * 4 + 2] = w;\n52\t    spl[k * 4 + 3] = 0;\n53\t  }\n54\t  const idx = [];\n55\t  for (let j = 0; j < nz - 1; j++) for (let i = 0; i < nx - 1; i++) {\n56\t    const a = j * nx + i, b = a + 1, c = a + nx, d = c + 1;\n57\t    // skip quads well inside the real terrain\n58\t    const qx = x0 + (i + 0.5) * STEP, qz = z0 + (j + 0.5) * STEP;\n59\t    if (qx > cx0 + STEP && qx < cx1 - STEP && qz > cz0 + STEP && qz < cz1 - STEP) continue;\n60\t    idx.push(a, c, b, b, c, d);\n61\t  }\n62\t  const geo = new THREE.BufferGeometry();\n63\t  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n64\t  geo.setAttribute('splat', new THREE.BufferAttribute(spl, 4));\n65\t  geo.setIndex(idx);\n66\t  geo.computeVertexNormals();\n67\t  const ground = new THREE.Mesh(geo, material);\n68\t  ground.name = 'far_ground';\n69\t  ground.matrixAutoUpdate = false;\n70\t  group.add(ground);\n71\t\n72\t  /* far trees: woods and hedgerow lines, LOD impostors only */\n73\t  const lods = ['pine_a_lod', 'pine_b_lod', 'pine_c_lod', 'oak_a_lod', 'oak_b_lod', 'birch_a_lod', 'pine_big_lod', 'oak_big_lod', 'beech_big_lod', 'fir_big_lod']\n74\t    .filter((n) => models.has(n));\n75\t  const lines = ['treeline_far', 'treeline_far_b'].filter((n) => models.has(n));\n76\t  const R = rng(4242);\n77\t  const place = new Map(lods.map((n) => [n, []]));\n78\t  const maxD = F.treeRange || 620;\n79\t  if (lods.length) {\n80\t    for (let z = z0; z < z1; z += 6) for (let x = x0; x < x1; x += 6) {\n81\t      const d = outside(x, z);\n82\t      if (d < 8 || d > maxD) continue;\n83\t      const jx = x + (R() - 0.5) * 5, jz = z + (R() - 0.5) * 5;\n84\t      const w = woods(jx, jz), fc = fieldCell(jx, jz);\n85\t      const p = w > 0.5 ? 0.55 : fc.edge < 0.035 ? 0.5 : 0.006;\n86\t      if (R() > p) continue;\n87\t      const conifer = w > 0.5 && fbm2(jx / 300, jz / 300, 2) > 0;\n88\t      const pool = lods.filter((n) => conifer ? /pine|fir/.test(n) : /oak|beech|birch/.test(n));\n89\t      const name = R.pick(pool.length ? pool : lods);\n90\t      place.get(name).push([jx, height(jx, jz) - 0.3, jz, R() * Math.PI * 2, 0.9 + R() * 0.8]);\n91\t    }\n92\t  }\n93\t  const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), up = new THREE.Vector3(0, 1, 0), v = new THREE.Vector3(), s = new THREE.Vector3();\n94\t  let farCount = 0;\n95\t  for (const [name, list] of place) {\n96\t    if (!list.length) continue;\n97\t    const model = models.get(name);\n98\t    for (const p of model.prims) {\n99\t      const mesh = new THREE.InstancedMesh(p.geometry, matlib.resolve(p.material), list.length);\n100\t      list.forEach(([x, y, z, yaw, sc], i) => {\n101\t        q.setFromAxisAngle(up, yaw);\n102\t        mesh.setMatrixAt(i, m4.compose(v.set(x, y, z), q, s.setScalar(sc)));\n103\t      });\n104\t      mesh.frustumCulled = false;\n105\t      mesh.name = 'far:' + name;\n106\t      group.add(mesh);\n107\t    }\n108\t    farCount += list.length;\n109\t  }\n110\t  // continuous treelines along wood edges, if the models exist\n111\t  if (lines.length) {\n112\t    const tl = [];\n113\t    for (let k = 0; k < 900; k++) {\n114\t      const a = R() * Math.PI * 2, r = 160 + R() * 380;\n115\t      const x = (cx0 + cx1) / 2 + Math.cos(a) * (r + (cx1 - cx0) / 2), z = (cz0 + cz1) / 2 + Math.sin(a) * (r + (cz1 - cz0) / 2);\n116\t      if (outside(x, z) < 60 || woods(x, z) < 0.35) continue;\n117\t      tl.push([x, height(x, z) - 0.5, z, a + Math.PI / 2 + (R() - 0.5) * 0.6, 0.9 + R() * 0.5, R.pick(lines)]);\n118\t    }\n119\t    for (const name of lines) {\n120\t      const list = tl.filter((t) => t[5] === name);\n121\t      if (!list.length) continue;\n122\t      for (const p of models.get(name).prims) {\n123\t        const mesh = new THREE.InstancedMesh(p.geometry, matlib.resolve(p.material), list.length);\n124\t        list.forEach(([x, y, z, yaw, sc], i) => {\n125\t          q.setFromAxisAngle(up, yaw);\n126\t          mesh.setMatrixAt(i, m4.compose(v.set(x, y, z), q, s.setScalar(sc)));\n127\t        });\n128\t        mesh.frustumCulled = false;\n129\t        group.add(mesh);\n130\t      }\n131\t    }\n132\t  }\n133\t\n134\t  /* distant buildings: the next village up the valley, farms */\n135\t  const batch = createStaticBatcher(matlib, 400);\n136\t  for (const b of F.buildings || []) {\n137\t    const model = models.get(b.m);\n138\t    if (!model) continue;\n139\t    const y = height(b.x, b.z) - 0.2;\n140\t    q.setFromAxisAngle(up, (b.yaw || 0) * Math.PI / 180);\n141\t    batch.add(model, m4.compose(v.set(b.x, y, b.z), q, s.setScalar(b.scale || 1)));\n142\t  }\n143\t  group.add(batch.build());\n144\t\n145\t  return { group, height, farTrees: farCount };\n146\t}\n147\t"},{"tool_use_id":"toolu_01HREqD9hqfGUxe1hdfYJD1H","type":"tool_result","content":"  if (Math.hypot(x - CLEARING.x, z - CLEARING.z) < CLEARING.r) return true;\n  if (Math.hypot(x - BUNKER.x, z - BUNKER.z) < 11) return true;\n  for (const [fx, fz] of FOXHOLES) if (Math.hypot(x - fx, z - fz) < 3.5) return true;\n  return false;\n}\n// forest\n// mature specimens fall back to a scaled-up ordinary tree until their models exist\nconst BIG = { pine_big: ['pine_a', 1.45], fir_big: ['pine_b', 1.5], oak_big: ['oak_a', 1.5], beech_big: ['oak_b', 1.55] };\nconst tree = (m, x, z, scale, o = {}) => {\n  const big = BIG[m];\n  scatter.push({ m, x, z, yaw: R() * 360, scale, ...(big ? { alt: big[0], altScale: big[1] } : {}), ...o });\n};\nfor (let i = 0; i < 5400; i++) {\n  const x = R.range(-92, 92), z = R.range(279, 600);\n  if (noTree(x, z)) continue;\n  const r = R();\n  const m = r < 0.22 ? R.pick(['pine_big', 'fir_big']) : r < 0.5 ? R.pick(['pine_a', 'pine_b', 'pine_c']) : r < 0.6 ? R.pick(['oak_big', 'beech_big'])\n    : r < 0.74 ? R.pick(['oak_a', 'oak_b']) : r < 0.8 ? 'birch_a' : r < 0.83 ? 'tree_dead' : R.pick(['bush_a', 'bush_b', 'bramble']);\n  tree(m, x, z, m.startsWith('bush') || m === 'bramble' ? 0.8 + R() * 0.5 : 0.95 + R() * 0.55);\n}\nfor (let i = 0; i < 260; i++) {\n  const x = R.range(-60, 60), z = R.range(285, 560);\n  if (noTree(x, z)) continue;\n  scatter.push({ m: R.pick(['boulder_a', 'boulder_b', 'rocks_small', 'stump', 'log', 'boulder_a']), x, z, yaw: R() * 360, scale: 0.8 + R() * 0.5, rock: true });\n}\n// trees around the village and the fields, the far bank to the south\nfor (let i = 0; i < 1300; i++) {\n  const x = R.range(-98, 98), z = R.range(-44, 262);\n  if (Math.abs(x) < 47 && z > -20) continue;\n  const r = R();\n  const m = r < 0.25 ? R.pick(['oak_big', 'beech_big']) : r < 0.6 ? R.pick(['oak_a', 'oak_b']) : r < 0.75 ? 'birch_a' : r < 0.85 ? 'pine_big' : R.pick(['pine_a', 'pine_b']);\n  tree(m, x, z, 0.95 + R() * 0.5);\n}\n// garden trees and bushes\nfor (let i = 0; i < 70; i++) {\n  const side = R.sign();\n  const x = side * R.range(16, 42), z = R.range(92, 250);\n  if (noTree(x, z)) continue;\n  scatter.push({ m: R() < 0.35 ? R.pick(['oak_a', 'oak_b']) : R.pick(['bush_a', 'bush_b']), x, z, yaw: R() * 360, scale: R() < 0.35 ? 0.55 + R() * 0.2 : 0.8 + R() * 0.4 });\n}\n// river banks: reeds and bushes\n37:// bounding boxes of the lines (grown by `pad`): distance tests only run near them\n485:// trees around the village and the fields, the far bank to the south\n649:  far: {","is_error":false}]}}
