{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"2666ce12874f0973a2fd85c30fd7603ea316c33269c0878f6a8366cb09b823de","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_013DTZtdeYkj1fNMCNBr1P98","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow && sed -n 1,80p js/input.js; sed -n 255,275p js/main.js","description":"Read input handling and resume logic"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"e1e261dcf82d7e82225e41f3bb2717daf934b20f4a556d2243ce9deeab10c6eb","message":{"role":"user","content":[{"tool_use_id":"toolu_013DTZtdeYkj1fNMCNBr1P98","type":"tool_result","content":"/* Hedgerow — keyboard and mouse. Pointer lock while playing; mouse deltas\n   accumulate between frames; edge-triggered presses are kept until read. */\n\nexport function createInput(canvas) {\n  const down = new Set();\n  const pressed = new Set();\n  const released = new Set();\n  let dx = 0, dy = 0, wheel = 0;\n  let mouseL = false, mouseR = false, mouseLPressed = false;\n  let locked = false;\n  let enabled = false;\n  const listeners = { lock: [], unlock: [] };\n\n  const keyName = (e) => {\n    if (e.code === 'ControlLeft' || e.code === 'ControlRight') return 'Control';\n    if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') return 'Shift';\n    return e.code;\n  };\n\n  window.addEventListener('keydown', (e) => {\n    if (!enabled) return;\n    const k = keyName(e);\n    if (!down.has(k)) pressed.add(k);\n    down.add(k);\n    if (['Space', 'Tab', 'KeyW', 'KeyA', 'KeyS', 'KeyD', 'Control'].includes(k) || k.startsWith('Arrow')) e.preventDefault();\n  });\n  window.addEventListener('keyup', (e) => {\n    const k = keyName(e);\n    down.delete(k);\n    released.add(k);\n  });\n  window.addEventListener('blur', () => { down.clear(); mouseL = mouseR = false; });\n\n  canvas.addEventListener('mousedown', (e) => {\n    if (!enabled) return;\n    if (!locked) { requestLock(); return; }\n    if (e.button === 0) { mouseL = true; mouseLPressed = true; }\n    if (e.button === 2) mouseR = true;\n  });\n  window.addEventListener('mouseup', (e) => {\n    if (e.button === 0) mouseL = false;\n    if (e.button === 2) mouseR = false;\n  });\n  canvas.addEventListener('contextmenu', (e) => e.preventDefault());\n  window.addEventListener('mousemove', (e) => {\n    if (!locked) return;\n    // guard against the occasional huge first delta after locking\n    if (Math.abs(e.movementX) > 400 || Math.abs(e.movementY) > 400) return;\n    dx += e.movementX; dy += e.movementY;\n  });\n  window.addEventListener('wheel', (e) => { if (locked) wheel += Math.sign(e.deltaY); }, { passive: true });\n\n  document.addEventListener('pointerlockchange', () => {\n    const now = document.pointerLockElement === canvas;\n    if (now === locked) return;\n    locked = now;\n    if (!locked) { mouseL = mouseR = false; down.clear(); }\n    for (const f of listeners[locked ? 'lock' : 'unlock']) f();\n  });\n\n  function requestLock() {\n    try {\n      const p = canvas.requestPointerLock({ unadjustedMovement: true });\n      if (p && p.catch) p.catch(() => canvas.requestPointerLock());\n    } catch { canvas.requestPointerLock(); }\n  }\n\n  return {\n    get locked() { return locked; },\n    get mouseL() { return mouseL; },\n    get mouseR() { return mouseR; },\n    enable(on) { enabled = on; if (!on) { down.clear(); mouseL = mouseR = false; } },\n    requestLock,\n    exitLock() { if (document.pointerLockElement) document.exitPointerLock(); },\n    on(ev, f) { listeners[ev].push(f); },\n    held: (k) => down.has(k),\n    pressed: (k) => pressed.has(k),\n    released: (k) => released.has(k),\n    fired() { const v = mouseLPressed; return v; },\n    consumeMouse() { const r = [dx, dy]; dx = 0; dy = 0; return r; },\nfunction resume() {\n  state = 'playing';\n  show(null);\n  screenStack = [];\n  hud.show(true);\n  document.body.classList.add('playing');\n  input.enable(true);\n  input.requestLock();\n  audio.resume();\n}\n\nfunction pause() {\n  if (state !== 'playing') return;\n  state = 'paused';\n  input.enable(false);\n  document.body.classList.remove('playing');\n  $('[data-pause-objective]').textContent = mission?.done ? '' : (LEVEL.objectives[mission?.index ?? 0]?.text || '');\n  show('pause');\n}\n\nfunction onDeath() {","is_error":false}]}}
