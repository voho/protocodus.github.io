.nx, h.ny, h.nz, h.surface || 'stone');\n        G.audio.impact(h.x, h.y, h.z, h.surface);\n        // near misses keep enemies' heads down\n        for (const e of G.enemies) {\n          if (!e.dead && Math.hypot(e.pos.x - h.x, e.pos.y + 1 - h.y, e.pos.z - h.z) < 2.2) e.suppress(1.2, P.pos);\n        }\n      }\n    }\n7:   * raycast(origin, dir, maxDist, mask)   — bullets, sight lines, camera\n37:    col.surface = col.surface || 'stone';\n157:  function raycast(ox, oy, oz, dx, dy, dz, maxT, mask = SHOT, opts = {}) {\n186:    let surface = hit ? hit.surface : null;\n188:      const tt = terrain.raycast(ox, oy, oz, dx, dy, dz, best);\n194:        surface = terrain.surfaceAt(x, z);\n221:    return !raycast(ax, ay, az, dx / L, dy / L, dz / L, L - 0.05, mask, { noWater: true });\n341:    const h = raycast(x, y + 0.3, z, 0, -1, 0, 0.7, MOVE, { noWater: true });\n342:    return h?.surface || (terrain ? terrain.surfaceAt(x, z) : 'stone');\n346:    add, remove, query, raycast, clear, groundAt, pushOut, obstacleAhead, tooDeep, waterDepth, surfaceUnder,","is_error":false}]},"uuid":"d4454321-e6c9-47bd-9d48-d18de8af048d","timestamp":"2026-10-21T19:01:18.186Z","toolUseResult":{"stdout":"    G.lights.flash(muzzle.x + md.x * 0.3, muzzle.y, muzzle.z + md.z * 0.3, '#ffb36b', 60, 9, 0.06);\n    G.audio.gunshot(w.sound, muzzle.x, muzzle.y, muzzle.z, { player: true });\n    if (P.weapon === 'garand' && a.mag === 0) {\n      // the empty en-bloc flies out with its ping\n      G.audio.garandPing();\n      const wpn = P.char.weapon;\n      const at = new THREE.Vector3();\n      if (wpn) wpn.localToWorld(at.set(0, 0.06, 0.05)); else at.copy(muzzle);\n      const side = new THREE.Vector3(-Math.cos(P.yaw), 0, Math.sin(P.yaw));\n      G.debris.spawn(magObject(w), at, new THREE.Vector3(side.x * 1.2, 3.2, side.z * 1.2), { spin: 18, radius: 0.03 });\n    }\n    if (w.tracer) G.effects.tracer(muzzle.x, muzzle.y, muzzle.z, md.x, md.y, md.z, mlen);\n    G.rig.kick(w.recoil * (P.crouch ? 0.7 : 1) 