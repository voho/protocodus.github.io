x - ix, ty = fy - iy;","+      const sx = tx * tx * (3 - 2 * tx), sy = ty * ty * (3 - 2 * ty);","+      const x1 = (ix + 1) % n, y1 = (iy + 1) % n;","+      const a = L[iy * n + ix], b = L[iy * n + x1], c = L[y1 * n + ix], d = L[y1 * n + x1];","+      oct[o] = a + (b - a) * sx + (c - a) * sy + (a - b - c + d) * sx * sy;","+    }","+    const i = y * S + x;","+    H[i] = oct[1] * 0.25 + oct[2] * 0.3 + oct[3] * 0.25 + oct[4] * 0.2;","+    A[i] = 0.5 + (oct[0] - 0.5) * 0.45 + (oct[1] - 0.5) * 0.35 + (oct[3] - 0.5) * 0.25 + (oct[4] - 0.5) * 0.15;","+  }","+  // pits, a few millimetres across, darker inside","+  for (let k = 0; k < 900; k++) {","+    const cx = R() * S, cy = R() * S, r = 1 + R() * 2.5, deep = 0.08 + R() * 0.12;","+    for (let j = Math.floor(-r - 1); j <= r + 1; j++) for (let i = Math.floor(-r - 1); i <= r + 1; i++) {","+      const px = (Math.floor(cx) + i + S) % S, py = (Math.floor(cy) + j + S) % S;","+      const t = 1 - Math.hypot(Math.floor(cx) + i - cx, Math.floor(cy) + j - cy) / r;","+      if (t <= 0) continue;","+      H[py * S + px] -= deep * t * t;","+      A[py * S + px] -= 0.25 * t;","+    }","+  }","+  const data = new Uint8Array(S * S * 4);","+  for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {","+    const i = y * S + x;","+    const dx = (H[y * S + ((x + 1) % S)] - H[y * S + ((x + S - 1) % S)]) * 9;","+    const dy = (H[((y + 1) % S) * S + x] - H[((y + S - 1) % S) * S + x]) * 9;","+    const l = Math.hypot(dx, dy, 1);","+    data[i * 4] = (0.5 - (0.5 * dx) / l) * 255;","+    data[i * 4 + 1] = (0.5 - (0.5 * dy) / l) * 255;","+    data[i * 4 + 2] = (0.5 + 0.5 / l) * 255;","+    data[i * 4 + 3] = Math.max(0, Math.min(1, A[i])) * 255;","+  }","+  const tex = new THREE.DataTexture(data, S, S);","+  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;","+  tex.generateMipmaps = true;","+  tex.minFilter = THREE.LinearMipmapLinearFilter;","+  tex.magFilter = THREE.LinearFilter;","+  tex.anisotropy = 8;","+  tex.needsUpdate = true;","+  return tex;","+}","+"," export function createMaterialLibrary(textures, shared) {","   const cache = new Map();","+  GRAIN_UNIFORMS.tGrain.value ??= grainTexture();"," ","   function get(key, opts = {}) {","     const id = key + (opts.variant ? ':' + opts.variant : '');"]},{"oldStart":203,"oldLines":6,"newStart":263,"newLines":9,"lines":["         skin: SKIN.test(src.name || ''),","         // the soldiers and their kit keep the fill light's sheen: it models their shape in the dark","         glints: CARRIED.test(src.name || ''),","+        // the grain of the surface close up: houses, walls, wrecks, crates (not the leaves, the","+        // bark, what is carried or the lit panes)","+        grain: !cards && !bk && !CARRIED.test(src.name || '') && !src.userData?.rooms,","       });","       baked.set(src.uuid, m);","       return m;"]},{"oldStart":219,"oldLines":10,"newStart":282,"newLines":10,"lines":["    With `detailTex` (palette materials) a tiling detail texture (RGB normal,","    A albedo detail) in metre UVs adds the surface grain. `rooms`: lit","    window panes (rooms.js) show the room behind them. */","-function addWeather(mat, shared, { porosity = 0.75, detailTex = null, tile = 1, foliage = false, sway = foliage, bark = null, streaks = false, rooms = false, smoulder = null, skin = false, glints = false }) {","+function addWeather(mat, shared, { porosity = 0.75, detailTex = null, tile = 1, foliage = false, sway = foliage, bark = null, streaks = false, rooms = false, smoulder = null, skin = false, glints = false, grain = false }) {","   const detail = !!detailTex;","   const tileScale = 1 / tile;","-  mat.customProgramCacheKey = () => 'hedgerow-' + (detail ? 'd' : 'b') + (foliage ? 'f' : '') + (sway ? 'w' : '') + (bark ? 'k' : '') + (streaks ? 's' : '') + (rooms ? 'r' : '') + (smoulder ? 'm' + smoulder[0] : '') + (skin ? 'h' : '') + (glints ? 'g' : '') + (mat.normalMap ? 'n' : '');","+  mat.customProgramCacheKey = () => 'hedgerow-' + (detail ? 'd' : 'b') + (foliage