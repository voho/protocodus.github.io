era looks, from behind it to ahead:","-        // the tufts in view are drawn near to far, so those hidden behind nearer ones fail the","-        // depth test before they are shaded (far to near, every blade was shaded and then covered)","-        vec2 ab = vec2(mod(id, uN), floor(id / uN));","-        if (uFlip > 0.5) ab.y = uN - 1.0 - ab.y;","-        vec2 cell = uOrigin + (uSwap > 0.5 ? ab.yx : ab);","+        vec2 cell = uOrigin + vec2(mod(id, uN), floor(id / uN));","         vec4 h = hash4(cell);","         vec2 root = (cell + 0.5 + (h.xy - 0.5) * 1.4) * uSpacing;","         // how grassy, and the ground's height (the mesh's, to a centimetre), in one fetch"]},{"oldStart":216,"oldLines":10,"newStart":210,"newLines":6,"lines":["       const o = uniforms.uOrigin.value;","       o.set(Math.floor(camera.position.x / spacing) - n / 2, Math.floor(camera.position.z / spacing) - n / 2);","       uniforms.uPixel.value = 2 * Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2) / height;","-      // near to far: rows across the main axis of the view, in its direction","-      const e = camera.matrixWorld.elements, fx = -e[8], fz = -e[10];","-      uniforms.uSwap.value = Math.abs(fx) > Math.abs(fz) ? 1 : 0;","-      uniforms.uFlip.value = (Math.abs(fx) > Math.abs(fz) ? fx : fz) < 0 ? 1 : 0;","       if (player) uniforms.uPlayer.value.copy(player);","       const sv = uniforms.uShock.value;","       for (let i = 0; i < 3; i++) {"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/grass.js"]}},"serverClassifierContext":{"request":"6dbf3001-1c15-415a-abb8-9a93a80b6eec","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null