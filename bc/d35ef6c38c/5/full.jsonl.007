ec2(1.6, 0.7));\n          float gw = (gust(root.xz, uTime, wdir) - 0.55) / 1.05;\n          float k = hgt * min(hgt, 14.0) * 0.0025 * (0.55 + 0.6 * gw);\n          transformed.x += (sin(ph) * 0.6 + sin(ph * 2.7 + position.z * 1.3) * 0.25) * k;\n          transformed.z += (cos(ph * 0.8) * 0.4 + sin(ph * 3.1 + position.x * 1.1) * 0.2) * k;\n          // the lean downwind, in the tree's own space (it is turned and scaled as it stands)\n          mat3 im = mat3(modelMatrix);\n          #ifdef USE_INSTANCING\n            im = im * mat3(instanceMatrix);\n          #endif\n          transformed += transpose(im) * vec3(wdir.x, 0.0, wdir.y) / dot(im[0], im[0]) * hgt * min(hgt, 14.0) * 0.0025 * gw * 0.9;\n        }` : ''}`)\"\"\"),\n])\n\nrep_in('js/grass.js', [\n  (\"\"\"import { dimFillSpecular } from './fill.js';\"\"\", \"\"\"import { dimFillSpecular } from './fill.js';\nimport { GUST_GLSL } from './weather.js';\"\"\"),\n  (\"\"\"        uniform vec4 uShock[3];\n        varying float vT;\"\"\", \"\"\"        uniform vec4 uShock[3];\n        varying float vT;\n        ${GUST_GLSL}\"\"\"),\n  (\"\"\"          // out of the tuft, the wind (gusts rolling across the field), a flutter\n          float gust = 0.5 + 0.5 * sin(dot(root, uWind) * 0.3 - uTime * 1.7 + sin(dot(root, vec2(-uWind.y, uWind.x)) * 0.11) * 2.0);\n          vec2 lean = normalize(off) * (0.25 + 0.45 * b.z) + uWind * (0.15 + 0.55 * gust * gust)\"\"\", \"\"\"          // out of the tuft, the wind (waves rolling across the field), a flutter; the gusts that drive\n          // the rain (weather.js) make the waves stronger and lay the grass over as they sweep through\n          float gf = (gust(root, uTime, uWind) - 0.55) / 1.05;\n          float gw = (0.5 + 0.5 * sin(dot(root, uWind) * 0.3 - uTime * 1.7 + sin(dot(root, vec2(-uWind.y, uWind.x)) * 0.11) * 2.0))\n            * (0.45 + 0.75 * gf) + 0.4 * gf;\n          vec2 lean = normalize(off) * (0.25 + 0.45 * b.z) + uWind * (0.15 + 0.55 * gw * gw)\"\"\"),\n])\npri