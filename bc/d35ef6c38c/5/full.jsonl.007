points spaced","+   equiangularly about the light (as its inverse-square light falls on the","+   ray, so their average visibility is the share of its closed-form glow,","+   volumetric.js, that reaches the eye) are looked up, and that share is","+   written to a second target. A truck's cab in front of its fire, the","+   walls of a burning ruin, a soldier by a lamp cut dark shafts out of the","+   glow in the rain. */"," "," import * as THREE from 'three';"," "]},{"oldStart":55,"oldLines":6,"newStart":65,"newLines":53,"lines":["   gl_FragColor = vec4(lit * dt * phase, 0.0, 0.0, 1.0);"," }`;"," ","+// the share of the shadow-casting point light's glow along each view ray that is not in shadow","+const PSTEPS = 12;","+const PFRAG = /* glsl */ `","+#define PSTEPS ${PSTEPS}","+uniform sampler2D tDepth;","+uniform highp samplerCubeShadow tCube;","+uniform mat4 uProjInv, uViewInv;","+uniform vec3 uCam, uPL;","+uniform float uPLNear, uPLFar, uPLBias, uPLRange;","+varying vec2 vUv;","+","+float ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }","+","+void main() {","+  float d = texture2D(tDepth, vUv).x;","+  vec4 v = uProjInv * vec4(vUv * 2.0 - 1.0, d * 2.0 - 1.0, 1.0);","+  v.xyz /= v.w;","+  float T = d >= 1.0 ? 1e4 : length(v.xyz);","+  vec3 dir = normalize(mat3(uViewInv) * v.xyz);","+  // the same stretch of the ray, and the same soft core, as volumetric.js integrates","+  vec3 L = uPL - uCam;","+  float t0 = dot(L, dir);","+  float h2 = max(dot(L, L) - t0 * t0, 0.0);","+  float R = uPLRange, vis = 1.0;","+  if (h2 < R * R) {","+    float w = sqrt(R * R - h2);","+    float ta = max(0.0, t0 - w), tb = min(T, t0 + w);","+    if (tb > ta) {","+      float h = sqrt(h2) + 0.35;","+      float aa = atan((ta - t0) / h), ab = atan((tb - t0) / h);","+      float j = ign(gl_FragCoord.xy), s = 0.0;","+      for (int i = 0; i < PSTEPS; i++) {","+        float t = t0 + h * tan(mix(aa, ab, (float(i) + j) / float(PSTEPS)));","+        vec3 lp =