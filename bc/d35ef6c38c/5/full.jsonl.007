lief's surface, on its height canvas (lower is sunk in)","+const CELL = 256; // a variant's size in texels; four to a texture"," "," /* A decal is painted with the same strokes on its canvases: the colour (opaque","    all over, so a texel at an edge filters with its own colour, not black), how"]},{"oldStart":185,"oldLines":9,"newStart":188,"newLines":13,"lines":["     return g;","   };","   const p = { S, col: mk(ground), alpha: mk('#000'), height: mk(`rgb(${FLAT},${FLAT},${FLAT})`), bare: bare ? mk('#000') : null };","+  const all = [p.col, p.alpha, p.height, p.bare].filter(Boolean);","   // one shape onto the canvases named in `styles` (a fill or stroke style each)","   p.fill = (path, styles) => { for (const k in styles) { p[k].fillStyle = styles[k]; p[k].fill(path); } };","   p.stroke = (path, styles, width) => { for (const k in styles) { p[k].strokeStyle = styles[k]; p[k].lineWidth = width; p[k].stroke(path); } };","+  // paint only inside one variant's square","+  p.clip = (x, y, w) => { for (const g of all) { g.save(); g.beginPath(); g.rect(x, y, w, w); g.clip(); } };","+  p.unclip = () => { for (const g of all) g.restore(); };","   return p;"," }"," "]},{"oldStart":235,"oldLines":154,"newStart":242,"newLines":156,"lines":["   return path;"," }"," ","-/* the canvases as textures: the colour with how much of it shows, the relief as a normal map","-   (`relief`: how steep a slope of the height comes out) and (metal) roughness and metalness */","-function finish(p, relief) {","-  const S = p.S, n = S * S;","-  const data = (g) => g.getImageData(0, 0, S, S).data;","-  const col = data(p.col), al = data(p.alpha), hd = data(p.height);","-  // the height softened a little: from eight bits its slopes would come out in terraces","-  let h = new Float32Array(n), t = new Float32Array(n);","-  for (let i = 0; i < n; i++) h[i] = hd[i * 4] / 255;","-  const at = (x, y) => h[Math.min(S - 1, Math.max(0, y)) * S + Math.min(S - 1, Math.max(0, x))];","-  for (let pass = 0; pass < 2; pass++) {","-    for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {","-      let sum = 0;","-      for (let j = -1; j <= 1; j++) for (let i = -1; i <= 1; i++) sum += at(x + i, y + j);","-      t[y * S + x] = sum / 9;","-    }","-    [h, t] = [t, h];","-  }","-  const rgba = new Uint8Array(n * 4), nrm = new Uint8Array(n * 4);","-  for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {","-    const i = y * S + x, o = i * 4;","-    rgba[o] = col[o]; rgba[o + 1] = col[o + 1]; rgba[o + 2] = col[o + 2]; rgba[o + 3] = al[o];","-    // the texture's rows run up its v (no flip): a rise along them tilts the normal back down v","-    const dx = (at(x + 1, y) - at(x - 1, y)) * relief, dy = (at(x, y + 1) - at(x, y - 1)) * relief;","-    const l = Math.hypot(dx, dy, 1);","-    nrm[o] = (0.5 - (0.5 * dx) / l) * 255; nrm[o + 1] = (0.5 - (0.5 * dy) / l) * 255; nrm[o + 2] = (0.5 + 0.5 / l) * 255; nrm[o + 3] = 255;","-  }","-  const tex = (d, color) => {","-    const tx = new THREE.DataTexture(d, S, S);","-    tx.colorSpace = color ? THREE.SRGBColorSpace : THREE.NoColorSpace;","-    tx.generateMipmaps = true;","-    tx.minFilter = THREE.LinearMipmapLinearFilter;","-    tx.magFilter = THREE.LinearFilter;","-    tx.anisotropy = 4;","-    tx.needsUpdate = true;","-    return tx;","-  };","-  const set = { map: tex(rgba, true), normalMap: tex(nrm, false), orm: null };","-  if (p.bare) {","-    // bare steel smooth and metal, the paint round it rough (green: roughness, blue: metalness)","-    const b = data(p.bare), orm = new Uint8Array(n * 4);","-    for (let i = 0; i < n; i++) { const k = b[i * 4] / 255; orm[i * 4 + 1] = (0.72 - 0.42 * k) * 255; orm[i * 4 + 2] = k * 255; orm[i * 4 + 3] = 255; }","-    set.orm = tex(orm, false);","-  }","-  return set;","-}","-","-/* stone (and brick, cobbles, concrete): the face spalled away in chips round a black hole */","-function stoneHole(S) {","-  const R = rng(9151), c = S / 2;","-  const p = painter(S, 'rgb(150,143,131)');","+/* stone (and brick, cobbles, concrete): the face spalled away in chips, lopsided, round a black hole */","+function stoneHole(p, R, cx, cy, S) {","+  const ox = cx + (R() - 0.5) * S * 0.08, oy = cy + (R() - 0.5) * S * 0.08;","   // the powder of it thrown round, and grit","-  const dust = p.alpha.createRadialGradient(c, c, S * 0.12, c, c, S * 0.48);","-  dust.addColorStop(0, grey(70)); dust.addColorStop(1, grey(0));","-  p.alpha.fillStyle = dust; p.alpha.fillRect(0, 0, S, S);","-  for (let k = 0; k < 70; k++) {","-    const a = R() * Math.PI * 2, r = S * (0.14 + 0.3 * Math.sqrt(R())), v = 105 + R() * 70;","-    p.fill(disc(c + Math.cos(a) * r, c + Math.sin(a) * r, S * (0.004 + R() * 0.008)), { col: `rgb(${v},${v * 0.95},${v * 0.87})`, alpha: grey(60 + R() * 100), height: grey(FLAT + 6) });","+  const dust = p.alpha.createRadialGradient(ox, oy, S * 0.1, ox, oy, S * 0.42);","+  dust.addColorStop(0, grey(55 + R() * 30)); dust.addColorStop(1, grey(0));","+  p.alpha.fillStyle = dust; p.alpha.fill(disc(ox, oy, S * 0.42));","+  for (let k = 0; k < 60; k++) {","+    const a = R() * Math.PI * 2, r = S * (0.13 + 0.27 * Math.sqrt(R())), v = 105 + R() * 70;","+    p.fill(disc(ox + Math.cos(a) * r, oy + Math.sin(a) * r, S * (0.004 + R() * 0.008)), { col: `rgb(${v},${v * 0.95},${v * 0.87})`, alpha: grey(60 + R() * 100), height: grey(FLAT + 6) });","   }","   // cracks running out of it","-  for (let k = 0, m = 3 + Math.floor(R() * 3); k < m; k++) {","+  for (let k = 0, m = 2 + Math.floor(R() * 4); k < m; k++) {","     const a = R() * Math.PI * 2;","-    p.stroke(crack(R, c + Math.cos(a) * S * 0.14, c + Math.sin(a) * S * 0.14, a, S * (0.12 + R() * 0.2)), { col: 'rgb(30,28,25)', alpha: grey(200), height: grey(FLAT - 28) }, S * (0.005 + R() * 0.005));","+    p.stroke(crack(R, cx + Math.cos(a) * S * 0.13, cy + Math.sin(a) * S * 0.13, a, S * (0.1 + R() * 0.16)), { col: 'rgb(30,28,25)', alpha: grey(200), height: grey(FLAT - 28) }, S * (0.005 + R() * 0.005));","   }","   // the crater, in