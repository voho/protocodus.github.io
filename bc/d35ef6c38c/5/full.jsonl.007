y, S * (0.038 + R() * 0.014), 9, 0.3), { col: 'rgb(8,6,4)', height: grey(0) });"," }"," ","-/* painted steel: dented, the paint flaked off round a holed, bright bowl */","-function metalHole(S) {","-  const R = rng(777), c = S / 2;","-  const p = painter(S, 'rgb(150,151,154)', true);","-  const bowl = p.height.createRadialGradient(c, c, 0, c, c, S * 0.24);","+/* painted steel: dented, the paint flaked off round a bright bowl, holed (or, a glancing hit, not) */","+function metalHole(p, R, cx, cy, S) {","+  const dr = S * (0.19 + R() * 0.07);","+  const bowl = p.height.createRadialGradient(cx, cy, 0, cx, cy, dr);","   bowl.addColorStop(0, grey(70)); bowl.addColorStop(0.7, grey(FLAT - 6)); bowl.addColorStop(0.86, grey(FLAT + 22)); bowl.addColorStop(1, grey(FLAT));","-  p.height.fillStyle = bowl; p.height.fill(disc(c, c, S * 0.24));","+  p.height.fillStyle = bowl; p.height.fill(disc(cx, cy, dr));","   // a scuff of soot and lead round it, flakes of paint gone further out","-  const scuff = p.alpha.createRadialGradient(c, c, S * 0.1, c, c, S * 0.3);","+  const scuff = p.alpha.createRadialGradient(cx, cy, dr * 0.45, cx, cy, dr * 1.35);","   scuff.addColorStop(0, grey(150)); scuff.addColorStop(1, grey(0));","-  p.alpha.fillStyle = scuff; p.alpha.fill(disc(c, c, S * 0.3));","-  p.col.fillStyle = 'rgb(28,27,26)'; p.col.fill(disc(c, c, S * 0.3));","-  for (let k = 0; k < 9; k++) {","-    const a = R() * Math.PI * 2, r = S * (0.18 + R() * 0.1);","-    p.fill(ragged(R, c + Math.cos(a) * r, c + Math.sin(a) * r, S * (0.01 + R() * 0.025), 6, 0.4), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });","+  p.alpha.fillStyle = scuff; p.alpha.fill(disc(cx, cy, dr * 1.35));","+  p.col.fillStyle = 'rgb(28,27,26)'; p.col.fill(disc(cx, cy, dr * 1.35));","+  for (let k = 0, m = 5 + Math.floor(R() * 8); k < m; k++) {","+    const a = R() * Math.PI * 2, r = dr * (0.85 + R() * 0.45);","+    p.fill(ragged(R, cx + Math.cos(a) * r, cy + Math.sin(a) * r, S * (0.01 + R() * 0.025), 6, 0.4), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });","   }","-  p.fill(ragged(R, c, c, S * 0.21, 18, 0.3), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });","+  p.fill(ragged(R, cx, cy, dr * 0.88, 18, 0.3), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });","   // the hole, its lip torn","-  p.fill(ragged(R, c, c, S * 0.05, 8, 0.35), { col: 'rgb(6,6,6)', bare: grey(0), height: grey(0) });","-  return finish(p, 20);","+  if (R() < 0.75) p.fill(ragged(R, cx, cy, S * (0.04 + R() * 0.02), 8, 0.35), { col: 'rgb(6,6,6)', bare: grey(0), height: grey(0) });"," }"," "," /* the ground: a pit kicked in the mud, clods thrown out of it */","-function mudSplat(S) {","-  const R = rng(3301), c = S / 2;","-  const p = painter(S, 'rgb(44,35,26)');","-  for (let k = 0; k < 46; k++) {","-    const a = R() * Math.PI * 2, r = S * (0.1 + 0.36 * Math.sqrt(R())), v = 34 + R() * 26;","-    p.fill(ragged(R, c + Math.cos(a) * r, c + Math.sin(a) * r, S * (0.008 + R() * 0.03), 6, 0.45), { col: `rgb(${v},${v * 0.8},${v * 0.6})`, alpha: grey(170 + R() * 85), height: grey(FLAT + 25 + R() * 45) });","+function mudSplat(p, R, cx, cy, S) {","+  for (let k = 0, m = 30 + Math.floor(R() * 30); k < m; k++) {","+    const a = R() * Math.PI * 2, r = S * (0.1 + 0.32 * Math.sqrt(R())), v = 34 + R() * 26;","+    p.fill(ragged(R, cx + Math.cos(a) * r, cy + Math.sin(a) * r, S * (0.008 + R() * 0.03), 6, 0.45), { col: `rgb(${v},${v * 0.8},${v * 0.6})`, alpha: grey(170 + R() * 85), height: grey(FLAT + 25 + R() * 45) });","   }","-  p.fill(ragged(R, c, c, S * 0.15, 13, 0.4), { col: 'rgb(30,24,17)', alpha: grey(235), height: grey(FLAT - 45) });","-  p.fill(ragged(R, c, c, S * 0.06, 9, 0.4), { col: 'rgb(18,14,10)', alpha: grey(255), height: grey(FLAT - 90) });","-  return finish(p, 14);","+  p.fill(ragged(R, cx, cy, S * (0.12 + R() * 0.06), 13, 0.4), { col: 'rgb(30,24,17)', alpha: grey(235), height: grey(FLAT - 45) });","+  p.fill(ragged(R, cx, cy, S * (0.05 + R() * 0.02), 9, 0.4), { col: 'rgb(18,14,10)', alpha: grey(255), height: grey(FLAT - 90) });"," }"," "," /* a blast's scorch on the ground, burnt out from the middle in streaks */","-function scorchMark(S) {","-  const R = rng(6), c = S / 2;","-  const p = painter(S, 'rgb(12,11,9)');","-  const burnt = p.alpha.createRadialGradient(c, c, 0, c, c, c);","+function scorchMark(p, R, cx, cy, S) {","+  const burnt = p.alpha.createRadialGradient(cx, cy, 0, cx, cy, S * 0.48);","   burnt.addColorStop(0, grey(242)); burnt.addColorStop(0.5, grey(178)); burnt.addColorStop(1, grey(0));","-  p.alpha.fillStyle = burnt; p.alpha.fillRect(0, 0, S, S);","+  p.alpha.fillStyle = burnt; p.alpha.fill(disc(cx, cy, S * 0.48));","   for (let k = 0; k < 40; k++) {","-    const a = R() * 6.28, r = S * (0.25 + R() * 0.25);","+    const a = R() * 6.28, r = S * (0.22 + R() * 0.24);","     const path = new Path2D();","-    path.moveTo(c, c); path.lineTo(c + Math.cos(a) * r, c + Math.sin(a) * r);","+    path.moveTo(cx, cy); path.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);","     p.stroke(path, { alpha: grey(80 + R() * 100) }, 1 + R() * 3);","   }","-  return finish(p, 0);","+}","+","+/* A kind's four variants as textures: the colour with how much of it shows, the relief as a","+   normal map (`relief`: how steep a slope of the height comes out) and, for metal, roughness","+   and metalness (green and blue). */","+function decalSet(paint, seed, ground, relief, bare = false) {","+  const S = CELL * 2, n = S * S, R = rng(seed);","+  const p = painter(S, ground, bare);","+  for (let i = 0; i < 4; i++) {","+    const x = (i % 2) * CELL, y = (i >> 1) * CELL;","+    p.clip(x, y, CELL);","+    paint(p, R, x + CELL / 2, y + CELL / 2, CELL);","+    p.unclip();","+  }","+  const data = (g) => g.getImageData(0, 0, S, S).data;","+  const col = data(p.col), al = data(p.alpha), hd = data(p.height);","+  // the height softened a little (twice over three texels each way): from eight bits its","+  // slopes would come out in terraces","+  const h = new Float32Array(n), t = new Float32Array(n);","+  for (let i = 0; i < n; i++) h[i] = hd[i * 4] / 255;","+  for (let pass = 0; pass < 2; pass++) {","+    for (let y = 0; y < S; y++) {","+      const r = y * S;","+      for (let x = 0; x < S; x++) t[r + x] = (h[r + Math.max(0, x - 1)] + h[r + x] + h[r + Math.min(S - 1, x + 1)]) / 3;","+    }","+    for (let y = 0; y < S; y++) {","+      const a = Math.max(0, y - 1) * S, b = y * S, c = Math.min(S - 1, y + 1) * S;","+      for (let x = 0; x < S; x++) h[b + x] = (t[a + x] + t[b + x] + t[c + x]) / 3;","+    }","+  }","+  const rgba = new Uint8Array(n * 4), nrm = new Uint8Array(n * 4);","+  for (let y = 0; y < S; y++) {","+    const a = Math.max(0, y - 1) * S, b = y * S, c = Math.min(S - 1, y + 1) * S;","+    for (let x = 0; x < S; x++) {","+      const i = b + x, o = i * 4;","+      rgba[o] = col[o]; rgba[o + 1] = col[o + 1]; rgba[o + 2] = col[o + 2]; rgba[o + 3] = al[o];","+      // the texture's rows run up its v (no flip): a rise along them tilts the normal back down v","+      const dx = (h[b + Math.min(S - 1, x + 1)] - h[b + Math.max(0, x - 1)]) * relief, dy = (h[c + x] - h[a + x]) * relief;","+      const l = Math.hypot(dx, dy, 1);","+      nrm[o] = (0.5 - (0.5 * dx) / l) * 255; nrm[o + 1] = (0.5 - (0.5 * dy) / l) * 255; nrm[o + 2] = (0.5 + 0.5 / l) * 255; nrm[o + 3] = 255;","+    }","+  }","+  const tex = (d, color) => {","+    const tx = new THREE.DataTexture(d, S, S);","+    tx.colorSpace = color ? THREE.SRGBColorSpace : THREE.NoColorSpace;","+    tx.generateMipmaps = true;","+    tx.minFilter = THREE.LinearMipmapLinearFilter;","+    tx.magFilter = THREE.LinearFilter;","+    tx.anisotropy = 4;","+    tx.needsUpdate = true;","+    return tx;","+  };","+  const set = { map: tex(rgba, true), normalMap: tex(nrm, false), orm: null };","+  if (p.bare) {","+    // bare steel smooth and metal, the paint round it rough","+    const b = data(p.bare), orm = new Uint8Array(n * 4);","+    for (let i = 0; i < n; i++) { const k = b[i * 4] / 255; orm[i * 4 + 1] = (0.72 - 0.42 * k) * 255; orm[i * 4 + 2] = k * 255; orm[i * 4 + 3] = 255; }","+    set.orm = tex(orm, false);","+  }","+  return set;"," }"," "," function decalMaterial(set, shared) {"]},{"oldStart":394,"oldLines":7,"newStart":403,"newLines":23,"lines":["   if (set.orm) { mat.roughnessMap = mat.metalnessMap = set.orm; mat.roughness = mat.metalness = 1; }","   mat.onBeforeCompile = (shader) => {","     shader.uniforms.uWet = shared ? shared.wet : { value: 0 };","-    shader.vertexShader = shader.vertexShader.replace('#include <project_vertex>', `#include <project_vertex>","+    shader.vertexShader = shader.vertexShader","+      .replace('#include <common>', '#include <common>\\nattribute vec2 aCell;')","+      .replace('#include <uv_vertex>', `#include <uv_vertex>","+      // its variant: a quarter of the textures","+      #ifdef USE_MAP","+        vMapUv = vMapUv * 0.5 + aCell;","+      #endif","+      #ifdef USE_NORMALMAP","+        vNormalMapUv = vNormalMapUv * 0.5 + aCell;","+      #endif","+      #ifdef USE_ROUGHNESSMAP","+        vRoughnessMapUv = vRoughnessMapUv * 0.5 + aCell;","+      #endif","+      #ifdef USE_METALNESSMAP","+        vMetalnessMapUv = vMetalnessMapUv * 0.5 + aCell;","+      #endif`)","+      .replace('#include <project_vertex>', `#include <project_vertex>","       mvPosition.xyz -= normalize(mvPosition.xyz) * min(${PULL.toFixed(3)}, length(mvPosition.xyz) * 0.2);","       gl_Position = projectionMatrix * mvPosition;`);","     shader.fragmentShader = shader.fragmentShader"]},{"oldStart":412,"oldLines":18,"newStart":437,"newLines":26,"lines":[" export function createDecals({ max = 200, shared = null } = {}) {","   const group = new THREE.Group();","   group.name = 'decals';","-  const geo = new THREE.PlaneGeometry(1, 1);","-  const sets = { stone: stoneHole(256), wood: woodHole(256), metal: metalHole(256), splat: mudSplat(256), scorch: scorchMark(256) };","+  const sets = {","+    stone: decalSet(stoneHole, 9151, 'rgb(150,143,131)', 18),","+    wood: decalSet(woodHole, 4243, 'rgb(158,124,84)', 22),","+    metal: decalSet(metalHole, 777, 'rgb(150,151,154)', 20, true),","+    splat: decalSet(mudSplat, 3301, 'rgb(44,35,26)', 14),","+    scorch: decalSet(scorchMark, 6, 'rgb(12,11,9)', 0),","+  };","   const kinds = {};","   for (const k in sets) {","     const cap = k === 'scorch' ? 24 : max;","+    const geo = new THREE.PlaneGeometry(1, 1);","+    const cells = new THREE.InstancedBufferAttribute(new Float32Array(cap * 2), 2);","+    geo.setAttribute('aCell', cells);","     const m = new THREE.InstancedMesh(geo, decalMaterial(sets[k], shared), cap);","     m.count = 0;","     m.frustumCulled = false;","     m.renderOrder = 2;","     m.receiveShadow = true;","     group.add(m);","-    kinds[k] = { mesh: m, cursor: 0, n: 0, cap };","+    kinds[k] = { mesh: m, cells, cursor: 0, n: 0, cap };","   }","   const n = new THREE.Vector3(), up = new THREE.Vector3(), side = new THREE.Vector3();","   const mtx = new THREE.Matrix4(), turn = new THREE.Matrix4();"]},{"oldStart":443,"oldLines":10,"newStart":476,"newLines":13,"lines":["     mtx.scale(side.set(size, size, 1));","     mtx.setPosition(x + n.x * 0.012, y + n.y * 0.012, zz + n.z * 0.012);","     K.mesh.setMatrixAt(K.cursor, mtx);","+    const v = Math.floor(Math.random() * 4);","+    K.cells.setXY(K.cursor, (v % 2) * 0.5, (v >> 1) * 0.5);","     K.cursor = (K.cursor + 1) % K.cap;","     K.n = Math.min(K.cap, K.n + 1);","     K.mesh.count = K.n;","     K.mesh.instanceMatrix.needsUpdate = true;","+    K.cells.needsUpdate = true;","   }"," ","   /* A bullet impact by surface. */"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/atmosphere.js"]}},"serverClassifierContext":{"request":"081971ee-1730-4038-9b20-77fa9bbb16c4","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"fa451e6b-3f6b-42c4-82da-f6241e5d03b1","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
{"parentUuid":"5b30cb61-0233-4608-b613-a356f217d4f8","isSidechain":false,"attachment":{"type":"total_tokens_reminder","text":"<total_tokens>13380384 tokens left</total_tokens>"},"type":"attachment","uuid":"937d745c-0b06-4eda-acee-459ce1bd85ef","timestamp":"2026-10-21T19:15:46.920Z","rendered":[{"content":"<system-reminder>\n<total_tokens>13380384 tokens left</total_tokens>\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
{"type":"api-request-blob","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","hash":"80317f4917632b31d6e2f6c5181abf9c5d654293bbc7a45dd936582c78abf14b","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01SVYwbcoafDqB6RV2NFfCdw","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow && python3 - <<'PY'\np='js/atmosphere.js'\ns=open(p).read()\nstart=s.index('/* ---------- decals ---------- */')\nnew=r'''/* ---------- decals ---------- */\n\n/* What a bullet leaves, by what it hit, and the scorch of a blast. Each is a\n   small lit quad with a relief of its own (a normal map, so a lamp, a fire, a\n   flare or the muzzle flash picks out a crater's rim): stone chipped away pale\n   round a black hole, cracked and powdered; wood splintered along its grain,\n   the fresh wood showing; paint dented and flaked off to the bare steel round\n   a hole; mud thrown up in clods. Every kind is painted four ways (the\n   quarters of its textures), and each decal takes one at random, turned at\n   random. A bullet stops at a collider, a flat box, and a wall's stones bulge a\n   few centimetres out of it: so each decal is drawn pulled towards the eye\n   along its own sight line (it stays where it is on the screen) by PULL, which\n   brings it out over the stones instead of into them. */\n\nconst PULL = 0.06;\nconst FLAT = 160; // a relief's surface, on its height canvas (lower is sunk in)\nconst CELL = 256; // a variant's size in texels; four to a texture\n\n/* A decal is painted with the same strokes on its canvases: the colour (opaque\n   all over, so a texel at an edge filters with its own colour, not black), how\n   much of it shows, its height and (metal) where it is bare. */\nfunction painter(S, ground, bare = false) {\n  const mk = (fill) => {\n    const c = document.createElement('canvas');\n    c.width = c.height = S;\n    const g = c.getContext('2d');\n    g.fillStyle = fill;\n    g.fillRect(0, 0, S, S);\n    return g;\n  };\n  const p = { S, col: mk(ground), alpha: mk('#000'), height: mk(`rgb(${FLAT},${FLAT},${FLAT})`), bare: bare ? mk('#000') : null };\n  const all = [p.col, p.alpha, p.height, p.bare].filter(Boolean);\n  // one shape onto the canvases named in `styles` (a fill or stroke style each)\n  p.fill = (path, styles) => { for (const k in styles) { p[k].fillStyle = styles[k]; p[k].fill(path); } };\n  p.stroke = (path, styles, width) => { for (const k in styles) { p[k].strokeStyle = styles[k]; p[k].lineWidth = width; p[k].stroke(path); } };\n  // paint only inside one variant's square\n  p.clip = (x, y, w) => { for (const g of all) { g.save(); g.beginPath(); g.rect(x, y, w, w); g.clip(); } };\n  p.unclip = () => { for (const g of all) g.restore(); };\n  return p;\n}\n\nconst grey = (v) => `rgb(${v | 0},${v | 0},${v | 0})`;\n\n/* a ragged outline round (x, y): n corners out to r, each pulled in by up to jag of it */\nfunction ragged(R, x, y, r, n, jag) {\n  const path = new Path2D();\n  for (let i = 0; i < n; i++) {\n    const a = ((i + (R() - 0.5) * 0.8) / n) * Math.PI * 2, rr = r * (1 - jag * R());\n    path[i ? 'lineTo' : 'moveTo'](x + Math.cos(a) * rr, y + Math.sin(a) * rr);\n  }\n  path.closePath();\n  return path;\n}\n\nfunction disc(x, y, r) {\n  const path = new Path2D();\n  path.arc(x, y, r, 0, Math.PI * 2);\n  return path;\n}\n\n/* a crack wandering from (x, y) along ang */\nfunction crack(R, x, y, ang, len, steps = 5) {\n  const path = new Path2D();\n  path.moveTo(x, y);\n  for (let s = 0; s < steps; s++) {\n    ang += (R() - 0.5) * 0.8;\n    x += (Math.cos(ang) * len) / steps;\n    y += (Math.sin(ang) * len) / steps;\n    path.lineTo(x, y);\n  }\n  return path;\n}\n\n/* a splinter: a sliver from (x, y) along ang, w wide at its root, to a point */\nfunction sliver(x, y, ang, len, w) {\n  const path = new Path2D(), c = Math.cos(ang), s = Math.sin(ang);\n  path.moveTo(x - s * w * 0.5, y + c * w * 0.5);\n  path.lineTo(x + c * len * 0.6 - s * w * 0.3, y + s * len * 0.6 + c * w * 0.3);\n  path.lineTo(x + c * len, y + s * len);\n  path.lineTo(x + c * len * 0.55 + s * w * 0.35, y + s * len * 0.55 - c * w * 0.35);\n  path.lineTo(x + s * w * 0.5, y - c * w * 0.5);\n  path.closePath();\n  return path;\n}\n\n/* stone (and brick, cobbles, concrete): the face spalled away in chips, lopsided, round a black hole */\nfunction stoneHole(p, R, cx, cy, S) {\n  const ox = cx + (R() - 0.5) * S * 0.08, oy = cy + (R() - 0.5) * S * 0.08;\n  // the powder of it thrown round, and grit\n  const dust = p.alpha.createRadialGradient(ox, oy, S * 0.1, ox, oy, S * 0.42);\n  dust.addColorStop(0, grey(55 + R() * 30)); dust.addColorStop(1, grey(0));\n  p.alpha.fillStyle = dust; p.alpha.fill(disc(ox, oy, S * 0.42));\n  for (let k = 0; k < 60; k++) {\n    const a = R() * Math.PI * 2, r = S * (0.13 + 0.27 * Math.sqrt(R())), v = 105 + R() * 70;\n    p.fill(disc(ox + Math.cos(a) * r, oy + Math.sin(a) * r, S * (0.004 + R() * 0.008)), { col: `rgb(${v},${v * 0.95},${v * 0.87})`, alpha: grey(60 + R() * 100), height: grey(FLAT + 6) });\n  }\n  // cracks running out of it\n  for (let k = 0, m = 2 + Math.floor(R() * 4); k < m; k++) {\n    const a = R() * Math.PI * 2;\n    p.stroke(crack(R, cx + Math.cos(a) * S * 0.13, cy + Math.sin(a) * S * 0.13, a, S * (0.1 + R() * 0.16)), { col: 'rgb(30,28,25)', alpha: grey(200), height: grey(FLAT - 28) }, S * (0.005 + R() * 0.005));\n  }\n  // the crater, in chips that each broke off at a depth of their own\n  const cr = S * (0.15 + R() * 0.09), kx = (cx + ox) / 2, ky = (cy + oy) / 2;\n  p.fill(ragged(R, kx, ky, cr, 13 + Math.floor(R() * 6), 0.45), { col: 'rgb(150,141,127)', alpha: grey(255), height: grey(FLAT - 34) });\n  for (let k = 0, m = 8 + Math.floor(R() * 5); k < m; k++) {\n    const a = R() * Math.PI * 2, r = cr * 0.6 * Math.sqrt(R()), v = 125 + R() * 55;\n    p.fill(ragged(R, kx + Math.cos(a) * r, ky + Math.sin(a) * r, S * (0.04 + R() * 0.05), 7, 0.4), { col: `rgb(${v},${v * 0.94},${v * 0.85})`, alpha: grey(255), height: grey(FLAT - 70 + (r / S) * 300 + R() * 18) });\n  }\n  // deepest in the middle, round the hole the lead and soot the bullet wiped off\n  const pit = p.height.createRadialGradient(cx, cy, 0, cx, cy, cr * 0.7);\n  pit.addColorStop(0, 'rgba(60,60,60,1)'); pit.addColorStop(1, 'rgba(60,60,60,0)');\n  p.height.fillStyle = pit; p.height.fill(disc(cx, cy, cr * 0.7));\n  const hr = S * (0.035 + R() * 0.015);\n  const wipe = p.col.createRadialGradient(cx, cy, hr * 0.8, cx, cy, hr * 2.4);\n  wipe.addColorStop(0, 'rgba(22,20,18,0.95)'); wipe.addColorStop(1, 'rgba(22,20,18,0)');\n  p.col.fillStyle = wipe; p.col.fill(disc(cx, cy, hr * 2.4));\n  p.fill(ragged(R, cx, cy, hr, 9, 0.3), { col: 'rgb(5,4,4)', height: grey(0) });\n}\n\n/* wood: torn open along the grain (the texture's up and down), the fresh wood splintered out */\nfunction woodHole(p, R, cx, cy, S) {\n  const dust = p.alpha.createRadialGradient(cx, cy, S * 0.08, cx, cy, S * 0.3);\n  dust.addColorStop(0, grey(70)); dust.addColorStop(1, grey(0));\n  p.alpha.fillStyle = dust; p.alpha.fill(disc(cx, cy, S * 0.3));\n  for (let k = 0, m = 14 + Math.floor(R() * 12); k < m; k++) {\n    const ang = (R() < 0.5 ? -1 : 1) * Math.PI * 0.5 + (R() - 0.5) * 0.6, v = 140 + R() * 70;\n    const x = cx + (R() - 0.5) * S * 0.09, y = cy + (R() - 0.5) * S * 0.07;\n    p.fill(sliver(x, y, ang, S * (0.1 + R() * 0.28), S * (0.015 + R() * 0.03)), { col: `rgb(${v},${v * 0.8},${v * 0.54})`, alpha: grey(255), height: grey(FLAT + 14 + R() * 40) });\n  }\n  // the hole torn into it, darker where the wood is crushed\n  p.fill(ragged(R, cx, cy, S * (0.07 + R() * 0.03), 11, 0.35), { col: 'rgb(62,44,26)', alpha: grey(255), height: grey(FLAT - 50) });\n  p.fill(ragged(R, cx, cy, S * (0.038 + R() * 0.014), 9, 0.3), { col: 'rgb(8,6,4)', height: grey(0) });\n}\n\n/* painted steel: dented, the paint flaked off round a bright bowl, holed (or, a glancing hit, not) */\nfunction metalHole(p, R, cx, cy, S) {\n  const dr = S * (0.19 + R() * 0.07);\n  const bowl = p.height.createRadialGradient(cx, cy, 0, cx, cy, dr);\n  bowl.addColorStop(0, grey(70)); bowl.addColorStop(0.7, grey(FLAT - 6)); bowl.addColorStop(0.86, grey(FLAT + 22)); bowl.addColorStop(1, grey(FLAT));\n  p.height.fillStyle = bowl; p.height.fill(disc(cx, cy, dr));\n  // a scuff of soot and lead round it, flakes of paint gone further out\n  const scuff = p.alpha.createRadialGradient(cx, cy, dr * 0.45, cx, cy, dr * 1.35);\n  scuff.addColorStop(0, grey(150)); scuff.addColorStop(1, grey(0));\n  p.alpha.fillStyle = scuff; p.alpha.fill(disc(cx, cy, dr * 1.35));\n  p.col.fillStyle = 'rgb(28,27,26)'; p.col.fill(disc(cx, cy, dr * 1.35));\n  for (let k = 0, m = 5 + Math.floor(R() * 8); k < m; k++) {\n    const a = R() * Math.PI * 2, r = dr * (0.85 + R() * 0.45);\n    p.fill(ragged(R, cx + Math.cos(a) * r, cy + Math.sin(a) * r, S * (0.01 + R() * 0.025), 6, 0.4), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });\n  }\n  p.fill(ragged(R, cx, cy, dr * 0.88, 18, 0.3), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });\n  // the hole, its lip torn\n  if (R() < 0.75) p.fill(ragged(R, cx, cy, S * (0.04 + R() * 0.02), 8, 0.35), { col: 'rgb(6,6,6)', bare: grey(0), height: grey(0) });\n}\n\n/* the ground: a pit kicked in the mud, clods thrown out of it */\nfunction mudSplat(p, R, cx, cy, S) {\n  for (let k = 0, m = 30 + Math.floor(R() * 30); k < m; k++) {\n    const a = R() * Math.PI * 2, r = S * (0.1 + 0.32 * Math.sqrt(R())), v = 34 + R() * 26;\n    p.fill(ragged(R, cx + Math.cos(a) * r, cy + Math.sin(a) * r, S * (0.008 + R() * 0.03), 6, 0.45), { col: `rgb(${v},${v * 0.8},${v * 0.6})`, alpha: grey(170 + R() * 85), height: grey(FLAT + 25 + R() * 45) });\n  }\n  p.fill(ragged(R, cx, cy, S * (0.12 + R() * 0.06), 13, 0.4), { col: 'rgb(30,24,17)', alpha: grey(235), height: grey(FLAT - 45) });\n  p.fill(ragged(R, cx, cy, S * (0.05 + R() * 0.02), 9, 0.4), { col: 'rgb(18,14,10)', alpha: grey(255), height: grey(FLAT - 90) });\n}\n\n/* a blast's scorch on the ground, burnt out from the middle in streaks */\nfunction scorchMark(p, R, cx, cy, S) {\n  const burnt = p.alpha.createRadialGradient(cx, cy, 0, cx, cy, S * 0.48);\n  burnt.addColorStop(0, grey(242)); burnt.addColorStop(0.5, grey(178)); burnt.addColorStop(1, grey(0));\n  p.alpha.fillStyle = burnt; p.alpha.fill(disc(cx, cy, S * 0.48));\n  for (let k = 0; k < 40; k++) {\n    const a = R() * 6.28, r = S * (0.22 + R() * 0.24);\n    const path = new Path2D();\n    path.moveTo(cx, cy); path.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);\n    p.stroke(path, { alpha: grey(80 + R() * 100) }, 1 + R() * 3);\n  }\n}\n\n/* A kind's four variants as textures: the colour with how much of it shows, the relief as a\n   normal map (`relief`: how steep a slope of the height comes out) and, for metal, roughness\n   and metalness (green and blue). */\nfunction decalSet(paint, seed, ground, relief, bare = false) {\n  const S = CELL * 2, n = S * S, R = rng(seed);\n  const p = painter(S, ground, bare);\n  for (let i = 0; i < 4; i++) {\n    const x = (i % 2) * CELL, y = (i >> 1) * CELL;\n    p.clip(x, y, CELL);\n    paint(p, R, x + CELL / 2, y + CELL / 2, CELL);\n    p.unclip();\n  }\n  const data = (g) => g.getImageData(0, 0, S, S).data;\n  const col = data(p.col), al = data(p.alpha), hd = data(p.height);\n  // the height softened a little (twice over three texels each way): from eight bits its\n  // slopes would come out in terraces\n  const h = new Float32Array(n), t = new Float32Array(n);\n  for (let i = 0; i < n; i++) h[i] = hd[i * 4] / 255;\n  for (let pass = 0; pass < 2; pass++) {\n    for (let y = 0; y < S; y++) {\n      const r = y * S;\n      for (let x = 0; x < S; x++) t[r + x] = (h[r + Math.max(0, x - 1)] + h[r + x] + h[r + Math.min(S - 1, x + 1)]) / 3;\n    }\n    for (let y = 0; y < S; y++) {\n      const a = Math.max(0, y - 1) * S, b = y * S, c = Math.min(S - 1, y + 1) * S;\n      for (let x = 0; x < S; x++) h[b + x] = (t[a + x] + t[b + x] + t[c + x]) / 3;\n    }\n  }\n  const rgba = new Uint8Array(n * 4), nrm = new Uint8Array(n * 4);\n  for (let y = 0; y < S; y++) {\n    const a = Math.max(0, y - 1) * S, b = y * S, c = Math.min(S - 1, y + 1) * S;\n    for (let x = 0; x < S; x++) {\n      const i = b + x, o = i * 4;\n      rgba[o] = col[o]; rgba[o + 1] = col[o + 1]; rgba[o + 2] = col[o + 2]; rgba[o + 3] = al[o];\n      // the texture's rows run up its v (no flip): a rise along them tilts the normal back down v\n      const dx = (h[b + Math.min(S - 1, x + 1)] - h[b + Math.max(0, x - 1)]) * relief, dy = (h[c + x] - h[a + x]) * relief;\n      const l = Math.hypot(dx, dy, 1);\n      nrm[o] = (0.5 - (0.5 * dx) / l) * 255; nrm[o + 1] = (0.5 - (0.5 * dy) / l) * 255; nrm[o + 2] = (0.5 + 0.5 / l) * 255; nrm[o + 3] = 255;\n    }\n  }\n  const tex = (d, color) => {\n    const tx = new THREE.DataTexture(d, S, S);\n    tx.colorSpace = color ? THREE.SRGBColorSpace : THREE.NoColorSpace;\n    tx.generateMipmaps = true;\n    tx.minFilter = THREE.LinearMipmapLinearFilter;\n    tx.magFilter = THREE.LinearFilter;\n    tx.anisotropy = 4;\n    tx.needsUpdate = true;\n    return tx;\n  };\n  const set = { map: tex(rgba, true), normalMap: tex(nrm, false), orm: null };\n  if (p.bare) {\n    // bare steel smooth and metal, the paint round it rough\n    const b = data(p.bare), orm = new Uint8Array(n * 4);\n    for (let i = 0; i < n; i++) { const k = b[i * 4] / 255; orm[i * 4 + 1] = (0.72 - 0.42 * k) * 255; orm[i * 4 + 2] = k * 255; orm[i * 4 + 3] = 255; }\n    set.orm = tex(orm, false);\n  }\n  return set;\n}\n\nfunction decalMaterial(set, shared) {\n  const mat = new THREE.MeshStandardMaterial({\n    map: set.map, normalMap: set.normalMap, roughness: 0.9, metalness: 0,\n    transparent: true, depthWrite: false,\n    polygonOffset: true, polygonOffsetFactor: -4, polygonOffsetUnits: -4,\n  });\n  if (set.orm) { mat.roughnessMap = mat.metalnessMap = set.orm; mat.roughness = mat.metalness = 1; }\n  mat.onBeforeCompile = (shader) => {\n    shader.uniforms.uWet = shared ? shared.wet : { value: 0 };\n    shader.vertexShader = shader.vertexShader\n      .replace('#include <common>', '#include <common>\\nattribute vec2 aCell;')\n      .replace('#include <uv_vertex>', `#include <uv_vertex>\n      // its variant: a quarter of the textures\n      #ifdef USE_MAP\n        vMapUv = vMapUv * 0.5 + aCell;\n      #endif\n      #ifdef USE_NORMALMAP\n        vNormalMapUv = vNormalMapUv * 0.5 + aCell;\n      #endif\n      #ifdef USE_ROUGHNESSMAP\n        vRoughnessMapUv = vRoughnessMapUv * 0.5 + aCell;\n      #endif\n      #ifdef USE_METALNESSMAP\n        vMetalnessMapUv = vMetalnessMapUv * 0.5 + aCell;\n      #endif`)\n      .replace('#include <project_vertex>', `#include <project_vertex>\n      mvPosition.xyz -= normalize(mvPosition.xyz) * min(${PULL.toFixed(3)}, length(mvPosition.xyz) * 0.2);\n      gl_Position = projectionMatrix * mvPosition;`);\n    shader.fragmentShader = shader.fragmentShader\n      .replace('#include <common>', '#include <common>\\nuniform float uWet;')\n      .replace('#include <map_fragment>', `#include <map_fragment>\n      // wet in the rain like what it is on, a little less (freshly broken)\n      diffuseColor.rgb *= mix(1.0, 0.75, uWet);`)\n      .replace('#include <roughnessmap_fragment>', `#include <roughnessmap_fragment>\n      roughnessFactor = mix(roughnessFactor, roughnessFactor * 0.6 + 0.08, uWet);`);\n    dimFillSpecular(shader);\n  };\n  return mat;\n}\n\nexport function createDecals({ max = 200, shared = null } = {}) {\n  const group = new THREE.Group();\n  group.name = 'decals';\n  const sets = {\n    stone: decalSet(stoneHole, 9151, 'rgb(150,143,131)', 18),\n    wood: decalSet(woodHole, 4243, 'rgb(158,124,84)', 22),\n    metal: decalSet(metalHole, 777, 'rgb(150,151,154)', 20, true),\n    splat: decalSet(mudSplat, 3301, 'rgb(44,35,26)', 14),\n    scorch: decalSet(scorchMark, 6, 'rgb(12,11,9)', 0),\n  };\n  const kinds = {};\n  for (const k in sets) {\n    const cap = k === 'scorch' ? 24 : max;\n    const geo = new THREE.PlaneGeometry(1, 1);\n    const cells = new THREE.InstancedBufferAttribute(new Float32Array(cap * 2), 2);\n    geo.setAttribute('aCell', cells);\n    const m = new THREE.InstancedMesh(geo, decalMaterial(sets[k], shared), cap);\n    m.count = 0;\n    m.frustumCulled = false;\n    m.renderOrder = 2;\n    m.receiveShadow = true;\n    group.add(m);\n    kinds[k] = { mesh: m, cells, cursor: 0, n: 0, cap };\n  }\n  const n = new THREE.Vector3(), up = new THREE.Vector3(), side = new THREE.Vector3();\n  const mtx = new THREE.Matrix4(), turn = new THREE.Matrix4();\n\n  /* A decal `size` across on a surface facing (nx, ny, nz): turned at random, or (along the\n     grain) with its up along the surface's. */\n  function add(kind, x, y, zz, nx, ny, nz, size, grain = false) {\n    const K = kinds[kind];\n    if (!K) return;\n    n.set(nx, ny, nz).normalize();\n    // its up: the world's laid on the surface (on a floor, any)\n    up.set(0, 1, 0).addScaledVector(n, -n.y);\n    if (up.lengthSq() < 0.04) up.set(1, 0, 0).addScaledVector(n, -n.x);\n    up.normalize();\n    side.crossVectors(up, n);\n    mtx.makeBasis(side, up, n).multiply(turn.makeRotationZ(grain ? (Math.random() - 0.5) * 0.4 : Math.random() * Math.PI * 2));\n    mtx.scale(side.set(size, size, 1));\n    mtx.setPosition(x + n.x * 0.012, y + n.y * 0.012, zz + n.z * 0.012);\n    K.mesh.setMatrixAt(K.cursor, mtx);\n    const v = Math.floor(Math.random() * 4);\n    K.cells.setXY(K.cursor, (v % 2) * 0.5, (v >> 1) * 0.5);\n    K.cursor = (K.cursor + 1) % K.cap;\n    K.n = Math.min(K.cap, K.n + 1);\n    K.mesh.count = K.n;\n    K.mesh.instanceMatrix.needsUpdate = true;\n    K.cells.needsUpdate = true;\n  }\n\n  /* A bullet impact by surface. */\n  function impact(x, y, zz, nx, ny, nz, surface) {\n    if (surface === 'water' || surface === 'foliage' || surface === 'flesh') return;\n    const r = Math.random();\n    if (surface === 'mud' || surface === 'grass' || surface === 'forest' || surface === 'dirt') add('splat', x, y, zz, nx, ny, nz, 0.3 + r * 0.22);\n    else if (surface === 'wood') add('wood', x, y, zz, nx, ny, nz, 0.17 + r * 0.08, true);\n    else if (surface === 'metal') add('metal', x, y, zz, nx, ny, nz, 0.12 + r * 0.05);\n    else add('stone', x, y, zz, nx, ny, nz, (surface === 'sandbag' ? 0.12 : 0.16) + r * 0.07);\n  }\n\n  function clear() { for (const K of Object.values(kinds)) { K.n = 0; K.cursor = 0; K.mesh.count = 0; } }\n\n  return { group, add, impact, clear };\n}\n'''\ns=s[:start]+new\nopen(p,'w').write(s)\nPY\nnode --check js/atmosphere.js && echo ok","description":"Rewrite decals with four variants per kind"},"caller":{"type":"direct"}}]}}
