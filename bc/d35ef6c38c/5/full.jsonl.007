 value under 0.25 means \"reflect here\". */\nexport function rng(seed) {\n  let s = seed >>> 0;\n  const next = () => {\n    s = (s + 0x6d2b79f5) >>> 0;\n    let t = s;\n    t = Math.imul(t ^ (t >>> 15), t | 1);\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n  next.range = (a, b) => a + (b - a) * next();\n  next.int = (a, b) => Math.floor(a + (b - a + 1) * next());\n  next.pick = (arr) => arr[Math.floor(next() * arr.length)];\nd4b284fd Add Hedgerow, a third-person WW2 shooter: Saint-Clair at dusk","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"26a46575-d05d-4077-ac01-d7a2f453428f","context":{"git_state":{"cwd":"REDACTED","root":null,"branch":null,"default_branch":null,"status":null,"visibility":{"origin":null,"push_remote":null,"remotes":[],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]},"error":"not_a_repo"},"live_cwd":"REDACTED","platform":"macos"}},"sourceToolAssistantUUID":"55fc1fb8-0ba1-4606-9902-549d5048d55d","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
