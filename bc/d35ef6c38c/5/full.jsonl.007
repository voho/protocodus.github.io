 (~120 ms).","+  Low/medium/high compile (70/113/113 programs). NOTE for player.js/ai.js: impact() API unchanged.","+"," Measured: the meadow grass costs ~5.8-9.5 ms on this headless GPU at high quality looking across"," the meadow (0.5 ms looking at the sky), and it scales with pixels (fragment-bound: shading the"," visible blades with all the scene's lights). Drawing the tufts near-to-far made no measurable"]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"4b9ca3ac-dfce-48f5-9a96-09955f3ff3f7","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","platform":"macos"}},"sourceToolAssistantUUID":"fa34005b-87bb-43f1-a4da-2ce359cb2dbf","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
