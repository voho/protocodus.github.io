od; not paint or metal, whose gloss would glitter with it), gone by 7 m\n        grainK = uGrain * (1.0 - smoothstep(3.0, 7.0, length(vViewPosition))) * smoothstep(0.55, 0.85, roughnessFactor);\n        if (grainK > 0.01) {\n          grainW = pow(abs(vWNormalM), vec3(4.0));\n          grainW /= dot(grainW, vec3(1.0));\n          grainX = texture2D(tGrain, vWPosM.zy);\n          grainY = texture2D(tGrain, vWPosM.xz);\n          grainZ = texture2D(tGrain, vWPosM.xy);\n          float g = grainX.a * grainW.x + grainY.a * grainW.y + grainZ.a * grainW.z;\n          diffuseColor.rgb *= mix(1.0, 0.7 + 0.6 * g, grainK);\n        }` : ''}\n        roughnessFactor = mix(roughnessFactor, ${foliage\"\"\")\nopen(p,'w').write(s)\nPY\nnode --check js/materials.js && grep -n \"grainK\" js/materials.js | head","description":"Move the grain block after the roughness lookup"},"caller":{"type":"direct"}}]}}
