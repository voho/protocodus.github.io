xture2D(tGrain, pg.xz), texture2D(tFabric, pf.xz), wool);","+          skZ = mix(texture2D(tGrain, pg.xy), texture2D(tFabric, pf.xy), wool);","+          float d = skX.a * skW.x + skY.a * skW.y + skZ.a * skW.z;","+          diffuseColor.rgb *= mix(1.0, mix(0.82 + 0.36 * d, 0.7 + 0.6 * d, wool), skK);","         }`)","         .replace('#include <opaque_fragment>', `#include <opaque_fragment>","         if (uSkinDebug > 0.5) gl_FragColor.rgb = mix(gl_FragColor.rgb, vec3(4.0, 0.0, 0.0), skinK);","         if (uSkinDebug > 1.5) gl_FragColor.rgb = mix(gl_FragColor.rgb, vec3(0.0, 4.0, 0.0), clothK);`)","         // wet wool darkens but does not turn glossy","         .replace('#include <metalnessmap_fragment>', `#include <metalnessmap_fragment>","-        roughnessFactor = max(roughnessFactor, 0.72 * clothK);`);","+        roughnessFactor = max(roughnessFactor, 0.72 * clothK);`)","+        .replace('#include <normal_fragment_maps>', `#include <normal_fragment_maps>","+        if (skK > 0.01) {","+          // each side's relief turned onto the surface by its coordinates' frame on the screen","+          float k = skK * mix(0.25, 0.7, step(skinK, clothK));","+          vec3 nX = cotangentFrame(normal, -vViewPosition, vSkP.zy) * normalize(vec3((skX.xy * 2.0 - 1.0) * k, 1.0));","+          vec3 nY = cotangentFrame(normal, -vViewPosition, vSkP.xz) * normalize(vec3((skY.xy * 2.0 - 1.0) * k, 1.0));","+          vec3 nZ = cotangentFrame(normal, -vViewPosition, vSkP.xy) * normalize(vec3((skZ.xy * 2.0 - 1.0) * k, 1.0));","+          normal = normalize(nX * skW.x + nY * skW.y + nZ * skW.z);","+        }`);","     }","     if (smoulder) {","       // round its fire, the charred wood and metal smoulders: glowing cracks in what is darkest,"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/materials.js"]}},"serverClassifierContext":{"request":"99269658-4e48-4af7-93a7-d18485e27192","context":{"git_state":{"cwd":"