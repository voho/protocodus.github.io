{"parentUuid":"3f2da584-ac66-4f51-9618-e12c596f5b01","isSidechain":false,"promptId":"6d5c0a1d-fdd5-4db0-8cbd-a5c82a0adcb7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WD2wchcrz6JcSmtqVg75VP","type":"tool_result","content":"138\t}`;\n139\t\n140\t// rain sheets: a full-screen triangle; the view ray of each pixel meets four cylinders round\n141\t// the eye, each carrying streaks one to two pixels wide on an angular grid (so they stay put as\n142\t// the view turns) that fall at the rain's speed and lean with its drift along the cylinder\n143\tconst SHEET_VERT = /* glsl */ `\n144\tvarying vec3 vRay;\n145\tvarying vec3 vProj;\n146\tvoid main() {\n147\t  vRay = transpose(mat3(viewMatrix)) * vec3(position.x / projectionMatrix[0][0], position.y / projectionMatrix[1][1], -1.0);\n148\t  vProj = vec3(projectionMatrix[2][2], projectionMatrix[3][2], projectionMatrix[1][1]);\n149\t  gl_Position = vec4(position.xy, 0.0, 1.0);\n150\t}`;\n151\t\n152\tconst SHEET_FRAG = /* glsl */ `\n153\t${GUST_GLSL}\n154\tuniform vec3 uColor, uVel, uSky;\n155\tuniform float uTime, uOpacity, uFlash, uFog;\n156\tuniform vec3 uLightPos[6];\n157\tuniform vec3 uLightCol[6];\n158\tuniform sampler2D tDepth;\n159\tuniform vec2 uScreen;\n160\tvarying vec3 vRay;\n161\tvarying vec3 vProj;\n162\tfloat sHash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\n163\tvoid main() {\n164\t  vec3 dir = normalize(vRay);\n165\t  float hd = length(dir.xz);\n166\t  if (hd < 0.08) discard;\n167\t  // the scene's depth along this ray (view-space z, as the rain's own occlusion test)\n168\t  float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;\n169\t  float sceneZ = vProj.y / (zd + vProj.x);\n170\t  vec3 fwd = -vec3(viewMatrix[0][2], viewMatrix[1][2], viewMatrix[2][2]);\n171\t  float cosF = dot(dir, fwd);\n172\t  float theta = atan(dir.z, dir.x);\n173\t  vec3 tang = vec3(-sin(theta), 0.0, cos(theta));\n174\t  float vt = dot(uVel.xz, tang.xz), fall = -uVel.y;\n175\t  float pxPerRad = vProj.z * 0.5 / uScreen.y;\n176\t  vec3 sum = vec3(0.0);\n177\t  float alpha = 0.0;\n178\t  for (int i = 0; i < 4; i++) {\n179\t    float fi = float(i);\n180\t    float r = 14.0 * pow(1.6, fi);                       // 14, 22, 36, 57 m\n181\t    float t = r / hd;\n182\t    vec3 P = cameraPosition + dir * t;\n183\t    float vis = smoothstep(0.0, 2.0, sceneZ - t * cosF);  // hidden behind what is nearer\n184\t    vis *= 1.0 - smoothstep(14.0, 30.0, P.y - cameraPosition.y);\n185\t    if (vis <= 0.0) continue;\n186\t    // angular cells about five pixels wide, a whole number of them round the circle\n187\t    float n = floor(6.2832 * pxPerRad / 5.0);\n188\t    float dth = 6.2832 / n;\n189\t    float U = (theta + P.y * vt / (fall * r)) / dth;\n190\t    float len = 0.9 + 0.5 * fi;                          // longer streaks further off\n191\t    float V = (P.y + uTime * fall) / 2.4;\n192\t    vec2 id = mod(floor(vec2(U, V)), vec2(n, 4096.0)) + fi * 17.0;     // seamless round the circle\n193\t    vec2 f = fract(vec2(U, V));\n194\t    if (sHash(id) > 0.22) continue;\n195\t    float x0 = 0.25 + 0.5 * sHash(id + 3.7), y0 = 0.7 * sHash(id + 7.1);\n196\t    float sx = 1.0 - smoothstep(0.4, 1.0, abs(f.x - x0) * 5.0);\n197\t    float sy = smoothstep(y0, y0 + 0.04, f.y) * smoothstep(y0 + len / 2.4, y0 + len / 2.4 - 0.08, f.y);\n198\t    float k = sx * sy * vis * exp(-t * uFog) * (0.6 + 0.8 * sHash(id + 11.3));\n199\t    if (k <= 0.0) continue;\n200\t    k *= gust(P.xz, uTime, uVel.xz);       // only on a streak: it is the dearest part\n201\t    // lit by the lamps near it\n202\t    vec3 lit = uSky;\n203\t    for (int j = 0; j < 6; j++) {\n204\t      vec3 d = P - uLightPos[j];\n205\t      lit += uLightCol[j] / (1.0 + dot(d, d) * 0.12);\n206\t    }\n207\t    // seen by the light they catch: faint in the dark, bright by a lamp or a fire\n208\t    sum += (uColor * (0.3 + uFlash * 3.0) + lit * 2.0) * k;\n209\t    alpha += k;\n210\t  }\n211\t  if (alpha <= 0.001) discard;\n212\t  gl_FragColor = vec4(sum / alpha, min(alpha * uOpacity, 0.8));\n213\t}`;\n214\t\n215\t// the crowns: a quad standing on each young splash near the eye, droplets flung up and out\n216\t// along their arcs worked out in it (never under a pixel and a half)\n217\tconst CROWN_VERT = /* glsl */ `"}]},"uuid":"560b576a-a37a-417f-bbb8-c018b47cab76","timestamp":"2026-10-21T22:57:41.472Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/weather.js","content":"}`;\n\n// rain sheets: a full-screen triangle; the view ray of each pixel meets four cylinders round\n// the eye, each carrying streaks one to two pixels wide on an angular grid (so they stay put as\n// the view turns) that fall at the rain's speed and lean with its drift along the cylinder\nconst SHEET_VERT = /* glsl */ `\nvarying vec3 vRay;\nvarying vec3 vProj;\nvoid main() {\n  vRay = transpose(mat3(viewMatrix)) * vec3(position.x / projectionMatrix[0][0], position.y / projectionMatrix[1][1], -1.0);\n  vProj = vec3(projectionMatrix[2][2], projectionMatrix[3][2], projectionMatrix[1][1]);\n  gl_Position = vec4(position.xy, 0.0, 1.0);\n}`;\n\nconst SHEET_FRAG = /* glsl */ `\n${GUST_GLSL}\nuniform vec3 uColor, uVel, uSky;\nuniform float uTime, uOpacity, uFlash, uFog;\nuniform vec3 uLightPos[6];\nuniform vec3 uLightCol[6];\nuniform sampler2D tDepth;\nuniform vec2 uScreen;\nvarying vec3 vRay;\nvarying vec3 vProj;\nfloat sHash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nvoid main() {\n  vec3 dir = normalize(vRay);\n  float hd = length(dir.xz);\n  if (hd < 0.08) discard;\n  // the scene's depth along this ray (view-space z, as the rain's own occlusion test)\n  float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;\n  float sceneZ = vProj.y / (zd + vProj.x);\n  vec3 fwd = -vec3(viewMatrix[0][2], viewMatrix[1][2], viewMatrix[2][2]);\n  float cosF = dot(dir, fwd);\n  float theta = atan(dir.z, dir.x);\n  vec3 tang = vec3(-sin(theta), 0.0, cos(theta));\n  float vt = dot(uVel.xz, tang.xz), fall = -uVel.y;\n  float pxPerRad = vProj.z * 0.5 / uScreen.y;\n  vec3 sum = vec3(0.0);\n  float alpha = 0.0;\n  for (int i = 0; i < 4; i++) {\n    float fi = float(i);\n    float r = 14.0 * pow(1.6, fi);                       // 14, 22, 36, 57 m\n    float t = r / hd;\n    vec3 P = cameraPosition + dir * t;\n    float vis = smoothstep(0.0, 2.0, sceneZ - t * cosF);  // hidden behind what is nearer\n    vis *= 1.0 - smoothstep(14.0, 30.0, P.y - cameraPosition.y);\n    if (vis <= 0.0) continue;\n    // angular cells about five pixels wide, a whole number of them round the circle\n    float n = floor(6.2832 * pxPerRad / 5.0);\n    float dth = 6.2832 / n;\n    float U = (theta + P.y * vt / (fall * r)) / dth;\n    float len = 0.9 + 0.5 * fi;                          // longer streaks further off\n    float V = (P.y + uTime * fall) / 2.4;\n    vec2 id = mod(floor(vec2(U, V)), vec2(n, 4096.0)) + fi * 17.0;     // seamless round the circle\n    vec2 f = fract(vec2(U, V));\n    if (sHash(id) > 0.22) continue;\n    float x0 = 0.25 + 0.5 * sHash(id + 3.7), y0 = 0.7 * sHash(id + 7.1);\n    float sx = 1.0 - smoothstep(0.4, 1.0, abs(f.x - x0) * 5.0);\n    float sy = smoothstep(y0, y0 + 0.04, f.y) * smoothstep(y0 + len / 2.4, y0 + len / 2.4 - 0.08, f.y);\n    float k = sx * sy * vis * exp(-t * uFog) * (0.6 + 0.8 * sHash(id + 11.3));\n    if (k <= 0.0) continue;\n    k *= gust(P.xz, uTime, uVel.xz);       // only on a streak: it is the dearest part\n    // lit by the lamps near it\n    vec3 lit = uSky;\n    for (int j = 0; j < 6; j++) {\n      vec3 d = P - uLightPos[j];\n      lit += uLightCol[j] / (1.0 + dot(d, d) * 0.12);\n    }\n    // seen by the light they catch: faint in the dark, bright by a lamp or a fire\n    sum += (uColor * (0.3 + uFlash * 3.0) + lit * 2.0) * k;\n    alpha += k;\n  }\n  if (alpha <= 0.001) discard;\n  gl_FragColor = vec4(sum / alpha, min(alpha * uOpacity, 0.8));\n}`;\n\n// the crowns: a quad standing on each young splash near the eye, droplets flung up and out\n// along their arcs worked out in it (never under a pixel and a half)\nconst CROWN_VERT = /* glsl */ `","numLines":80,"startLine":138,"totalLines":559}},"sourceToolAssistantUUID":"3f2da584-ac66-4f51-9618-e12c596f5b01","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
