int) * 0.7);`)","         .replace('#include <lights_physical_pars_fragment>', `#include <lights_physical_pars_fragment>","         uniform float uLeafTrans;","         float leafThin = 1.0;          // how thin the foliage is here (its baked occlusion, squared)"]},{"oldStart":675,"oldLines":7,"newStart":689,"newLines":9,"lines":["         #endif","         #include <lights_fragment_begin>`)","         .replace('#include <lights_fragment_end>', `#include <lights_fragment_end>","-        reflectedLight.indirectDiffuse += diffuseColor.rgb * 0.12;`)","+        // light from the sky through the leaves round it: as much as the foliage is thin there (not","+        // in a crown's dark heart, nor in a fern or a tussock low in its own shade)","+        reflectedLight.indirectDiffuse += diffuseColor.rgb * 0.12 * leafThin;`)","         .replace('float faceDirection = gl_FrontFacing ? 1.0 : - 1.0;', 'float faceDirection = 1.0;');","     }","     if (!glints) dimFillSpecular(shader);"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/materials.js"]}},"serverClassifierContext":{"request":"8ae0a087-9b51-4097-a1ad-7cfe6c0c2b41","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-gr