ding some 0.3 m/s as it dies away; the slope, as a direction and strength. Each ring\n+  // is a few centimetres wide: beyond some 15 m smaller than a pixel, where it would only glitter, so\n+  // fade (from 1 near to 0 far) thins them out, and at 0 the work is skipped\n+  vec2 rainRipples(vec2 p, float t, float fade) {\n     vec2 acc = vec2(0.0);\n+    if (fade < 0.01) return acc;\n+    p *= 2.4;\n     for (int k = 0; k < 2; k++) {\n       vec2 q = p + float(k) * vec2(0.37, 0.71);\n       vec2 cell = floor(q);\n@@ -417,7 +423,7 @@ export const GLSL_HELPERS = /* glsl */ `\n         vec2 c = cell + vec2(float(i), float(j));\n         float h = hash12(c + float(k) * 13.1);\n         vec2 centre = c + vec2(hash12(c + 3.7), hash12(c + 9.1));\n-        float phase = fract(t * 0.9 + h);\n+        float phase = fract(t * 1.3 + h);\n         vec2 d = q - centre;\n         float r = length(d);\n         float ring = r - phase * 0.9;\n@@ -425,6 +431,8 @@ export const GLSL_HELPERS = /* glsl */ `\n         acc += d / max(r, 1e-3) * wave;\n       }\n     }\n-    return acc * 0.5;\n+    return acc * 0.5 * fade;\n   }\n+  // how much of the rain's rings to draw at a view distance\n+  float rippleFade(float dist) { return 1.0 - smoothstep(8.0, 16.0, dist); }\n `;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"b8544427-6c9e-42b3-9769-3e3b5f04329e","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":6,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.git