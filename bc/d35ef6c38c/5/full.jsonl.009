]},{"oldStart":658,"oldLines":6,"newStart":667,"newLines":18,"lines":["         cell: CELLS.smoke, drag: 1.8, gravity: -0.25, rot: R() * 6, rotV: (R() - 0.5) * 0.6, fadeIn: 0.1,","       });","     }","+    // what is left of it: a few big puffs that hang over the place and drift off downwind,","+    // thinning, for a quarter of a minute","+    if (!water) for (let k = 0; k < 4; k++) {","+      const a = R() * 6.28;","+      alpha.spawn({","+        x: x + Math.cos(a) * 1.5 * scale, y: y + 1 + R() * 1.5, z: z + Math.sin(a) * 1.5 * scale,","+        vx: Math.cos(a) * 0.6, vy: 0.25 + R() * 0.3, vz: Math.sin(a) * 0.6,","+        life: 12 + R() * 8, size: 3 * scale, size1: (9 + R() * 5) * scale,","+        color: C('#47423c', 0.32), color1: C('#3b3834', 0), cell: CELLS.smoke, drag: 0.5, ride: 0.6, swirl: 0.25,","+        rot: R() * 6, rotV: (R() - 0.5) * 0.15, fadeIn: 1.2,","+      });","+    }","     // the column of earth (or water) the blast throws up, falling back:","     // clods and spray stretched along their flight, fanning out a little","     for (let k = 0; k < 16; k++) {"]},{"oldStart":770,"oldLines":11,"newStart":791,"newLines":50,"lines":["     alpha.spawn({ x, y, z, vx: dx * 2 + (R() - 0.5), vy: 2 + R(), vz: dz * 2 + (R() - 0.5), life: 0.9, size: 0.02, color: C('#c8a050', 1, 1.2), color1: C('#c8a050', 1), cell: CELLS.chunk, gravity: 9.8, rot: R() * 6, rotV: 25 });","   }"," ","+  /* a fresh crater smoulders: thin smoke curling up out of it and carried off on the wind, less and","+     less of it for SMOULDER seconds, and for the first few the embers of what burned in it glowing up","+     (the wet ground soon puts them out) */","+  function smoulder(dt) {","+    for (let i = craters.length - 1; i >= 0; i--) {","+      const c = craters[i];","+      c.age += dt;","+      if (c.age >= SMOULDER) { craters.splice(i, 1); continue; }","+      const left = 1 - c.age / SMOULDER;","+      c.smoke += dt;","+      const every = 0.3 + (1 - left) * 0.9;","+      while (c.smoke >= every) {","+        c.smoke -= every;","+        const a = R() * 6.28, r = R() * 0.7 * c.scale;","+        alpha.spawn({","+          x: c.x + Math.cos(a) * r, y: c.y + 0.1, z: c.z + Math.sin(a) * r,","+          vx: (R() - 0.5) * 0.3, vy: 0.4 + R() * 0.4, vz: (R() - 0.5) * 0.3,","+          life: 6 + R() * 4, size: 0.4 * c.scale, size1: (2.6 + R() * 1.6) * c.scale,","+          color: C('#423e39', 0.3 * left ** 1.3), color1: C('#35322e', 0), cell: CELLS.smoke,","+          drag: 0.8, ride: 0.7, swirl: 0.6, gravity: -0.04, rot: R() * 6, rotV: (R() - 0.5) * 0.4, fadeIn: 0.6,","+        });","+      }","+      if (c.age < 4) {","+        c.ember += dt * (1 - c.age / 4) * 9 * c.scale;","+        while (c.ember >= 1) {","+          c.ember -= 1;","+          const a = R() * 6.28, r = R() * 0.6 * c.scale;","+          add.spawn({","+            x: c.x + Math.cos(a) * r, y: c.y + 0.05, z: c.z + Math.sin(a) * r,","+            vx: (R() - 0.5) * 0.4, vy: 0.4 + R() * 1.2, vz: (R() - 0.5) * 0.4,","+            life: 0.4 + R() * 0.8, size: 0.02, color: C('#ffb060', 1, 2.2), color1: C('#ff4010', 0, 0.8),","+            cell: CELLS.spark, ride: 0.4, swirl: 1.2, drag: 1.2, gravity: -0.3,","+          });","+        }","+      }","+    }","+  }","+","   function update(dt, wind, camPos) {","     for (let i = blasts.length - 1; i >= 0; i--) {","       blasts[i].age += dt;","       if (blasts[i].age >= 1.6) blasts.splice(i, 1);","     }","+    smoulder(dt);","     for (let i = shocks.length - 1; i >= 0; i--) {","       const s = shocks[i];","       s.age += dt;"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/effects.js"]}},"serverClassifierContext":{"request":"00d679fc-db78-4c7a-b8fb-26c11eee1592","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","bran