RT, fragmentShader: SHELL_FRAG, uniforms: shellUniforms,\n    transparent: true, depthWrite: false, side: THREE.DoubleSide, fog: false,\n  }));\n  shell.frustumCulled = false;\n  shell.renderOrder = 4;\n  shell.visible = false;\n  // its streaks as many pixels wide as the sheets': the frame's own size\n  const frame = new THREE.Vector2();\n  shell.onBeforeRender = (renderer) => { renderer.getDrawingBufferSize(frame); shellUniforms.uScreen.value.set(1 / frame.x, 1 / frame.y); };\n  group.add(shell);\n\"\"\"\nassert old in s; s=s.replace(old,new)\nold=\"\"\"    sheetsOn = !!(scene && depth);\n    sheets.visible = sheetsOn && geo.instanceCount > 0;\n  }\"\"\"\nnew=\"\"\"    sheetsOn = !!(scene && depth);\n    sheets.visible = sheetsOn && geo.instanceCount > 0;\n    shell.visible = !sheetsOn && geo.instanceCount > 0;\n  }\"\"\"\nassert old in s; s=s.replace(old,new)\nold=\"\"\"    setCount(n) { geo.instanceCount = Math.min(n, count); sheets.visible = sheetsOn && n > 0; },\"\"\"\nnew=\"\"\"    setCount(n) { geo.instanceCount = Math.min(n, count); sheets.visible = sheetsOn && n > 0; shell.visible = !sheetsOn && n > 0; },\"\"\"\nassert old in s; s=s.replace(old,new)\nold=\"\"\"   to ~60 m, sheets of rain: four cylinders round the eye, worked out per\n   pixel in one full-screen draw, each with streaks falling at the rain's\n   speed and slant, hidden behind what is nearer, lit by the lamps near\n   them and fading into the haze.\"\"\"\nnew=\"\"\"   to ~60 m, sheets of rain: four cylinders round the eye, worked out per\n   pixel in one full-screen draw (or, without the late pass's depth on low\n   quality, drawn as four cylinder meshes with the scene), each with streaks\n   falling at the rain's speed and slant, hidden behind what is nearer, lit\n   by the lamps near them and fading into the haze.\"\"\"\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\nEOF\ncp js/weather.js $TMPDIR/chk_w.mjs && node --check $TMPDIR/chk_w.mjs && echo syntax-ok; rm -f $TMPDIR/chk_