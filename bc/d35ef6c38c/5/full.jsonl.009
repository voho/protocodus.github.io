ommon>\n        uniform float uPorosity, uWet, uTime, uRain;\n        uniform sampler2D tDetail;\n        varying vec3 vWNormalM;\n        varying vec2 vDetailUv;\n        varying vec3 vWPosM;\n        float mWetUp;\n        ${bark ? `uniform sampler2D tBark;\n        uniform float uBark, uMoss;\n        varying vec3 vBarkP, vBarkN;\n        varying float vBarkH;\n        vec4 barkA, barkB;\n        float barkK, barkW;` : ''}\n        ${streaks ? 'float mRiv, mRivX;\\n        vec3 mRivT;' : ''}\n        ${rooms ? 'varying vec4 vWin;' : ''}\n        ${grain ? `uniform sampler2D tGrain;\n        uniform float uGrain;\n        float grainK = 0.0, grainN = 0.0;\n        vec3 grainW = vec3(0.0);\n        vec4 grainX, grainY, grainZ;` : ''}\n        ${GLSL_HELPERS}\n        ${rooms ? ROOMS_GLSL : ''}`)\n      .replace('#include <map_fragment>', `#include <map_fragment>\n        ${bark ? `{\n          // close up, the bark's furrows and plates (the baked texture is stretched thin over a\n          // big trunk): seen from two sides of the trunk, blended by which way it faces; none on\n580:        .replace('#include <metalnessmap_fragment>', `#include <metalnessmap_fragment>\n143:export const GRAIN_UNIFORMS = { tGrain: { value: null }, uGrain: { value: 1 } };\n148:function grainTexture(S = 512) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"3f6f8482-8ae7-406a-b359-dc3474f22c86","context":{"git_state":{"cwd":"REDACTED","root":null,"branch":null,"default_branch":null,"status":null,"visibility":{"origin":null,"push_remote":null,"remotes":[],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]},"error":"not_a_repo"},"live_cwd":"REDACTED","platform":"macos"}},"sourceToolAssistantUUID":"a529abdd-72c0-43d3-959a-be653748002f","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd