, bright by a lamp or a fire","+    sum += (uColor * (0.3 + uFlash * 3.0) + lit * 2.0) * k;","     alpha += k;","   }","   if (alpha <= 0.001) discard;"]},{"oldStart":226,"oldLines":7,"newStart":227,"newLines":7,"lines":["   const sheetUniforms = {","     uColor: rainUniforms.uColor, uVel: rainUniforms.uVel, uTime: rainUniforms.uTime, uFlash: rainUniforms.uFlash,","     uLightPos: rainUniforms.uLightPos, uLightCol: rainUniforms.uLightCol,","-    uOpacity: { value: 0.3 }, uFog: { value: 0.012 },","+    uOpacity: { value: 0.16 }, uFog: { value: 0.012 },","     tDepth: { value: null }, uScreen: { value: new THREE.Vector2(1, 1) },","   };","   const sheets = new THREE.Mesh(tri, new THREE.ShaderMaterial({"]},{"oldStart":284,"oldLines":7,"newStart":285,"newLines":7,"lines":["     rainUniforms.uTime.value = time;","     rainUniforms.uCam.value.copy(camera.position);","     rainUniforms.uOpacity.value = 0.2 * rainAmount;","-    sheetUniforms.uOpacity.value = 0.3 * rainAmount;","+    sheetUniforms.uOpacity.value = 0.16 * rainAmount;","     splashUniforms.uTime.value = time;"," ","     // splashes around the camera"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/weather.js"]}},"serverClassifierContext":{"request":"2a71a3d2-e384-48bb-b093-43cf8428d530","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protoc