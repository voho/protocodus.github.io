m;","+uniform vec4 uFires[6];"," varying vec3 vDir;"," "," float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }"]},{"oldStart":101,"oldLines":15,"newStart":104,"newLines":36,"lines":["   float g = max(dot(normalize(vec3(d.x, 0.0, d.z)), uGlowDir), 0.0);","   float band = exp(-max(el, 0.0) * 9.0) * pow(g, 3.0);","   col += uGlow * band * 0.9;","-  // cloud deck projected on a plane","+  // cloud deck projected on a plane (uv: where the view meets it, in units of its height","+  // over the eye), rolled and billowed by noise warped by itself, slowly churning","   vec2 uv = d.xz / (max(el, 0.0) + 0.12);","   vec2 drift = uWind * uTime * 0.004;","-  float c1 = fbm(uv * 0.55 + drift);","-  float c2 = fbm(uv * 1.3 - drift * 1.7 + 4.0);","-  float cloud = smoothstep(0.35, 0.8, c1 * 0.7 + c2 * 0.45);","+  vec2 q = uv * 0.55 + drift;","+  vec2 w = vec2(fbm(q * 0.8 + vec2(3.1, 1.7) + uTime * 0.003), fbm(q * 0.8 + vec2(-2.3, 5.9) - uTime * 0.002)) - 0.5;","+  float c1 = fbm(q + w * 1.6);","+  float c2 = fbm(uv * 1.3 - drift * 1.7 + 4.0 + w * 0.8);","+  float dens = c1 * 0.7 + c2 * 0.45;","+  float cloud = smoothstep(0.35, 0.8, dens);","+  float belly = smoothstep(0.5, 0.95, dens);","   vec3 dark = uZenith * 0.55;","   vec3 lit = mix(uHorizon * 1.15, uGlow * 0.6 + uHorizon * 0.7, band * 1.5);","-  col = mix(col, mix(dark, lit, c2), cloud * smoothstep(0.06, 0.4, el));","+  float deck = smoothstep(0.06, 0.4, el);","+  col = mix(col, mix(dark, lit, c2), cloud * deck);","+  // the burning farms light the cloud base over them (taken 320 m up), the thick bellies","+  // most, flickering with the flames","+  vec2 P = uCam.xz + uv * 320.0;","+  float fire = 0.0;","+  for (int i = 0; i < 6; i++) {","+    vec4 f = uFires[i];","+    if (f.z <= 0.0) continue;","+    vec2 dp = P - f.xy;","+    float r2 = dot(dp, dp) + 102400.0;","+    fire += f.z * (0.8 + 0.2 * sin(uTime * 6.3 + f.w) * sin(uTime * 2.9 + f.w * 1.7)) * 320.0 / (r2 * sqrt(r2));","+  }","+  col += vec3(1.0, 0.42, 0.14) * fire * 2200.0 * cloud * (0.35 + 0.65 * belly) * smoothstep(0.02, 0.2, el);","+  // the far barrage's flashes catch the cloud over the horizon","+  float ad0 = max(dot(normalize(vec3(d.x, 0.0, d.z)), uArtyDir), 0.0);","+  col += vec3(1.0, 0.6, 0.3) * uArty * pow(ad0, 5.0) * exp(-max(el, 0.0) * 4.0) * cloud * 0.12;","   // lightning: a bright patch inside the clouds plus a general lift","   float fd = max(dot(d, uFlashDir), 0.0);","   col += vec3(0.75, 0.8, 1.0) * uFlash * (0.25 + 1.6 * pow(fd, 6.0) * (0.4 + cloud));"]},{"oldStart":144,"oldLines":7,"newStart":168,"newLines":10,"lines":["     uFlare: { value: 0 },","     uFlareDir: { value: new THREE.Vector3(0, 0.6, 0.8) },","     uFront: { value: 1 },","+    uCam: { value: new THREE.Vector3() },","+    uFires: { value: Array.from({ length: 6 }, () => new THREE.Vector4()) },","   };","+  let fires = null;","   const mat = new THREE.ShaderMaterial({","     vertexShader: VERT, fragmentShader: FRAG, uniforms,","     side: THREE.BackSide, depthWrite: false, fog: false,"]},{"oldStart":155,"oldLines":8,"newStart":182,"newLines":15,"lines":["   mesh.renderOrder = -10;","   return {","     mesh, uniforms,","+    /* the fires whose glow the cloud carries (effects.js addFire records: x, z, size, on) */","+    setFires(list) { fires = list; },","     update(dt, time, camera, flash, flashDir) {","       mesh.position.copy(camera.position);","+      uniforms.uCam.value.copy(camera.position);","+      if (fires) uniforms.uFires.value.forEach((v, i) => {","+        const f = fires[i];","+        v.set(f?.x || 0, f?.z || 0, f && f.on !== false ? f.size : 0, i * 2.3);","+      });","       uniforms.uTime.value = time;","       uniforms.uFlash.value = flash;","       if (flashDir) uniforms.uFlashDir.value.copy(flashDir);"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/sky.js"]}},"serverClassifierContext":{"request":"cc557487-a4eb-4f8a-993