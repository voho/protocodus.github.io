 exposure follows it over time, quickly when it brightens,","+   slowly when it darkens, within a narrow range about the level the night","+   was graded at, so a flare overhead or a blast close by dazzles and then","+   settles instead of burning the scene out white. */"," "," import * as THREE from 'three';"," "]},{"oldStart":12,"oldLines":9,"newStart":19,"newLines":50,"lines":[" varying vec2 vUv;"," void main() { vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }`;"," ","-const FRAG = /* glsl */ `","+// the frame's log luminance in 128 x 64 blocks (16 samples each), weighted to the middle","+const LUM = /* glsl */ `"," uniform sampler2D tSrc;","+varying vec2 vUv;","+void main() {","+  float s = 0.0;","+  for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {","+    vec3 c = texture2D(tSrc, vUv + (vec2(float(x), float(y)) - 1.5) * vec2(1.0 / 512.0, 1.0 / 256.0)).rgb;","+    s += log2(max(dot(c, vec3(0.2126, 0.7152, 0.0722)), 1e-4));","+  }","+  float w = 1.0 - 0.7 * smoothstep(0.0, 0.55, length((vUv - 0.5) * vec2(1.6, 1.0)));","+  gl_FragColor = vec4(s / 16.0 * w, w, 0.0, 1.0);","+}`;","+","+// sums blocks of texels: 128 x 64 -> 16 x 8 (8 x 8 each), then 16 x 8 -> 1 (the weighted mean)","+const SUM = /* glsl */ `","+uniform sampler2D tSrc;","+uniform ivec2 uBlock;","+uniform bool uMean;","+void main() {","+  ivec2 base = ivec2(gl_FragCoord.xy) * uBlock;","+  vec2 s = vec2(0.0);","+  for (int y = 0; y < 8; y++) for (int x = 0; x < 16; x++) {","+    if (x >= uBlock.x || y >= uBlock.y) continue;","+    s += texelFetch(tSrc, base + ivec2(x, y), 0).rg;","+  }","+  gl_FragColor = uMean ? vec4(s.x / max(s.y, 1e-4), 1.0, 0.0, 1.0) : vec4(s, 0.0, 1.0);","+}`;","+","+// the eye: follows the measured level, faster towards brighter","+const ADAPT = /* glsl */ `","+uniform sampler2D tMeasured, tPrev;","+uniform float uDt, uReset;","+void main() {","+  float m = texelFetch(tMeasured, ivec2(0), 0).r;","+  float a = texelFetch(tPrev, ivec2(0), 0).r;","+  float rate = m > a ? 2.2 : 0.6;","+  gl_FragColor = vec4(uReset > 0.5 ? m : a + (m - a) * (1.0 - exp(-uDt * rate)), 0.0, 0.0, 1.0);","+}`;","+","+const FRAG = /* glsl */ `","+uniform sampler2D tSrc, tAdapt;"," uniform float uTime, uHurt, uFlash, uSat, uGrain, uAspect, uSharp, uContrast;","+uniform float uKey, uUp, uDown;"," uniform vec2 uTexel;"," varying vec2 vUv;"," float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }"]},{"oldStart":33,"oldLines":6,"newStart":81,"newLines":8,"lines":["   col.r += texture2D(tSrc, vUv + c * ca).r - c0.r;","   col.b += texture2D(tSrc, vUv - c * ca).b - c0.b;","   col = max(col, 0.0);","+  // the eye's adaptation: up to uUp stops brighter in the dark, uDown stops darker in a glare","+  col *= exp2(clamp(uKey - texture2D(tAdapt, vec2(0.5)).r, -uDown, uUp));","   // an S-curve about mid grey (in linear light: a power on the ratio to 0.18)","   col = 0.18 * pow(col / 0.18, vec3(uContrast));","   float l = dot(col, vec3(0.2126, 0.7152, 0.0722));"]},{"oldStart":68,"oldLines":10,"newStart":118,"newLines":53,"lines":["   const quad = new THREE.Mesh(geometry, material);","   quad.frustumCulled = false;","   const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);","+","+  // the eye","+  const small = (w, h) => new THREE.WebGLRenderTarget(w, h, { type: THREE.HalfFloatType, depthBuffer: false, minFilter: THREE.NearestFilter, magFilter: THREE.NearestFilter });","+  const lum = small(128, 64), part = small(16, 8), measured = small(1, 1);","+  let adapt = [small(1, 1), small(1, 1)];","+  const pass = (frag, uniforms) => {","+    const m = new THREE.Mesh(geometry, new THREE.ShaderMaterial({ vertexShader: VERT, fragmentShader: frag, uniforms, depthTest: false, depthWrite: false, toneMapped: false }));","+    m.frustumCulled = false;","+    return m;","+  };","+  const lumQ = pass(LUM, { tSrc: { value: null } });","+  const sumU = { tSrc: { value: null }, uBlock: { value: new THREE.Vector2() }, uMean: { value: false } };","+  const sumQ = pass(SUM, sumU);","+  const adaptU = { tMeasured: { value: measured.texture }, tPrev: { value: null }, uDt: { value: 0 }, uReset: { value: 1 } };","+  const adaptQ = pass(ADAPT, adaptU);","+  Object.assign(material.uniforms, {","+    tAdapt: { value: null }, uKey: { value: -4.6 }, uUp: { value: 0.35 }, uDown: { value: 1.6 },","+  });","+  let last = 0;","+  function measure(renderer, src) {","+    const now = performance.now();","+    adaptU.uDt.value = last ? Math.min((now - last) / 1000, 0.1) : 0;","+    last = now;","+    lumQ.material.uniforms.tSrc.value = src;","+    renderer.setRenderTarget(lum);","+    renderer.render(lumQ, camera);","+    sumU.tSrc.value = lum.texture; sumU.uBlock.value.set(8, 8); sumU.uMean.value = false;","+    renderer.setRenderTarget(part);","+    renderer.render(sumQ, camera);","+    sumU.tSrc.value = part.texture; sumU.uBlock.value.set(16, 8); sumU.uMean.value = true;","+    renderer.setRenderTarget(measured);","+    renderer.render(sumQ, camera);","+    adaptU.tPrev.value = adapt[0].texture;","+    renderer.setRenderTarget(adapt[1]);","+    renderer.render(adaptQ, camera);","+    adaptU.uReset.value = 0;","+    adapt = [adapt[1], adapt[0]];","+    material.uniforms.tAdapt.value = adapt[0].texture;","+  }","+","   return {","     enabled: true, needsSwap: true, uniforms: material.uniforms,","+    /* the eye's level and the frame's (log2 luminance), for checking */","+    adaptation: { measured, get adapted() { return adapt[0]; }, reset() { adaptU.uReset.value = 1; } },","     setSize(w, h) { material.uniforms.uAspect.value = w / Math.max(1, h); material.uniforms.uTexel.value.set(1 / w, 1 / h); },","     render(renderer, writeBuffer, readBuffer) {","+      measure(renderer, readBuffer.texture);","       material.uniforms.tSrc.value = readBuffer.texture;","       renderer.setRenderTarget(writeBuffer);","       renderer.render(quad, camera);"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/post.js"]}},"serverClassifierContext":{"request":"cb94ac21-f500-4205-83c9-d5cc84184df0","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"9ae7ab6e-fd89-40cf-9075-6c4be910d80f","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
