 body;","   // smoke where it has cooled: dark, lit by the fire still in it, the night, a flare, lightning","   float smoke = body * smoothstep(0.06, 0.45, t) * (1.0 - smoothstep(0.1, 0.5, heat));","-  vec3 smokeCol = vec3(0.075, 0.068, 0.06) * (0.35 + uSky * 0.7 + vec3(0.7, 0.75, 0.9) * uFlash)","+  vec3 smokeCol = vec3(0.1, 0.092, 0.082) * (0.35 + uSky * 0.7 + vec3(0.7, 0.75, 0.9) * uFlash)","     + fire * 0.25 * (1.0 - cool) * (0.4 + 0.6 * n1);","-  float a = (smoke * 0.85 + glow * 0.25) * fade;","+  float a = (smoke * 0.7 + glow * 0.25) * fade;","   vec3 col = fire * glow * uGain * (0.5 + 1.5 * (1.0 - cool)) * fade + smokeCol * smoke * fade;","   // drawn over the finished frame: hidden behind what is in front, soft where it meets it","   if (uSoft > 0.5) {"]},{"oldStart":91,"oldLines":7,"newStart":91,"newLines":7,"lines":["   gl_FragColor = vec4(col, a);"," }`;"," ","-export function createFireballs(effects, { gain = 2.2 } = {}) {","+export function createFireballs(effects, { gain = 1.3 } = {}) {","   const quad = new THREE.PlaneGeometry(2, 2);","   const geo = new THREE.InstancedBufferGeometry();","   geo.index = quad.index;"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/fireball.js"]}},"serverClassifierContext":{"request":"37ceef9d-a9b3-46f5-be69-6e4fc898bbc4","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github