g\nmcp__exchange-azure-reader__applens\nmcp__exchange-azure-reader__applicationinsights\nmcp__exchange-azure-reader__appservice\nmcp__exchange-azure-reader__arm\nmcp__exchange-azure-reader__azd\nmcp__exchange-azure-reader__azurebackup\nmcp__exchange-azure-reader__azuremigrate\nmcp__exchange-azure-reader__azureterraform\nmcp__exchange-azure-reader__azureterraformbestpractices\nmcp__exchange-azure-reader__bicepschema\nmcp__exchange-azure-reader__cloudarchitect\nmcp__exchange-azure-reader__communication\nmcp__exchange-azure-reader__compute\nmcp__exchange-azure-reader__confidentialledger\nmcp__exchange-azure-reader__containerapps\nmcp__exchange-azure-reader__cosmos\nmcp__exchange-azure-reader__datadog\nmcp__exchange-azure-reader__deploy\nmcp__exchange-azure-reader__deviceregistry\nmcp__exchange-azure-reader__documentation\nmcp__exchange-azure-reader__eventgrid\nmcp__exchange-azure-reader__eventhubs\nmcp__exchange-azure-reader__extension_azqr\nmcp__exchange-azure-reader__extension_cli_generate\nmcp__exchange-azure-reader__extension_cli_install\nmcp__exchange-azure-reader__fileshares\nmcp__exchange-azure-reader__foundry\nmcp__exchange-azure-reader__foundryextensions\nmcp__exchange-azure-reader__functionapp\nmcp__exchange-azure-reader__functions\nmcp__exchange-azure-reader__get_azure_bestpractices\nmcp__exchange-azure-reader__grafana\nmcp__exchange-azure-reader__group_list\nmcp__exchange-azure-reader__group_resource_list\nmcp__exchange-azure-reader__keyvault\nmcp__exchange-azure-reader__kusto\nmcp__exchange-azure-reader__loadtesting\nmcp__exchange-azure-reader__managedlustre\nmcp__exchange-azure-reader__marketplace\nmcp__exchange-azure-reader__monitor\nmcp__exchange-azure-reader__mysql\nmcp__exchange-azure-reader__policy\nmcp__exchange-azure-reader__postgres\nmcp__exchange-azure-reader__pricing\nmcp__exchange-azure-reader__quota\nmcp__exchange-azure-reader__redis\nmcp__exchange-azure-reader__resilience\nmcp__exchange-azure-reader__resourcehealth\nmcp__exchange-azure-reader__role\nmcp__exchange-azure-reader__search\nmcp__exchange-azure-reader__servicebus\nmcp__exchange-azure-reader__servicefabric\nmcp__exchange-azure-reader__signalr\nmcp__exchange-azure-reader__speech\nmcp__exchange-azure-reader__sql\nmcp__exchange-azure-reader__sreagent\nmcp__exchange-azure-reader__storage\nmcp__exchange-azure-reader__storagesync\nmcp__exchange-azure-reader__subscription_list\nmcp__exchange-azure-reader__virtualdesktop\nmcp__exchange-azure-reader__wellarchitectedframework\nmcp__exchange-azure-reader__workbooks\nmcp__mcp-registry__list_connectors\nmcp__mcp-registry__search_mcp_registry\nmcp__mcp-registry__suggest_connectors\nmcp__midi-composer__additive_process\nmcp__midi-composer__analyze_progression\nmcp__midi-composer__arpeggiate\nmcp__midi-composer__arrange_song\nmcp__midi-composer__arrange_to_midi\nmcp__midi-composer__bach_chorale_voicing\nmcp__midi-composer__bartok_axis\nmcp__midi-composer__bass_line\nmcp__midi-composer__cantus_firmus\nmcp__midi-composer__check_melody\nmcp__midi-composer__check_voice_leading\nmcp__midi-composer__chord_palette\nmcp__midi-composer__chord_pattern\nmcp__midi-composer__chords_to_midi\nmcp__midi-composer__church_mode\nmcp__midi-composer__circle_of_fifths\nmcp__midi-composer__coltrane_changes\nmcp__midi-composer__counterpoint\nmcp__midi-composer__degrees_to_chords\nmcp__midi-composer__detect_key\nmcp__midi-composer__diatonic_chords\nmcp__midi-composer__drums_to_midi\nmcp__midi-composer__euclidean_rhythm\nmcp__midi-composer__find_cadences\nmcp__midi-composer__get_chord\nmcp__midi-composer__get_scale\nmcp__midi-composer__groove\nmcp__midi-composer__guido_vowel_melody\nmcp__midi-composer__harmonize_melody\nmcp__midi-composer__interval_between\nmcp__midi-composer__list_chords\nmcp__midi-composer__list_grooves\nmcp__midi-composer__list_scales\nmcp__midi-composer__match_chords\nmcp__midi-composer__match_scales\nmcp__midi-composer__melodic_sequence\nmcp__midi-composer__melodic_walk\nmcp__midi-composer__midi_to_audio\nmcp__mid