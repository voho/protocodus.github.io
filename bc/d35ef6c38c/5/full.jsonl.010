S, S);\n  for (let i = 0; i < 4; i++) {\n    const x0 = (i % 2) * C, y0 = (i >> 1) * C;\n    g.save();\n    g.beginPath(); g.rect(x0, y0, C, C); g.clip();\n    // the cloth's outline: straight at the top (the hem over the sill), frayed or torn below\n    const path = new Path2D();\n    path.moveTo(x0, y0); path.lineTo(x0 + C, y0);\n    for (let k = 0; k <= 24; k++) {\n      const t = k / 24, x = x0 + C * (1 - t);\n      let y = y0 + C * (0.97 - 0.025 * R());\n      if (i === 3) y -= C * 0.03 * (0.5 + 0.5 * Math.cos(t * Math.PI * 12));     // scalloped\n      if (i === 2 && t < 0.35) y -= C * (0.35 - t) * 0.9 * (0.8 + 0.4 * R());     // torn away at a corner\n      path.lineTo(x, y);\n    }\n    path.closePath();\n    g.fillStyle = 'rgb(222,216,202)';\n    g.fill(path);\n    g.save(); g.clip(path);\n    // the weave, faint\n    for (let k = 0; k < 90; k++) {\n      g.fillStyle = `rgba(${R() < 0.5 ? '255,255,250' : '120,110,96'},${(0.03 + R() * 0.05).toFixed(3)})`;\n      if (R() < 0.5) g.fillRect(x0, y0 + R() * C, C, 1 + R() * 2); else g.fillRect(x0 + R() * C, y0, 1 + R() * 2, C);\n    }\n    // ticking stripes along its edges\n    if (i === 1) for (const xs of [0.08, 0.13, 0.87, 0.92]) { g.fillStyle = 'rgba(70,86,120,0.55)'; g.fillRect(x0 + C * xs, y0, C * 0.025, C); }\n    // stains: water marks with darker rims, and grime\n    for (let k = 0; k < 7; k++) {\n      const x = x0 + R() * C, y = y0 + C * (0.2 + R() * 0.75), r = C * (0.05 + R() * 0.14);\n      const gr = g.createRadialGradient(x, y, r * 0.5, x, y, r);\n      gr.addColorStop(0, 'rgba(180,160,120,0.10)'); gr.addColorStop(0.85, 'rgba(150,125,85,0.22)'); gr.addColorStop(1, 'rgba(150,125,85,0)');\n      g.fillStyle = gr; g.fillRect(x - r, y - r, 2 * r, 2 * r);\n    }\n    // soiled along the hem (the rain splashes it, the wall's grime runs into it), and the fold over the sill\n    const dirt = g.createLinearGradient(0, y0 + C * 0.65, 0, y0 + C);\n    dirt.addColorStop(0, 'rgba(90,72,50,0)'); dirt.addColorStop(1, 'rgba(90,72,50,0.45)');\n    g.fillStyle = dirt; g.fillRect(x0, y0, C, C);\n    g.fillStyle = 'rgba(80,70,58,0.25)'; g.fillRect(x0, y0 + C * 0.06, C, C * 0.012);\n    g.restore();\n    // frayed threads along the bottom\n    g.strokeStyle = 'rgba(222,216,202,0.9)'; g.lineWidth = 1;\n    for (let k = 0; k < 40; k++) {\n      const x = x0 + R() * C, y = y0 + C * 0.93;\n      g.beginPath(); g.moveTo(x, y); g.lineTo(x + (R() - 0.5) * 4, y + C * (0.01 + R() * 0.04)); g.stroke();\n    }\n    g.restore();\n  }\n  const t = new THREE.CanvasTexture(c);\n  t.colorSpace = THREE.SRGBColorSpace;\n  t.flipY = false;\n  t.anisotropy = 4;\n  return t;\n}\n\n/* the sheet's motion: hanging from its top edge, swinging out from the wall and along it as the gusts\n   go by, rippling across, most at its hem; never back into the wall. In the geometry's own space,\n   which is the world's */\nconst MOTION = /* glsl */ `\n  {\n    float hv = aSheet.y, hu = aSheet.x, ph = aFold.z;\n    vec3 n = vec3(aFold.x, 0.0, aFold.y), tw = vec3(aFold.y, 0.0, -aFold.x);\n    float g = gust(transformed.xz, uTime, uWind);\n    // a wet sheet is heavy: it swings less and clings\n    float a = hv * hv * (0.04 + 0.11 * g) * mix(1.0, 0.65, uWet);\n    float out = a * (0.55 + 0.45 * sin(uTime * 1.7 + ph + hv * 2.0)) + 0.02 * hv * g * (0.5 + 0.5 * sin(hu * 9.0 - uTime * 5.0 + ph));\n    float along = a * 0.6 * sin(uTime * 1.1 + ph * 1.7 + hv * 1.5);\n    transformed += n * out + tw * along;\n  }`;\n\nfunction addMotion(mat, uniforms) {\n  mat.onBeforeCompile = (shader) => {\n    Object.assign(shader.uniforms, uniforms);\n    shader.vertexShader = shader.vertexShader\n      .replace('#include <common>', `#include <common>\n        attribute vec4 aFold;\n        attribute vec2 aSheet;\n        uniform float uTime, uWet;\n        uniform vec2 uWind;\n        ${GUST_GLSL}`)\n      .replace('#include <begin_vertex>', '#include <begin_vertex>\\n' + MOTION);\n    if (mat.isMeshStandardMaterial) {\n      shader.fragmentShader = shader.fragmentShader\n        .replace('#include <common>', '#include <common>\\nuniform float uWet;')\n        .replace('#include <map_fragment>', `#include <map_fragment>\n        // soaked: darker, and the wet cloth a little glossier\n        diffuseColor.rgb *= mix(1.0, 0.7, uWet);`)\n        .replace('#include <roughnessmap_fragment>', `#include <roughnessmap_fragment>\n        roughnessFactor = mix(roughnessFactor, 0.62, uWet);`);\n      dimFillSpecular(shader);\n    }\n  };\n  mat.customProgramCacheKey = () => 'hedgerow-sheet' + (mat.isMeshStandardMaterial ? 's' : 'd');\n}\n\n/* panes: the lit windows in the world (rooms.js paneRects); world, terrain: for the wall in front of\n   each and the ground; shared: the frame's time and wetness */\nexport function createSheets(panes, world, terrain, shared, { count = 4, seed = 41 } = {}) {\n  const R = rng(seed), up = new THREE.Vector3(0, 1, 0);\n  // an upper-floor window that looks out onto open ground\n  const cand = panes.filter((p) => {\n    if (Math.abs(p.n.y) > 0.2 || p.c.y - terrain.height(p.c.x, p.c.z) < 4.2) return false;\n    const o = p.c.clone().addScaledVector(p.n, 0.6);\n    return !world.raycast(o.x, o.y, o.z, p.n.x, 0, p.n.z, 10);\n  });\n  for (let i = cand.length - 1; i > 0; i--) { const j = Math.floor(R() * (i + 1)); [cand[i], cand[j]] = [cand[j], cand[i]]; }\n  const chosen = [];\n  for (const p of cand) {\n    if (chosen.length >= count) break;\n    if (chosen.some((q) => q.c.distanceTo(p.c) < 14)) continue;\n    chosen.push(p);\n  }\n  if (!chosen.length) return null;\n  const pos = [], uv = [], fold = [], sheet = [], idx = [];\n  chosen.forEach((p, si) => {\n    // the wall's face below the sill: the window is set back in it\n    const below = p.c.clone().addScaledVector(p.B, -(p.hh + 0.35));\n    const o = below.clone().addScaledVector(p.n, 1.5);\n    const hit = world.raycast(o.x, o.y, o.z, -p.n.x, 0, -p.n.z, 3);\n    const face = hit ? Math.max(0.05, 1.5 - hit.t) : 0.15;\n    const w = Math.min(p.hw * 1.8, 1.3), h = 1.2 + R() * 0.5, cell = si % 4, ph = R() * 6.28;\n    const top = p.c.clone().addScaledVector(p.B, -p.hh).addScaledVector(p.n, face + 0.04);\n    const base = pos.length / 3;\n    for (let j = 0; j <= SY; j++) {\n      for (let i = 0; i <= SX; i++) {\n        const u = i / SX, v = j / SY;\n        const q = top.clone().addScaledVector(p.T, (u - 0.5) * w).addScaledVector(up, -v * h);\n        pos.push(q.x, q.y, q.z);\n        uv.push((cell % 2) * 0.5 + u * 0.5, (cell >> 1) * 0.5 + v * 0.5);\n        fold.push(p.n.x, p.n.z, ph, h);\n        sheet.push(u, v);\n      }\n    }\n    for (let j = 0; j < SY; j++) {\n      for (let i = 0; i < SX; i++) {\n        const a = base + j * (SX + 1) + i, b = a + 1, c = a + SX + 1, d = c + 1;\n        idx.push(a, c, b, b, c, d);\n      }\n    }\n  });\n  const geo = new THREE.BufferGeometry();\n  geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\n  geo.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));\n  geo.setAttribute('aFold', new THREE.Float32BufferAttribute(fold, 4));\n  geo.setAttribute('aSheet', new THREE.Float32BufferAttribute(sheet, 2));\n  geo.setIndex(idx);\n  geo.computeVertexNormals();\n  geo.computeBoundingSphere();\n  geo.boundingSphere.radius += 1;\n  const map = linen();\n  const uniforms = { uTime: shared.time, uWet: shared.wet, uWind: { value: new THREE.Vector2(1.6, 0.7) } };\n  const mat = new THREE.MeshStandardMaterial({ map, alphaTest: 0.5, side: THREE.DoubleSide, roughness: 0.92, metalness: 0, flatShading: true });\n  addMotion(mat, uniforms);\n  const mesh = new THREE.Mesh(geo, mat);\n  mesh.name = 'sheets';\n  mesh.castShadow = mesh.receiveShadow = true;\n  // its shadow moves with it\n  const dist = new THREE.MeshDistanceMaterial({ map, alphaTest: 0.5, side: THREE.DoubleSide });\n  addMotion(dist, uniforms);\n  mesh.customDistanceMaterial = dist;\n  return { mesh, count: chosen.length, at: chosen.map((p) => p.c) };\n}\n"}},"serverClassifierRequest":"d8051301-f1e3-45ba-985b-dd09250ba6d2","apiBlockIndex":2,"requestId":"req_011CgGKPFVzPv742hrVWLtuX","requestRef":"734f3d18-af63-4f5a-8c5f-058aaf8aa11b","requestedModel":"claude-opus-5-5","attributionMcpServer":"ccd_turn","attributionMcpTool":"update_plan","type":"assistant","uuid":"99652702-52ad-4d1c-871a-e47f87c826a2","timestamp":"2026-10-22T00:21:01.330Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
