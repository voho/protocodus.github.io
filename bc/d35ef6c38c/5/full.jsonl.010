he breaks","    one more): the fighting never wears them away. Seeded, so the village is","    the same every time. */"]},{"oldStart":24,"oldLines":6,"newStart":26,"newLines":7,"lines":[" const BUILT = /^(house|barn|ruin|bunker)|^church$/;"," const PLASTERED = /^house/;"," const SIDES = [[1, 0], [-1, 0], [0, 1], [0, -1]];","+const SIGN = 3.7, SIGNS = 5;       // a painted advertisement's width (m), and how many"," "," /* a texture's colours, readable: drawn once at up to 1024 (enough to tell plaster, stone and a window apart) */"," function texels(tex) {"]},{"oldStart":148,"oldLines":6,"newStart":151,"newLines":7,"lines":["   const fronts = ['LANE', 'STREET', 'TRACK'].map((k) => lines?.[k]).filter(Boolean);","   const sides = new Map(), colours = new Map(), tmp = {};","   let breaks = 0, holes = 0;","+  const signs = [];","   for (const p of props) {","     const name = p.m.name || '', box = p.m.box;","     if (!BUILT.test(name)) continue;"]},{"oldStart":198,"oldLines":6,"newStart":202,"newLines":20,"lines":["         }","         return -1;","       };","+      // where an old painted advertisement could be: high on a house's open plaster (the sign fills","+      // 0.94 by 0.42 of its decal)","+      if (PLASTERED.test(name) && exposed > 0.3) {","+        const hw = Math.ceil(SIGN * 0.47 / STEP), hh = Math.ceil(SIGN * 0.21 / STEP);","+        for (let t = 0; t < 60; t++) {","+          const cell = pick(2.4, 4.8);","+          if (cell < 0) break;","+          const i = cell % s.W, j = (cell / s.W) | 0;","+          if (!fits(s, i, j, hw, hh, true)) continue;","+          at(s, cell, tmp);","+          signs.push({ x: tmp.x, y: tmp.y, z: tmp.z, nx, nz, size: SIGN * k, exposed });","+          break;","+        }","+      }","       // plaster blown off, bigger nearer the ground (the break fills an ellipse 0.94 by 0.62 of its","       // decal; a smaller one where a big one will not fit)","       const nb = PLASTERED.test(name) ? Math.floor(s.area * 0.1 * exposed + R()) : 0;"]},{"oldStart":250,"oldLines":5,"newStart":268,"newLines":14,"lines":["       }","     }","   }","-  return { breaks, holes };","+  // the advertisements: on the most exposed of those walls, no two within 20 m, each a different","+  // trade as far as they go","+  signs.sort((a, b) => b.exposed - a.exposed);","+  const put = [];","+  for (const g of signs) {","+    if (put.length >= SIGNS) break;","+    if (put.some((o) => Math.hypot(o.x - g.x, o.z - g.z) < 20)) continue;","+    if (decals.pin('sign', g.x, g.y, g.z, g.nx, 0, g.nz, g.size, false, R, true, put.length)) put.push(g);","+  }","+  return { breaks, holes, signs: put.length };"," }"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js","hunks":[{"oldStart":173,"oldLines":7,"newStart":173,"newLines":7,"lines":["   G.halos = createHalos(LEVEL.fog.density);","   scene.add(G.halos.group);","   // room kept for the damage the walls already carry (damage.js)","-  G.decals = createDecals({ shared, pinned: { stone: 480, wood: 80, spall: 64 } });","+  G.decals = createDecals({ shared, pinned: { stone: 480, wood: 80, spall: 64, sign: 5 } });","   scene.add(G.decals.group);"," ","   built = buildLevel(G, LEVEL, quality);"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/damage.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js"]}},"serverClassifierContext":{"request":"d7769f8f-2a68-43c4-bbdb-d3ab1788314e","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"2358d0ef-3daa-4e45-8834-61c258299a16","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
