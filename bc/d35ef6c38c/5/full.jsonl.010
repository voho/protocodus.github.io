asts,","     setFlameShare(v) { flameShare = v; },","     /* the scene depth, its texel and whether to fade by it: for others drawn in the late pass */"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js","hunks":[{"oldStart":15,"oldLines":6,"newStart":15,"newLines":7,"lines":[" import { createCasings } from './casings.js';"," import { createDrips } from './drips.js';"," import { dressWalls } from './damage.js';","+import { createSteam } from './steam.js';"," import { createChunks } from './chunks.js';"," import { cullPointLights } from './lightloop.js';"," import { createFireballs } from './fireball.js';"]},{"oldStart":185,"oldLines":6,"newStart":186,"newLines":8,"lines":["   // and the clods and stones a blast throws (chunks.js)","   G.chunks = createChunks(G);","   scene.add(G.chunks.mesh);","+  // steam off the barrel of the gun in your hands after it has fired in the rain (steam.js)","+  G.steam = createSteam(G, shared.rain);","   // rainwater standing in the shell craters (ponds.js)","   G.ponds = createPonds(LEVEL.craters, G.terrain, textures, shared);","   if (G.ponds) scene.add(G.ponds.mesh);"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/effects.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js"]}},"serverClassifierContext":{"request":"8678fe29-2cb1-44f4-ad67-aa0fdc8f2e58","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"1675859c-6aea-4a71-a533-d3aec7c5952e","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
