    alpha.mesh.material.depthTest = add.mesh.material.depthTest = thrown.mesh.material.depthTest = !on;","     if (!on) shared.uSoft.value = 0;","   }","   /* The late pass: what would smear through the temporal anti-aliasing (taa.js) —"]},{"oldStart":466,"oldLines":7,"newStart":476,"newLines":7,"lines":["   function useLate(on, depth = null) {","     late.enabled = on;","     lateDepth = depth;","-    (on ? lateScene : group).add(add.mesh);","+    (on ? lateScene : group).add(add.mesh, thrown.mesh);","   }","   /* this frame's lights ([{x, y, z, color, intensity, range}], lights.js) and the ambient (1 = as chosen) */","   function setLights(list, ambient = 1) {"]},{"oldStart":797,"oldLines":6,"newStart":807,"newLines":7,"lines":["     updateFires(dt, wind, camPos);","     alpha.update(dt, groundFn, wind);","     add.update(dt, groundFn, wind);","+    thrown.update(dt, groundFn, wind);","   }"," ","   return {"]},{"oldStart":807,"oldLines":6,"newStart":818,"newLines":6,"lines":["     depthUniforms: { tDepth: shared.tDepth, uScreen: shared.uScreen, uSoft: shared.uSoft },","     setGround(fn) { groundFn = fn; },","     setCasings(c) { casings = c; },","-    get count() { return alpha.P.n + add.P.n; },","+    get count() { return alpha.P.n + add.P.n + thrown.P.n; },","   };"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/effects.js"]}},"serverClassifierContext":{"request":"9a2c3e35-42e4-43de-8a93-fb687ddac152","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_re