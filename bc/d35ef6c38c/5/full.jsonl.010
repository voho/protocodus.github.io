w/js/fireball.js","hunks":[{"oldStart":65,"oldLines":8,"newStart":65,"newLines":9,"lines":["   float body = 1.0 - smoothstep(0.55, 1.0, edge);","   float fade = 1.0 - smoothstep(0.75, 1.5, t);","   if (body * fade < 0.01) discard;","-  // heat: hottest at the heart and at first; it cools from the outside in","-  float cool = smoothstep(0.04, 0.7, t);","+  // heat: hottest at the heart and at first; it cools from the outside in, from the start (white","+  // only for a frame or two, at its heart: a blast is not a ball of light)","+  float cool = smoothstep(0.0, 0.55, t);","   // (folds of cooler, sootier flame through it: the turbulence decides much of it)","   float heat = clamp((1.0 - edge) * 1.05 - cool * 1.1 + (n2 - 0.5) * 1.1 + (n1 - 0.5) * 0.5, 0.0, 1.0);","   // a black body: deep red, orange, yellow, white only at the hottest"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/effects.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/fireball.js"]}},"serverClassifierContext":{"request":"6b2f2d5e-475d-469d-ae05-a8b75dc9b58e","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"1d2d5252-5fc1-4e90-a1bf-f4452bf7c085","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
