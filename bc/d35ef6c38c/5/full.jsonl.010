,","     setFlameShare(v) { flameShare = v; },","     /* the scene depth, its texel and whether to fade by it: for others drawn in the late pass */"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js","hunks":[{"oldStart":179,"oldLines":8,"newStart":179,"newLines":9,"lines":["   built = buildLevel(G, LEVEL, quality);","   G.cover = built.cover;","   dressWalls(G, built.props, LEVEL.lines);","-  // the lit windows' glass, for the cracks a bullet leaves in it","+  // the lit windows' glass, for the cracks a bullet leaves in it and the shards it breaks out","   G.decals.setPanes(paneRects(built.props));","+  G.decals.onGlass = (x, y, z, nx, nz) => G.effects.glass(x, y, z, nx, nz);","   G.effects.setGround((x, z) => G.terrain.height(x, z));","   // the brass thrown out of the gun (casings.js), lying where it falls","   G.casings = createCasings(G);"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/atmosphere.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/effects.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js"]}},"serverClassifierContext":{"request":"cd0a2a0e-4145-466c-a888-02fd49efa5af","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho