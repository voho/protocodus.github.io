n !world.raycast(o.x, o.y, o.z, p.n.x, 0, p.n.z, 10);","   });","+  T.filter = performance.now() - t0; T.cand = cand.length; t0 = performance.now();","   for (let i = cand.length - 1; i > 0; i--) { const j = Math.floor(R() * (i + 1)); [cand[i], cand[j]] = [cand[j], cand[i]]; }","   // on as many kinds of house as there are, before a second on any one kind","   const chosen = [];"]},{"oldStart":221,"oldLines":12,"newStart":223,"newLines":13,"lines":["     for (const p of cand) {","       if (chosen.length >= count) break;","       if (chosen.some((q) => q.p === p || q.p.c.distanceTo(p.c) < 14 || (!again && q.p.prop.m === p.prop.m))) continue;","-      const w = Math.min(2 * p.hw + 0.2, 1.4), at = hanging(p, w);","+      const w = Math.min(2 * p.hw + 0.2, 1.4), at = hanging(p, w); window.__clothT.hangs++;","       if (!at || at.len < 0.9) continue;","       chosen.push({ p, w, at });","     }","   }","   houses.clear();","+  T.hang = performance.now() - t0;","   if (!chosen.length) return null;","   const pos = [], uv = [], fold = [], sheet = [], du = [], dv = [], idx = [];","   const W = SX + 1, H = SY + 1;"]},{"oldStart":273,"oldLines":7,"newStart":276,"newLines":7,"lines":["   geo.computeVertexNormals();","   geo.computeBoundingSphere();","   geo.boundingSphere.radius += 1;","-  const map = linen();","+  t0 = performance.now(); const map = linen(); T.linen = performance.now() - t0;","   const uniforms = { uTime: shared.time, uWet: shared.wet, uWind: { value: new THREE.Vector2(1.4, 0.6) } };","   const mat = new THREE.MeshStandardMaterial({ map, alphaTest: 0.5, side: THREE.DoubleSide, roughness: 0.92, metalness: 0 });","   addMotion(mat, uniforms);"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/cloth.js"]}},"serverClassifierContext":{"request":"dadb3a72-1ecb-457b-8850-685142ccc6f4","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedg