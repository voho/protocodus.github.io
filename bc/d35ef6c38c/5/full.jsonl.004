s();","   }"]},{"oldStart":248,"oldLines":7,"newStart":250,"newLines":9,"lines":["     // its glow over them; without it they are drawn with the scene); the depth of field","     // borrows the scene depth the light-in-the-rain pass reads, so it needs that pass","     G.effects.usePass(!!quality.volumetric, scene);","-    renderer.setEffects([...(quality.volumetric ? [G.effects.pass] : []), ...(ao ? [ssao] : []), ...(refl ? [ssr] : []), ...(quality.volumetric ? [volumetric, dof] : []), ...(quality.bloom ? [bloom] : []), grade]);","+    // the flare's shafts need its shadows: with them, and with the light in the rain that lays them on","+    const shaft = quality.volumetric && quality.shadows;","+    renderer.setEffects([...(quality.volumetric ? [G.effects.pass] : []), ...(ao ? [ssao] : []), ...(refl ? [ssr] : []), ...(shaft ? [shafts] : []), ...(quality.volumetric ? [volumetric, dof] : []), ...(quality.bloom ? [bloom] : []), grade]);","   }","   G?.weather?.setCount(quality.rain);","   G?.grass?.setCount(quality.blades ?? 0);"]},{"oldStart":423,"oldLines":7,"newStart":427,"newLines":7,"lines":[" window.hedgerow = {","   get G() { return G; },","   get input() { return input; },","-  get fx() { return { volumetric, bloom, grade, ssao, dof, ssr }; },","+  get fx() { return { volumetric, bloom, grade, ssao, dof, ssr, shafts }; },","   flyTo(x, y, z, yaw = 0, pitch = -0.1) { if (!fly) startFly(); fly.pos.set(x, y, z); fly.yaw = yaw; fly.pitch = pitch; },"," };"," "]},{"oldStart":555,"oldLines":6,"newStart":559,"newLines":10,"lines":["     volumetric?.setLights(G.lights.active, G.time, G.weather.intensity ?? 1);","     dof?.set(volumetric?.uniforms.tDepth.value, state === 'playing' ? G.rig.aimT : 0);","     G.effects.setLights(G.lights.active, 1 + flash * 0.9);","+    if (shafts && quality.volumetric && quality.shadows) {","+      shafts.set(G.flares);","+      volumetric.setShafts(shafts, G.flares.light.color, G.flares.light.intensity * (0.6 + 0.4 * (G.weather.intensity ?? 1)));","+    }","     G.weather.setLights(G.lights.active);","     G.halos?.update(dt, G.time, camera.position);","     G.mist?.update(dt, camera.position, G.time, flash);"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/shafts.js","hunks":[{"oldStart":75,"oldLines":10,"newStart":75,"newLines":12,"lines":["   const target = new THREE.WebGLRenderTarget(4, 4, { type: THREE.HalfFloatType, format: THREE.RedFormat, depthBuffer: false, stencilBuffer: false });","   target.texture.minFilter = target.texture.magFilter = THREE.LinearFilter;","   const u = material.uniforms;","+  const texel = new THREE.Vector2(1, 1);","   let light = null;"," ","   return {","     enabled: false, needsSwap: false, uniforms: u, texture: target.texture,","+    texel,                // of the half-resolution target, for the upsample","     /* the flares (flares.js): on while one's shadow map is being drawn */","     set(flares) {","       const l = flares?.light;"]},{"oldStart":87,"oldLines":7,"newStart":89,"newLines":9,"lines":["       light = this.enabled ? l : null;","     },","     setSize(w, h) {","-      target.setSize(Math.max(1, Math.round(w * scale)), Math.max(1, Math.round(h * scale)));","+      const tw = Math.max(1, Math.round(w * scale)), th = Math.max(1, Math.round(h * scale));","+      target.setSize(tw, th);","+      texel.set(1 / tw, 1 / th);","     },","     render(renderer, writeBuffer, readBuffer) {","       if (!readBuffer.depthTexture || !light) return;"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/volumetric.js","hunks":[{"oldStart":45,"oldLines":9,"newStart":45,"newLines":10,"lines":[" uniform int uCount;"," uniform float uDensity, uTime, uRain, uFar;"," uniform vec2 uWind;","-uniform sampler2D tAO, tSSR;","+uniform sampler2D tAO, tSSR, tShafts;"," uniform vec2 uAOTexel;"," uniform float uAO, uSSR;","+uniform vec3 uShaftCol;"," varying vec2 vUv;"," "," f