col = mix(vec3(0.45, 0.04, 0.0), vec3(1.0, 0.32, 0.02), smoothstep(0.05, 0.4, heat));","-  col = mix(col, vec3(1.0, 0.68, 0.18), smoothstep(0.4, 0.7, heat));","-  col = mix(col, vec3(1.0, 0.93, 0.72), smoothstep(0.72, 0.95, heat));","+  // a black body: deep red at the ragged edges, mostly orange, yellow, white only at the hottest","+  vec3 col = mix(vec3(0.45, 0.04, 0.0), vec3(1.0, 0.3, 0.02), smoothstep(0.05, 0.35, heat));","+  col = mix(col, vec3(1.0, 0.6, 0.12), smoothstep(0.35, 0.65, heat));","+  col = mix(col, vec3(1.0, 0.85, 0.45), smoothstep(0.65, 0.85, heat));","+  col = mix(col, vec3(1.0, 0.95, 0.8), smoothstep(0.88, 1.0, heat));","   float a = smoothstep(0.04, 0.35, heat);","   // drawn over the finished frame: hidden behind what is in front, soft where it meets it","   if (uSoft > 0.5) {"]},{"oldStart":81,"oldLines":7,"newStart":84,"newLines":7,"lines":["   gl_FragColor = vec4(col * a * uGain, 1.0);"," }`;"," ","-export function createFlames(effects, { gain = 2.6 } = {}) {","+export function createFlames(effects, { gain = 1.4 } = {}) {","   const quad = new THREE.PlaneGeometry(1, 1);","   quad.translate(0, 0.5, 0);","   const geo = new THREE.InstancedBufferGeometry();"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/flames.js"]}},"serverClassifierContext":{"request":"011206d6-5e6c-4341-8500-c64527cc7f4b","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io