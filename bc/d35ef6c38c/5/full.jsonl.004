 };\nawait stand(4, 290, 0.2, 0.0, 600);\nconst A = [], B = [];\nfor (let k = 0; k < 4; k++) { fx.taa.enabled = true; A.push(await fps()); fx.taa.enabled = false; B.push(await fps()); }\nfx.taa.enabled = true;\nconst med = (a) => { a.sort((p, q) => p - q); return +a[a.length >> 1].toFixed(1); };\ninfo.forestFps = { taa: med(A), none: med(B), ms: +(1000 / med(A) - 1000 / med(B)).toFixed(2) };\nreturn info;\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"19b29fc9-bb18-42c9-8a9f-a632a80c40d2","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
