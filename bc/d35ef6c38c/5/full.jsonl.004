{"type":"api-request-blob","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","hash":"9064c4a17c53a6281777895169497dc8c60fb98330c942bae9850b5ca664337b","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"thinking","thinking":"I'm writing `flames.js` to render each fire as camera-facing billboards within 60 m, using a shader that shapes a black-body-colored turbulent flame body and fades into sparser licks topped with smoke and embers.\n\n","signature":""},{"type":"tool_use","id":"toolu_01DG7tKb4RcJdHMhzRPUBFVn","name":"Write","input":{"file_path":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/flames.js","content":"/* Hedgerow — fire as flame: procedural flames at each fire near the camera.\n\n   Over every fire within 60 m (the burning truck, the house, the flak gun\n   once it is blown) stand three billboards, each turned to the camera about\n   its upright axis, and each a body of flame worked out in its shader:\n   turbulent noise rising through a shape that is wide at the base and licks\n   up to points, eaten away from the top, coloured by its heat like a black\n   body — deep red at its ragged edges, through orange, to a yellow-white\n   core — bright enough to bloom. Drawn with the late particles (after the\n   anti-aliasing, so the flicker stays crisp: effects.js), hidden behind\n   what stands in front and soft where it meets the truck's cab or the wall;\n   without the effects chain it is drawn with the scene. The sprite flames\n   of effects.js thin out to the odd lick over it; the smoke and the embers\n   stay. */\n\nimport * as THREE from 'three';\n\nconst PER = 3, MAXF = 6, RANGE = 60;\n\nconst VERT = /* glsl */ `\nattribute vec4 aFire;          // xyz: the base, w: size\nattribute vec2 aSeed;          // seed, share (0..1: how big this one is)\nvarying vec2 vUv;\nvarying float vSeed, vDist;\nvarying vec2 vProj;\nvoid main() {\n  float s = aFire.w;\n  // turned to the camera about the upright axis\n  vec3 t = cameraPosition - aFire.xyz;\n  t.y = 0.0;\n  if (dot(t, t) < 1e-4) t = vec3(0.0, 0.0, 1.0);\n  vec3 right = normalize(vec3(t.z, 0.0, -t.x));\n  float w = (1.0 + 0.5 * aSeed.y) * s, h = (1.6 + 0.9 * aSeed.y) * s;\n  vec3 p = aFire.xyz + right * position.x * w + vec3(0.0, position.y * h, 0.0);\n  vUv = vec2(position.x * 2.0, position.y);\n  vSeed = aSeed.x;\n  vec4 mv = viewMatrix * vec4(p, 1.0);\n  vDist = -mv.z;\n  vProj = vec2(projectionMatrix[2][2], projectionMatrix[3][2]);\n  gl_Position = projectionMatrix * mv;\n}`;\n\nconst FRAG = /* glsl */ `\nuniform float uTime, uGain, uSoft;\nuniform sampler2D tDepth;\nuniform vec2 uScreen;\nvarying vec2 vUv;\nvarying float vSeed, vDist;\nvarying vec2 vProj;\nfloat hash(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat noise(vec2 p) {\n  vec2 i = floor(p), f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\nfloat fbm(vec2 p) { float s = 0.0, a = 0.5; for (int i = 0; i < 4; i++) { s += a * noise(p); p = p * 2.03 + 17.1; a *= 0.5; } return s; }\nvoid main() {\n  float t = uTime + vSeed * 7.3;\n  vec2 uv = vUv;                 // x: -1..1 across, y: 0..1 up\n  // noise rising through it, faster higher up; the flame bends with it\n  float n1 = fbm(vec2(uv.x * 1.6 + vSeed * 3.1, uv.y * 2.2 - t * 2.1));\n  float n2 = fbm(vec2(uv.x * 3.4 - vSeed * 1.7, uv.y * 4.0 - t * 3.6));\n  float x = uv.x + (n1 - 0.5) * 0.9 * uv.y;\n  // wide at the base, licking up to points, eaten away from above\n  float width = mix(0.9, 0.08, pow(uv.y, 0.7));\n  float body = 1.0 - smoothstep(width * 0.45, width, abs(x));\n  body *= 1.0 - smoothstep(0.25, 0.95, uv.y + (n2 - 0.5) * 0.6 - (n1 - 0.5) * 0.3);\n  body *= smoothstep(0.0, 0.1, uv.y);\n  float heat = clamp(body * (1.3 - uv.y * 0.9) * (0.65 + 0.7 * n2), 0.0, 1.0);\n  if (heat < 0.04) discard;\n  // a black body: deep red, orange, yellow, a white-hot core\n  vec3 col = mix(vec3(0.45, 0.04, 0.0), vec3(1.0, 0.32, 0.02), smoothstep(0.05, 0.4, heat));\n  col = mix(col, vec3(1.0, 0.68, 0.18), smoothstep(0.4, 0.7, heat));\n  col = mix(col, vec3(1.0, 0.93, 0.72), smoothstep(0.72, 0.95, heat));\n  float a = smoothstep(0.04, 0.35, heat);\n  // drawn over the finished frame: hidden behind what is in front, soft where it meets it\n  if (uSoft > 0.5) {\n    float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;\n    a *= clamp((vProj.y / (zd + vProj.x) - vDist) / 0.35, 0.0, 1.0);\n  }\n  gl_FragColor = vec4(col * a * uGain, 1.0);\n}`;\n\nexport function createFlames(effects, { gain = 2.6 } = {}) {\n  const quad = new THREE.PlaneGeometry(1, 1);\n  quad.translate(0, 0.5, 0);\n  const geo = new THREE.InstancedBufferGeometry();\n  geo.index = quad.index;\n  geo.setAttribute('position', quad.attributes.position);\n  const fireA = new THREE.InstancedBufferAttribute(new Float32Array(MAXF * PER * 4), 4);\n  const seedA = new THREE.InstancedBufferAttribute(new Float32Array(MAXF * PER * 2), 2);\n  fireA.setUsage(THREE.DynamicDrawUsage);\n  geo.setAttribute('aFire', fireA);\n  geo.setAttribute('aSeed', seedA);\n  geo.instanceCount = 0;\n  const own = { tDepth: { value: null }, uScreen: { value: new THREE.Vector2(1, 1) }, uSoft: { value: 0 } };\n  const uniforms = { uTime: { value: 0 }, uGain: { value: gain }, ...own };\n  const mat = new THREE.ShaderMaterial({\n    vertexShader: VERT, fragmentShader: FRAG, uniforms,\n    transparent: true, depthWrite: false, blending: THREE.CustomBlending, fog: false,\n  });\n  mat.blendSrc = THREE.OneFactor; mat.blendDst = THREE.OneFactor; mat.blendEquation = THREE.AddEquation;\n  const mesh = new THREE.Mesh(geo, mat);\n  mesh.name = 'flames';\n  mesh.frustumCulled = false;\n  mesh.renderOrder = 7;\n  // each fire's three flames: where round its base, how big, their seeds (fixed per fire)\n  const layout = new WeakMap();\n  const lay = (f) => {\n    let l = layout.get(f);\n    if (!l) {\n      const k = (f.x * 12.9898 + f.z * 78.233) % 1;\n      l = [[-0.32, 0.1, 0.55, k], [0.3, -0.12, 0.7, k + 0.37], [0.02, 0.05, 1.0, k + 0.71]];\n      layout.set(f, l);\n    }\n    return l;\n  };\n  const near = [];\n  let time = 0;\n\n  return {\n    mesh,\n    /* drawn after the frame in this scene (the late pass, hidden behind the scene by its\n       depth: depth = {tDepth, uScreen, uSoft} uniforms that pass keeps), or with the scene */\n    drawLate(lateScene, scene, depth = null) {\n      (lateScene || scene).add(mesh);\n      mat.depthTest = !lateScene;\n      const d = lateScene && depth ? depth : own;\n      uniforms.tDepth = d.tDepth; uniforms.uScreen = d.uScreen; uniforms.uSoft = d.uSoft;\n      mat.needsUpdate = true;\n      // the sprite flames thin out to the odd lick over these\n      effects.setFlameShare?.(0.3);\n    },\n    update(dt, cam) {\n      time += dt;\n      uniforms.uTime.value = time;\n      near.length = 0;\n      for (const f of effects.fires) {\n        if (!f.on || f.far) continue;\n        const d2 = (f.x - cam.x) ** 2 + (f.z - cam.z) ** 2;\n        if (d2 < RANGE * RANGE) near.push([d2, f]);\n      }\n      near.sort((a, b) => a[0] - b[0]);\n      const n = Math.min(MAXF, near.length);\n      for (let i = 0; i < n; i++) {\n        const f = near[i][1];\n        const l = lay(f);\n        for (let j = 0; j < PER; j++) {\n          const [ox, oz, share, seed] = l[j], k = i * PER + j;\n          fireA.array.set([f.x + ox * f.size, f.y - 0.1, f.z + oz * f.size, f.size], k * 4);\n          seedA.array[k * 2] = seed; seedA.array[k * 2 + 1] = share;\n        }\n      }\n      geo.instanceCount = n * PER;\n      fireA.needsUpdate = true;\n      seedA.needsUpdate = true;\n    },\n  };\n}\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01Q23XM88NiW67Z5nBYNuPRR","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow && node --check js/flames.js && python3 - <<'PYEOF'\np = 'js/effects.js'\ns = open(p).read()\nrep = [\n(\"\"\"  function updateFires(dt, wind, camPos) {\n    for (const f of fires) {\"\"\",\n \"\"\"  // the share of the sprite flames still spawned (flames.js draws the body of the fire over them)\n  let flameShare = 1;\n  function updateFires(dt, wind, camPos) {\n    for (const f of fires) {\"\"\"),\n(\"\"\"        const s = f.size;\n        add.spawn({\n          x: f.x + (R() - 0.5) * 1.2 * s, y: f.y + R() * 0.3, z: f.z + (R() - 0.5) * 1.2 * s,\"\"\",\n \"\"\"        const s = f.size;\n        if (f.far || R() < flameShare) add.spawn({\n          x: f.x + (R() - 0.5) * 1.2 * s, y: f.y + R() * 0.3, z: f.z + (R() - 0.5) * 1.2 * s,\"\"\"),\n(\"\"\"    pass, usePass, late, useLate, setLights, shocks,\"\"\",\n \"\"\"    pass, usePass, late, useLate, setLights, shocks,\n    setFlameShare(v) { flameShare = v; },\"\"\"),\n]\nfor a, b in rep:\n    assert a in s, a[:60]\n    s = s.replace(a, b)\nopen(p, 'w').write(s)\n\np = 'js/main.js'\ns = open(p).read()\nrep = [\n(\"import { createFlares } from './flares.js';\", \"import { createFlares } from './flares.js';\\nimport { createFlames } from './flames.js';\"),\n(\"\"\"  // illumination flares over the front, now and then (their shadows at four times the lamps' map size)\"\"\",\n \"\"\"  // the fires' flames, drawn as flame (flames.js)\n  G.flames = createFlames(G.effects);\n  G.flames.drawLate(null, scene);\n  // illumination flares over the front, now and then (their shadows at four times the lamps' map size)\"\"\"),\n(\"\"\"    G.weather.drawLate(aa ? G.effects.late.scene : null, G.effects.depthUniforms);\"\"\",\n \"\"\"    G.weather.drawLate(aa ? G.effects.late.scene : null, G.effects.depthUniforms);\n    G.flames.drawLate(aa ? G.effects.late.scene : null, scene, G.effects.depthUniforms);\"\"\"),\n(\"\"\"    G.effects.update(dt, { x: 1.4, z: 0.6 }, camera.position);\"\"\",\n \"\"\"    G.effects.update(dt, { x: 1.4, z: 0.6 }, camera.position);\n    G.flames.update(dt, camera.position);\"\"\"),\n]\nfor a, b in rep:\n    assert a in s, a[:60]\n    s = s.replace(a, b)\nopen(p, 'w').write(s)\nprint('ok')\nPYEOF\nfor f in js/effects.js js/main.js; do node --check $f || echo FAIL $f; done; grep -n \"G.flames\\|G.weather = createWeather\\|applyGraphics();\" js/main.js | head","description":"Wire the shader flames in and thin the sprite flames"},"caller":{"type":"direct"}}]}}
