{"parentUuid":"d92ddc0a-2b7d-4b24-b912-a797f0578fef","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgFZUy4aFhH5aLmfZb2Fa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PP2j9wr5xhHJp6eKkoKqkP","name":"Edit","input":{"replace_all":false,"file_path":"/Users/vojta/Library/Application REDACTED.md","old_string":"  Note for camera/first-person work: anything rendered nearer than 1.2 m is treated as moving\n  with the camera (not reprojected); a camera jump over 2 m resets the history.","new_string":"  Note for camera/first-person work: anything rendered nearer than 1.2 m is treated as moving\n  with the camera (not reprojected); a camera jump over 2 m resets the history.\n- d57e5389 heat haze over the nearest fires and blast shockwave rings (distort.js, new; after\n  taa and the late pass in the chain; effects.js records shocks). Also leaves anything nearer\n  than 1.2 m (the rifle) untouched.\n\nObserved, not fixed (pre-existing, invisible): adding or removing any swapping pass in the effects\nchain changes ~150 pixels by 3-7 levels along a hairline of slope 0.75 through (256,0) at\n1024x768 - some pass's rounding depends on buffer parity. Neither parity shows a visible seam."},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1394,"cache_read_input_tokens":789499,"output_tokens":870,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1394,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":870,"cache_read_input_tokens":789499,"cache_creation_input_tokens":1394,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1394},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transfor