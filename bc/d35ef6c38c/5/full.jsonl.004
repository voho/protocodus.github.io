vX));","+            float line = 1.0 - smoothstep(0.06, 0.2, abs(mRivX));","             float fy = floor(q.y), ty = fract(q.y);","             float run = smoothstep(0.55, 0.8, mix(hash12(vec2(col, fy)), hash12(vec2(col, fy + 1.0)), ty * ty * (3.0 - 2.0 * ty)));","             mRiv = line * run * k;","-            diffuseColor.rgb *= 1.0 - 0.25 * mRiv;","+            diffuseColor.rgb *= 1.0 - 0.45 * mRiv;","           }","         }","         #endif` : ''}`)"]},{"oldStart":323,"oldLines":7,"newStart":324,"newLines":7,"lines":["           normal = normalize(tbnR * normalize(vec3(rip * 0.8, 1.0)) * 0.5 + normal * 0.5);","         }","         ${streaks ? `// a rivulet bulges out of the wall: its sides lean, so it catches the light across it","-        if (mRiv > 0.01) normal = normalize(normal + mat3(viewMatrix) * mRivT * (mRivX * 5.0 * mRiv));` : ''}`)","+        if (mRiv > 0.01) normal = normalize(normal + mat3(viewMatrix) * mRivT * (mRivX * 3.0 * mRiv));` : ''}`)","       .replace('#include <opaque_fragment>', `#include <opaque_fragment>","         #ifdef OPAQUE","           gl_FragColor.a = mirrorAlpha(roughnessFactor, mWetUp);"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/materials.js"]}},"serverClassifierContext":{"request":"bfb44cf7-b5e7-43cf-8d1e-f5c16094ea2f","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":