auto = renderer.autoClear;\n      renderer.autoClear = false;\n      renderer.setRenderTarget(readBuffer);\n      renderer.render(lateScene, camera);\n      renderer.autoClear = auto;\n    },\n  };\n  /* the additive system after the anti-aliasing (on, with the scene depth's getter) or with the rest */\n  function useLate(on, depth = null) {\n    late.enabled = on;\n    lateDepth = depth;\n    (on ? lateScene : group).add(add.mesh);\n  }\"\"\"\nassert old in s; s = s.replace(old, new)\nold = \"\"\"    group, muzzle, tracer, impact, blood, splash, explosion, addFire, smokePuff, shell, flareLaunch, update, fires,\n    pass, usePass, setLights,\"\"\"\nnew = \"\"\"    group, muzzle, tracer, impact, blood, splash, explosion, addFire, smokePuff, shell, flareLaunch, update, fires,\n    pass, usePass, late, useLate, setLights,\n    /* the scene depth, its texel and whether to fade by it: for others drawn in the late pass */\n    depthUniforms: { tDepth: shared.tDepth, uScreen: shared.uScreen, uSoft: shared.uSoft },\"\"\"\nassert old in s; s = s.replace(old, new)\nopen(p, 'w').write(s)\n\np = 'js/weather.js'\ns = open(p).read()\nrep = [\n(\"\"\"varying float vAlpha;\nvarying vec2 vUv;\nvarying vec3 vLit;\nvoid main() {\n  vec3 vel = uVel * (0.85 + 0.3 * aDrop.w);\"\"\",\n \"\"\"varying float vAlpha;\nvarying vec2 vUv;\nvarying vec3 vLit;\nvarying float vDist;\nvarying vec2 vProj;\nvoid main() {\n  vec3 vel = uVel * (0.85 + 0.3 * aDrop.w);\"\"\"),\n(\"\"\"  vLit = lit;\n  gl_Position = projectionMatrix * viewMatrix * vec4(wp, 1.0);\n}`;\n\nconst RAIN_FRAG = /* glsl */ `\nuniform vec3 uColor;\nuniform float uOpacity, uFlash;\nvarying float vAlpha;\nvarying vec2 vUv;\nvarying vec3 vLit;\nvoid main() {\"\"\",\n \"\"\"  vLit = lit;\n  vec4 mv = viewMatrix * vec4(wp, 1.0);\n  vDist = -mv.z;\n  vProj = vec2(projectionMatrix[2][2], projectionMatrix[3][2]);\n  gl_Position = projectionMatrix * mv;\n}`;\n\nconst RAIN_FRAG = /* glsl */ `\nuniform vec3 uColor;\nuniform float uOpacity, uFlash, uSoft;\nuniform sampler2D tDepth;\nuniform vec2 uScreen;\nvarying float vAlpha;\nvarying vec2 vUv;\nvarying vec3 vLit;\nvarying float vDist;\nvarying vec2 vProj;\nvoid main() {\n  // drawn after the frame (the late pass): hidden behind what the scene drew\n  if (uSoft > 0.5) {\n    float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;\n    if (vDist > vProj.y / (zd + vProj.x)) discard;\n  }\"\"\"),\n(\"\"\"    uLightPos: { value: Array.from({ length: 6 }, () => new THREE.Vector3(0, -1000, 0)) },\n    uLightCol: { value: Array.from({ length: 6 }, () => new THREE.Vector3()) },\n  };\n  const rainMat\"\"\",\n \"\"\"    uLightPos: { value: Array.from({ length: 6 }, () => new THREE.Vector3(0, -1000, 0)) },\n    uLightCol: { value: Array.from({ length: 6 }, () => new THREE.Vector3()) },\n    tDepth: { value: null }, uScreen: { value: new THREE.Vector2(1, 1) }, uSoft: { value: 0 },\n  };\n  const rainMat\"\"\"),\n(\"\"\"  return {\n    group, update, flashDir, setLights,\"\"\",\n \"\"\"  /* the rain drawn in another scene after the frame (the late pass of effects.js, hidden\n     behind the scene by its depth: depth = {tDepth, uScreen, uSoft} uniforms that pass keeps),\n     or with the rest of the weather again (scene null) */\n  function drawLate(scene, depth = null) {\n    (scene || group).add(rain);\n    rainMat.depthTest = !scene;\n    const own = { tDepth: { value: null }, uScreen: { value: new THREE.Vector2(1, 1) }, uSoft: { value: 0 } };\n    const d = scene && depth ? depth : own;\n    rainUniforms.tDepth = d.tDepth; rainUniforms.uScreen = d.uScreen; rainUniforms.uSoft = d.uSoft;\n  }\n\n  return {\n    group, update, flashDir, setLights, drawLate,\"\"\"),\n]\nfor a, b in rep:\n    assert a in s, a[:60]\n    s = s.replace(a, b)\nopen(p, 'w').write(s)\nprint('ok')\nPYEOF\nnode --check js/effects.js && node --check js/weather.js && echo parsed","description":"Add the late pass and late-drawn rain"}},"wireIngestContext":{"toolu_017wqQWsHRFfcZBB