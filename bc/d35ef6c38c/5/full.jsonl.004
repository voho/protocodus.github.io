r.render;\nfx.blur.render = function (renderer, w, rb) {\n  mat.uniforms.tDepth.value = fx.volumetric.uniforms.tDepth.value;\n  mat.uniforms.uProjInv.value.copy(G.camera.projectionMatrixInverse);\n  const prev = renderer.getRenderTarget();\n  renderer.setRenderTarget(target); renderer.render(quad, ortho);\n  const buf = new Float32Array(pts.length * 4);\n  renderer.readRenderTargetPixels(target, 0, 0, pts.length, 1, buf);\n  out = pts.map((p, i) => ({ px: p, depth: +buf[i * 4].toFixed(5), dist: +buf[i * 4 + 1].toFixed(3) }));\n  renderer.setRenderTarget(prev);\n  return orig.call(this, renderer, w, rb);\n};\nfx.blur.enabled = true;\nG.rig.yaw += 0.03;\nawait new Promise(res => requestAnimationFrame(res));\nG.rig.yaw += 0.03;\nawait new Promise(res => requestAnimationFrame(res));\nfx.blur.render = orig;\nreturn { out, near: G.camera.near, far: G.camera.far };\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01Kfz6WtXvGW6nb2piMGW4Bo","name":"Bash","input":{"command":"REDACTED; node $S/hl.mjs eval $S/mb2.js","description":"Read the rifle and hand depths from the frame","timeout":120000},"caller":{"type":"direct"}}]}}
