 fx.volumetric.uniforms.tDepth.value;\n  mat.uniforms.uProjInv.value.copy(G.camera.projectionMatrixInverse);\n  const prev = renderer.getRenderTarget();\n  renderer.setRenderTarget(target); renderer.render(quad, ortho);\n  const buf = new Float32Array(pts.length * 4);\n  renderer.readRenderTargetPixels(target, 0, 0, pts.length, 1, buf);\n  out = pts.map((p, i) => ({ px: p, depth: +buf[i * 4].toFixed(5), dist: +buf[i * 4 + 1].toFixed(3) }));\n  renderer.setRenderTarget(prev);\n  return orig.call(this, renderer, w, rb);\n};\nfx.blur.enabled = true;\nG.rig.yaw += 0.03;\nawait new Promise(res => requestAnimationFrame(res));\nG.rig.yaw += 0.03;\nawait new Promise(res => requestAnimationFrame(res));\nfx.blur.render = orig;\nreturn { out, near: G.camera.near, far: G.camera.far };\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"6918b512-b2db-4f33-9336-5e961cf17ea2","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
