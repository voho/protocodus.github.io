" js/main.js | head","description":"Wire the shader flames in and thin the sprite flames"}},"wireIngestContext":{"toolu_01Q23XM88NiW67Z5nBYNuPRR":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow"}},"serverClassifierRequest":"54376692-0692-4837-a8a9-95fc2fcc3fc7","apiBlockIndex":3,"requestId":"req_011CgFZsSiLATiEGqSL7HV8E","requestRef":"9dbc578f-3e48-40ac-b7f4-80676b12b745","requestedModel":"claude-opus-5-5","attributionMcpServer":"ccd_turn","attributionMcpTool":"update_plan","type":"assistant","uuid":"7cbe378d-3b2e-4d64-93ca-85d9d44311c2","timestamp":"2026-10-21T14:50:20.008Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
