      launch headless shell (detached), open url\n//   node hl.mjs eval <file.js>      run the file's code in the page (awaits, prints the JSON result)\n//   node hl.mjs stop                close it\n// State (pid, debug port) lives next to this script.\nimport { spawn } from 'node:child_process';\nimport { readFileSync, writeFileSync, existsSync, mkdirSync, rmSync } from 'node:fs';\nimport { join, dirname } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst HERE = dirname(fileURLToPath(import.meta.url));\nconst STATE = join(HERE, 'hl-state.json');\nconst BIN = process.env.HOME + '/Library/Caches/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-mac-arm64/chrome-headless-shell';\nconst PORT = 9337;\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n\nasync function targets() {\n  const r = await fetch(`http://127.0.0.1:${PORT}/json/list`);\n  return r.json();\n}\n\nasync function connect() {\n  const page = (await targets()).find((t) => t.type === 'page');\n  if (!page) throw new Error('no page');\n  const ws = new WebSocket(page.webSocketDebuggerUrl);\n  await new Promise((res, rej) => { ws.onopen = res; ws.onerror = rej; });\n  let id = 0;\n  const pending = new Map();\n  ws.onmessage = (m) => {\n    const d = JSON.parse(m.data);\n    if (d.id && pending.has(d.id)) { pending.get(d.id)(d); pending.delete(d.id); }\n  };\n  const send = (method, params = {}) => new Promise((res) => { const i = ++id; pending.set(i, res); ws.send(JSON.stringify({ id: i, method, params })); });\n  return { send, close: () => ws.close() };\n}\n\nconst [cmd, arg] = process.argv.slice(2);\nif (cmd === 'start') {\n  const prof = join(HERE, 'hl-profile');\n  rmSync(prof, { recursive: true, force: true });\n  mkdirSync(prof, { recursive: true });\n  const p = spawn(BIN, [\n    `--remote-debugging-port=${PORT}`, `--user-data-dir=${prof}`, '--window-size=1024,768',\n    '--use-angle=metal', '--enable-gpu', '--ignore-gpu-blocklist', '--enable-unsafe-webgpu',\n    '--no-first-run', '--no-default-browser-check', '--mute-audio', '--autoplay-policy=no-user-gesture-required',\n    arg || 'about:blank',\n  ], { detached: true, stdio: 'ignore' });\n  p.unref();\n  writeFileSync(STATE, JSON.stringify({ pid: p.pid }));\n  for (let i = 0; i < 50; i++) { try { await targets(); break; } catch { await sleep(200); } }\n  console.log('started', p.pid);\n} else if (cmd === 'eval') {\n  const code = readFileSync(arg, 'utf8');\n  const c = await connect();\n  const r = await c.send('Runtime.evaluate', { expression: `(async () => { ${code} })()`, awaitPromise: true, returnByValue: true, timeout: 600000 });\n  c.close();\n  if (r.result?.exceptionDetails) console.log('ERROR', JSON.stringify(r.result.exceptionDetails.exception?.description || r.result.exceptionDetails.text));\n  else console.log(JSON.stringify(r.result?.result?.value ?? null, null, 1));\n} else if (cmd === 'stop') {\n  if (existsSync(STATE)) {\n    const { pid } = JSON.parse(readFileSync(STATE, 'utf8'));\n    try { process.kill(-pid); } catch { try { process.kill(pid); } catch { /* gone */ } }\n    rmSync(STATE, { force: true });\n  }\n  rmSync(join(HERE, 'hl-profile'), { recursive: true, force: true });\n  console.log('stopped');\n}\n----\nconst THREE = await import('three');\nwindow.THREE = THREE;\nwindow.post = (name, canvas) => fetch('/__snap/' + name, { method: 'POST', body: canvas.toDataURL('image/jpeg', 0.9) }).then(r => r.status);\nwindow.snap = async (name) => { const G = window.hedgerow.G; G.renderer.render(G.scene, G.camera); return post(name, G.renderer.domElement); };\nwindow.snapCrop = async (name, x, y, w, h, s = 1) => {\n  const G = window.hedgerow.G; G.renderer.render(G.scene, G.camera);\n  const c = document.createElement('canvas'); c.width = w * s; c.height = h * s;\n  c.getContext('2d').drawImage(G.renderer.domElement, x, y, w, h, 0, 0, w * s, h * s);\n  return post(name, c);\n};\nwindow.stand = async (x, z, yaw = 0, pitch = -0.3, wait = 900) => {\n  const G = window.hedgerow.G;\n  G.player.reset([x, z, yaw]);\n  G.rig.yaw = yaw; G.rig.pitch = pitch;\n  await new Promise((r) => setTimeout(r, wait));\n  G.rig.yaw = yaw; G.rig.pitch = pitch;\n  await new Promise((r) => setTimeout(r, 250));\n};\nwindow.lit = (on) => {\n  const G = window.hedgerow.G, L = G.lights;\n  if (!L._upd) L._upd = L.update;\n  L.update = on ? function (dt, t, cam) { L._upd.call(this, dt, t, cam, 0); L.hemi.intensity = 25; L.key.intensity = 8; } : L._upd;\n};\nwindow.startGame = async () => {\n  for (let i = 0; i < 60 && !window.hedgerow?.G?.grass; i++) await new Promise((r) => setTimeout(r, 1000));\n  for (let i = 0; i < 20 && !document.querySelector('[data-action=\"start\"]')?.offsetParent; i++) await new Promise((r) => setTimeout(r, 1000));\n  document.querySelector('[data-action=\"start\"]')?.click();\n  await new Promise((r) => setTimeout(r, 1500));\n  return !!window.hedgerow.G.player;\n};\nreturn { started: await startGame() };\n----\nfor (let i = 0; i < 60 && !window.hedgerow?.G?.clutter; i++) await new Promise((r) => setTimeout(r, 1000));\nconst G = window.hedgerow?.G;\nconst err = document.querySelector('[data-error]')?.hidden === false ? document.querySelector('[data-error-text]')?.textContent : null;\nreturn { loaded: !!G?.clutter, err };\nlocation.reload();\nreturn 'reloading';","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"28097917-cd8e-4ff7-a44c-0d101839acc4","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name