 lane while nothing is in sight; stopped to fight;\n  // a step aside when stuck on something\n  const moving = A.mode === 'advance' && A.settle <= 0.2;\n  if (A.t % 2 < dt) {\n    const moved = Math.hypot(P.pos.x - A.lastPos[0], P.pos.z - A.lastPos[1]);\n    A.side = moving && moved < 0.6 ? (A.side ? 0 : 1) : 0;\n    A.lastPos = [P.pos.x, P.pos.z];\n  }\n  hold('KeyW', moving);\n  hold('KeyD', moving && A.side === 1);\n  hold('ShiftLeft', moving && P.pos.z < 58 && A.side === 0);\n\n  // the grenade: held to cook, let go to throw\n  if (A.grenade === 'cook') {\n    hold('KeyG', A.gT > 0.25 && A.gT < 0.75 && Math.abs(ey) < 0.05);\n    if (A.gT > 0.75) { hold('KeyG', false); A.grenade = 'done'; A.settle = 0.8; }\n  }\n\n  // shooting: aimed down the sights, single shots from the Garand, bursts from the Thompson\n  const aiming = A.mode === 'engage' && A.grenade !== 'cook';\n  input.test.aim(aiming);\n  A.fireT -= dt;\n  let trigger = false;\n  if (aiming && onTarget && ammo.mag > 0 && P.reloading <= 0 && P.switching <= 0) {\n    if (w === 'garand') { if (A.fireT <= 0) { input.test.click(); A.fireT = 0.3 + Math.random() * 0.2; } }\n    else { trigger = A.fireT > -0.45 ? true : false; if (A.fireT < -0.8) A.fireT = 0.3; }\n  }\n  input.test.hold(trigger);\n  if (ammo.mag === 0 && ammo.reserve > 0 && P.reloading <= 0) tap('KeyR');\n\n  pump();\n  return { t: +A.t.toFixed(2), mode: A.mode, z: +P.pos.z.toFixed(1), x: +P.pos.x.toFixed(1), w, mag: ammo.mag, tgt: A.target ? A.target.type : null, d: A.aim ? +A.aim[3].toFixed(1) : null, g: A.grenade };\n}\n\nwindow.__auto = { frame, A, pump };\nreturn 'ok';\n"}},"serverClassifierRequest":"32afc3f0-df57-4908-b21b-d912165278fb","apiBlockIndex":2,"requestId":"req_011CgGx5PqMcGd93AvJrCVuV","requestRef":"aaacb18a-aad1-460b-8722-353b5b5aa92c","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"7633427e-2076-45e1-a985-9003e45e44ae","timestamp":"2026-10-22T08:22:04.728Z","advisorModel":"claude-opus-5-5","effort":"max","perTurn