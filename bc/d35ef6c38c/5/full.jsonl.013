pCrop = async (name, x, y, w, h, s = 1) => {\n  const G = window.hedgerow.G; G.renderer.render(G.scene, G.camera);\n  const c = document.createElement('canvas'); c.width = w * s; c.height = h * s;\n  c.getContext('2d').drawImage(G.renderer.domElement, x, y, w, h, 0, 0, w * s, h * s);\n  return post(name, c);\n};\nwindow.stand = async (x, z, yaw = 0, pitch = -0.3, wait = 900) => {\n  const G = window.hedgerow.G;\n  G.player.reset([x, z, yaw]);\n  G.rig.yaw = yaw; G.rig.pitch = pitch;\n  await new Promise((r) => setTimeout(r, wait));\n  G.rig.yaw = yaw; G.rig.pitch = pitch;\n  await new Promise((r) => setTimeout(r, 250));\n};\nwindow.lit = (on) => {\n  const G = window.hedgerow.G, L = G.lights;\n  if (!L._upd) L._upd = L.update;\n  L.update = on ? function (dt, t, cam) { L._upd.call(this, dt, t, cam, 0); L.hemi.intensity = 25; L.key.intensity = 8; } : L._upd;\n};\nwindow.startGame = async () => {\n  for (let i = 0; i < 60 && !window.hedgerow?.G?.grass; i++) await new Promise((r) => setTimeout(r, 1000));\n  for (let i = 0; i < 20 && !document.querySelector('[data-action=\"start\"]')?.offsetParent; i++) await new Promise((r) => setTimeout(r, 1000));\n  document.querySelector('[data-action=\"start\"]')?.click();\n  await new Promise((r) => setTimeout(r, 1500));\n  return !!window.hedgerow.G.player;\n};\nreturn { started: await startGame() };","is_error":false}]}}
