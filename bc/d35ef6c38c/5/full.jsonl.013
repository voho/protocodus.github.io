X, bounds.minZ);\n  CANOPY_UNIFORMS.uCanopySize.value.set(W * cell, H * cell);\n  return tex;\n}\n\n/* the flare's light this frame (flares.js: a directional light at its position, aimed at its target) */\nexport function setCanopyLight(light) {\n  CANOPY_UNIFORMS.uFlareDir.value.copy(light.position).sub(light.target.position).normalize();\n}\n\nconst CANOPY_GLSL = /* glsl */ `\nuniform sampler2D tCanopy;\nuniform vec2 uCanopyMin, uCanopySize;\nuniform vec3 uFlareDir;\n// how much of a directional light reaches wpos through the crowns: for any but the flare's, all of\n// it; for the flare's, what its shadow map (coord, in it: x and y 0..1) says where that map reaches\n// and the canopy map's estimate where it does not\nfloat canopyFar(vec3 dirView, vec4 coord, vec3 wpos) {\n  vec3 L = (vec4(dirView, 0.0) * viewMatrix).xyz;\n  if (dot(L, uFlareDir) < 0.9995 || uCanopySize.x <= 1.0) return 1.0;\n  float e = min(min(coord.x, 1.0 - coord.x), min(coord.y, 1.0 - coord.y));\n  float inMap = smoothstep(0.02, 0.12, e) * step(coord.z, 1.0);\n  if (inMap >= 1.0) return 1.0;\n  vec2 p = wpos.xz + L.xz / max(L.y, 0.2) * 10.0;\n  float cover = texture2D(tCanopy, (p - uCanopyMin) / uCanopySize).r;\n  return mix(1.0 - 0.9 * cover, 1.0, inMap);\n}\n`;\n\n// three's directional lights' shadow line, with the canopy after it (and, for a light drawn without\n// a shadow map, the canopy alone)\nconst ANCHOR = /(vDirectionalShadowCoord\\[ i \\] \\) : 1\\.0;)(\\s*)#endif/;\nlet patched = null;\nfunction chunk() {\n  if (patched !== null) return patched;\n  const src = THREE.ShaderChunk.lights_fragment_begin;\n  patched = ANCHOR.test(src)\n    ? src.replace(ANCHOR, '$1$2directLight.color *= canopyFar( directLight.direction, vDirectionalShadowCoord[ i ], CANOPY_WPOS );$2#else$2directLight.color *= canopyFar( directLight.direction, vec4( -1.0 ), CANOPY_WPOS );$2#endif')\n    : '';\n  return patched;\n}\n\n/* in a material's onBeforeCompile: its fragment shader's world position (an expression) */\nexport function addCanopy(shader, wpos) {\n  const c = chunk();\n  if (!c || !shader.fragmentShader.includes('#include <lights_fragment_begin>')) return;\n  Object.assign(shader.uniforms, CANOPY_UNIFORMS);\n  shader.fragmentShader = shader.fragmentShader\n    .replace('#include <common>', '#include <common>\\n' + CANOPY_GLSL)\n    .replace('#include <lights_fragment_begin>', c.replaceAll('CANOPY_WPOS', wpos));\n}\n"}},"serverClassifierRequest":"4ffcb950-dbe5-4843-aaa9-cdb62a7f0e99","apiBlockIndex":2,"requestId":"req_011CgGvXabFBDJtjrCv4Bbvp","requestRef":"07f52589-2a2a-4e70-9acf-3ffb63dc3eda","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"138e67ef-c990-4e19-b3c8-82c37669b654","timestamp":"2026-10-22T08:01:47.213Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"transport-playability","slug":"shimmying-swimming-falcon"}
