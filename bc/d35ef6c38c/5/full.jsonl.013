n_ab_views.js >/dev/null; node hl.mjs eval rain_ab_old.js >/dev/null; node hl.mjs eval rain_ab.js | tr -d '\\n' | head -c 300; echo\ncp $S/weather.new.js $W/weather.js\nboot; node hl.mjs eval rain_ab_views.js >/dev/null; node hl.mjs eval rain_ab_new.js >/dev/null; node hl.mjs eval rain_ab.js | tr -d '\\n' | head -c 300; echo\ncmp $S/weather.new.js $W/weather.js && echo restored","description":"Capture old and new rain from four views at one frozen moment","dangerouslyDisableSandbox":true,"timeout":600000},"caller":{"type":"direct"}}]}}
