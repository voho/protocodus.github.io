r (let i = 0; i < route.length - 1; i++) {\n    const [ax, az] = route[i], [bx, bz] = route[i + 1], dx = bx - ax, dz = bz - az, l2 = dx * dx + dz * dz;\n    const t = Math.max(0, Math.min(1, ((x - ax) * dx + (z - az) * dz) / l2));\n    const d = Math.hypot(x - ax - dx * t, z - az - dz * t);\n    if (d < best.d) best = { d, s: cum[i] + t * Math.sqrt(l2) };\n  }\n  return best.s;\n};\nconst pointAt = (s) => {\n  s = Math.min(s, cum[cum.length - 1]);\n  for (let i = 0; i < route.length - 1; i++) {\n    if (s <= cum[i + 1]) { const t = (s - cum[i]) / (cum[i + 1] - cum[i]); return [route[i][0] + (route[i + 1][0] - route[i][0]) * t, route[i][1] + (route[i + 1][1] - route[i][1]) * t]; }\n  }\n  return route[route.length - 1];\n};\n\n// ---- seeing an enemy: the first of chest, head, waist that a ray from the eye reaches ----\nconst SIGHT = 4;\nconst aimPoint = (e) => {\n  const eye = G.camera.position;\n  for (const h of [1.3, 1.55, 0.95]) {\n    const tx = e.pos.x, ty = e.pos.y + h, tz = e.pos.z;\n    const dx = tx - eye.x, dy = ty - eye.y, dz = tz - eye.z, d = Math.hypot(dx, dy, dz);\n    if (d > 58) return null;\n    const hit = G.world.raycast(eye.x, eye.y, eye.z, dx / d, dy / d, dz / d, d, SIGHT);\n    if (!hit || hit.t > d - 0.6) return [tx, ty, tz, d];\n  }\n  return null;\n};\n\nconst wrap = (a) => Math.atan2(Math.sin(a), Math.cos(a));\nconst A = {\n  t: 0, mode: 'advance', target: null, aim: null, lost: 0, fireT: 0.6, settle: 0, engagedFor: 0,\n  yaw: G.rig.yaw, pitch: G.rig.pitch, grenade: 'ready', gT: 0, switched: false, stuckT: 0, lastPos: [0, 0], side: 0,\n};\nlet scan = 0;\n\nfunction frame() {\n  for (const c of taps) key(c, false);\n  taps = [];\n  const P = G.player, eye = G.camera.position, dt = 1 / 60;\n  A.t += dt;\n  const w = P.weapon, ammo = P.ammo[w];\n  // the Thompson for the street's close work\n  if (!A.switched && P.pos.z > 100 && P.reloading <= 0) { tap('Digit2'); A.switched = true; }\n\n  // a target: the nearest enemy in sight, checked a few