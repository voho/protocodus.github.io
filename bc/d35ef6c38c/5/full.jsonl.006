{"type":"api-request-blob","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","hash":"bb81ad4ba9fd30c2d535f4230c1fea2c5933aaf36d61d7972e4cf985dab866ca","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"thinking","thinking":"I found the burning props—`ruin_b`, `truck_burnt`, `halftrack_wreck`, and `beam_charred`—each with their own baked materials. I'll create a `smoulder` variant so their charred areas get slowly pulsing glowing cracks when near a burning fire.\n\n","signature":""},{"type":"tool_use","id":"toolu_018mWxQt41FfjUWpfQMT5e7X","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow && python3 - <<'EOF'\np = 'js/materials.js'\ns = open(p).read()\ndef rep(old, new):\n    global s\n    assert s.count(old) == 1, old\n    s = s.replace(old, new)\nrep(\"\"\"/* how much light comes through the leaves (foliage, addWeather) */\nexport const FOLIAGE_UNIFORMS = { uLeafTrans: { value: 1.6 } };\"\"\", \"\"\"/* how much light comes through the leaves (foliage, addWeather) */\nexport const FOLIAGE_UNIFORMS = { uLeafTrans: { value: 1.6 } };\n\n/* what burns, and smoulders round its fire: the charred wood and metal of a burning ruin or wreck */\nconst SMOULDER = /^(ruin|beam_charred|truck_burnt|halftrack_wreck|jeep_wreck)/;\n/* the fires nearest the camera (x, y, z, size; size 0: none), for the smouldering (updateSmoulder) */\nexport const SMOULDER_UNIFORMS = { uFires: { value: Array.from({ length: 4 }, () => new THREE.Vector4()) } };\nconst near4 = [];\nexport function updateSmoulder(fires, cam) {\n  near4.length = 0;\n  for (const f of fires) {\n    if (!f.on || f.far) continue;\n    near4.push([(f.x - cam.x) ** 2 + (f.z - cam.z) ** 2, f]);\n  }\n  near4.sort((a, b) => a[0] - b[0]);\n  SMOULDER_UNIFORMS.uFires.value.forEach((v, i) => {\n    const f = near4[i]?.[1];\n    if (f) v.set(f.x, f.y, f.z, f.size); else v.set(0, -1000, 0, 0);\n  });\n}\"\"\")\nrep(\"\"\"        streaks: !cards && !CARRIED.test(src.name || ''),\n        rooms: !!src.userData?.rooms,\n      });\"\"\", \"\"\"        streaks: !cards && !CARRIED.test(src.name || ''),\n        rooms: !!src.userData?.rooms,\n        smoulder: !cards && SMOULDER.test(src.name || ''),\n      });\"\"\")\nrep(\"\"\"function addWeather(mat, shared, { porosity = 0.75, detailTex = null, tile = 1, foliage = false, sway = foliage, bark = null, streaks = false, rooms = false }) {\n  const detail = !!detailTex;\n  const tileScale = 1 / tile;\n  mat.customProgramCacheKey = () => 'hedgerow-' + (detail ? 'd' : 'b') + (foliage ? 'f' : '') + (sway ? 'w' : '') + (bark ? 'k' : '') + (streaks ? 's' : '') + (rooms ? 'r' : '') + (mat.normalMap ? 'n' : '');\"\"\", \"\"\"function addWeather(mat, shared, { porosity = 0.75, detailTex = null, tile = 1, foliage = false, sway = foliage, bark = null, streaks = false, rooms = false, smoulder = false }) {\n  const detail = !!detailTex;\n  const tileScale = 1 / tile;\n  mat.customProgramCacheKey = () => 'hedgerow-' + (detail ? 'd' : 'b') + (foliage ? 'f' : '') + (sway ? 'w' : '') + (bark ? 'k' : '') + (streaks ? 's' : '') + (rooms ? 'r' : '') + (smoulder ? 'm' : '') + (mat.normalMap ? 'n' : '');\"\"\")\nrep(\"\"\"      ...(foliage ? FOLIAGE_UNIFORMS : {}),\n    });\"\"\", \"\"\"      ...(foliage ? FOLIAGE_UNIFORMS : {}),\n      ...(smoulder ? SMOULDER_UNIFORMS : {}),\n    });\"\"\")\nrep(\"\"\"    if (rooms) {\n      // the room behind the pane (instead of the baked glow), seen through old glass which\"\"\", \"\"\"    if (smoulder) {\n      // round its fire, the charred wood and metal smoulders: glowing cracks in what is darkest,\n      // breathing slowly, brighter the nearer the flames\n      shader.fragmentShader = shader.fragmentShader\n        .replace('#include <common>', `#include <common>\n        uniform vec4 uFires[4];\n        float smNoise(vec2 p) {\n          vec2 i = floor(p), f = fract(p);\n          f = f * f * (3.0 - 2.0 * f);\n          return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x), mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);\n        }`)\n        .replace('#include <emissivemap_fragment>', `#include <emissivemap_fragment>\n        {\n          float heat = 0.0;\n          for (int i = 0; i < 4; i++) {\n            vec4 f = uFires[i];\n            if (f.w <= 0.0) continue;\n            float d = length(vWPosM - f.xyz);\n            heat = max(heat, 1.0 - smoothstep(0.3 * f.w, 2.4 * f.w, d));\n          }\n          if (heat > 0.0) {\n            float charred = 1.0 - smoothstep(0.025, 0.09, dot(diffuseColor.rgb, vec3(0.3, 0.59, 0.11)));\n            vec2 q = vWPosM.xz * 5.0 + vWPosM.y * vec2(3.1, -2.3);\n            float n = smNoise(q) * 0.6 + smNoise(q * 2.7 + 9.1) * 0.4;\n            float crack = smoothstep(0.58, 0.68, n) * (1.0 - smoothstep(0.68, 0.8, n));\n            float breathe = 0.55 + 0.45 * sin(uTime * 1.3 + smNoise(q * 0.3) * 12.0);\n            totalEmissiveRadiance += vec3(1.0, 0.24, 0.04) * (crack * 2.6 + 0.12) * charred * heat * heat * breathe;\n          }\n        }`);\n    }\n    if (rooms) {\n      // the room behind the pane (instead of the baked glow), seen through old glass which\"\"\")\nopen(p, 'w').write(s)\n\np = 'js/main.js'\ns = open(p).read()\nrep(\"\"\"    G.flames.update(dt, camera.position);\"\"\", \"\"\"    G.flames.update(dt, camera.position);\n    updateSmoulder(G.effects.fires, camera.position);\"\"\")\nold_imp = \"import { createMaterialLibrary\"\ni = s.find(old_imp)\nline_end = s.index('\\n', i)\nline = s[i:line_end]\nprint('import line:', line)\nopen(p, 'w').write(s)\nprint('ok')\nEOF\ngrep -n \"from './materials.js'\" js/main.js","description":"Add the smoulder material variant and its update"},"caller":{"type":"direct"}}]}}
