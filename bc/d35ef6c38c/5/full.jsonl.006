 anti-aliasing (taa.js) —\n426:  const lateScene = new THREE.Scene();\n428:  const late = {\n429:    enabled: false, needsSwap: false, scene: lateScene,\n438:      renderer.render(lateScene, camera);\n443:  function useLate(on, depth = null) {\n444:    late.enabled = on;\n446:    (on ? lateScene : group).add(add.mesh);\n700:    pass, usePass, late, useLate, setLights, shocks, blasts,\n702:    /* the scene depth, its texel and whether to fade by it: for others drawn in the late pass */\n     fading into the scene by its depth (borrowed: depth()). */\n  const lateScene = new THREE.Scene();\n  let lateDepth = null;\n  const late = {\n    enabled: false, needsSwap: false, scene: lateScene,\n    setSize(w, h) { shared.uScreen.value.set(1 / w, 1 / h); },\n    render(renderer, writeBuffer, readBuffer) {\n      const dt = lateDepth ? lateDepth() : null;\n      shared.tDepth.value = dt;\n      shared.uSoft.value = dt ? 1 : 0;\n      const auto = renderer.autoClear;\n      renderer.autoClear = false;\n      renderer.setRenderTarget(readBuffer);\n      renderer.render(lateScene, camera);\n      renderer.autoClear = auto;\n    },\n  };\n  /* the additive system after the anti-aliasing (on, with the scene depth's getter) or with the rest */\n  function useLate(on, depth = null) {\n    late.enabled = on;\n    lateDepth = depth;\n    (on ? lateScene : group).add(add.mesh);\n  }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"31d04b0a-9131-4c13-8fb5-33e55c1cdbb1","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"publi