 = s.replace(old, new)\n# RUTS_GLSL must come before reliefDepth, which now uses it\nrep(\"\"\"        vec2 pxz; float cavity;\n        ${GLSL_HELPERS}\n        ${RUTS_GLSL}\"\"\", \"\"\"        vec2 pxz; float cavity;\n        ${GLSL_HELPERS}\n        ${RUTS_GLSL}\"\"\")\nrep(\"\"\"          vec4 b = max(hw - ma, 0.0) * step(0.002, w);\n          b /= max(dot(b, vec4(1.0)), 1e-4);\n          return dot(b, (1.0 - h) * sc);\n        }`)\"\"\", \"\"\"          vec4 b = max(hw - ma, 0.0) * step(0.002, w);\n          b /= max(dot(b, vec4(1.0)), 1e-4);\n          // and the wheel ruts cut into the mud of the lanes (~7 cm)\n          return dot(b, (1.0 - h) * sc) + rutsAt(xz, b.x).x * sc.x * 1.2;\n        }`)\"\"\")\nrep(\"\"\"          float maxD = max(max(sc.x * step(0.002, wr.x), sc.y * step(0.002, wr.y)), max(sc.z * step(0.002, wr.z), sc.w * step(0.002, wr.w)));\"\"\", \"\"\"          float maxD = max(max(sc.x * step(0.002, wr.x), sc.y * step(0.002, wr.y)), max(sc.z * step(0.002, wr.z), sc.w * step(0.002, wr.w)));\n          // on a rutted lane the ground goes deeper\n          float lane = rutLane(vWPos.xz) * step(0.002, wr.x);\n          maxD = max(maxD, sc.x * 2.2 * lane);\"\"\")\nrep(\"\"\"            float waterD = holdR > 0.3 && levelR > 0.0 ? (1.0 - min(levelR, 1.0)) * dot(wr, sc) / max(dot(wr, vec4(1.0)), 1e-4) : 1e3;\"\"\", \"\"\"            float waterD = holdR > 0.3 && levelR > 0.0 ? (1.0 - min(levelR, 1.0)) * dot(wr, sc) / max(dot(wr, vec4(1.0)), 1e-4) : 1e3;\n            // the water standing in a rut, a little below the lane\n            if (lane > 0.0 && uWet > 0.0 && rutsAt(vWPos.xz, 1.0).y > 0.02) waterD = min(waterD, sc.x * 0.55);\"\"\")\nopen(p, 'w').write(s)\nprint('ok')\nEOF\ngrep -n \"rutLane\\|rutsAt\" js/terrain.js","description":"Revert env change; cut ruts into the relief"}},"serverClassifierRequest":"497d6060-ad79-4ea1-a6d4-3580030a242a","apiBlockIndex":2,"requestId":"req_011CgFhFXt52mhgW5oCZFxHw","requestRef":"8bb60c26-f546-4645-b5cf-26abdb