re2D(tDepth, uv).x;","   if (z >= 1.0) discard;","   vec4 v = uInvProj * vec4(uv * 2.0 - 1.0, z * 2.0 - 1.0, 1.0);","-  vec3 P = (uCamWorld * vec4(v.xyz / v.w, 1.0)).xyz;","+  vec3 V = v.xyz / v.w;","+  vec3 P = (uCamWorld * vec4(V, 1.0)).xyz;","   vec3 c = vPane.xyz, n = vec3(vPane2.x, 0.0, vPane2.y), t = vec3(n.z, 0.0, -n.x);","   float out_ = dot(P - c, n);","   if (out_ < 0.03 || out_ > ${DEPTH.toFixed(1)}) discard;"]},{"oldStart":97,"oldLines":18,"newStart":106,"newLines":26,"lines":["   lit *= mix(1.0, smoothstep(0.02, 0.02 + soft * 2.0, bx), 0.85);","   if (hh > 0.35) lit *= mix(1.0, smoothstep(0.015, 0.015 + soft * 2.0, abs(abs(q.y) - hh / 3.0)), 0.7);","   // as from a glowing window: the inverse square of the distance from it, how squarely the pane","-  // faces this surface and the surface the pane (its normal rebuilt from the depth)","-  vec3 sn = normalize(cross(dFdx(P), dFdy(P)));","+  // faces this surface and the surface the pane (its normal rebuilt from the depth, from the","+  // neighbours on the same surface: the nearer in depth of each pair, so edges stay clean)","+  vec3 r = viewPos(uv + vec2(uScreen.x, 0.0)), l = viewPos(uv - vec2(uScreen.x, 0.0));","+  vec3 t_ = viewPos(uv + vec2(0.0, uScreen.y)), b_ = viewPos(uv - vec2(0.0, uScreen.y));","+  vec3 dx = abs(r.z - V.z) < abs(l.z - V.z) ? r - V : V - l;","+  vec3 dy = abs(t_.z - V.z) < abs(b_.z - V.z) ? t_ - V : V - b_;","+  vec3 sn = normalize(mat3(uCamWorld) * cross(dx, dy));","   if (dot(sn, cameraPosition - P) < 0.0) sn = -sn;","   vec3 hp = P - H;","   float r2 = dot(hp, hp);","   vec3 hd = hp * inversesqrt(r2);","   float e = uPower * hw * hh * max(dot(hd, n), 0.0) * max(dot(sn, -hd), 0.0) / (r2 + hw * hh * 4.0);","   e *= 1.0 - smoothstep(${(DEPTH * 0.6).toFixed(1)}, ${DEPTH.toFixed(1)}, out_);","+  // the rifle in your hands (nearer than 1.2 m) less","+  e *= -V.z < 1.2 ? 0.35 : 1.0;","+  // multiplied in by the blending: the frame times (1 + this)","   gl_FragColor = vec4(uColor * e * lit, 1.0);"," }`;"," ","-export function createWindowLight(panes, { power = 2.4, color = '#ffa860' } = {}) {","+export function createWindowLight(panes, { power = 40, color = '#ffa860' } = {}) {","   if (!panes.length) return null;","   const box = new THREE.BoxGeometry(2, 2, 2);","   const geo = new THREE.InstancedBufferGeometry();"]},{"oldStart":122,"oldLines":14,"newStart":139,"newLines":16,"lines":["   const uniforms = {","     tDepth: { value: null }, uScreen: { value: new THREE.Vector2(1, 1) },","     uInvProj: { value: new THREE.Matrix4() }, uCamWorld: { value: new THREE.Matrix4() },","-    // the room lamps' light, as it lands (an average albedo of what it lands on folded in)","-    uColor: { value: new THREE.Color(color).multiplyScalar(0.12) }, uPower: { value: power },","+    // the room lamps' light over the night's fill light, as a tint (the rest is in uPower)","+    uColor: { value: new THREE.Color(color) }, uPower: { value: power },","   };","   const mat = new THREE.ShaderMaterial({","     vertexShader: VERT, fragmentShader: FRAG, uniforms,","     side: THREE.BackSide, transparent: true, depthTest: false, depthWrite: false,","-    blending: THREE.AdditiveBlending, fog: false,","+    blending: THREE.CustomBlending, fog: false,","   });","+  // the frame times (1 + the light)","+  mat.blendSrc = THREE.DstColorFactor; mat.blendDst = THREE.OneFactor; mat.blendEquation = THREE.AddEquation;","   const mesh = new THREE.Mesh(geo, mat);","   mesh.name = 'windowlight';","   mesh.frustumCulled = false;"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/windowlight.js"]}},"serverClassifierContext":{"request":"440a8328-c0da-493f-9ca3-3e42cd267d03","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":f