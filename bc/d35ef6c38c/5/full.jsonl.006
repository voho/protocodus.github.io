; y <= 1; y++) for (int x = -1; x <= 1; x++) {","+            vec2 g = vec2(float(x), float(y)), o = smHash2(i + g);","+            float d = length(g + o - f);","+            if (d < d1) { d2 = d1; d1 = d; id = dot(i + g, vec2(7.0, 113.0)); } else if (d < d2) d2 = d;","+          }","+          return vec2(d2 - d1, id);","         }`)","         .replace('#include <emissivemap_fragment>', `#include <emissivemap_fragment>","         {"]},{"oldStart":383,"oldLines":12,"newStart":389,"newLines":14,"lines":["             heat = max(heat, 1.0 - smoothstep(0.3 * f.w, 2.4 * f.w, d));","           }","           if (heat > 0.0) {","+            // in what is charred black: the char's alligator cracks glowing, a dull red under them,","+            // each cell breathing on its own","             float charred = 1.0 - smoothstep(0.025, 0.09, dot(diffuseColor.rgb, vec3(0.3, 0.59, 0.11)));","-            vec2 q = vWPosM.xz * 5.0 + vWPosM.y * vec2(3.1, -2.3);","-            float n = smNoise(q) * 0.6 + smNoise(q * 2.7 + 9.1) * 0.4;","-            float crack = smoothstep(0.58, 0.68, n) * (1.0 - smoothstep(0.68, 0.8, n));","-            float breathe = 0.55 + 0.45 * sin(uTime * 1.3 + smNoise(q * 0.3) * 12.0);","-            totalEmissiveRadiance += vec3(1.0, 0.24, 0.04) * (crack * 2.6 + 0.12) * charred * heat * heat * breathe;","+            vec2 q = vWPosM.xz * 9.0 + vWPosM.y * vec2(6.1, -4.3);","+            vec2 cr = smCracks(q);","+            float crack = 1.0 - smoothstep(0.02, 0.09, cr.x);","+            float breathe = 0.5 + 0.5 * sin(uTime * (0.9 + 0.5 * fract(cr.y * 0.37)) + cr.y);","+            totalEmissiveRadiance += vec3(1.0, 0.22, 0.03) * (crack * 1.3 * breathe + 0.07) * charred * heat * heat;","           }","         }`);","     }"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/materials.js"]}},"serverClassifierContext":{"request":"18fd31d5-8c8a-41cd-8a39-c41c8ce78484","context":{"git_s