ngth(P - ro) : 200.0;","     clipRay(ro, rd, c + n * 0.38, n, t0, t1);"]},{"oldStart":166,"oldLines":9,"newStart":167,"newLines":9,"lines":["       if (dot(N, inner - L) < 0.0) N = -N;","       clipRay(ro, rd, L, N, t0, t1);","     }","-    if (t1 > t0) {","-      float dt = (t1 - t0) / 8.0, j = ign(gl_FragCoord.xy), sum = 0.0;","-      for (int i = 0; i < 8; i++) {","+    if (t1 > t0 + 0.02) {","+      float dt = (t1 - t0) / 5.0, j = ign(gl_FragCoord.xy), sum = 0.0;","+      for (int i = 0; i < 5; i++) {","         vec3 X = ro + rd * (t0 + (float(i) + j) * dt);","         float ox = dot(X - c, n);","         vec3 H;"]},{"oldStart":176,"oldLines":9,"newStart":177,"newLines":9,"lines":["         vec3 hp = X - H;","         float r2 = dot(hp, hp);","         vec3 hd = hp * inversesqrt(r2);","-        // Henyey-Greenstein, g 0.45: brightest looking back along the beam into the window","-        float cs = dot(hd, -rd), g = 0.45;","-        float ph = (1.0 - g * g) / pow(1.0 + g * g - 2.0 * g * cs, 1.5);","+        // scattered mostly forward (Schlick's Henyey-Greenstein, g ~0.45): brightest looking back","+        // along the beam into the window","+        float ph = 0.583 / ((1.0 - 0.646 * dot(hd, -rd)) * (1.0 - 0.646 * dot(hd, -rd)));","         sum += lit * max(dot(hd, n), 0.0) / (r2 + hw * hh * 4.0) * ph","           * smoothstep(0.38, 0.8, ox) * (1.0 - smoothstep(${(DEPTH * 0.5).toFixed(1)}, ${DEPTH.toFixed(1)}, ox));","       }"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/windowlight.js"]}},"serverClassifierContext":{"request":"28491a96-63ea-462b-a10a-f8a006fb6112","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal"