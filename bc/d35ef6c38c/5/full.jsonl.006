:7,"newStart":62,"newLines":7,"lines":["   const qx = (x * ux + z * uz) / 30 - time * 7 / 30, qy = (x * -uz + z * ux) * 0.45 / 30;","   const n = gNoise(qx, qy) * 0.7 + gNoise(qx * 2.3 + 5.1, qy * 2.3 + 5.1) * 0.3;","   const t = Math.min(1, Math.max(0, (n - 0.3) / 0.45));","-  return 0.35 + 1.25 * t * t * (3 - 2 * t);","+  return 0.55 + 1.05 * t * t * (3 - 2 * t);"," }"," "," const RAIN_VERT = /* glsl */ `"]},{"oldStart":450,"oldLines":7,"newStart":450,"newLines":7,"lines":["     splashUniforms.uTime.value = time;"," ","     // splashes around the camera, as many as the gust over it brings","-    const g = gustAt(camera.position.x, camera.position.z, time, rainUniforms.uVel.value.x, rainUniforms.uVel.value.z) * 1.15;","+    const g = gustAt(camera.position.x, camera.position.z, time, rainUniforms.uVel.value.x, rainUniforms.uVel.value.z);","     splashAcc += dt * 900 * rainAmount * g;","     const cx = camera.position.x, cz = camera.position.z;","     let changed = false;"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/weather.js"]}},"serverClassifierContext":{"request":"cd4911b5-47a5-4a22-8782-5fdb75f5839c","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","platform"