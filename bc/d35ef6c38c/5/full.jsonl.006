ity) {\n250:  return { terrain, world, veg, placed, enemyDefs, cover, lamps, fires, water, staticGroup, height };\n307:function buildRiver(W, textures, shared) {","is_error":false}]},"uuid":"88a715cf-4230-42af-ad61-6c654fb553c7","timestamp":"2026-10-21T16:35:13.519Z","toolUseResult":{"stdout":"  const sz = Math.min(Math.abs(b.min.z), Math.abs(b.max.z)) * scale * 0.8;\n  for (const [lx, lz] of [[sx, sz], [-sx, sz], [sx, -sz], [-sx, -sz]]) {\n    lo = Math.min(lo, terrain.height(x + lx * c + lz * s, z - lx * s + lz * c));\n  }\n  return lo;\n}\n\nfunction buildRiver(W, textures, shared) {\n  const segs = 100;\n  const pos = [], uv = [], idx = [];\n  for (let i = 0; i <= segs; i++) {\n    const x = W.x0 + (W.x1 - W.x0) * (i / segs);\n    const zc = W.riverZ(x);\n    for (const side of [-1, 1]) {\n      pos.push(x, W.level, zc + side * 13);\n      uv.push(x / 10, side);\n    }\n  }\n  for (let i = 0; i < segs; i++) {\n    const a = i * 2, b = a + 1, c = a + 2, d = a + 3;\n    idx.push(a, b, c, b, d, c);\n  }\n  const geo = new THREE.BufferGeometry();\n  geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\n  geo.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));\n  geo.setAttribute('normal', new THREE.Float32BufferAttribute(pos.map((_, i) => (i % 3 === 1 ? 1 : 0)), 3));\n  geo.setIndex(idx);\n  const mesh = new THREE.Mesh(geo, createWaterMaterial(textures, shared));\n  mesh.name = 'river';\n  return mesh;\n}\n\n/* Is (x, z) inside (or within 0.3 m of) something solid standing on the ground? */\nexport function insideSolid(world, terrain, x, z) {\n  const g = terrain.height(x, z);\n  for (const c of world.query(x - 0.5, z - 0.5, x + 0.5, z + 0.5)) {\n    if (!(c.flags & 1) || c.top - g < 0.15) continue;\n    const rx = x - c.x, rz = z - c.z;\n    if (c.type === 'box' ? Math.abs(rx * c.c - rz * c.s) <= c.hx + 0.3 && Math.abs(rx * c.s + rz * c.c) <= c.hz + 0.3\n      : rx * rx + rz * rz <= (c.r + 0.3) ** 2) return true;\n  }\n  return false;\n}