normalMap ? 'n' : '');","+  mat.customProgramCacheKey = () => 'hedgerow-' + (detail ? 'd' : 'b') + (foliage ? 'f' : '') + (sway ? 'w' : '') + (bark ? 'k' : '') + (streaks ? 's' : '') + (rooms ? 'r' : '') + (smoulder ? 'm' + smoulder[0] : '') + (mat.normalMap ? 'n' : '');","   mat.onBeforeCompile = (shader) => {","     Object.assign(shader.uniforms, {","       uTile: { value: tileScale }, uPorosity: { value: porosity },"]},{"oldStart":389,"oldLines":14,"newStart":390,"newLines":18,"lines":["             heat = max(heat, 1.0 - smoothstep(0.3 * f.w, 2.4 * f.w, d));","           }","           if (heat > 0.0) {","-            // in what is charred black: the char's alligator cracks glowing, a dull red under them,","-            // each cell breathing on its own","             float charred = 1.0 - smoothstep(0.025, 0.09, dot(diffuseColor.rgb, vec3(0.3, 0.59, 0.11)));","             vec2 q = vWPosM.xz * 9.0 + vWPosM.y * vec2(6.1, -4.3);","             vec2 cr = smCracks(q);","-            float crack = 1.0 - smoothstep(0.02, 0.09, cr.x);","             float breathe = 0.5 + 0.5 * sin(uTime * (0.9 + 0.5 * fract(cr.y * 0.37)) + cr.y);","-            totalEmissiveRadiance += vec3(1.0, 0.22, 0.03) * (crack * 1.3 * breathe + 0.07) * charred * heat * heat;","+            ${smoulder === 'wood'","+              ? `// charred wood: the char's alligator cracks glowing, a dull red under them, each cell","+            // breathing on its own","+            float crack = 1.0 - smoothstep(0.02, 0.09, cr.x);","+            totalEmissiveRadiance += vec3(1.0, 0.22, 0.03) * (crack * 1.3 * breathe + 0.07) * charred * heat * heat;`","+              : `// hot metal: a dull red glow, mottled, strongest nearest the flames","+            float mottle = 0.6 + 0.4 * smoothstep(0.0, 0.3, cr.x);","+            totalEmissiveRadiance += vec3(1.0, 0.16, 0.02) * 0.32 * mottle * (0.75 + 0.25 * breathe) * charred * heat * heat * heat;`}","           }","         }`);","     }"]}]}],"moreFiles":0,"changed