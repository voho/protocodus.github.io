t = vec3(0.0);"]},{"oldStart":96,"oldLines":6,"newStart":119,"newLines":7,"lines":[" }`;"," "," const SHEET_FRAG = /* glsl */ `","+${GUST_GLSL}"," uniform vec3 uColor, uVel, uSky;"," uniform float uTime, uOpacity, uFlash, uFog;"," uniform vec3 uLightPos[6];"]},{"oldStart":140,"oldLines":7,"newStart":164,"newLines":7,"lines":["     float x0 = 0.25 + 0.5 * sHash(id + 3.7), y0 = 0.7 * sHash(id + 7.1);","     float sx = 1.0 - smoothstep(0.4, 1.0, abs(f.x - x0) * 5.0);","     float sy = smoothstep(y0, y0 + 0.04, f.y) * smoothstep(y0 + len / 2.4, y0 + len / 2.4 - 0.08, f.y);","-    float k = sx * sy * vis * exp(-t * uFog) * (0.6 + 0.8 * sHash(id + 11.3));","+    float k = sx * sy * vis * exp(-t * uFog) * (0.6 + 0.8 * sHash(id + 11.3)) * gust(P.xz, uTime, uVel.xz);","     if (k <= 0.0) continue;","     // lit by the lamps near it","     vec3 lit = uSky;"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/weather.js"]}},"serverClassifierContext":{"request":"870d2f65-04fe-4bee-b71f-25c9423de280","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"fda1387b-46b6-4c8f-90b3-0d0d214b06f1","permissionDecision":{"deci