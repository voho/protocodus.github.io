) => new THREE.Vector4()) } };","+const near4 = [];","+export function updateSmoulder(fires, cam) {","+  near4.length = 0;","+  for (const f of fires) {","+    if (!f.on || f.far) continue;","+    near4.push([(f.x - cam.x) ** 2 + (f.z - cam.z) ** 2, f]);","+  }","+  near4.sort((a, b) => a[0] - b[0]);","+  SMOULDER_UNIFORMS.uFires.value.forEach((v, i) => {","+    const f = near4[i]?.[1];","+    if (f) v.set(f.x, f.y, f.z, f.size); else v.set(0, -1000, 0, 0);","+  });","+}","+"," /* what rain does not run down in rivulets: the soldiers, their kit and weapons (and, by","    palette key, cloth, skin and the like) */"," const CARRIED = /^(allied|axis|m1_garand|thompson|kar98k|mp40|mg42|grenade)/;"]},{"oldStart":172,"oldLines":6,"newStart":190,"newLines":7,"lines":["         bark: bk ? { tex: textures.bark, k: bk[1], moss: bk[2] } : null,","         streaks: !cards && !CARRIED.test(src.name || ''),","         rooms: !!src.userData?.rooms,","+        smoulder: !cards && SMOULDER.test(src.name || ''),","       });","       baked.set(src.uuid, m);","       return m;"]},{"oldStart":188,"oldLines":10,"newStart":207,"newLines":10,"lines":["    With `detailTex` (palette materials) a tiling detail texture (RGB normal,","    A albedo detail) in metre UVs adds the surface grain. `rooms`: lit","    window panes (rooms.js) show the room behind them. */","-function addWeather(mat, shared, { porosity = 0.75, detailTex = null, tile = 1, foliage = false, sway = foliage, bark = null, streaks = false, rooms = false }) {","+function addWeather(mat, shared, { porosity = 0.75, detailTex = null, tile = 1, foliage = false, sway = foliage, bark = null, streaks = false, rooms = false, smoulder = false }) {","   const detail = !!detailTex;","   const tileScale = 1 / tile;","-  mat.customProgramCacheKey = () => 'hedgerow-' + (detail ? 'd' : 'b') + (foliage ? 'f' : '') + (sway ? 'w' : '') + (bark ? 'k' : '') + (streaks ? 's' : '') + (rooms ? 'r' : '') + (mat.normalMap ? 'n' : '');","+  mat.customProgramCacheKey = () => 'hedgerow-' + (detail ? 'd' : 'b') + (foliage ? 'f' : '') + (sway ? 'w' : '') + (bark ? 'k' : '') + (streaks ? 's' : '') + (rooms ? 'r' : '') + (smoulder ? 'm' : '') + (mat.normalMap ? 'n' : '');","   mat.onBeforeCompile = (shader) => {","     Object.assign(shader.uniforms, {","       uTile: { value: tileScale }, uPorosity: { value: porosity },"]},{"oldStart":200,"oldLines":6,"newStart":219,"newLines":7,"lines":["       ...(bark ? { tBark: { value: bark.tex }, uBark: { value: bark.k }, uMoss: { value: bark.moss } } : {}),","       ...(rooms ? ROOM_UNIFORMS : {}),","       ...(foliage ? FOLIAGE_UNIFORMS : {}),","+      ...(smoulder ? SMOULDER_UNIFORMS : {}),","     });","     shader.vertexShader = shader.vertexShader","       .replace('#include <common>', `#include <common>"]},{"oldStart":341,"oldLines":6,"newStart":361,"newLines":36,"lines":["         #ifdef OPAQUE","           gl_FragColor.a = mirrorAlpha(roughnessFactor, mWetUp);","         #endif`);","+    if (smoulder) {","+      // round its fire, the charred wood and metal smoulders: glowing cracks in what is darkest,","+      // breathing slowly, brighter the nearer the flames","+      shader.fragmentShader = shader.fragmentShader","+        .replace('#include <common>', `#include <common>","+        uniform vec4 uFires[4];","+        float smNoise(vec2 p) {","+          vec2 i = floor(p), f = fract(p);","+          f = f * f * (3.0 - 2.0 * f);","+          return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x), mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);","+        }`)","+        .replace('#include <emissivemap_fragment>', `#include <emissivemap_fragment>","+        {","+          float heat = 0.0;","+          for (int i = 0; i < 4; i++) {","+            vec4 f = uFires[i];","+            if (f.w <= 0.0) continue;","+            float d = length(vWPosM - f.xyz);","+            heat = max(heat, 1.0 - smoothstep(0.3 * f.w, 2.4 * f.w, d));","+          }","+          if (heat > 0.0) {","+            float charred = 1.0 - smoothstep(0.025, 0.09, dot(diffuseColor.rgb, vec3(0.3, 0.59, 0.11)));","+            vec2 q = vWPosM.xz * 5.0 + vWPosM.y * vec2(3.1, -2.3);","+            float n = smNoise(q) * 0.6 + smNoise(q * 2.7 + 9.1) * 0.4;","+            float crack = smoothstep(0.58, 0.68, n) * (1.0 - smoothstep(0.68, 0.8, n));","+            float breathe = 0.55 + 0.45 * sin(uTime * 1.3 + smNoise(q * 0.3) * 12.0);","+            totalEmissiveRadiance += vec3(1.0, 0.24, 0.04) * (crack * 2.6 + 0.12) * charred * heat * heat * breathe;","+          }","+        }`);","+    }","     if (rooms) {","       // the room behind the pane (instead of the baked glow), seen through old glass which","       // takes little light itself; running rain bends the view. The curtains drawn back in"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/materials.js"]}},"serverClassifierContext":{"request":"9b488901-85b2-42eb-b095-df46ca8400c3","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUU