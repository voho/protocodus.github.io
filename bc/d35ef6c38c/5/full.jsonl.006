 2 * t); };"," ","-/* lines: {name: [[x, z], ...]}; which: the ones that get ruts */","-export function createRuts(lines, which = ['LANE', 'TRACK']) {","-  const roads = which.map((k) => lines?.[k]).filter((l) => l && l.length > 1);","+/* lines: {name: [[x, z], ...]}; which: the ones that get ruts; gutters: the ones whose edges","+   carry running water (height(x, z): the ground, for which way it runs) */","+export function createRuts(lines, which = ['LANE', 'TRACK'], { gutters = [], height = null } = {}) {","+  const roads = [","+    ...which.map((k) => lines?.[k]).filter((l) => l && l.length > 1).map((l) => ({ l, reach: REACH, gutter: false })),","+    ...gutters.map((k) => lines?.[k]).filter((l) => l && l.length > 1).map((l) => ({ l, reach: GREACH, gutter: true })),","+  ];","   if (!roads.length) return null;","   let x0 = Infinity, z0 = Infinity, x1 = -Infinity, z1 = -Infinity;","-  for (const l of roads) for (const [x, z] of l) { x0 = Math.min(x0, x); x1 = Math.max(x1, x); z0 = Math.min(z0, z); z1 = Math.max(z1, z); }","-  x0 -= REACH + 1; z0 -= REACH + 1; x1 += REACH + 1; z1 += REACH + 1;","+  for (const { l } of roads) for (const [x, z] of l) { x0 = Math.min(x0, x); x1 = Math.max(x1, x); z0 = Math.min(z0, z); z1 = Math.max(z1, z); }","+  x0 -= GREACH + 1; z0 -= GREACH + 1; x1 += GREACH + 1; z1 += GREACH + 1;","   const w = Math.ceil((x1 - x0) / RES), h = Math.ceil((z1 - z0) / RES);","   // far from any lane by default","   const best = new Float32Array(w * h).fill(Infinity);","   const data = new Uint16Array(w * h * 2);","-  const far = THREE.DataUtils.toHalfFloat(REACH + 1);","+  const far = THREE.DataUtils.toHalfFloat(9);","   for (let i = 0; i < w * h; i++) data[i * 2] = far;","-  for (const l of roads) {","+  for (const { l, reach, gutter } of roads) {","+    // a gutter's water runs downhill: at each point of the line, which way and how fast (-1..1)","+    const flow = l.map((p, i) => {","+      if (!gutter || !height) return 0;","+      const a = l[Math.max(0, i - 1)], b = l[Math.min(l.length - 1, i + 1)];","+      const run = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;","+      return Math.max(-1, Math.min(1, (height(a[0], a[1]) - height(b[0], b[1])) / run * 400));","+    });","     let along = 0;","     for (let s = 0; s < l.length - 1; s++) {","       const [ax, az] = l[s], [bx, bz] = l[s + 1];","       const dx = bx - ax, dz = bz - az, len = Math.hypot(dx, dz) || 1e-6;","       // the texels within reach of this segment","-      const i0 = Math.max(0, Math.floor((Math.min(ax, bx) - REACH - x0) / RES)), i1 = Math.min(w - 1, Math.ceil((Math.max(ax, bx) + REACH - x0) / RES));","-      const j0 = Math.max(0, Math.floor((Math.min(az, bz) - REACH - z0) / RES)), j1 = Math.min(h - 1, Math.ceil((Math.max(az, bz) + REACH - z0) / RES));","+      const i0 = Math.max(0, Math.floor((Math.min(ax, bx) - reach - x0) / RES)), i1 = Math.min(w - 1, Math.ceil((Math.max(ax, bx) + reach - x0) / RES));","+      const j0 = Math.max(0, Math.floor((Math.min(az, bz) - reach - z0) / RES)), j1 = Math.min(h - 1, Math.ceil((Math.max(az, bz) + reach - z0) / RES));","       for (let j = j0; j <= j1; j++) for (let i = i0; i <= i1; i++) {","         const x = x0 + (i + 0.5) * RES, z = z0 + (j + 0.5) * RES;","         const t = Math.min(1, Math.max(0, ((x - ax) * dx + (z - az) * dz) / (len * len)));","         const px = ax + dx * t, pz = az + dz * t;","         const d = Math.hypot(x - px, z - pz);","         const k = j * w + i;","-        if (d >= best[k] || d > REACH) continue;","+        if (d >= best[k] || d > reach) continue;","         best[k] = d;","         // signed: which side of the lane (right of the way it runs is positive), wandering","-        // a little along it; water in the ruts in stretches, some long, some a puddle's length","+        // a little along it; water in the ruts in stretches, some long, some a puddle's length;","+        // in a gutter, -1.5 + half its flow","         const side = Math.sign(dz * (x - px) - dx * (z - pz)) || 1;","         const a = along + t * len;","-        data[k * 2] = THREE.DataUtils.toHalfFloat(d * side + (noise1(a * 0.11) - 0.5) * 0.35);","-        data[k * 2 + 1] = THREE.DataUtils.toHalfFloat(smooth(0.42, 0.62, noise1(a * 0.07 + 3.1) * 0.75 + noise1(a * 0.31 + 7.7) * 0.25));","+        data[k * 2] = THREE.DataUtils.toHalfFloat(d * side + (noise1(a * 0.11) - 0.5) * (gutter ? 0.08 : 0.35));","+        data[k * 2 + 1] = THREE.DataUtils.toHalfFloat(gutter ? -1.5 + 0.5 * (flow[s] + (flow[s + 1] - flow[s]) * t)","+          : smooth(0.42, 0.62, noise1(a * 0.07 + 3.1) * 0.75 + noise1(a * 0.31 + 7.7) * 0.25));","       }","       along += len;","     }"]},{"oldStart":69,"oldLines":7,"newStart":88,"newLines":8,"lines":[" }"," "," /* GLSL: rutsAt(xz, mud) -> vec3(the trough 0..1, water standing in it 0..1, the crown 0..1);","-   rutLane(xz): on a rutted lane */","+   rutLane(xz): on a rutted lane; gutterAt(xz): how much of a gutter's stream is here (0..1);","+   gutterWaves(xz, time): the slope its wavelets give the water (world xz), running downstream */"," export const RUTS_GLSL = /* glsl */ `","   uniform sampler2D tRut;","   uniform vec2 uRutMin, uRutSize;"]},{"oldStart":77,"oldLines":12,"newStart":97,"newLines":35,"lines":["   float rutLane(vec2 xz) {","     vec2 q = (xz - uRutMin) / uRutSize;","     if (q.x <= 0.0 || q.y <= 0.0 || q.x >= 1.0 || q.y >= 1.0) return 0.0;","-    return step(abs(texture2D(tRut, q).r), 1.6);","+    vec2 r = texture2D(tRut, q).rg;","+    return step(abs(r.x), 1.6) * step(-0.5, r.y);","+  }","+  float gutterAt(vec2 xz) {","+    vec2 q = (xz - uRutMin) / uRutSize;","+    if (q.x <= 0.0 || q.y <= 0.0 || q.x >= 1.0 || q.y >= 1.0) return 0.0;","+    vec2 r = texture2D(tRut, q).rg;","+    if (r.y > -0.75) return 0.0;","+    return 1.0 - smoothstep(0.1, 0.3, abs(abs(r.x) - ${GUTTER.toFixed(2)}));","+  }","+  vec2 gutterWaves(vec2 xz, float time) {","+    vec2 q = (xz - uRutMin) / uRutSize;","+    vec2 r = texture2D(tRut, q).rg;","+    // along the street: across the distance field's gradient (two more fetches, only on the stream)","+    float gx = texture2D(tRut, q + vec2(${RES} / uRutSize.x, 0.0)).r - r.x;","+    float gz = texture2D(tRut, q + vec2(0.0, ${RES} / uRutSize.y)).r - r.x;","+    float s = clamp((r.y + 1.5) * 2.0, -1.0, 1.0);","+    vec2 down = normalize(vec2(-gz, gx) + vec2(1e-6, 0.0)) * (s < 0.0 ? -1.0 : 1.0);","+    float v = 0.35 + 0.65 * abs(s);","+    float a = dot(xz, down);","+    float ph = (a - time * 0.7 * v) * 13.0 + sin(r.x * 11.0) * 1.3;","+    float ph2 = (a - time * 0.5 * v) * 27.0 + r.x * 7.0;","+    return down * (cos(ph) * 0.22 + cos(ph2) * 0.1);","   }","   vec3 rutsAt(vec2 xz, float mud) {","     vec2 q = (xz - uRutMin) / uRutSize;","     if (mud < 0.01 || q.x <= 0.0 || q.y <= 0.0 || q.x >= 1.0 || q.y >= 1.0) return vec3(0.0);","     vec2 r = texture2D(tRut, q).rg;","+    if (r.y < -0.5) return vec3(0.0);","     // two ruts a cart's track apart (1.56 m), a crown between them","     float off = abs(abs(r.x) - 0.78);","     float trough = (1.0 - smoothstep(0.09, 0.23, off)) * mud;"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/terrain.js","hunks":[{"oldStart":200,"oldLines":7,"newStart":200,"newLines":7,"lines":["         varying vec4 vSplat;","         varying vec3 vWPos;","         varying vec3 vWNormal;","-        vec3 tNormal; float tRough; float tPuddle; float tRim; float tShore; float tSwardK;","+        vec3 tNormal; float tRough; float tPuddle; float tRim; float tShore; float tSwardK; float tGutter;","         vec2 pxz; float cavity;","         ${GLSL_HELPERS}","         ${RUTS_GLSL}"]},{"oldStart":253,"oldLines":8,"newStart":253,"newLines":10,"lines":["             // the water's surface caps the march","             float holdR = (wr.x + wr.w + wr.z * 0.35) / max(dot(wr, vec4(1.0)), 1e-4) * uWet;","             float waterD = holdR > 0.3 && levelR > 0.0 ? (1.0 - min(levelR, 1.0)) * dot(wr, sc) / max(dot(wr, vec4(1.0)), 1e-4) : 1e3;","-            // the water standing in a rut, a little below the lane","+            // the water standing in a rut, a little below the lane; running in a gutter, over all but","+            // the tops of the cobbles","             if (lane > 0.0 && uWet > 0.0 && rutsAt(vWPos.xz, 1.0).y > 0.02) waterD = min(waterD, sc.x * 0.55);","+            if (uWet > 0.0 && gutterAt(vWPos.xz) > 0.3) waterD = min(waterD, sc.w * 0.45);","             const int STEPS = 12;","             float layer = maxD / float(STEPS);","             float d = 0.0, srf = min(reliefDepth(pxz, wr, gx, gy, sc), waterD);"]},{"oldStart":326,"oldLines":6,"newStart":328,"newLines":9,"lines":["           tPuddle *= 1.0 - tSwardK;","           tRim *= 1.0 - tSwardK;","         }","+        // water running in the street's gutters, over all but the tops of the cobbles","+        tGutter = gutterAt(pxz) * uWet * (1.0 - rockW);","+        tPuddle = max(tPuddle, tGutter * (1.0 - smoothstep(0.6, 0.85, hts.w)));","         // the wheel ruts of the lanes: dark wet mud, water standing in them in stretches, a","         // grassy crown between them","         vec3 ruts = rutsAt(pxz, b.x * (1.0 - rockW));"]},{"oldStart":356,"oldLines":6,"newStart":361,"newLines":8,"lines":["           // rain rings in puddles","           vec2 rip = rainRipples(pxz * 1.7, uTime) * uRain;","           nts.xy += rip * tPuddle * 0.9;","+          // the gutter's stream runs downhill in wavelets","+          if (tGutter > 0.01) nts.xy += gutterWaves(pxz, uTime) * tGutter * tPuddle;","           mat3 tbn = cotangentFrame(normal, -vViewPosition, vWPos.xz);","           normal = normalize(tbn * normalize(nts));","         }"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/ruts.js","/Users/vojta/Dev/protocodus.github.io/.claude/work