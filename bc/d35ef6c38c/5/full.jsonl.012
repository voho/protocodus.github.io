 s[c]);\n      n++;\n    }\n    for (; n < LAMPS; n++) LP[n].w = 0;\n  }","originalFile":null,"structuredPatch":[{"oldStart":764,"oldLines":6,"newStart":764,"newLines":25,"lines":["       const k = Math.min(l.intensity, 40) * 0.05;","       C[i].set(l.color.r * k, l.color.g * k, l.color.b * k);","     }","+    // the rain in the lamplight: round the nearest lamps under their caps, fires and flashes within","+    // 30 m (fading in from 22), not round a lamp in a window (its light may be inside a room)","+    const cam = rainUniforms.uCam.value, LP = glintUniforms.uLamp.value, LC = glintUniforms.uLampCol.value;","+    const SH = glintUniforms.uShelter.value;","+    let n = 0;","+    for (const l of list) {","+      if (n >= LAMPS) break;","+      if (!l || !(l.cone != null || (l.fog != null && l.fog < 1))) continue;","+      const d = Math.hypot(l.x - cam.x, l.y - cam.y, l.z - cam.z);","+      if (d > 30) continue;","+      const r = Math.min(4.5, Math.max(2.2, l.range * 0.25)), f = Math.min(1, Math.max(0, (d - 22) / 8));","+      const k = Math.min(l.intensity, 40) * 0.05 * (1 - f * f * (3 - 2 * f));","+      LP[n].set(l.x, l.y, l.z, r);","+      LC[n].set(l.color.r * k, l.color.g * k, l.color.b * k, l.cone ?? -2);","+      const s = shelterOf(l.x, l.z, r);","+      for (let c = 0; c < GRID * GRID; c++) SH[(n * GRID * GRID + c) >> 2].setComponent((n * GRID * GRID + c) & 3, s[c]);","+      n++;","+    }","+    for (; n < LAMPS; n++) LP[n].w = 0;","   }"," ","   /* the rain drawn in another scene after the frame (the late pass of effects.js, hidden"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"serverClassifierContext":{"request":"adb48f2e-88a0-4cab-9890-3ee2a6625efe","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"cou