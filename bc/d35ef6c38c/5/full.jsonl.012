{"parentUuid":"7daa1f4d-1edd-44a6-ac35-3932b48ed2be","isSidechain":false,"promptId":"17b7ed16-a101-4402-afdd-06026f97016b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jf5aGeyYY6panQQdKZCzBV","type":"tool_result","content":"float fbm(vec2 p) { float s = 0.0, a = 0.5; for (int i = 0; i < 4; i++) { s += a * noise(p); p = p * 2.03 + 17.1; a *= 0.5; } return s; }\nvoid main() {\n  float t = uTime + vSeed * 7.3;\n  vec2 uv = vUv;                 // x: -1..1 across, y: 0..1 up\n  // noise rising through it, faster higher up; the flame bends with it\n  float n1 = fbm(vec2(uv.x * 1.6 + vSeed * 3.1, uv.y * 2.2 - t * 2.1));\n  float n2 = fbm(vec2(uv.x * 3.4 - vSeed * 1.7, uv.y * 4.0 - t * 3.6));\n  float x = uv.x + (n1 - 0.5) * 0.9 * uv.y;\n  // wide at the base, licking up to points, eaten away from above\n  float width = mix(0.9, 0.08, pow(uv.y, 0.7));\n  float body = 1.0 - smoothstep(width * 0.45, width, abs(x));\n  body *= 1.0 - smoothstep(0.25, 0.95, uv.y + (n2 - 0.5) * 0.6 - (n1 - 0.5) * 0.3);\n  // a ragged base, fading in (it rises out of something, not off a line)\n  body *= smoothstep(0.0, 0.28, uv.y + (n1 - 0.5) * 0.3);\n  // broken into tongues by the rising noise (more of it whole near the base)\n  body *= smoothstep(0.3, 0.62, n2 + (1.0 - uv.y) * 0.32);\n  float heat = clamp(body * (1.05 - uv.y * 0.8) * (0.5 + 0.6 * n1), 0.0, 1.0);\n  if (heat < 0.04) discard;\n  // a black body: deep red at the ragged edges, mostly orange, yellow, white only at the hottest\n  vec3 col = mix(vec3(0.45, 0.04, 0.0), vec3(1.0, 0.3, 0.02), smoothstep(0.05, 0.35, heat));\n  col = mix(col, vec3(1.0, 0.6, 0.12), smoothstep(0.35, 0.65, heat));\n  col = mix(col, vec3(1.0, 0.85, 0.45), smoothstep(0.65, 0.85, heat));\n  col = mix(col, vec3(1.0, 0.95, 0.8), smoothstep(0.88, 1.0, heat));\n  float a = smoothstep(0.04, 0.35, heat);\n  // drawn over the finished frame: hidden behind what is in front, soft where it meets it\n  if (uSoft > 0.5) {\n    float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;\n    a *= clamp((vProj.y / (zd + vProj.x) - vDist) / 0.35, 0.0, 1.0);\n  }\n  gl_FragColor = vec4(col * a * uGain, 1.0);\n}`;","is_error":false}]},"uuid":"ab526f26-2c03-4825-829d-5be692a3f6d8","timestamp":"2026-10-22T03:05:24.621Z","toolUseResult":{"stdout":"float fbm(vec2 p) { float s = 0.0, a = 0.5; for (int i = 0; i < 4; i++) { s += a * noise(p); p = p * 2.03 + 17.1; a *= 0.5; } return s; }\nvoid main() {\n  float t = uTime + vSeed * 7.3;\n  vec2 uv = vUv;                 // x: -1..1 across, y: 0..1 up\n  // noise rising through it, faster higher up; the flame bends with it\n  float n1 = fbm(vec2(uv.x * 1.6 + vSeed * 3.1, uv.y * 2.2 - t * 2.1));\n  float n2 = fbm(vec2(uv.x * 3.4 - vSeed * 1.7, uv.y * 4.0 - t * 3.6));\n  float x = uv.x + (n1 - 0.5) * 0.9 * uv.y;\n  // wide at the base, licking up to points, eaten away from above\n  float width = mix(0.9, 0.08, pow(uv.y, 0.7));\n  float body = 1.0 - smoothstep(width * 0.45, width, abs(x));\n  body *= 1.0 - smoothstep(0.25, 0.95, uv.y + (n2 - 0.5) * 0.6 - (n1 - 0.5) * 0.3);\n  // a ragged base, fading in (it rises out of something, not off a line)\n  body *= smoothstep(0.0, 0.28, uv.y + (n1 - 0.5) * 0.3);\n  // broken into tongues by the rising noise (more of it whole near the base)\n  body *= smoothstep(0.3, 0.62, n2 + (1.0 - uv.y) * 0.32);\n  float heat = clamp(body * (1.05 - uv.y * 0.8) * (0.5 + 0.6 * n1), 0.0, 1.0);\n  if (heat < 0.04) discard;\n  // a black body: deep red at the ragged edges, mostly orange, yellow, white only at the hottest\n  vec3 col = mix(vec3(0.45, 0.04, 0.0), vec3(1.0, 0.3, 0.02), smoothstep(0.05, 0.35, heat));\n  col = mix(col, vec3(1.0, 0.6, 0.12), smoothstep(0.35, 0.65, heat));\n  col = mix(col, vec3(1.0, 0.85, 0.45), smoothstep(0.65, 0.85, heat));\n  col = mix(col, vec3(1.0, 0.95, 0.8), smoothstep(0.88, 1.0, heat));\n  float a = smoothstep(0.04, 0.35, heat);\n  // drawn over the finished frame: hidden behind what is in front, soft where it meets it\n  if (uSoft > 0.5) {\n    float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;\n    a *= clamp((vProj.y / (zd + vProj.x) - vDist) / 0.35, 0.0, 1.0);\n  }\n  gl_FragColor = vec4(col * a * uGain, 1.0);\n}`;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"8e37fc1a-7b29-49d5-acdc-810b62fe9640","context":{"git_state":{"cwd":"REDACTED","root":null,"branch":null,"default_branch":null,"status":null,"visibility":{"origin":null,"push_remote":null,"remotes":[],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]},"error":"not_a_repo"},"live_cwd":"REDACTED","platform":"macos"}},"sourceToolAssistantUUID":"7daa1f4d-1edd-44a6-ac35-3932b48ed2be","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
