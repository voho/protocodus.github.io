his one is)","+attribute vec3 aSeed;          // seed, share (0..1: how big this one is), gain (its fire's)"," varying vec2 vUv;","-varying float vSeed, vDist;","+varying float vSeed, vDist, vGain;"," varying vec2 vProj;"," void main() {","   float s = aFire.w;"]},{"oldStart":35,"oldLines":6,"newStart":35,"newLines":7,"lines":["   vec3 p = aFire.xyz + right * position.x * w + vec3(0.0, position.y * h, 0.0);","   vUv = vec2(position.x * 2.0, position.y);","   vSeed = aSeed.x;","+  vGain = aSeed.z;","   vec4 mv = viewMatrix * vec4(p, 1.0);","   vDist = -mv.z;","   vProj = vec2(projectionMatrix[2][2], projectionMatrix[3][2]);"]},{"oldStart":46,"oldLines":7,"newStart":47,"newLines":7,"lines":[" uniform sampler2D tDepth;"," uniform vec2 uScreen;"," varying vec2 vUv;","-varying float vSeed, vDist;","+varying float vSeed, vDist, vGain;"," varying vec2 vProj;"," float hash(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }"," float noise(vec2 p) {"]},{"oldStart":83,"oldLines":7,"newStart":84,"newLines":7,"lines":["     float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;","     a *= clamp((vProj.y / (zd + vProj.x) - vDist) / 0.35, 0.0, 1.0);","   }","-  gl_FragColor = vec4(col * a * uGain, 1.0);","+  gl_FragColor = vec4(col * a * uGain * vGain, 1.0);"," }`;"," "," export function createFlames(effects, { gain = 1.4 } = {}) {"]},{"oldStart":93,"oldLines":7,"newStart":94,"newLines":7,"lines":["   geo.index = quad.index;","   geo.setAttribute('position', quad.attributes.position);","   const fireA = new THREE.InstancedBufferAttribute(new Float32Array(MAXF * PER * 4), 4);","-  const seedA = new THREE.InstancedBufferAttribute(new Float32Array(MAXF * PER * 2), 2);","+  const seedA = new THREE.InstancedBufferAttribute(new Float32Array(MAXF * PER * 3), 3);","   fireA.setUsage(THREE.DynamicDrawUsage);","   geo.setAttribute('aFire', fireA);","   geo.setAttribute('aSeed', seedA);"]},{"oldStart":154,"ol