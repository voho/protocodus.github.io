ling off from the light, the more seen against it","+  vec3 rel = p - L.xyz;","+  float dd = dot(rel, rel), rl = sqrt(dd + 1e-4);","+  float cap = smoothstep(C.w, C.w + 0.35, -rel.y / rl);","+  vLit = C.rgb * rainPhase(-dot(-toCam, rel) / rl) * cap / (1.0 + dd * 0.9);","+  // a ball of it, fading out before the box's faces, none right by the eye; in a gust more","+  vAlpha = (1.0 - smoothstep(0.6, 1.0, length(o) / R)) * smoothstep(1.2, 4.0, dist) * (uWidth / width)","+    * (0.45 + 1.1 * fract(aDrop.w * 7.31 + aDrop.x * 3.7))","+    * smoothstep(0.0, 0.35, g - fract(aDrop.w * 13.7) * 0.9) * open;","+  vUv = uv;","+  vec4 mv = viewMatrix * vec4(wp, 1.0);","+  vDist = -mv.z;","+  vProj = vec2(projectionMatrix[2][2], projectionMatrix[3][2]);","+  gl_Position = projectionMatrix * mv;","+}`;","+","+const GLINT_FRAG = /* glsl */ `","+uniform vec3 uColor;","+uniform float uOpacity, uSoft;","+uniform sampler2D tDepth;","+uniform vec2 uScreen;","+varying float vAlpha;","+varying vec2 vUv;","+varying vec3 vLit;","+varying float vDist;","+varying vec2 vProj;","+void main() {","+  if (uSoft > 0.5) {","+    float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;","+    if (vDist > vProj.y / (zd + vProj.x)) discard;","+  }","+  float edge = 1.0 - abs(vUv.x - 0.5) * 2.0;","+  float tail = smoothstep(0.0, 0.35, vUv.y) * smoothstep(1.0, 0.75, vUv.y);","+  float a = edge * tail * vAlpha * uOpacity * min(dot(vLit, vec3(0.33)) * 6.0, 1.0);","+  if (a < 0.004) discard;","+  gl_FragColor = vec4(uColor * 0.25 + vLit * 3.0, min(a, 0.9));","+}`;","+"," // rain sheets: four cylinders round the eye, 14, 22, 36 and 57 m out, each carrying streaks one to"," // two pixels wide on an angular grid (so they stay put as the view turns) that fall at the rain's"," // speed and lean with its drift along the cylinder. SHEET_GLSL works out one cylinder's streak where"]}],"userModified":false,"replaceAll":false,"staleRecovered":true,"contentNotInModelContext":true},"serverClassifierContext"