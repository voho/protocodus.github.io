2 rip = rainRipples(vWPosM.xz * 1.9, uTime, rippleFade(length(vViewPosition))) * uRain * mWetUp;","           mat3 tbnR = cotangentFrame(normal, -vViewPosition, vWPosM.xz);","           normal = normalize(tbnR * normalize(vec3(rip * 0.8, 1.0)) * 0.5 + normal * 0.5);","         }"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/ssr.js","hunks":[{"oldStart":69,"oldLines":7,"newStart":69,"newLines":7,"lines":["   // standing water lies level; the rain rings ruffle it (the rings terrain.js draws)","   float pool = smoothstep(0.6, 0.95, mirror);","   nW = normalize(mix(nW, vec3(0.0, 1.0, 0.0), pool));","-  vec2 rip = pool > 0.01 ? rainRipples(W.xz * 1.7, uTime) * uRain * pool : vec2(0.0);","+  vec2 rip = pool > 0.01 ? rainRipples(W.xz * 1.7, uTime, rippleFade(-P.z)) * uRain * pool : vec2(0.0);","   // a rough film scatters the rays round the mirror direction","   float j = ign(gl_FragCoord.xy);","   vec2 sc = (vec2(j, ign(gl_FragCoord.yx + 17.0)) - 0.5) * (1.0 - mirror) * 0.24;"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/terrain.js","hunks":[{"oldStart":359,"oldLines":8,"newStart":359,"newLines":7,"lines":["           vec3 nts = tNormal;","           nts.xy *= (1.0 - tPuddle) * (1.0 - 0.5 * tShore);","           // rain rings in puddles","-          vec2 rip = rainRipples(pxz * 1.7, uTime) * uRain;","-          nts.xy += rip * tPuddle * 0.9;","+          if (tPuddle > 0.01) nts.xy += rainRipples(pxz * 1.7, uTime, rippleFade(length(vViewPosition))) * uRain * tPuddle * 0.9;","           mat3 tbn = cotangentFrame(normal, -vViewPosition, vWPos.xz);","           normal = normalize(tbn * normalize(nts));","         }"]},{"oldStart":408,"oldLines":8,"newStart":407,"newLines":15,"lines":["     p3 += dot(p3, p3.yzx + 33.33);","     return fract((p3.x + p3.y) * p3.z);","   }","-  vec2 rainRipples(vec2 p, float t) {","+  // the rings raindrops make on standing water: