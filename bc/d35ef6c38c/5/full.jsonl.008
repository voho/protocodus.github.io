{"parentUuid":"4a60cde5-8f60-457f-a64c-3a5678242645","isSidechain":false,"attachment":{"type":"file","filename":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/lightloop.js","content":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/lightloop.js","content":"/* Hedgerow — the point lights only where they reach.\n\n   Every lit material loops over all nine point lights (the pool of eight and\n   the shadow-casting one, lights.js) for every pixel, and three.js shades each\n   one - the full BRDF, the skin's and the leaves' extras, the shadow lookup -\n   even where its range has already cut its light to nothing, as it has for\n   most of them on most of the screen. Patched once, before any material is\n   compiled: a point light that does not reach a pixel is skipped there (a\n   branch the GPU takes together across a block of pixels the light is far\n   from). What it adds where it does reach is unchanged. */\n\nimport * as THREE from 'three';\n\nconst AT = 'getPointLightInfo( pointLight, geometryPosition, directLight );';\n\nexport function cullPointLights() {\n  const src = THREE.ShaderChunk.lights_fragment_begin;\n  const a = src.indexOf(AT);\n  if (a < 0 || src.includes('/* hedgerow: reach */')) return false;\n  const b = src.indexOf('RE_Direct( directLight', a);\n  const e = b < 0 ? -1 : src.indexOf(');', b);\n  if (e < 0) return false;\n  THREE.ShaderChunk.lights_fragment_begin = src.slice(0, a + AT.length) + '\\n\\t\\tif ( directLight.visible ) { /* hedgerow: reach */'\n    + src.slice(a + AT.length, e + 2) + '\\n\\t\\t}' + src.slice(e + 2);\n  return true;\n}\n","numLines":27,"startLine":1,"totalLines":27}},"displayPath":"../../../../../../../Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/lightloop.js"},"type":"attachment","uuid":"506488a3-1c8a-43f8-ad26-bcf7cd8cd711","timestamp":"2026-10-21T21:12:44.522Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/lightloop.js\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t/* Hedgerow — the point lights only where they reach.\n2\t\n3\t   Every lit material loops over all nine point lights (the pool of eight and\n4\t   the shadow-casting one, lights.js) for every pixel, and three.js shades each\n5\t   one - the full BRDF, the skin's and the leaves' extras, the shadow lookup -\n6\t   even where its range has already cut its light to nothing, as it has for\n7\t   most of them on most of the screen. Patched once, before any material is\n8\t   compiled: a point light that does not reach a pixel is skipped there (a\n9\t   branch the GPU takes together across a block of pixels the light is far\n10\t   from). What it adds where it does reach is unchanged. */\n11\t\n12\timport * as THREE from 'three';\n13\t\n14\tconst AT = 'getPointLightInfo( pointLight, geometryPosition, directLight );';\n15\t\n16\texport function cullPointLights() {\n17\t  const src = THREE.ShaderChunk.lights_fragment_begin;\n18\t  const a = src.indexOf(AT);\n19\t  if (a < 0 || src.includes('/* hedgerow: reach */')) return false;\n20\t  const b = src.indexOf('RE_Direct( directLight', a);\n21\t  const e = b < 0 ? -1 : src.indexOf(');', b);\n22\t  if (e < 0) return false;\n23\t  THREE.ShaderChunk.lights_fragment_begin = src.slice(0, a + AT.length) + '\\n\\t\\tif ( directLight.visible ) { /* hedgerow: reach */'\n24\t    + src.slice(a + AT.length, e + 2) + '\\n\\t\\t}' + src.slice(e + 2);\n25\t  return true;\n26\t}\n27\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"REDACTED","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
{"parentUuid":"506488a3-1c8a-43f8-ad26-bcf7cd8cd711","isSidechain":false,"attachment":{"type":"file","filename":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/chunks.js","content":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/chunks.js","content":"/* Hedgerow — what a blast throws.\n\n   A grenade or a charge going off throws up the ground it lay on: clods of\n   mud and turf in the fields, broken stones on the cobbles. Each piece is a\n   lump (one lumpy, faceted shape, stretched and turned its own way) that\n   flies out and up, black against the fireball, tumbling, knocks off a wall,\n   bounces once or twice and lies where it falls; the last CAP of them stay.\n   One instanced mesh in the ground's wet material, a colour per piece. */\n\nimport * as THREE from 'three';\n\nconst CAP = 120;\n\n// per surface (terrain.surfaceAt): mud and turf, or stone\nconst COLOURS = {\n  mud: ['#2f251b', '#3b2d20', '#261e16'], grass: ['#2f2a1c', '#363a23', '#2b2419'],\n  forest: ['#2c2318', '#342a1d'], cobble: ['#5e5b56', '#4b4844', '#6c675f'],\n};\n\n/* a lump: an icosphere pushed in and out by a noise of where each corner is (so shared corners\n   move together), facets left sharp */\nfunction lumpGeometry() {\n  const g = new THREE.IcosahedronGeometry(0.5, 1);\n  const pos = g.attributes.position, v = new THREE.Vector3();\n  const h = (x, y, z) => { const s = Math.sin(Math.round(x * 997) * 12.9898 + Math.round(y * 997) * 78.233 + Math.round(z * 997) * 37.719) * 43758.5453; return s - Math.floor(s); };\n  for (let i = 0; i < pos.count; i++) {\n    v.fromBufferAttribute(pos, i);\n    const k = 0.72 + 0.4 * h(v.x, v.y, v.z) + 0.12 * Math.sin(v.x * 9 + v.z * 5);\n    pos.setXYZ(i, v.x * k, v.y * k * 0.8, v.z * k);\n  }\n  g.computeVertexNormals();\n  g.setAttribute('color', new THREE.Float32BufferAttribute(new Float32Array(pos.count * 3).fill(1), 3));\n  return g;\n}\n\nexport function createChunks(G) {\n  const mesh = new THREE.InstancedMesh(lumpGeometry(), G.matlib.get('dirt'), CAP);\n  mesh.name = 'chunks';\n  mesh.count = 0;\n  mesh.frustumCulled = false;\n  mesh.castShadow = false;\n  mesh.receiveShadow = true;\n  mesh.instanceColor = new THREE.InstancedBufferAttribute(new Float32Array(CAP * 3), 3);\n  const list = [];\n  let cursor = 0;\n  const axis = new THREE.Vector3(), dq = new THREE.Quaternion(), m = new THREE.Matrix4(), tmp = new THREE.Vector3(), col = new THREE.Color();\n\n  /* a blast at (x, y, z) on the ground (y its height there), `scale` (a charge 1.8), on `surface` */\n  function burst(x, y, z, scale = 1, surface = 'mud') {\n    const colours = COLOURS[surface] || COLOURS.mud, stone = surface === 'cobble';\n    const n = Math.round((stone ? 20 : 26) * scale);\n    for (let k = 0; k < n; k++) {\n      let c;\n      if (list.length < CAP) {\n        c = { slot: list.length, p: new THREE.Vector3(), v: new THREE.Vector3(), q: new THREE.Quaternion(), w: new THREE.Vector3(), s: new THREE.Vector3(), rest: false };\n        list.push(c);\n        mesh.count = list.length;\n      } else {\n        c = list[cursor];\n        cursor = (cursor + 1) % CAP;\n      }\n      const a = Math.random() * Math.PI * 2, out = (1.5 + Math.random() * 5.5) * scale;\n      c.p.set(x + Math.cos(a) * 0.3 * Math.random(), y + 0.15, z + Math.sin(a) * 0.3 * Math.random());\n      c.v.set(Math.cos(a) * out, (4 + Math.random() * 8) * scale, Math.sin(a) * out);\n      // mostly small, now and then a big one\n      const size = (0.04 + Math.pow(Math.random(), 2.0) * 0.14) * (stone ? 0.85 : 1);\n      c.s.set(size * (0.7 + Math.random() * 0.6), size * (0.6 + Math.random() * 0.5), size * (0.7 + Math.random() * 0.6));\n      c.q.setFromAxisAngle(axis.set(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).normalize(), Math.random() * 6.28);\n      c.w.set(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).multiplyScalar(30);\n      c.rest = false;\n      mesh.setColorAt(c.slot, col.set(colours[Math.floor(Math.random() * colours.length)]).multiplyScalar(0.85 + Math.random() * 0.3));\n    }\n    mesh.instanceColor.needsUpdate = true;\n  }\n\n  function update(dt) {\n    let moved = false;\n    for (const c of list) {\n      if (c.rest) continue;\n      moved = true;\n      c.v.y -= 9.8 * dt;\n      c.p.addScaledVector(c.v, dt);\n      const w = c.w.length();\n      if (w > 1e-3) c.q.premultiply(dq.setFromAxisAngle(axis.copy(c.w).divideScalar(w), w * dt));\n      // off a wall\n      tmp.copy(c.p);\n      const r = c.s.x * 0.5;\n      if (G.world.pushOut(tmp, r, c.p.y - r, r * 2, 0.02)) {\n        c.v.x = ((tmp.x - c.p.x) / Math.max(dt, 1e-3)) * 0.25; c.v.z = ((tmp.z - c.p.z) / Math.max(dt, 1e-3)) * 0.25;\n        c.p.x = tmp.x; c.p.z = tmp.z;\n      }\n      const g = G.world.groundAt(c.p.x, c.p.z, c.p.y + 0.2, 0.25, 0.05) + c.s.y * 0.3;\n      if (c.p.y < g) {\n        c.p.y = g;\n        if (c.v.y < -2.0) {\n          // a bounce (mud gives little back), and a new tumble\n          c.v.y *= -0.22; c.v.x *= 0.45; c.v.z *= 0.45;\n          c.w.multiplyScalar(0.5);\n        } else c.rest = true;\n      }\n      mesh.setMatrixAt(c.slot, m.compose(c.p, c.q, c.s));\n    }\n    if (moved) mesh.instanceMatrix.needsUpdate = true;\n  }\n\n  function clear() { list.length = 0; cursor = 0; mesh.count = 0; }\n\n  return { mesh, burst, update, clear };\n}\n","numLines":110,"startLine":1,"totalLines":110}},"displayPath":"../../../../../../../Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/chunks.js"},"type":"attachment","uuid":"5859e37e-f8fd-44cc-86f9-452484258ebe","timestamp":"2026-10-21T21:12:44.522Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/chunks.js\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t/* Hedgerow — what a blast throws.\n2\t\n3\t   A grenade or a charge going off throws up the ground it lay on: clods of\n4\t   mud and turf in the fields, broken stones on the cobbles. Each piece is a\n5\t   lump (one lumpy, faceted shape, stretched and turned its own way) that\n6\t   flies out and up, black against the fireball, tumbling, knocks off a wall,\n7\t   bounces once or twice and lies where it falls; the last CAP of them stay.\n8\t   One instanced mesh in the ground's wet material, a colour per piece. */\n9\t\n10\timport * as THREE from 'three';\n11\t\n12\tconst CAP = 120;\n13\t\n14\t// per surface (terrain.surfaceAt): mud and turf, or stone\n15\tconst COLOURS = {\n16\t  mud: ['#2f251b', '#3b2d20', '#261e16'], grass: ['#2f2a1c', '#363a23', '#2b2419'],\n17\t  forest: ['#2c2318', '#342a1d'], cobble: ['#5e5b56', '#4b4844', '#6c675f'],\n18\t};\n19\t\n20\t/* a lump: an icosphere pushed in and out by a noise of where each corner is (so shared corners\n21\t   move together), facets left sharp */\n22\tfunction lumpGeometry() {\n23\t  const g = new THREE.IcosahedronGeometry(0.5, 1);\n24\t  const pos = g.attributes.position, v = new THREE.Vector3();\n25\t  const h = (x, y, z) => { const s = Math.sin(Math.round(x * 997) * 12.9898 + Math.round(y * 997) * 78.233 + Math.round(z * 997) * 37.719) * 43758.5453; return s - Math.floor(s); };\n26\t  for (let i = 0; i < pos.count; i++) {\n27\t    v.fromBufferAttribute(pos, i);\n28\t    const k = 0.72 + 0.4 * h(v.x, v.y, v.z) + 0.12 * Math.sin(v.x * 9 + v.z * 5);\n29\t    pos.setXYZ(i, v.x * k, v.y * k * 0.8, v.z * k);\n30\t  }\n31\t  g.computeVertexNormals();\n32\t  g.setAttribute('color', new THREE.Float32BufferAttribute(new Float32Array(pos.count * 3).fill(1), 3));\n33\t  return g;\n34\t}\n35\t\n36\texport function createChunks(G) {\n37\t  const mesh = new THREE.InstancedMesh(lumpGeometry(), G.matlib.get('dirt'), CAP);\n38\t  mesh.name = 'chunks';\n39\t  mesh.count = 0;\n40\t  mesh.frustumCulled = false;\n41\t  mesh.castShadow = false;\n42\t  mesh.receiveShadow = true;\n43\t  mesh.instanceColor = new THREE.InstancedBufferAttribute(new Float32Array(CAP * 3), 3);\n44\t  const list = [];\n45\t  let cursor = 0;\n46\t  const axis = new THREE.Vector3(), dq = new THREE.Quaternion(), m = new THREE.Matrix4(), tmp = new THREE.Vector3(), col = new THREE.Color();\n47\t\n48\t  /* a blast at (x, y, z) on the ground (y its height there), `scale` (a charge 1.8), on `surface` */\n49\t  function burst(x, y, z, scale = 1, surface = 'mud') {\n50\t    const colours = COLOURS[surface] || COLOURS.mud, stone = surface === 'cobble';\n51\t    const n = Math.round((stone ? 20 : 26) * scale);\n52\t    for (let k = 0; k < n; k++) {\n53\t      let c;\n54\t      if (list.length < CAP) {\n55\t        c = { slot: list.length, p: new THREE.Vector3(), v: new THREE.Vector3(), q: new THREE.Quaternion(), w: new THREE.Vector3(), s: new THREE.Vector3(), rest: false };\n56\t        list.push(c);\n57\t        mesh.count = list.length;\n58\t      } else {\n59\t        c = list[cursor];\n60\t        cursor = (cursor + 1) % CAP;\n61\t      }\n62\t      const a = Math.random() * Math.PI * 2, out = (1.5 + Math.random() * 5.5) * scale;\n63\t      c.p.set(x + Math.cos(a) * 0.3 * Math.random(), y + 0.15, z + Math.sin(a) * 0.3 * Math.random());\n64\t      c.v.set(Math.cos(a) * out, (4 + Math.random() * 8) * scale, Math.sin(a) * out);\n65\t      // mostly small, now and then a big one\n66\t      const size = (0.04 + Math.pow(Math.random(), 2.0) * 0.14) * (stone ? 0.85 : 1);\n67\t      c.s.set(size * (0.7 + Math.random() * 0.6), size * (0.6 + Math.random() * 0.5), size * (0.7 + Math.random() * 0.6));\n68\t      c.q.setFromAxisAngle(axis.set(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).normalize(), Math.random() * 6.28);\n69\t      c.w.set(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).multiplyScalar(30);\n70\t      c.rest = false;\n71\t      mesh.setColorAt(c.slot, col.set(colours[Math.floor(Math.random() * colours.length)]).multiplyScalar(0.85 + Math.random() * 0.3));\n72\t    }\n73\t    mesh.instanceColor.needsUpdate = true;\n74\t  }\n75\t\n76\t  function update(dt) {\n77\t    let moved = false;\n78\t    for (const c of list) {\n79\t      if (c.rest) continue;\n80\t      moved = true;\n81\t      c.v.y -= 9.8 * dt;\n82\t      c.p.addScaledVector(c.v, dt);\n83\t      const w = c.w.length();\n84\t      if (w > 1e-3) c.q.premultiply(dq.setFromAxisAngle(axis.copy(c.w).divideScalar(w), w * dt));\n85\t      // off a wall\n86\t      tmp.copy(c.p);\n87\t      const r = c.s.x * 0.5;\n88\t      if (G.world.pushOut(tmp, r, c.p.y - r, r * 2, 0.02)) {\n89\t        c.v.x = ((tmp.x - c.p.x) / Math.max(dt, 1e-3)) * 0.25; c.v.z = ((tmp.z - c.p.z) / Math.max(dt, 1e-3)) * 0.25;\n90\t        c.p.x = tmp.x; c.p.z = tmp.z;\n91\t      }\n92\t      const g = G.world.groundAt(c.p.x, c.p.z, c.p.y + 0.2, 0.25, 0.05) + c.s.y * 0.3;\n93\t      if (c.p.y < g) {\n94\t        c.p.y = g;\n95\t        if (c.v.y < -2.0) {\n96\t          // a bounce (mud gives little back), and a new tumble\n97\t          c.v.y *= -0.22; c.v.x *= 0.45; c.v.z *= 0.45;\n98\t          c.w.multiplyScalar(0.5);\n99\t        } else c.rest = true;\n100\t      }\n101\t      mesh.setMatrixAt(c.slot, m.compose(c.p, c.q, c.s));\n102\t    }\n103\t    if (moved) mesh.instanceMatrix.needsUpdate = true;\n104\t  }\n105\t\n106\t  function clear() { list.length = 0; cursor = 0; mesh.count = 0; }\n107\t\n108\t  return { mesh, burst, update, clear };\n109\t}\n110\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"REDACTED","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
