{"parentUuid":"5d959ac7-0281-4290-9d68-03a9851e4720","isSidechain":false,"promptId":"6d5c0a1d-fdd5-4db0-8cbd-a5c82a0adcb7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016aTU3yZU44HfnfbX3wSAW5","type":"tool_result","content":"160\t/* ---------- decals ---------- */\n161\t\n162\t/* What a bullet leaves, by what it hit, and the scorch of a blast. Each is a\n163\t   small lit quad with a relief of its own (a normal map, so a lamp, a fire, a\n164\t   flare or the muzzle flash picks out a crater's rim): stone chipped away pale\n165\t   round a black hole, cracked and powdered; wood splintered along its grain,\n166\t   the fresh wood showing; paint dented and flaked off to the bare steel round\n167\t   a hole; mud thrown up in clods. Every kind is painted four ways (the\n168\t   quarters of its textures), and each decal takes one at random, turned at\n169\t   random. A bullet stops at a collider, a flat box, and a wall's stones bulge a\n170\t   few centimetres out of it: so each decal is drawn pulled towards the eye\n171\t   along its own sight line (it stays where it is on the screen) by PULL, which\n172\t   brings it out over the stones instead of into them. */\n173\t\n174\tconst PULL = 0.06;\n175\tconst FLAT = 160; // a relief's surface, on its height canvas (lower is sunk in)\n176\tconst CELL = 256; // a variant's size in texels; four to a texture\n177\t\n178\t/* A decal is painted with the same strokes on its canvases: the colour (opaque\n179\t   all over, so a texel at an edge filters with its own colour, not black), how\n180\t   much of it shows, its height and (metal) where it is bare. */\n181\tfunction painter(S, ground, bare = false) {\n182\t  const mk = (fill) => {\n183\t    const c = document.createElement('canvas');\n184\t    c.width = c.height = S;\n185\t    const g = c.getContext('2d');\n186\t    g.fillStyle = fill;\n187\t    g.fillRect(0, 0, S, S);\n188\t    return g;\n189\t  };\n190\t  const p = { S, col: mk(ground), alpha: mk('#000'), height: mk(`rgb(${FLAT},${FLAT},${FLAT})`), bare: bare ? mk('#000') : null };\n191\t  const all = [p.col, p.alpha, p.height, p.bare].filter(Boolean);\n192\t  // one shape onto the canvases named in `styles` (a fill or stroke style each)\n193\t  p.fill = (path, styles) => { for (const k in styles) { p[k].fillStyle = styles[k]; p[k].fill(path); } };\n194\t  p.stroke = (path, styles, width) => { for (const k in styles) { p[k].strokeStyle = styles[k]; p[k].lineWidth = width; p[k].stroke(path); } };\n195\t  // paint only inside one variant's square\n196\t  p.clip = (x, y, w) => { for (const g of all) { g.save(); g.beginPath(); g.rect(x, y, w, w); g.clip(); } };\n197\t  p.unclip = () => { for (const g of all) g.restore(); };\n198\t  return p;\n199\t}\n200\t\n201\tconst grey = (v) => `rgb(${v | 0},${v | 0},${v | 0})`;\n202\t\n203\t/* a ragged outline round (x, y): n corners out to r, each pulled in by up to jag of it */\n204\tfunction ragged(R, x, y, r, n, jag) {\n205\t  const path = new Path2D();\n206\t  for (let i = 0; i < n; i++) {\n207\t    const a = ((i + (R() - 0.5) * 0.8) / n) * Math.PI * 2, rr = r * (1 - jag * R());\n208\t    path[i ? 'lineTo' : 'moveTo'](x + Math.cos(a) * rr, y + Math.sin(a) * rr);\n209\t  }\n210\t  path.closePath();\n211\t  return path;\n212\t}\n213\t\n214\tfunction disc(x, y, r) {\n215\t  const path = new Path2D();\n216\t  path.arc(x, y, r, 0, Math.PI * 2);\n217\t  return path;\n218\t}\n219\t\n220\t/* a crack wandering from (x, y) along ang */\n221\tfunction crack(R, x, y, ang, len, steps = 5) {\n222\t  const path = new Path2D();\n223\t  path.moveTo(x, y);\n224\t  for (let s = 0; s < steps; s++) {\n225\t    ang += (R() - 0.5) * 0.8;\n226\t    x += (Math.cos(ang) * len) / steps;\n227\t    y += (Math.sin(ang) * len) / steps;\n228\t    path.lineTo(x, y);\n229\t  }\n230\t  return path;\n231\t}\n232\t\n233\t/* a splinter: a sliver from (x, y) along ang, w wide at its root, to a point */\n234\tfunction sliver(x, y, ang, len, w) {\n235\t  const path = new Path2D(), c = Math.cos(ang), s = Math.sin(ang);\n236\t  path.moveTo(x - s * w * 0.5, y + c * w * 0.5);\n237\t  path.lineTo(x + c * len * 0.6 - s * w * 0.3, y + s * len * 0.6 + c * w * 0.3);\n238\t  path.lineTo(x + c * len, y + s * len);\n239\t  path.lineTo(x + c * len * 0.55 + s * w * 0.35, y + s * len * 0.55 - c * w * 0.35);\n240\t  path.lineTo(x + s * w * 0.5, y - c * w * 0.5);\n241\t  path.closePath();\n242\t  return path;\n243\t}\n244\t\n245\t/* stone (and brick, cobbles, concrete): the face spalled away in chips, lopsided, round a black hole */\n246\tfunction stoneHole(p, R, cx, cy, S) {\n247\t  const ox = cx + (R() - 0.5) * S * 0.08, oy = cy + (R() - 0.5) * S * 0.08;\n248\t  // the powder of it thrown round, and grit\n249\t  const dust = p.alpha.createRadialGradient(ox, oy, S * 0.1, ox, oy, S * 0.42);\n250\t  dust.addColorStop(0, grey(55 + R() * 30)); dust.addColorStop(1, grey(0));\n251\t  p.alpha.fillStyle = dust; p.alpha.fill(disc(ox, oy, S * 0.42));\n252\t  for (let k = 0; k < 60; k++) {\n253\t    const a = R() * Math.PI * 2, r = S * (0.13 + 0.27 * Math.sqrt(R())), v = 105 + R() * 70;\n254\t    p.fill(disc(ox + Math.cos(a) * r, oy + Math.sin(a) * r, S * (0.004 + R() * 0.008)), { col: `rgb(${v},${v * 0.95},${v * 0.87})`, alpha: grey(60 + R() * 100), height: grey(FLAT + 6) });\n255\t  }\n256\t  // cracks running out of it\n257\t  for (let k = 0, m = 2 + Math.floor(R() * 4); k < m; k++) {\n258\t    const a = R() * Math.PI * 2;\n259\t    p.stroke(crack(R, cx + Math.cos(a) * S * 0.13, cy + Math.sin(a) * S * 0.13, a, S * (0.1 + R() * 0.16)), { col: 'rgb(30,28,25)', alpha: grey(200), height: grey(FLAT - 28) }, S * (0.005 + R() * 0.005));\n260\t  }\n261\t  // the crater, in chips that each broke off at a depth of their own\n262\t  const cr = S * (0.15 + R() * 0.09), kx = (cx + ox) / 2, ky = (cy + oy) / 2;\n263\t  p.fill(ragged(R, kx, ky, cr, 13 + Math.floor(R() * 6), 0.45), { col: 'rgb(150,141,127)', alpha: grey(255), height: grey(FLAT - 34) });\n264\t  for (let k = 0, m = 8 + Math.floor(R() * 5); k < m; k++) {\n265\t    const a = R() * Math.PI * 2, r = cr * 0.6 * Math.sqrt(R()), v = 125 + R() * 55;\n266\t    p.fill(ragged(R, kx + Math.cos(a) * r, ky + Math.sin(a) * r, S * (0.04 + R() * 0.05), 7, 0.4), { col: `rgb(${v},${v * 0.94},${v * 0.85})`, alpha: grey(255), height: grey(FLAT - 70 + (r / S) * 300 + R() * 18) });\n267\t  }\n268\t  // deepest in the middle, round the hole the lead and soot the bullet wiped off\n269\t  const pit = p.height.createRadialGradient(cx, cy, 0, cx, cy, cr * 0.7);\n270\t  pit.addColorStop(0, 'rgba(60,60,60,1)'); pit.addColorStop(1, 'rgba(60,60,60,0)');\n271\t  p.height.fillStyle = pit; p.height.fill(disc(cx, cy, cr * 0.7));\n272\t  const hr = S * (0.035 + R() * 0.015);\n273\t  const wipe = p.col.createRadialGradient(cx, cy, hr * 0.8, cx, cy, hr * 2.4);\n274\t  wipe.addColorStop(0, 'rgba(22,20,18,0.95)'); wipe.addColorStop(1, 'rgba(22,20,18,0)');\n275\t  p.col.fillStyle = wipe; p.col.fill(disc(cx, cy, hr * 2.4));\n276\t  p.fill(ragged(R, cx, cy, hr, 9, 0.3), { col: 'rgb(5,4,4)', height: grey(0) });\n277\t}\n278\t\n279\t/* wood: torn open along the grain (the texture's up and down), the fresh wood splintered out */\n280\tfunction woodHole(p, R, cx, cy, S) {\n281\t  const dust = p.alpha.createRadialGradient(cx, cy, S * 0.08, cx, cy, S * 0.3);\n282\t  dust.addColorStop(0, grey(70)); dust.addColorStop(1, grey(0));\n283\t  p.alpha.fillStyle = dust; p.alpha.fill(disc(cx, cy, S * 0.3));\n284\t  for (let k = 0, m = 14 + Math.floor(R() * 12); k < m; k++) {\n285\t    const ang = (R() < 0.5 ? -1 : 1) * Math.PI * 0.5 + (R() - 0.5) * 0.6, v = 140 + R() * 70;\n286\t    const x = cx + (R() - 0.5) * S * 0.09, y = cy + (R() - 0.5) * S * 0.07;\n287\t    p.fill(sliver(x, y, ang, S * (0.1 + R() * 0.28), S * (0.015 + R() * 0.03)), { col: `rgb(${v},${v * 0.8},${v * 0.54})`, alpha: grey(255), height: grey(FLAT + 14 + R() * 40) });\n288\t  }\n289\t  // the hole torn into it, darker where the wood is crushed\n290\t  p.fill(ragged(R, cx, cy, S * (0.07 + R() * 0.03), 11, 0.35), { col: 'rgb(62,44,26)', alpha: grey(255), height: grey(FLAT - 50) });\n291\t  p.fill(ragged(R, cx, cy, S * (0.038 + R() * 0.014), 9, 0.3), { col: 'rgb(8,6,4)', height: grey(0) });\n292\t}\n293\t\n294\t/* painted steel: dented, the paint flaked off round a bright bowl, holed (or, a glancing hit, not) */\n295\tfunction metalHole(p, R, cx, cy, S) {\n296\t  const dr = S * (0.19 + R() * 0.07);\n297\t  const bowl = p.height.createRadialGradient(cx, cy, 0, cx, cy, dr);\n298\t  bowl.addColorStop(0, grey(70)); bowl.addColorStop(0.7, grey(FLAT - 6)); bowl.addColorStop(0.86, grey(FLAT + 22)); bowl.addColorStop(1, grey(FLAT));\n299\t  p.height.fillStyle = bowl; p.height.fill(disc(cx, cy, dr));\n300\t  // a scuff of soot and lead round it, flakes of paint gone further out\n301\t  const scuff = p.alpha.createRadialGradient(cx, cy, dr * 0.45, cx, cy, dr * 1.35);\n302\t  scuff.addColorStop(0, grey(150)); scuff.addColorStop(1, grey(0));\n303\t  p.alpha.fillStyle = scuff; p.alpha.fill(disc(cx, cy, dr * 1.35));\n304\t  p.col.fillStyle = 'rgb(28,27,26)'; p.col.fill(disc(cx, cy, dr * 1.35));\n305\t  for (let k = 0, m = 5 + Math.floor(R() * 8); k < m; k++) {\n306\t    const a = R() * Math.PI * 2, r = dr * (0.85 + R() * 0.45);\n307\t    p.fill(ragged(R, cx + Math.cos(a) * r, cy + Math.sin(a) * r, S * (0.01 + R() * 0.025), 6, 0.4), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });\n308\t  }\n309\t  p.fill(ragged(R, cx, cy, dr * 0.88, 18, 0.3), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });\n310\t  // the hole, its lip torn\n311\t  if (R() < 0.75) p.fill(ragged(R, cx, cy, S * (0.04 + R() * 0.02), 8, 0.35), { col: 'rgb(6,6,6)', bare: grey(0), height: grey(0) });\n312\t}\n313\t\n314\t/* the ground: a pit kicked in the mud, clods thrown out of it */\n315\tfunction mudSplat(p, R, cx, cy, S) {\n316\t  for (let k = 0, m = 30 + Math.floor(R() * 30); k < m; k++) {\n317\t    const a = R() * Math.PI * 2, r = S * (0.1 + 0.32 * Math.sqrt(R())), v = 34 + R() * 26;\n318\t    p.fill(ragged(R, cx + Math.cos(a) * r, cy + Math.sin(a) * r, S * (0.008 + R() * 0.03), 6, 0.45), { col: `rgb(${v},${v * 0.8},${v * 0.6})`, alpha: grey(170 + R() * 85), height: grey(FLAT + 25 + R() * 45) });\n319\t  }\n320\t  p.fill(ragged(R, cx, cy, S * (0.12 + R() * 0.06), 13, 0.4), { col: 'rgb(30,24,17)', alpha: grey(235), height: grey(FLAT - 45) });\n321\t  p.fill(ragged(R, cx, cy, S * (0.05 + R() * 0.02), 9, 0.4), { col: 'rgb(18,14,10)', alpha: grey(255), height: grey(FLAT - 90) });\n322\t}\n323\t\n324\t/* a blast's scorch on the ground, burnt out from the middle in streaks */\n325\tfunction scorchMark(p, R, cx, cy, S) {\n326\t  const burnt = p.alpha.createRadialGradient(cx, cy, 0, cx, cy, S * 0.48);\n327\t  burnt.addColorStop(0, grey(242)); burnt.addColorStop(0.5, grey(178)); burnt.addColorStop(1, grey(0));\n328\t  p.alpha.fillStyle = burnt; p.alpha.fill(disc(cx, cy, S * 0.48));\n329\t  for (let k = 0; k < 40; k++) {\n330\t    const a = R() * 6.28, r = S * (0.22 + R() * 0.24);\n331\t    const path = new Path2D();\n332\t    path.moveTo(cx, cy); path.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);\n333\t    p.stroke(path, { alpha: grey(80 + R() * 100) }, 1 + R() * 3);\n334\t  }\n335\t}\n336\t\n337\t/* A kind's four variants as textures: the colour with how much of it shows, the relief as a\n338\t   normal map (`relief`: how steep a slope of the height comes out) and, for metal, roughness\n339\t   and metalness (green and blue). */\n340\tfunction decalSet(paint, seed, ground, relief, bare = false) {\n341\t  const S = CELL * 2, n = S * S, R = rng(seed);\n342\t  const p = painter(S, ground, bare);\n343\t  for (let i = 0; i < 4; i++) {\n344\t    const x = (i % 2) * CELL, y = (i >> 1) * CELL;\n345\t    p.clip(x, y, CELL);\n346\t    paint(p, R, x + CELL / 2, y + CELL / 2, CELL);\n347\t    p.unclip();\n348\t  }\n349\t  const data = (g) => g.getImageData(0, 0, S, S).data;\n350\t  const col = data(p.col), al = data(p.alpha), hd = data(p.height);\n351\t  // the height softened a little (twice over three texels each way): from eight bits its\n352\t  // slopes would come out in terraces\n353\t  const h = new Float32Array(n), t = new Float32Array(n);\n354\t  for (let i = 0; i < n; i++) h[i] = hd[i * 4] / 255;\n355\t  for (let pass = 0; pass < 2; pass++) {\n356\t    for (let y = 0; y < S; y++) {\n357\t      const r = y * S;\n358\t      for (let x = 0; x < S; x++) t[r + x] = (h[r + Math.max(0, x - 1)] + h[r + x] + h[r + Math.min(S - 1, x + 1)]) / 3;\n359\t    }\n360\t    for (let y = 0; y < S; y++) {\n361\t      const a = Math.max(0, y - 1) * S, b = y * S, c = Math.min(S - 1, y + 1) * S;\n362\t      for (let x = 0; x < S; x++) h[b + x] = (t[a + x] + t[b + x] + t[c + x]) / 3;\n363\t    }\n364\t  }\n365\t  const rgba = new Uint8Array(n * 4), nrm = new Uint8Array(n * 4);\n366\t  for (let y = 0; y < S; y++) {\n367\t    const a = Math.max(0, y - 1) * S, b = y * S, c = Math.min(S - 1, y + 1) * S;\n368\t    for (let x = 0; x < S; x++) {\n369\t      const i = b + x, o = i * 4;\n370\t      rgba[o] = col[o]; rgba[o + 1] = col[o + 1]; rgba[o + 2] = col[o + 2]; rgba[o + 3] = al[o];\n371\t      // the texture's rows run up its v (no flip): a rise along them tilts the normal back down v\n372\t      const dx = (h[b + Math.min(S - 1, x + 1)] - h[b + Math.max(0, x - 1)]) * relief, dy = (h[c + x] - h[a + x]) * relief;\n373\t      const l = Math.hypot(dx, dy, 1);\n374\t      nrm[o] = (0.5 - (0.5 * dx) / l) * 255; nrm[o + 1] = (0.5 - (0.5 * dy) / l) * 255; nrm[o + 2] = (0.5 + 0.5 / l) * 255; nrm[o + 3] = 255;\n375\t    }\n376\t  }\n377\t  const tex = (d, color) => {\n378\t    const tx = new THREE.DataTexture(d, S, S);\n379\t    tx.colorSpace = color ? THREE.SRGBColorSpace : THREE.NoColorSpace;\n380\t    tx.generateMipmaps = true;\n381\t    tx.minFilter = THREE.LinearMipmapLinearFilter;\n382\t    tx.magFilter = THREE.LinearFilter;\n383\t    tx.anisotropy = 4;\n384\t    tx.needsUpdate = true;\n385\t    return tx;\n386\t  };\n387\t  const set = { map: tex(rgba, true), normalMap: tex(nrm, false), orm: null };\n388\t  if (p.bare) {\n389\t    // bare steel smooth and metal, the paint round it rough\n390\t    const b = data(p.bare), orm = new Uint8Array(n * 4);\n391\t    for (let i = 0; i < n; i++) { const k = b[i * 4] / 255; orm[i * 4 + 1] = (0.72 - 0.42 * k) * 255; orm[i * 4 + 2] = k * 255; orm[i * 4 + 3] = 255; }\n392\t    set.orm = tex(orm, false);\n393\t  }\n394\t  return set;\n395\t}\n396\t\n397\tfunction decalMaterial(set, shared) {\n398\t  const mat = new THREE.MeshStandardMaterial({\n399\t    map: set.map, normalMap: set.normalMap, roughness: 0.9, metalness: 0,\n400\t    transparent: true, depthWrite: false,\n401\t    polygonOffset: true, polygonOffsetFactor: -4, polygonOffsetUnits: -4,\n402\t  });\n403\t  if (set.orm) { mat.roughnessMap = mat.metalnessMap = set.orm; mat.roughness = mat.metalness = 1; }\n404\t  mat.onBeforeCompile = (shader) => {\n405\t    shader.uniforms.uWet = shared ? shared.wet : { value: 0 };\n406\t    shader.vertexShader = shader.vertexShader\n407\t      .replace('#include <common>', '#include <common>\\nattribute vec2 aCell;')\n408\t      .replace('#include <uv_vertex>', `#include <uv_vertex>\n409\t      // its variant: a quarter of the textures\n410\t      #ifdef USE_MAP\n411\t        vMapUv = vMapUv * 0.5 + aCell;\n412\t      #endif\n413\t      #ifdef USE_NORMALMAP\n414\t        vNormalMapUv = vNormalMapUv * 0.5 + aCell;\n415\t      #endif\n416\t      #ifdef USE_ROUGHNESSMAP\n417\t        vRoughnessMapUv = vRoughnessMapUv * 0.5 + aCell;\n418\t      #endif\n419\t      #ifdef USE_METALNESSMAP\n420\t        vMetalnessMapUv = vMetalnessMapUv * 0.5 + aCell;\n421\t      #endif`)\n422\t      .replace('#include <project_vertex>', `#include <project_vertex>\n423\t      mvPosition.xyz -= normalize(mvPosition.xyz) * min(${PULL.toFixed(3)}, length(mvPosition.xyz) * 0.2);\n424\t      gl_Position = projectionMatrix * mvPosition;`);\n425\t    shader.fragmentShader = shader.fragmentShader\n426\t      .replace('#include <common>', '#include <common>\\nuniform float uWet;')\n427\t      .replace('#include <map_fragment>', `#include <map_fragment>\n428\t      // wet in the rain like what it is on, a little less (freshly broken)\n429\t      diffuseColor.rgb *= mix(1.0, 0.75, uWet);`)\n430\t      .replace('#include <roughnessmap_fragment>', `#include <roughnessmap_fragment>\n431\t      roughnessFactor = mix(roughnessFactor, roughnessFactor * 0.6 + 0.08, uWet);`);\n432\t    dimFillSpecular(shader);\n433\t  };\n434\t  return mat;\n435\t}\n436\t\n437\texport function createDecals({ max = 200, shared = null } = {}) {\n438\t  const group = new THREE.Group();\n439\t  group.name = 'decals';\n440\t  const sets = {\n441\t    stone: decalSet(stoneHole, 9151, 'rgb(150,143,131)', 18),\n442\t    wood: decalSet(woodHole, 4243, 'rgb(158,124,84)', 22),\n443\t    metal: decalSet(metalHole, 777, 'rgb(150,151,154)', 20, true),\n444\t    splat: decalSet(mudSplat, 3301, 'rgb(44,35,26)', 14),\n445\t    scorch: decalSet(scorchMark, 6, 'rgb(12,11,9)', 0),\n446\t  };\n447\t  const kinds = {};\n448\t  for (const k in sets) {\n449\t    const cap = k === 'scorch' ? 24 : max;\n450\t    const geo = new THREE.PlaneGeometry(1, 1);\n451\t    const cells = new THREE.InstancedBufferAttribute(new Float32Array(cap * 2), 2);\n452\t    geo.setAttribute('aCell', cells);\n453\t    const m = new THREE.InstancedMesh(geo, decalMaterial(sets[k], shared), cap);\n454\t    m.count = 0;\n455\t    m.frustumCulled = false;\n456\t    m.renderOrder = 2;\n457\t    m.receiveShadow = true;\n458\t    group.add(m);\n459\t    kinds[k] = { mesh: m, cells, cursor: 0, n: 0, cap };\n460\t  }\n461\t  const n = new THREE.Vector3(), up = new THREE.Vector3(), side = new THREE.Vector3();\n462\t  const mtx = new THREE.Matrix4(), turn = new THREE.Matrix4();\n463\t\n464\t  /* A decal `size` across on a surface facing (nx, ny, nz): turned at random, or (along the\n465\t     grain) with its up along the surface's. */\n466\t  function add(kind, x, y, zz, nx, ny, nz, size, grain = false) {\n467\t    const K = kinds[kind];\n468\t    if (!K) return;\n469\t    n.set(nx, ny, nz).normalize();\n470\t    // its up: the world's laid on the surface (on a floor, any)\n471\t    up.set(0, 1, 0).addScaledVector(n, -n.y);\n472\t    if (up.lengthSq() < 0.04) up.set(1, 0, 0).addScaledVector(n, -n.x);\n473\t    up.normalize();\n474\t    side.crossVectors(up, n);\n475\t    mtx.makeBasis(side, up, n).multiply(turn.makeRotationZ(grain ? (Math.random() - 0.5) * 0.4 : Math.random() * Math.PI * 2));\n476\t    mtx.scale(side.set(size, size, 1));\n477\t    mtx.setPosition(x + n.x * 0.012, y + n.y * 0.012, zz + n.z * 0.012);\n478\t    K.mesh.setMatrixAt(K.cursor, mtx);\n479\t    const v = Math.floor(Math.random() * 4);\n480\t    K.cells.setXY(K.cursor, (v % 2) * 0.5, (v >> 1) * 0.5);\n481\t    K.cursor = (K.cursor + 1) % K.cap;\n482\t    K.n = Math.min(K.cap, K.n + 1);\n483\t    K.mesh.count = K.n;\n484\t    K.mesh.instanceMatrix.needsUpdate = true;\n485\t    K.cells.needsUpdate = true;\n486\t  }\n487\t\n488\t  /* A bullet impact by surface. */\n489\t  function impact(x, y, zz, nx, ny, nz, surface) {\n490\t    if (surface === 'water' || surface === 'foliage' || surface === 'flesh') return;\n491\t    const r = Math.random();\n492\t    if (surface === 'mud' || surface === 'grass' || surface === 'forest' || surface === 'dirt') add('splat', x, y, zz, nx, ny, nz, 0.3 + r * 0.22);\n493\t    else if (surface === 'wood') add('wood', x, y, zz, nx, ny, nz, 0.17 + r * 0.08, true);\n494\t    else if (surface === 'metal') add('metal', x, y, zz, nx, ny, nz, 0.12 + r * 0.05);\n495\t    else add('stone', x, y, zz, nx, ny, nz, (surface === 'sandbag' ? 0.12 : 0.16) + r * 0.07);\n496\t  }\n497\t\n498\t  function clear() { for (const K of Object.values(kinds)) { K.n = 0; K.cursor = 0; K.mesh.count = 0; } }\n499\t\n500\t  return { group, add, impact, clear };\n501\t}\n502\t"}]},"uuid":"bd881f87-1d40-4ff2-ba78-d163e02c2229","timestamp":"2026-10-21T21:20:20.338Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/atmosphere.js","content":"/* ---------- decals ---------- */\n\n/* What a bullet leaves, by what it hit, and the scorch of a blast. Each is a\n   small lit quad with a relief of its own (a normal map, so a lamp, a fire, a\n   flare or the muzzle flash picks out a crater's rim): stone chipped away pale\n   round a black hole, cracked and powdered; wood splintered along its grain,\n   the fresh wood showing; paint dented and flaked off to the bare steel round\n   a hole; mud thrown up in clods. Every kind is painted four ways (the\n   quarters of its textures), and each decal takes one at random, turned at\n   random. A bullet stops at a collider, a flat box, and a wall's stones bulge a\n   few centimetres out of it: so each decal is drawn pulled towards the eye\n   along its own sight line (it stays where it is on the screen) by PULL, which\n   brings it out over the stones instead of into them. */\n\nconst PULL = 0.06;\nconst FLAT = 160; // a relief's surface, on its height canvas (lower is sunk in)\nconst CELL = 256; // a variant's size in texels; four to a texture\n\n/* A decal is painted with the same strokes on its canvases: the colour (opaque\n   all over, so a texel at an edge filters with its own colour, not black), how\n   much of it shows, its height and (metal) where it is bare. */\nfunction painter(S, ground, bare = false) {\n  const mk = (fill) => {\n    const c = document.createElement('canvas');\n    c.width = c.height = S;\n    const g = c.getContext('2d');\n    g.fillStyle = fill;\n    g.fillRect(0, 0, S, S);\n    return g;\n  };\n  const p = { S, col: mk(ground), alpha: mk('#000'), height: mk(`rgb(${FLAT},${FLAT},${FLAT})`), bare: bare ? mk('#000') : null };\n  const all = [p.col, p.alpha, p.height, p.bare].filter(Boolean);\n  // one shape onto the canvases named in `styles` (a fill or stroke style each)\n  p.fill = (path, styles) => { for (const k in styles) { p[k].fillStyle = styles[k]; p[k].fill(path); } };\n  p.stroke = (path, styles, width) => { for (const k in styles) { p[k].strokeStyle = styles[k]; p[k].lineWidth = width; p[k].stroke(path); } };\n  // paint only inside one variant's square\n  p.clip = (x, y, w) => { for (const g of all) { g.save(); g.beginPath(); g.rect(x, y, w, w); g.clip(); } };\n  p.unclip = () => { for (const g of all) g.restore(); };\n  return p;\n}\n\nconst grey = (v) => `rgb(${v | 0},${v | 0},${v | 0})`;\n\n/* a ragged outline round (x, y): n corners out to r, each pulled in by up to jag of it */\nfunction ragged(R, x, y, r, n, jag) {\n  const path = new Path2D();\n  for (let i = 0; i < n; i++) {\n    const a = ((i + (R() - 0.5) * 0.8) / n) * Math.PI * 2, rr = r * (1 - jag * R());\n    path[i ? 'lineTo' : 'moveTo'](x + Math.cos(a) * rr, y + Math.sin(a) * rr);\n  }\n  path.closePath();\n  return path;\n}\n\nfunction disc(x, y, r) {\n  const path = new Path2D();\n  path.arc(x, y, r, 0, Math.PI * 2);\n  return path;\n}\n\n/* a crack wandering from (x, y) along ang */\nfunction crack(R, x, y, ang, len, steps = 5) {\n  const path = new Path2D();\n  path.moveTo(x, y);\n  for (let s = 0; s < steps; s++) {\n    ang += (R() - 0.5) * 0.8;\n    x += (Math.cos(ang) * len) / steps;\n    y += (Math.sin(ang) * len) / steps;\n    path.lineTo(x, y);\n  }\n  return path;\n}\n\n/* a splinter: a sliver from (x, y) along ang, w wide at its root, to a point */\nfunction sliver(x, y, ang, len, w) {\n  const path = new Path2D(), c = Math.cos(ang), s = Math.sin(ang);\n  path.moveTo(x - s * w * 0.5, y + c * w * 0.5);\n  path.lineTo(x + c * len * 0.6 - s * w * 0.3, y + s * len * 0.6 + c * w * 0.3);\n  path.lineTo(x + c * len, y + s * len);\n  path.lineTo(x + c * len * 0.55 + s * w * 0.35, y + s * len * 0.55 - c * w * 0.35);\n  path.lineTo(x + s * w * 0.5, y - c * w * 0.5);\n  path.closePath();\n  return path;\n}\n\n/* stone (and brick, cobbles, concrete): the face spalled away in chips, lopsided, round a black hole */\nfunction stoneHole(p, R, cx, cy, S) {\n  const ox = cx + (R() - 0.5) * S * 0.08, oy = cy + (R() - 0.5) * S * 0.08;\n  // the powder of it thrown round, and grit\n  const dust = p.alpha.createRadialGradient(ox, oy, S * 0.1, ox, oy, S * 0.42);\n  dust.addColorStop(0, grey(55 + R() * 30)); dust.addColorStop(1, grey(0));\n  p.alpha.fillStyle = dust; p.alpha.fill(disc(ox, oy, S * 0.42));\n  for (let k = 0; k < 60; k++) {\n    const a = R() * Math.PI * 2, r = S * (0.13 + 0.27 * Math.sqrt(R())), v = 105 + R() * 70;\n    p.fill(disc(ox + Math.cos(a) * r, oy + Math.sin(a) * r, S * (0.004 + R() * 0.008)), { col: `rgb(${v},${v * 0.95},${v * 0.87})`, alpha: grey(60 + R() * 100), height: grey(FLAT + 6) });\n  }\n  // cracks running out of it\n  for (let k = 0, m = 2 + Math.floor(R() * 4); k < m; k++) {\n    const a = R() * Math.PI * 2;\n    p.stroke(crack(R, cx + Math.cos(a) * S * 0.13, cy + Math.sin(a) * S * 0.13, a, S * (0.1 + R() * 0.16)), { col: 'rgb(30,28,25)', alpha: grey(200), height: grey(FLAT - 28) }, S * (0.005 + R() * 0.005));\n  }\n  // the crater, in chips that each broke off at a depth of their own\n  const cr = S * (0.15 + R() * 0.09), kx = (cx + ox) / 2, ky = (cy + oy) / 2;\n  p.fill(ragged(R, kx, ky, cr, 13 + Math.floor(R() * 6), 0.45), { col: 'rgb(150,141,127)', alpha: grey(255), height: grey(FLAT - 34) });\n  for (let k = 0, m = 8 + Math.floor(R() * 5); k < m; k++) {\n    const a = R() * Math.PI * 2, r = cr * 0.6 * Math.sqrt(R()), v = 125 + R() * 55;\n    p.fill(ragged(R, kx + Math.cos(a) * r, ky + Math.sin(a) * r, S * (0.04 + R() * 0.05), 7, 0.4), { col: `rgb(${v},${v * 0.94},${v * 0.85})`, alpha: grey(255), height: grey(FLAT - 70 + (r / S) * 300 + R() * 18) });\n  }\n  // deepest in the middle, round the hole the lead and soot the bullet wiped off\n  const pit = p.height.createRadialGradient(cx, cy, 0, cx, cy, cr * 0.7);\n  pit.addColorStop(0, 'rgba(60,60,60,1)'); pit.addColorStop(1, 'rgba(60,60,60,0)');\n  p.height.fillStyle = pit; p.height.fill(disc(cx, cy, cr * 0.7));\n  const hr = S * (0.035 + R() * 0.015);\n  const wipe = p.col.createRadialGradient(cx, cy, hr * 0.8, cx, cy, hr * 2.4);\n  wipe.addColorStop(0, 'rgba(22,20,18,0.95)'); wipe.addColorStop(1, 'rgba(22,20,18,0)');\n  p.col.fillStyle = wipe; p.col.fill(disc(cx, cy, hr * 2.4));\n  p.fill(ragged(R, cx, cy, hr, 9, 0.3), { col: 'rgb(5,4,4)', height: grey(0) });\n}\n\n/* wood: torn open along the grain (the texture's up and down), the fresh wood splintered out */\nfunction woodHole(p, R, cx, cy, S) {\n  const dust = p.alpha.createRadialGradient(cx, cy, S * 0.08, cx, cy, S * 0.3);\n  dust.addColorStop(0, grey(70)); dust.addColorStop(1, grey(0));\n  p.alpha.fillStyle = dust; p.alpha.fill(disc(cx, cy, S * 0.3));\n  for (let k = 0, m = 14 + Math.floor(R() * 12); k < m; k++) {\n    const ang = (R() < 0.5 ? -1 : 1) * Math.PI * 0.5 + (R() - 0.5) * 0.6, v = 140 + R() * 70;\n    const x = cx + (R() - 0.5) * S * 0.09, y = cy + (R() - 0.5) * S * 0.07;\n    p.fill(sliver(x, y, ang, S * (0.1 + R() * 0.28), S * (0.015 + R() * 0.03)), { col: `rgb(${v},${v * 0.8},${v * 0.54})`, alpha: grey(255), height: grey(FLAT + 14 + R() * 40) });\n  }\n  // the hole torn into it, darker where the wood is crushed\n  p.fill(ragged(R, cx, cy, S * (0.07 + R() * 0.03), 11, 0.35), { col: 'rgb(62,44,26)', alpha: grey(255), height: grey(FLAT - 50) });\n  p.fill(ragged(R, cx, cy, S * (0.038 + R() * 0.014), 9, 0.3), { col: 'rgb(8,6,4)', height: grey(0) });\n}\n\n/* painted steel: dented, the paint flaked off round a bright bowl, holed (or, a glancing hit, not) */\nfunction metalHole(p, R, cx, cy, S) {\n  const dr = S * (0.19 + R() * 0.07);\n  const bowl = p.height.createRadialGradient(cx, cy, 0, cx, cy, dr);\n  bowl.addColorStop(0, grey(70)); bowl.addColorStop(0.7, grey(FLAT - 6)); bowl.addColorStop(0.86, grey(FLAT + 22)); bowl.addColorStop(1, grey(FLAT));\n  p.height.fillStyle = bowl; p.height.fill(disc(cx, cy, dr));\n  // a scuff of soot and lead round it, flakes of paint gone further out\n  const scuff = p.alpha.createRadialGradient(cx, cy, dr * 0.45, cx, cy, dr * 1.35);\n  scuff.addColorStop(0, grey(150)); scuff.addColorStop(1, grey(0));\n  p.alpha.fillStyle = scuff; p.alpha.fill(disc(cx, cy, dr * 1.35));\n  p.col.fillStyle = 'rgb(28,27,26)'; p.col.fill(disc(cx, cy, dr * 1.35));\n  for (let k = 0, m = 5 + Math.floor(R() * 8); k < m; k++) {\n    const a = R() * Math.PI * 2, r = dr * (0.85 + R() * 0.45);\n    p.fill(ragged(R, cx + Math.cos(a) * r, cy + Math.sin(a) * r, S * (0.01 + R() * 0.025), 6, 0.4), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });\n  }\n  p.fill(ragged(R, cx, cy, dr * 0.88, 18, 0.3), { col: 'rgb(150,151,154)', alpha: grey(255), bare: grey(255) });\n  // the hole, its lip torn\n  if (R() < 0.75) p.fill(ragged(R, cx, cy, S * (0.04 + R() * 0.02), 8, 0.35), { col: 'rgb(6,6,6)', bare: grey(0), height: grey(0) });\n}\n\n/* the ground: a pit kicked in the mud, clods thrown out of it */\nfunction mudSplat(p, R, cx, cy, S) {\n  for (let k = 0, m = 30 + Math.floor(R() * 30); k < m; k++) {\n    const a = R() * Math.PI * 2, r = S * (0.1 + 0.32 * Math.sqrt(R())), v = 34 + R() * 26;\n    p.fill(ragged(R, cx + Math.cos(a) * r, cy + Math.sin(a) * r, S * (0.008 + R() * 0.03), 6, 0.45), { col: `rgb(${v},${v * 0.8},${v * 0.6})`, alpha: grey(170 + R() * 85), height: grey(FLAT + 25 + R() * 45) });\n  }\n  p.fill(ragged(R, cx, cy, S * (0.12 + R() * 0.06), 13, 0.4), { col: 'rgb(30,24,17)', alpha: grey(235), height: grey(FLAT - 45) });\n  p.fill(ragged(R, cx, cy, S * (0.05 + R() * 0.02), 9, 0.4), { col: 'rgb(18,14,10)', alpha: grey(255), height: grey(FLAT - 90) });\n}\n\n/* a blast's scorch on the ground, burnt out from the middle in streaks */\nfunction scorchMark(p, R, cx, cy, S) {\n  const burnt = p.alpha.createRadialGradient(cx, cy, 0, cx, cy, S * 0.48);\n  burnt.addColorStop(0, grey(242)); burnt.addColorStop(0.5, grey(178)); burnt.addColorStop(1, grey(0));\n  p.alpha.fillStyle = burnt; p.alpha.fill(disc(cx, cy, S * 0.48));\n  for (let k = 0; k < 40; k++) {\n    const a = R() * 6.28, r = S * (0.22 + R() * 0.24);\n    const path = new Path2D();\n    path.moveTo(cx, cy); path.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);\n    p.stroke(path, { alpha: grey(80 + R() * 100) }, 1 + R() * 3);\n  }\n}\n\n/* A kind's four variants as textures: the colour with how much of it shows, the relief as a\n   normal map (`relief`: how steep a slope of the height comes out) and, for metal, roughness\n   and metalness (green and blue). */\nfunction decalSet(paint, seed, ground, relief, bare = false) {\n  const S = CELL * 2, n = S * S, R = rng(seed);\n  const p = painter(S, ground, bare);\n  for (let i = 0; i < 4; i++) {\n    const x = (i % 2) * CELL, y = (i >> 1) * CELL;\n    p.clip(x, y, CELL);\n    paint(p, R, x + CELL / 2, y + CELL / 2, CELL);\n    p.unclip();\n  }\n  const data = (g) => g.getImageData(0, 0, S, S).data;\n  const col = data(p.col), al = data(p.alpha), hd = data(p.height);\n  // the height softened a little (twice over three texels each way): from eight bits its\n  // slopes would come out in terraces\n  const h = new Float32Array(n), t = new Float32Array(n);\n  for (let i = 0; i < n; i++) h[i] = hd[i * 4] / 255;\n  for (let pass = 0; pass < 2; pass++) {\n    for (let y = 0; y < S; y++) {\n      const r = y * S;\n      for (let x = 0; x < S; x++) t[r + x] = (h[r + Math.max(0, x - 1)] + h[r + x] + h[r + Math.min(S - 1, x + 1)]) / 3;\n    }\n    for (let y = 0; y < S; y++) {\n      const a = Math.max(0, y - 1) * S, b = y * S, c = Math.min(S - 1, y + 1) * S;\n      for (let x = 0; x < S; x++) h[b + x] = (t[a + x] + t[b + x] + t[c + x]) / 3;\n    }\n  }\n  const rgba = new Uint8Array(n * 4), nrm = new Uint8Array(n * 4);\n  for (let y = 0; y < S; y++) {\n    const a = Math.max(0, y - 1) * S, b = y * S, c = Math.min(S - 1, y + 1) * S;\n    for (let x = 0; x < S; x++) {\n      const i = b + x, o = i * 4;\n      rgba[o] = col[o]; rgba[o + 1] = col[o + 1]; rgba[o + 2] = col[o + 2]; rgba[o + 3] = al[o];\n      // the texture's rows run up its v (no flip): a rise along them tilts the normal back down v\n      const dx = (h[b + Math.min(S - 1, x + 1)] - h[b + Math.max(0, x - 1)]) * relief, dy = (h[c + x] - h[a + x]) * relief;\n      const l = Math.hypot(dx, dy, 1);\n      nrm[o] = (0.5 - (0.5 * dx) / l) * 255; nrm[o + 1] = (0.5 - (0.5 * dy) / l) * 255; nrm[o + 2] = (0.5 + 0.5 / l) * 255; nrm[o + 3] = 255;\n    }\n  }\n  const tex = (d, color) => {\n    const tx = new THREE.DataTexture(d, S, S);\n    tx.colorSpace = color ? THREE.SRGBColorSpace : THREE.NoColorSpace;\n    tx.generateMipmaps = true;\n    tx.minFilter = THREE.LinearMipmapLinearFilter;\n    tx.magFilter = THREE.LinearFilter;\n    tx.anisotropy = 4;\n    tx.needsUpdate = true;\n    return tx;\n  };\n  const set = { map: tex(rgba, true), normalMap: tex(nrm, false), orm: null };\n  if (p.bare) {\n    // bare steel smooth and metal, the paint round it rough\n    const b = data(p.bare), orm = new Uint8Array(n * 4);\n    for (let i = 0; i < n; i++) { const k = b[i * 4] / 255; orm[i * 4 + 1] = (0.72 - 0.42 * k) * 255; orm[i * 4 + 2] = k * 255; orm[i * 4 + 3] = 255; }\n    set.orm = tex(orm, false);\n  }\n  return set;\n}\n\nfunction decalMaterial(set, shared) {\n  const mat = new THREE.MeshStandardMaterial({\n    map: set.map, normalMap: set.normalMap, roughness: 0.9, metalness: 0,\n    transparent: true, depthWrite: false,\n    polygonOffset: true, polygonOffsetFactor: -4, polygonOffsetUnits: -4,\n  });\n  if (set.orm) { mat.roughnessMap = mat.metalnessMap = set.orm; mat.roughness = mat.metalness = 1; }\n  mat.onBeforeCompile = (shader) => {\n    shader.uniforms.uWet = shared ? shared.wet : { value: 0 };\n    shader.vertexShader = shader.vertexShader\n      .replace('#include <common>', '#include <common>\\nattribute vec2 aCell;')\n      .replace('#include <uv_vertex>', `#include <uv_vertex>\n      // its variant: a quarter of the textures\n      #ifdef USE_MAP\n        vMapUv = vMapUv * 0.5 + aCell;\n      #endif\n      #ifdef USE_NORMALMAP\n        vNormalMapUv = vNormalMapUv * 0.5 + aCell;\n      #endif\n      #ifdef USE_ROUGHNESSMAP\n        vRoughnessMapUv = vRoughnessMapUv * 0.5 + aCell;\n      #endif\n      #ifdef USE_METALNESSMAP\n        vMetalnessMapUv = vMetalnessMapUv * 0.5 + aCell;\n      #endif`)\n      .replace('#include <project_vertex>', `#include <project_vertex>\n      mvPosition.xyz -= normalize(mvPosition.xyz) * min(${PULL.toFixed(3)}, length(mvPosition.xyz) * 0.2);\n      gl_Position = projectionMatrix * mvPosition;`);\n    shader.fragmentShader = shader.fragmentShader\n      .replace('#include <common>', '#include <common>\\nuniform float uWet;')\n      .replace('#include <map_fragment>', `#include <map_fragment>\n      // wet in the rain like what it is on, a little less (freshly broken)\n      diffuseColor.rgb *= mix(1.0, 0.75, uWet);`)\n      .replace('#include <roughnessmap_fragment>', `#include <roughnessmap_fragment>\n      roughnessFactor = mix(roughnessFactor, roughnessFactor * 0.6 + 0.08, uWet);`);\n    dimFillSpecular(shader);\n  };\n  return mat;\n}\n\nexport function createDecals({ max = 200, shared = null } = {}) {\n  const group = new THREE.Group();\n  group.name = 'decals';\n  const sets = {\n    stone: decalSet(stoneHole, 9151, 'rgb(150,143,131)', 18),\n    wood: decalSet(woodHole, 4243, 'rgb(158,124,84)', 22),\n    metal: decalSet(metalHole, 777, 'rgb(150,151,154)', 20, true),\n    splat: decalSet(mudSplat, 3301, 'rgb(44,35,26)', 14),\n    scorch: decalSet(scorchMark, 6, 'rgb(12,11,9)', 0),\n  };\n  const kinds = {};\n  for (const k in sets) {\n    const cap = k === 'scorch' ? 24 : max;\n    const geo = new THREE.PlaneGeometry(1, 1);\n    const cells = new THREE.InstancedBufferAttribute(new Float32Array(cap * 2), 2);\n    geo.setAttribute('aCell', cells);\n    const m = new THREE.InstancedMesh(geo, decalMaterial(sets[k], shared), cap);\n    m.count = 0;\n    m.frustumCulled = false;\n    m.renderOrder = 2;\n    m.receiveShadow = true;\n    group.add(m);\n    kinds[k] = { mesh: m, cells, cursor: 0, n: 0, cap };\n  }\n  const n = new THREE.Vector3(), up = new THREE.Vector3(), side = new THREE.Vector3();\n  const mtx = new THREE.Matrix4(), turn = new THREE.Matrix4();\n\n  /* A decal `size` across on a surface facing (nx, ny, nz): turned at random, or (along the\n     grain) with its up along the surface's. */\n  function add(kind, x, y, zz, nx, ny, nz, size, grain = false) {\n    const K = kinds[kind];\n    if (!K) return;\n    n.set(nx, ny, nz).normalize();\n    // its up: the world's laid on the surface (on a floor, any)\n    up.set(0, 1, 0).addScaledVector(n, -n.y);\n    if (up.lengthSq() < 0.04) up.set(1, 0, 0).addScaledVector(n, -n.x);\n    up.normalize();\n    side.crossVectors(up, n);\n    mtx.makeBasis(side, up, n).multiply(turn.makeRotationZ(grain ? (Math.random() - 0.5) * 0.4 : Math.random() * Math.PI * 2));\n    mtx.scale(side.set(size, size, 1));\n    mtx.setPosition(x + n.x * 0.012, y + n.y * 0.012, zz + n.z * 0.012);\n    K.mesh.setMatrixAt(K.cursor, mtx);\n    const v = Math.floor(Math.random() * 4);\n    K.cells.setXY(K.cursor, (v % 2) * 0.5, (v >> 1) * 0.5);\n    K.cursor = (K.cursor + 1) % K.cap;\n    K.n = Math.min(K.cap, K.n + 1);\n    K.mesh.count = K.n;\n    K.mesh.instanceMatrix.needsUpdate = true;\n    K.cells.needsUpdate = true;\n  }\n\n  /* A bullet impact by surface. */\n  function impact(x, y, zz, nx, ny, nz, surface) {\n    if (surface === 'water' || surface === 'foliage' || surface === 'flesh') return;\n    const r = Math.random();\n    if (surface === 'mud' || surface === 'grass' || surface === 'forest' || surface === 'dirt') add('splat', x, y, zz, nx, ny, nz, 0.3 + r * 0.22);\n    else if (surface === 'wood') add('wood', x, y, zz, nx, ny, nz, 0.17 + r * 0.08, true);\n    else if (surface === 'metal') add('metal', x, y, zz, nx, ny, nz, 0.12 + r * 0.05);\n    else add('stone', x, y, zz, nx, ny, nz, (surface === 'sandbag' ? 0.12 : 0.16) + r * 0.07);\n  }\n\n  function clear() { for (const K of Object.values(kinds)) { K.n = 0; K.cursor = 0; K.mesh.count = 0; } }\n\n  return { group, add, impact, clear };\n}\n","numLines":343,"startLine":160,"totalLines":502}},"sourceToolAssistantUUID":"5d959ac7-0281-4290-9d68-03a9851e4720","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
