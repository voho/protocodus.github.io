lower GPUs and dense screens: when frames run long\n   for a second the render resolution steps down by a tenth (to 60 % of the\n   quality's pixel ratio at most), and after five smooth seconds it steps\n   back up, though never to a scale that proved too slow in the last 30 s.\n   Only while playing; the hidden-pane watchdog (?debug) never adapts. */\nfunction applyResolution() {\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, quality.pixelRatio) * resScale);\n  renderer.setSize(window.innerWidth, window.innerHeight, false);\n}\nfunction adaptResolution(now) {\n  const raw = lastFrameAt ? Math.min(0.25, (now - lastFrameAt) / 1000) : 1 / 60;\n  lastFrameAt = now;\n  if (state !== 'playing' || document.hidden) { slowFor = fastFor = 0; return; }\n  frameAvg += (raw - frameAvg) * 0.08;\n  resCeilingAge += raw;\n  if (resCeilingAge > 30) resCeiling = 1;\n  if (frameAvg > 1 / 45) { slowFor += raw; fastFor = 0; }\n  else if (frameAvg < 1 / 58) { fastFor += raw; slowFor = 0; }\n  else slowFor = fastFor = 0;\n  if (slowFor > 1 && resScale > 0.61) {\n    resScale = Math.max(0.6, resScale - 0.1);\n    resCeiling = resScale; resCeilingAge = 0; slowFor = 0;\nfun/hedgerow/js/main.js:526:  const sl = G.lights.shadowLight, sl2 = G.lights.shadowLight2;\nfun/hedgerow/js/main.js:536:  if (fl && G.lights.shadowOf !== lampShadowOf) sl.shadow.needsUpdate = true;\nfun/hedgerow/js/main.js:537:  lampShadowOf = G.lights.shadowOf;\nfun/hedgerow/js/shafts.js:170:      const l = lights?.shadowLight;\nfun/hedgerow/js/shafts.js:172:      plight = l && l.castShadow && l.intensity > 0 && lights.shadowOf && map?.isCubeDepthTexture ? l : null;\nfun/hedgerow/js/shafts.js:173:      if (plight) pu.uPLRange.value = lights.shadowOf.range * glowRange;","is_error":false}]},"uuid":"108c5440-4e50-4584-86c7-95e307c9235e","timestamp":"2026-10-21T21:13:22.883Z","toolUseResult":{"stdout":"let lastStep = 0;\nfunction frame(now) {\n  requestAnimationFrame(frame);\n  adaptResolution(now);\n  step()