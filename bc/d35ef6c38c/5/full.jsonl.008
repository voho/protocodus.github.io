 * 78.233) * 43758.5453); }","+void main() {","+  float fall = aEmit.w;","+  float T = sqrt(2.0 * fall / 9.8);","+  vec3 at = aEmit.xyz + vec3(uWind.x * 0.06 * T * T, -fall, uWind.y * 0.06 * T * T);","+  float string = smoothstep(0.82, 0.9, aSeed.x);","+  float rate = mix(1.2 + 2.0 * aSeed.x, 11.0, string) * (0.6 + 0.4 * uRain);","+  float k = (uTime - T) * rate + aSeed.y * 37.0;","+  float slot = floor(k), age = fract(k) / rate;","+  float has = step(hash(slot), mix(0.7, 0.92, string));","+  float d = length(at - cameraPosition);","+  float size = (has > 0.5 && age < 0.17 && d < 9.0 && fall > 0.8) ? 0.16 : 0.0;","+  vec3 right = normalize(vec3(viewMatrix[0][0], 0.0, viewMatrix[2][0]));","+  vec3 p = at + right * (uv.x - 0.5) * size + vec3(0.0, uv.y * size * 0.5, 0.0);","+  vUv = uv;","+  vAge = age;","+  vSeed = fract(aSeed.y * 7.13 + slot * 0.371);","+  vec3 lit = vec3(0.0);","+  for (int i = 0; i < 6; i++) {","+    vec3 dd = at - uLightPos[i];","+    lit += uLightCol[i] / (1.0 + dot(dd, dd) * 0.9);","+  }","+  vLit = lit;","+  vec4 mv = viewMatrix * vec4(p, 1.0);","+  vDist = -mv.z;","+  vProj = vec2(projectionMatrix[2][2], projectionMatrix[3][2]);","+  gl_Position = projectionMatrix * mv;","+}`;","+"," /* A model's eaves as points the water lets go from, in its own space: [x, y, z, fall], fall","    the drop down to the model itself below the point (Infinity: to the ground). */"," function eavesOf(model) {"]},{"oldStart":233,"oldLines":18,"newStart":278,"newLines":28,"lines":["   mesh.name = 'drips';","   mesh.frustumCulled = false;","   mesh.renderOrder = 5;","+  const splashUniforms = {","+    uTime: uniforms.uTime, uRain: uniforms.uRain, uWind: uniforms.uWind, uLightPos: uniforms.uLightPos, uLightCol: uniforms.uLightCol,","+    uColor: uniforms.uColor, uSky: uniforms.uSky, uFlash: uniforms.uFlash, uOpacity: { value: 0.5 },","+    tDepth: uniforms.tDepth, uScreen: uniforms.uScreen, uSoft: uniforms.uSoft,","+  };","+  const splashMat = new THREE.ShaderMaterial({ vertexShader: SPLASH_VERT, fragmentShader: CROWN_FRAG, uniforms: splashUniforms, transparent: true, depthWrite: false, fog: false });","+  const splashes = new THREE.Mesh(geo, splashMat);","+  splashes.name = 'drip-splashes';","+  splashes.frustumCulled = false;","+  splashes.renderOrder = 5;","   const own = { tDepth: uniforms.tDepth, uScreen: uniforms.uScreen, uSoft: uniforms.uSoft };"," ","   return {","-    mesh, count: n,","+    mesh, splashes, count: n,","     /* drawn after the frame in this scene (the late pass, hidden behind the scene by its depth:","        depth = {tDepth, uScreen, uSoft} uniforms that pass keeps), or with the scene */","     drawLate(lateScene, scene, depth = null) {","-      (lateScene || scene).add(mesh);","-      mat.depthTest = !lateScene;","+      (lateScene || scene).add(mesh, splashes);","+      mat.depthTest = splashMat.depthTest = !lateScene;","       const d = lateScene && depth ? depth : own;","-      uniforms.tDepth = d.tDepth; uniforms.uScreen = d.uScreen; uniforms.uSoft = d.uSoft;","-      mat.needsUpdate = true;","+      for (const u of [uniforms, splashUniforms]) { u.tDepth = d.tDepth; u.uScreen = d.uScreen; u.uSoft = d.uSoft; }","+      mat.needsUpdate = splashMat.needsUpdate = true;","     },","     /* time; rain: how hard it rains (weather.js); flash: lightning; sky: a flare's light at the eye */","     update(time, rain, flash, sky) {"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/weather.js","hunks":[{"oldStart":242,"oldLines":7,"newStart":242,"newLines":7,"lines":["   gl_Position = projectionMatrix * mv;"," }`;"," ","-const CROWN_FRAG = /* glsl */ `","+export const CROWN_FRAG = /* glsl */ `"," uniform vec3 uColor, uSky;"," uniform float uOpacity, uFlash, uSoft;"," uniform sampler2D tDepth;"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/drips.js","/Users/vojta/Dev/protocodus.github.