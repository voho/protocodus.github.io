{"parentUuid":"e6c093a0-c1fd-48bb-95b8-3fdfe33ca67e","isSidechain":false,"promptId":"6d5c0a1d-fdd5-4db0-8cbd-a5c82a0adcb7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K7CQACu4pfzdKHe6i4B6Xd","type":"tool_result","content":"1\t/* Hedgerow — the village has been fought over.\n2\t\n3\t   The walls that look onto the lane, the street, the square and the forest\n4\t   track carry what was fired at them before you came: plaster blown off in\n5\t   patches down to the rubble stone or the brick under it, and bursts of\n6\t   machine-gun fire stitched across plaster and stone. All of it is put down\n7\t   at load from each building's own shape. A model's four sides are drawn\n8\t   once, in software, into a grid of what is in front every 5 cm: how far\n9\t   out, how squarely it faces that way, the colour of its texture there. A\n10\t   mark goes only where the wall is open and flat across its whole size, so\n11\t   never over a window, a beam, a drainpipe, a corner or the ivy, and a\n12\t   plaster break only on plaster (light and plain). How many marks a wall\n13\t   gets goes by how open the ground in front of it is and how near it is to\n14\t   the lines the fighting follows. The marks are pinned decals in the bullet\n15\t   holes' own meshes (atmosphere.js): no new draw calls, and the fighting\n16\t   never wears them away. Seeded, so the village is the same every time. */\n17\t\n18\timport { rng, polylineDistance, smoothstep } from './util.js';\n19\t\n20\tconst STEP = 0.05;            // the grid's cell (m)\n21\tconst TOP = 5.5;              // nothing marked higher on a wall than this (m over the model's base)\n22\tconst BUILT = /^(house|barn|ruin|bunker)|^church$/;\n23\tconst PLASTERED = /^house/;\n24\tconst SIDES = [[1, 0], [-1, 0], [0, 1], [0, -1]];\n25\t\n26\t/* a texture's colours, readable: drawn once at up to 1024 (enough to tell plaster, stone and a window apart) */\n27\tfunction texels(tex) {\n28\t  const img = tex?.image;\n29\t  if (!img || !img.width) return null;\n30\t  const S = Math.min(1024, img.width);\n31\t  const c = document.createElement('canvas');\n32\t  c.width = c.height = S;\n33\t  const g = c.getContext('2d', { willReadFrequently: true });\n34\t  g.drawImage(img, 0, 0, S, S);\n35\t  return { S, data: g.getImageData(0, 0, S, S).data, flip: !!tex.flipY };\n36\t}\n37\t\n38\t/* an attribute's values packed in a plain array (a glTF's may come interleaved or quantised) */\n39\tfunction floats(a) {\n40\t  if (!a.isInterleavedBufferAttribute && !a.normalized && a.array instanceof Float32Array) return a.array;\n41\t  const out = new Float32Array(a.count * a.itemSize), get = ['getX', 'getY', 'getZ'];\n42\t  for (let i = 0; i < a.count; i++) for (let c = 0; c < a.itemSize; c++) out[i * a.itemSize + c] = a[get[c]](i);\n43\t  return out;\n44\t}\n45\t\n46\t/* One side of a model, the one facing (dx, 0, dz) in its own space. For every cell of it (u across,\n47\t   v up) the front-most surface: how far out along the facing, how squarely it faces that way, and\n48\t   its colour (lightness and saturation, 0-255; none where `look` has no texture for the triangle's\n49\t   part: a window, the ivy). Only the triangles turned towards the side are drawn. */\n50\tfunction rasterSide(model, dx, dz, look) {\n51\t  const ux = dz, uz = -dx, b = model.box;\n52\t  const us = [b.min.x * ux + b.min.z * uz, b.max.x * ux + b.max.z * uz, b.min.x * ux + b.max.z * uz, b.max.x * ux + b.min.z * uz];\n53\t  const u0 = Math.min(...us), v0 = b.min.y;\n54\t  const W = Math.ceil((Math.max(...us) - u0) / STEP), H = Math.ceil((Math.min(b.max.y, v0 + TOP) - v0) / STEP);\n55\t  const depth = new Float32Array(W * H).fill(-1e9), face = new Float32Array(W * H);\n56\t  const tu = new Float32Array(W * H), tv = new Float32Array(W * H), part = new Int8Array(W * H).fill(-1);\n57\t  model.prims.forEach((pr, pi) => {\n58\t    const g = pr.geometry, idx = g.index;\n59\t    if (!g.attributes.uv) return;\n60\t    const P = floats(g.attributes.position), T = floats(g.attributes.uv), n = idx ? idx.count : g.attributes.position.count;\n61\t    for (let t = 0; t < n; t += 3) {\n62\t      const a = idx ? idx.getX(t) : t, bi = idx ? idx.getX(t + 1) : t + 1, ci = idx ? idx.getX(t + 2) : t + 2;\n63\t      const ax = P[a * 3], ay = P[a * 3 + 1], az = P[a * 3 + 2];\n64\t      const bx = P[bi * 3], by = P[bi * 3 + 1], bz = P[bi * 3 + 2];\n65\t      const cx = P[ci * 3], cy = P[ci * 3 + 1], cz = P[ci * 3 + 2];\n66\t      // how squarely it faces this side: its normal's share along the facing\n67\t      const e1x = bx - ax, e1y = by - ay, e1z = bz - az, e2x = cx - ax, e2y = cy - ay, e2z = cz - az;\n68\t      const nx = e1y * e2z - e1z * e2y, ny = e1z * e2x - e1x * e2z, nz = e1x * e2y - e1y * e2x;\n69\t      const f = (nx * dx + nz * dz) / (Math.hypot(nx, ny, nz) || 1);\n70\t      if (!(f > 0.05)) continue;\n71\t      const p0 = ax * ux + az * uz, p1 = bx * ux + bz * uz, p2 = cx * ux + cz * uz;\n72\t      const d0 = ax * dx + az * dz, d1 = bx * dx + bz * dz, d2 = cx * dx + cz * dz;\n73\t      const area = (p1 - p0) * (cy - ay) - (p2 - p0) * (by - ay);\n74\t      if (Math.abs(area) < 1e-9) continue;\n75\t      const ua = T[a * 2], va = T[a * 2 + 1], ub = T[bi * 2], vb = T[bi * 2 + 1], uc = T[ci * 2], vc = T[ci * 2 + 1];\n76\t      const i0 = Math.max(0, Math.ceil((Math.min(p0, p1, p2) - u0) / STEP - 0.5)), i1 = Math.min(W - 1, Math.floor((Math.max(p0, p1, p2) - u0) / STEP - 0.5));\n77\t      const j0 = Math.max(0, Math.ceil((Math.min(ay, by, cy) - v0) / STEP - 0.5)), j1 = Math.min(H - 1, Math.floor((Math.max(ay, by, cy) - v0) / STEP - 0.5));\n78\t      for (let j = j0; j <= j1; j++) {\n79\t        const v = v0 + (j + 0.5) * STEP;\n80\t        for (let i = i0; i <= i1; i++) {\n81\t          const u = u0 + (i + 0.5) * STEP;\n82\t          const w1 = ((u - p0) * (cy - ay) - (p2 - p0) * (v - ay)) / area, w2 = ((p1 - p0) * (v - ay) - (u - p0) * (by - ay)) / area, w0 = 1 - w1 - w2;\n83\t          if (w0 < -1e-4 || w1 < -1e-4 || w2 < -1e-4) continue;\n84\t          const d = w0 * d0 + w1 * d1 + w2 * d2, k = j * W + i;\n85\t          if (d <= depth[k]) continue;\n86\t          depth[k] = d; face[k] = f; part[k] = pi;\n87\t          tu[k] = w0 * ua + w1 * ub + w2 * uc;\n88\t          tv[k] = w0 * va + w1 * vb + w2 * vc;\n89\t        }\n90\t      }\n91\t    }\n92\t  });\n93\t  const lum = new Uint8Array(W * H), sat = new Uint8Array(W * H);\n94\t  for (let k = 0; k < W * H; k++) {\n95\t    const t = part[k] >= 0 ? look(part[k]) : null;\n96\t    if (!t) continue;\n97\t    const x = (((tu[k] % 1) + 1) % 1 * t.S) | 0, y = (((((t.flip ? 1 - tv[k] : tv[k]) % 1) + 1) % 1) * t.S) | 0;\n98\t    const o = (y * t.S + x) * 4, r = t.data[o], g = t.data[o + 1], bl = t.data[o + 2], mx = Math.max(r, g, bl);\n99\t    lum[k] = (r + g + bl) / 3;\n100\t    sat[k] = mx ? ((mx - Math.min(r, g, bl)) / mx) * 255 : 0;\n101\t  }\n102\t  return { dx, dz, ux, uz, u0, v0, W, H, depth, face, lum, sat };\n103\t}\n104\t\n105\t/* is the rectangle hw cells across and hh up and down round (i, j) open wall: one surface facing about\n106\t   square on, no step in it (a shutter's edge, a window's reveal: a decal is drawn PULL nearer the eye\n107\t   than where it lies, which covers a plaster's gentle bulge but not those), nothing dark in it (a\n108\t   window, an opening, a gap); and for plaster, light and plain (bar a few grimy cells) */\n109\tfunction fits(s, i, j, hw, hh, plaster) {\n110\t  if (i - hw < 0 || j - hh < 0 || i + hw >= s.W || j + hh >= s.H) return false;\n111\t  const d0 = s.depth[j * s.W + i];\n112\t  let m = 0, m2 = 0, n = 0, off = 0;\n113\t  for (let y = j - hh; y <= j + hh; y++) {\n114\t    for (let x = i - hw; x <= i + hw; x++) {\n115\t      const k = y * s.W + x, l = s.lum[k], d = s.depth[k];\n116\t      if (s.face[k] < 0.9 || Math.abs(d - d0) > 0.05 || l < 45) return false;\n117\t      if ((x > i - hw && Math.abs(d - s.depth[k - 1]) > 0.012) || (y > j - hh && Math.abs(d - s.depth[k - s.W]) > 0.012)) return false;\n118\t      if (plaster && (l < 105 || s.sat[k] > 75)) off++;\n119\t      m += l; m2 += l * l; n++;\n120\t    }\n121\t  }\n122\t  m /= n;\n123\t  return !plaster || (off < n * 0.08 && m2 / n - m * m < 22 * 22);\n124\t}\n125\t\n126\t/* a model's side, with its open wall cells (where marks may go) and how much of it there is; null where\n127\t   there is too little. `tex`: the model's colours, read on first use */\n128\tfunction sideOf(model, dx, dz, tex) {\n129\t  // only the model's main part has wall on it (the others: its windows, the ivy)\n130\t  let main = 0;\n131\t  model.prims.forEach((p, i) => { if (p.geometry.attributes.position.count > model.prims[main].geometry.attributes.position.count) main = i; });\n132\t  const t = tex(main);\n133\t  if (!t) return null;\n134\t  const s = rasterSide(model, dx, dz, (pi) => (pi === main ? t : null));\n135\t  s.cells = [];\n136\t  for (let k = 0; k < s.W * s.H; k++) if (s.face[k] >= 0.95 && s.lum[k] >= 45 && ((k / s.W) | 0) * STEP >= 0.25) s.cells.push(k);\n137\t  if (s.cells.length < 400) return null;\n138\t  s.area = s.cells.length * STEP * STEP;\n139\t  return s;\n140\t}\n141\t\n142\t/* Marks the walls of the buildings in `props` (levelBuild's {m, x, y, z, yaw, scale}) with the decals'\n143\t   pin(); `lines`: the level's lines on the ground, the fighting's along LANE, STREET and TRACK. */\n144\texport function dressWalls(G, props, lines, { seed = 1944 } = {}) {\n145\t  const R = rng(seed), decals = G.decals, world = G.world;\n146\t  const fronts = ['LANE', 'STREET', 'TRACK'].map((k) => lines?.[k]).filter(Boolean);\n147\t  const sides = new Map(), colours = new Map(), tmp = {};\n148\t  let breaks = 0, holes = 0;\n149\t  for (const p of props) {\n150\t    const name = p.m.name || '', box = p.m.box;\n151\t    if (!BUILT.test(name)) continue;\n152\t    const c = Math.cos(p.yaw), sn = Math.sin(p.yaw), k = p.scale || 1;\n153\t    // a cell's place on the wall, in the world\n154\t    const at = (s, cell, out) => {\n155\t      const i = cell % s.W, j = (cell / s.W) | 0, u = s.u0 + (i + 0.5) * STEP, d = s.depth[cell];\n156\t      const mx = u * s.ux + d * s.dx, mz = u * s.uz + d * s.dz;\n157\t      out.x = p.x + (mx * c + mz * sn) * k; out.y = p.y + (s.v0 + (j + 0.5) * STEP) * k; out.z = p.z + (-mx * sn + mz * c) * k;\n158\t      return out;\n159\t    };\n160\t    for (const [dx, dz] of SIDES) {\n161\t      const nx = dx * c + dz * sn, nz = -dx * sn + dz * c;\n162\t      // how exposed: open ground in front of the side (rays out at chest height from just off the\n163\t      // middle of the model's box on that side) ...\n164\t      const fx = dx ? (dx > 0 ? box.max.x : box.min.x) : (box.min.x + box.max.x) / 2, fz = dz ? (dz > 0 ? box.max.z : box.min.z) : (box.min.z + box.max.z) / 2;\n165\t      const ox = p.x + (fx * c + fz * sn) * k + nx * 0.4, oz = p.z + (-fx * sn + fz * c) * k + nz * 0.4;\n166\t      const oy = (G.terrain?.height(ox, oz) ?? p.y) + 1.4;\n167\t      let open = 0;\n168\t      for (const a of [-0.7, -0.35, 0, 0.35, 0.7]) {\n169\t        const ca = Math.cos(a), sa = Math.sin(a);\n170\t        if (!world.raycast(ox, oy, oz, nx * ca - nz * sa, 0, nx * sa + nz * ca, 12)) open += 0.2;\n171\t      }\n172\t      // ... onto where the fighting went: the ground in front of it near the lane, the street, the track\n173\t      let near = Infinity;\n174\t      for (const l of fronts) near = Math.min(near, polylineDistance(l, ox + nx * 8, oz + nz * 8, tmp).d);\n175\t      const exposed = open * smoothstep(24, 6, near);\n176\t      if (exposed < 0.05) continue;\n177\t      // the side itself, drawn the first time one of the model's is needed\n178\t      const key = name + dx + dz;\n179\t      if (!sides.has(key)) {\n180\t        sides.set(key, sideOf(p.m, dx, dz, (main) => {\n181\t          if (!colours.has(name)) colours.set(name, texels(G.matlib.resolve(p.m.prims[main].material)?.map));\n182\t          return colours.get(name);\n183\t        }));\n184\t      }\n185\t      const s = sides.get(key);\n186\t      if (!s) continue;\n187\t      // the ground there, in the model's own height\n188\t      const ground = (oy - 1.4 - p.y) / k;\n189\t      const placed = [];\n190\t      const free = (i, j, hw, hh) => placed.every(([pi, pj, pw, ph]) => Math.abs(pi - i) > (pw + hw) * 0.8 || Math.abs(pj - j) > (ph + hh) * 0.8);\n191\t      // a cell of open wall from lo to hi metres over the ground\n192\t      const pick = (lo, hi) => {\n193\t        for (let t = 0; t < 40; t++) {\n194\t          const cell = s.cells[Math.floor(R() * s.cells.length)], h = s.v0 + (((cell / s.W) | 0) + 0.5) * STEP - ground;\n195\t          if (h >= lo && h <= hi) return cell;\n196\t        }\n197\t        return -1;\n198\t      };\n199\t      // plaster blown off, bigger nearer the ground (the break fills an ellipse 0.94 by 0.62 of its\n200\t      // decal; a smaller one where a big one will not fit)\n201\t      const nb = PLASTERED.test(name) ? Math.floor(s.area * 0.1 * exposed + R()) : 0;\n202\t      for (let b = 0; b < nb; b++) {\n203\t        let done = false;\n204\t        for (let t = 0; t < 30 && !done; t++) {\n205\t          const cell = pick(0.4, 4.2);\n206\t          if (cell < 0) break;\n207\t          const i = cell % s.W, j = (cell / s.W) | 0, h = s.v0 + (j + 0.5) * STEP - ground;\n208\t          const big = (2.1 - 0.7 * Math.min(1, h / 3)) * (0.75 + R() * 0.25);\n209\t          for (const size of [big, big * 0.75, big * 0.55, big * 0.4]) {\n210\t            const hw = Math.ceil((size * 0.46) / STEP), hh = Math.ceil((size * 0.32) / STEP);\n211\t            if (!free(i, j, hw, hh) || !fits(s, i, j, hw, hh, true)) continue;\n212\t            at(s, cell, tmp);\n213\t            if (decals.pin('spall', tmp.x, tmp.y, tmp.z, nx, 0, nz, size * k, true, R)) { placed.push([i, j, hw, hh]); breaks++; }\n214\t            done = true;\n215\t            break;\n216\t          }\n217\t        }\n218\t      }\n219\t      // a cannon shell's or a grenade's: the face of the wall smashed in round a hole\n220\t      const ns = Math.floor(s.area * 0.02 * exposed + R());\n221\t      for (let b = 0; b < ns; b++) {\n222\t        for (let t = 0; t < 20; t++) {\n223\t          const cell = pick(0.3, 3.5);\n224\t          if (cell < 0) break;\n225\t          const i = cell % s.W, j = (cell / s.W) | 0, size = 0.45 + R() * 0.3, half = Math.ceil((size * 0.42) / STEP);\n226\t          if (!free(i, j, half, half) || !fits(s, i, j, half, half, false)) continue;\n227\t          at(s, cell, tmp);\n228\t          if (decals.pin('stone', tmp.x, tmp.y, tmp.z, nx, 0, nz, size * k, false, R)) { placed.push([i, j, half, half]); holes++; }\n229\t          break;\n230\t        }\n231\t      }\n232\t      // bursts of machine-gun fire: a line of holes, the gun swinging as it fired\n233\t      const nbu = Math.floor(s.area * 0.08 * exposed + R());\n234\t      for (let b = 0; b < nbu; b++) {\n235\t        const start = pick(0.5, 3.0);\n236\t        if (start < 0) break;\n237\t        const a = (R() - 0.5) * (R() < 0.8 ? 0.9 : 2.4), ca = Math.cos(a), sa = Math.sin(a), gap = 0.07 + R() * 0.15;\n238\t        const si = start % s.W, sj = (start / s.W) | 0, dir = R() < 0.5 ? -1 : 1;\n239\t        for (let h = 0, n = 3 + Math.floor(R() * 7); h < n; h++) {\n240\t          const along = h * gap * (0.7 + R() * 0.6), off = (R() - 0.5) * 0.08;\n241\t          const i = Math.round(si + (dir * along * ca - off * sa) / STEP), j = Math.round(sj + (along * sa + off * ca) / STEP);\n242\t          const size = 0.18 + R() * 0.1;\n243\t          if (!fits(s, i, j, 2, 2, false)) continue;\n244\t          const cell = j * s.W + i;\n245\t          at(s, cell, tmp);\n246\t          if (decals.pin(s.sat[cell] > 100 ? 'wood' : 'stone', tmp.x, tmp.y, tmp.z, nx, 0, nz, size * k, false, R)) holes++;\n247\t        }\n248\t      }\n249\t    }\n250\t  }\n251\t  return { breaks, holes };\n252\t}\n253\t"}]},"uuid":"6c308a2f-e64e-4624-82cd-5c72a4af2562","timestamp":"2026-10-21T21:49:52.016Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/damage.js","content":"/* Hedgerow — the village has been fought over.\n\n   The walls that look onto the lane, the street, the square and the forest\n   track carry what was fired at them before you came: plaster blown off in\n   patches down to the rubble stone or the brick under it, and bursts of\n   machine-gun fire stitched across plaster and stone. All of it is put down\n   at load from each building's own shape. A model's four sides are drawn\n   once, in software, into a grid of what is in front every 5 cm: how far\n   out, how squarely it faces that way, the colour of its texture there. A\n   mark goes only where the wall is open and flat across its whole size, so\n   never over a window, a beam, a drainpipe, a corner or the ivy, and a\n   plaster break only on plaster (light and plain). How many marks a wall\n   gets goes by how open the ground in front of it is and how near it is to\n   the lines the fighting follows. The marks are pinned decals in the bullet\n   holes' own meshes (atmosphere.js): no new draw calls, and the fighting\n   never wears them away. Seeded, so the village is the same every time. */\n\nimport { rng, polylineDistance, smoothstep } from './util.js';\n\nconst STEP = 0.05;            // the grid's cell (m)\nconst TOP = 5.5;              // nothing marked higher on a wall than this (m over the model's base)\nconst BUILT = /^(house|barn|ruin|bunker)|^church$/;\nconst PLASTERED = /^house/;\nconst SIDES = [[1, 0], [-1, 0], [0, 1], [0, -1]];\n\n/* a texture's colours, readable: drawn once at up to 1024 (enough to tell plaster, stone and a window apart) */\nfunction texels(tex) {\n  const img = tex?.image;\n  if (!img || !img.width) return null;\n  const S = Math.min(1024, img.width);\n  const c = document.createElement('canvas');\n  c.width = c.height = S;\n  const g = c.getContext('2d', { willReadFrequently: true });\n  g.drawImage(img, 0, 0, S, S);\n  return { S, data: g.getImageData(0, 0, S, S).data, flip: !!tex.flipY };\n}\n\n/* an attribute's values packed in a plain array (a glTF's may come interleaved or quantised) */\nfunction floats(a) {\n  if (!a.isInterleavedBufferAttribute && !a.normalized && a.array instanceof Float32Array) return a.array;\n  const out = new Float32Array(a.count * a.itemSize), get = ['getX', 'getY', 'getZ'];\n  for (let i = 0; i < a.count; i++) for (let c = 0; c < a.itemSize; c++) out[i * a.itemSize + c] = a[get[c]](i);\n  return out;\n}\n\n/* One side of a model, the one facing (dx, 0, dz) in its own space. For every cell of it (u across,\n   v up) the front-most surface: how far out along the facing, how squarely it faces that way, and\n   its colour (lightness and saturation, 0-255; none where `look` has no texture for the triangle's\n   part: a window, the ivy). Only the triangles turned towards the side are drawn. */\nfunction rasterSide(model, dx, dz, look) {\n  const ux = dz, uz = -dx, b = model.box;\n  const us = [b.min.x * ux + b.min.z * uz, b.max.x * ux + b.max.z * uz, b.min.x * ux + b.max.z * uz, b.max.x * ux + b.min.z * uz];\n  const u0 = Math.min(...us), v0 = b.min.y;\n  const W = Math.ceil((Math.max(...us) - u0) / STEP), H = Math.ceil((Math.min(b.max.y, v0 + TOP) - v0) / STEP);\n  const depth = new Float32Array(W * H).fill(-1e9), face = new Float32Array(W * H);\n  const tu = new Float32Array(W * H), tv = new Float32Array(W * H), part = new Int8Array(W * H).fill(-1);\n  model.prims.forEach((pr, pi) => {\n    const g = pr.geometry, idx = g.index;\n    if (!g.attributes.uv) return;\n    const P = floats(g.attributes.position), T = floats(g.attributes.uv), n = idx ? idx.count : g.attributes.position.count;\n    for (let t = 0; t < n; t += 3) {\n      const a = idx ? idx.getX(t) : t, bi = idx ? idx.getX(t + 1) : t + 1, ci = idx ? idx.getX(t + 2) : t + 2;\n      const ax = P[a * 3], ay = P[a * 3 + 1], az = P[a * 3 + 2];\n      const bx = P[bi * 3], by = P[bi * 3 + 1], bz = P[bi * 3 + 2];\n      const cx = P[ci * 3], cy = P[ci * 3 + 1], cz = P[ci * 3 + 2];\n      // how squarely it faces this side: its normal's share along the facing\n      const e1x = bx - ax, e1y = by - ay, e1z = bz - az, e2x = cx - ax, e2y = cy - ay, e2z = cz - az;\n      const nx = e1y * e2z - e1z * e2y, ny = e1z * e2x - e1x * e2z, nz = e1x * e2y - e1y * e2x;\n      const f = (nx * dx + nz * dz) / (Math.hypot(nx, ny, nz) || 1);\n      if (!(f > 0.05)) continue;\n      const p0 = ax * ux + az * uz, p1 = bx * ux + bz * uz, p2 = cx * ux + cz * uz;\n      const d0 = ax * dx + az * dz, d1 = bx * dx + bz * dz, d2 = cx * dx + cz * dz;\n      const area = (p1 - p0) * (cy - ay) - (p2 - p0) * (by - ay);\n      if (Math.abs(area) < 1e-9) continue;\n      const ua = T[a * 2], va = T[a * 2 + 1], ub = T[bi * 2], vb = T[bi * 2 + 1], uc = T[ci * 2], vc = T[ci * 2 + 1];\n      const i0 = Math.max(0, Math.ceil((Math.min(p0, p1, p2) - u0) / STEP - 0.5)), i1 = Math.min(W - 1, Math.floor((Math.max(p0, p1, p2) - u0) / STEP - 0.5));\n      const j0 = Math.max(0, Math.ceil((Math.min(ay, by, cy) - v0) / STEP - 0.5)), j1 = Math.min(H - 1, Math.floor((Math.max(ay, by, cy) - v0) / STEP - 0.5));\n      for (let j = j0; j <= j1; j++) {\n        const v = v0 + (j + 0.5) * STEP;\n        for (let i = i0; i <= i1; i++) {\n          const u = u0 + (i + 0.5) * STEP;\n          const w1 = ((u - p0) * (cy - ay) - (p2 - p0) * (v - ay)) / area, w2 = ((p1 - p0) * (v - ay) - (u - p0) * (by - ay)) / area, w0 = 1 - w1 - w2;\n          if (w0 < -1e-4 || w1 < -1e-4 || w2 < -1e-4) continue;\n          const d = w0 * d0 + w1 * d1 + w2 * d2, k = j * W + i;\n          if (d <= depth[k]) continue;\n          depth[k] = d; face[k] = f; part[k] = pi;\n          tu[k] = w0 * ua + w1 * ub + w2 * uc;\n          tv[k] = w0 * va + w1 * vb + w2 * vc;\n        }\n      }\n    }\n  });\n  const lum = new Uint8Array(W * H), sat = new Uint8Array(W * H);\n  for (let k = 0; k < W * H; k++) {\n    const t = part[k] >= 0 ? look(part[k]) : null;\n    if (!t) continue;\n    const x = (((tu[k] % 1) + 1) % 1 * t.S) | 0, y = (((((t.flip ? 1 - tv[k] : tv[k]) % 1) + 1) % 1) * t.S) | 0;\n    const o = (y * t.S + x) * 4, r = t.data[o], g = t.data[o + 1], bl = t.data[o + 2], mx = Math.max(r, g, bl);\n    lum[k] = (r + g + bl) / 3;\n    sat[k] = mx ? ((mx - Math.min(r, g, bl)) / mx) * 255 : 0;\n  }\n  return { dx, dz, ux, uz, u0, v0, W, H, depth, face, lum, sat };\n}\n\n/* is the rectangle hw cells across and hh up and down round (i, j) open wall: one surface facing about\n   square on, no step in it (a shutter's edge, a window's reveal: a decal is drawn PULL nearer the eye\n   than where it lies, which covers a plaster's gentle bulge but not those), nothing dark in it (a\n   window, an opening, a gap); and for plaster, light and plain (bar a few grimy cells) */\nfunction fits(s, i, j, hw, hh, plaster) {\n  if (i - hw < 0 || j - hh < 0 || i + hw >= s.W || j + hh >= s.H) return false;\n  const d0 = s.depth[j * s.W + i];\n  let m = 0, m2 = 0, n = 0, off = 0;\n  for (let y = j - hh; y <= j + hh; y++) {\n    for (let x = i - hw; x <= i + hw; x++) {\n      const k = y * s.W + x, l = s.lum[k], d = s.depth[k];\n      if (s.face[k] < 0.9 || Math.abs(d - d0) > 0.05 || l < 45) return false;\n      if ((x > i - hw && Math.abs(d - s.depth[k - 1]) > 0.012) || (y > j - hh && Math.abs(d - s.depth[k - s.W]) > 0.012)) return false;\n      if (plaster && (l < 105 || s.sat[k] > 75)) off++;\n      m += l; m2 += l * l; n++;\n    }\n  }\n  m /= n;\n  return !plaster || (off < n * 0.08 && m2 / n - m * m < 22 * 22);\n}\n\n/* a model's side, with its open wall cells (where marks may go) and how much of it there is; null where\n   there is too little. `tex`: the model's colours, read on first use */\nfunction sideOf(model, dx, dz, tex) {\n  // only the model's main part has wall on it (the others: its windows, the ivy)\n  let main = 0;\n  model.prims.forEach((p, i) => { if (p.geometry.attributes.position.count > model.prims[main].geometry.attributes.position.count) main = i; });\n  const t = tex(main);\n  if (!t) return null;\n  const s = rasterSide(model, dx, dz, (pi) => (pi === main ? t : null));\n  s.cells = [];\n  for (let k = 0; k < s.W * s.H; k++) if (s.face[k] >= 0.95 && s.lum[k] >= 45 && ((k / s.W) | 0) * STEP >= 0.25) s.cells.push(k);\n  if (s.cells.length < 400) return null;\n  s.area = s.cells.length * STEP * STEP;\n  return s;\n}\n\n/* Marks the walls of the buildings in `props` (levelBuild's {m, x, y, z, yaw, scale}) with the decals'\n   pin(); `lines`: the level's lines on the ground, the fighting's along LANE, STREET and TRACK. */\nexport function dressWalls(G, props, lines, { seed = 1944 } = {}) {\n  const R = rng(seed), decals = G.decals, world = G.world;\n  const fronts = ['LANE', 'STREET', 'TRACK'].map((k) => lines?.[k]).filter(Boolean);\n  const sides = new Map(), colours = new Map(), tmp = {};\n  let breaks = 0, holes = 0;\n  for (const p of props) {\n    const name = p.m.name || '', box = p.m.box;\n    if (!BUILT.test(name)) continue;\n    const c = Math.cos(p.yaw), sn = Math.sin(p.yaw), k = p.scale || 1;\n    // a cell's place on the wall, in the world\n    const at = (s, cell, out) => {\n      const i = cell % s.W, j = (cell / s.W) | 0, u = s.u0 + (i + 0.5) * STEP, d = s.depth[cell];\n      const mx = u * s.ux + d * s.dx, mz = u * s.uz + d * s.dz;\n      out.x = p.x + (mx * c + mz * sn) * k; out.y = p.y + (s.v0 + (j + 0.5) * STEP) * k; out.z = p.z + (-mx * sn + mz * c) * k;\n      return out;\n    };\n    for (const [dx, dz] of SIDES) {\n      const nx = dx * c + dz * sn, nz = -dx * sn + dz * c;\n      // how exposed: open ground in front of the side (rays out at chest height from just off the\n      // middle of the model's box on that side) ...\n      const fx = dx ? (dx > 0 ? box.max.x : box.min.x) : (box.min.x + box.max.x) / 2, fz = dz ? (dz > 0 ? box.max.z : box.min.z) : (box.min.z + box.max.z) / 2;\n      const ox = p.x + (fx * c + fz * sn) * k + nx * 0.4, oz = p.z + (-fx * sn + fz * c) * k + nz * 0.4;\n      const oy = (G.terrain?.height(ox, oz) ?? p.y) + 1.4;\n      let open = 0;\n      for (const a of [-0.7, -0.35, 0, 0.35, 0.7]) {\n        const ca = Math.cos(a), sa = Math.sin(a);\n        if (!world.raycast(ox, oy, oz, nx * ca - nz * sa, 0, nx * sa + nz * ca, 12)) open += 0.2;\n      }\n      // ... onto where the fighting went: the ground in front of it near the lane, the street, the track\n      let near = Infinity;\n      for (const l of fronts) near = Math.min(near, polylineDistance(l, ox + nx * 8, oz + nz * 8, tmp).d);\n      const exposed = open * smoothstep(24, 6, near);\n      if (exposed < 0.05) continue;\n      // the side itself, drawn the first time one of the model's is needed\n      const key = name + dx + dz;\n      if (!sides.has(key)) {\n        sides.set(key, sideOf(p.m, dx, dz, (main) => {\n          if (!colours.has(name)) colours.set(name, texels(G.matlib.resolve(p.m.prims[main].material)?.map));\n          return colours.get(name);\n        }));\n      }\n      const s = sides.get(key);\n      if (!s) continue;\n      // the ground there, in the model's own height\n      const ground = (oy - 1.4 - p.y) / k;\n      const placed = [];\n      const free = (i, j, hw, hh) => placed.every(([pi, pj, pw, ph]) => Math.abs(pi - i) > (pw + hw) * 0.8 || Math.abs(pj - j) > (ph + hh) * 0.8);\n      // a cell of open wall from lo to hi metres over the ground\n      const pick = (lo, hi) => {\n        for (let t = 0; t < 40; t++) {\n          const cell = s.cells[Math.floor(R() * s.cells.length)], h = s.v0 + (((cell / s.W) | 0) + 0.5) * STEP - ground;\n          if (h >= lo && h <= hi) return cell;\n        }\n        return -1;\n      };\n      // plaster blown off, bigger nearer the ground (the break fills an ellipse 0.94 by 0.62 of its\n      // decal; a smaller one where a big one will not fit)\n      const nb = PLASTERED.test(name) ? Math.floor(s.area * 0.1 * exposed + R()) : 0;\n      for (let b = 0; b < nb; b++) {\n        let done = false;\n        for (let t = 0; t < 30 && !done; t++) {\n          const cell = pick(0.4, 4.2);\n          if (cell < 0) break;\n          const i = cell % s.W, j = (cell / s.W) | 0, h = s.v0 + (j + 0.5) * STEP - ground;\n          const big = (2.1 - 0.7 * Math.min(1, h / 3)) * (0.75 + R() * 0.25);\n          for (const size of [big, big * 0.75, big * 0.55, big * 0.4]) {\n            const hw = Math.ceil((size * 0.46) / STEP), hh = Math.ceil((size * 0.32) / STEP);\n            if (!free(i, j, hw, hh) || !fits(s, i, j, hw, hh, true)) continue;\n            at(s, cell, tmp);\n            if (decals.pin('spall', tmp.x, tmp.y, tmp.z, nx, 0, nz, size * k, true, R)) { placed.push([i, j, hw, hh]); breaks++; }\n            done = true;\n            break;\n          }\n        }\n      }\n      // a cannon shell's or a grenade's: the face of the wall smashed in round a hole\n      const ns = Math.floor(s.area * 0.02 * exposed + R());\n      for (let b = 0; b < ns; b++) {\n        for (let t = 0; t < 20; t++) {\n          const cell = pick(0.3, 3.5);\n          if (cell < 0) break;\n          const i = cell % s.W, j = (cell / s.W) | 0, size = 0.45 + R() * 0.3, half = Math.ceil((size * 0.42) / STEP);\n          if (!free(i, j, half, half) || !fits(s, i, j, half, half, false)) continue;\n          at(s, cell, tmp);\n          if (decals.pin('stone', tmp.x, tmp.y, tmp.z, nx, 0, nz, size * k, false, R)) { placed.push([i, j, half, half]); holes++; }\n          break;\n        }\n      }\n      // bursts of machine-gun fire: a line of holes, the gun swinging as it fired\n      const nbu = Math.floor(s.area * 0.08 * exposed + R());\n      for (let b = 0; b < nbu; b++) {\n        const start = pick(0.5, 3.0);\n        if (start < 0) break;\n        const a = (R() - 0.5) * (R() < 0.8 ? 0.9 : 2.4), ca = Math.cos(a), sa = Math.sin(a), gap = 0.07 + R() * 0.15;\n        const si = start % s.W, sj = (start / s.W) | 0, dir = R() < 0.5 ? -1 : 1;\n        for (let h = 0, n = 3 + Math.floor(R() * 7); h < n; h++) {\n          const along = h * gap * (0.7 + R() * 0.6), off = (R() - 0.5) * 0.08;\n          const i = Math.round(si + (dir * along * ca - off * sa) / STEP), j = Math.round(sj + (along * sa + off * ca) / STEP);\n          const size = 0.18 + R() * 0.1;\n          if (!fits(s, i, j, 2, 2, false)) continue;\n          const cell = j * s.W + i;\n          at(s, cell, tmp);\n          if (decals.pin(s.sat[cell] > 100 ? 'wood' : 'stone', tmp.x, tmp.y, tmp.z, nx, 0, nz, size * k, false, R)) holes++;\n        }\n      }\n    }\n  }\n  return { breaks, holes };\n}\n","numLines":253,"startLine":1,"totalLines":253}},"sourceToolAssistantUUID":"e6c093a0-c1fd-48bb-95b8-3fdfe33ca67e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"REDACTED","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"HEAD","slug":"shimmying-swimming-falcon"}
