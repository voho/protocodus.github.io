    const col = p.col.createRadialGradient(mx, my, 0, mx, my, w * 0.5);","+      col.addColorStop(0, tone(1)); col.addColorStop(1, tone(0.8));","+      const hg = p.height.createRadialGradient(mx, my, 0, mx, my, w * 0.5);","+      hg.addColorStop(0, grey(FLAT - 16)); hg.addColorStop(1, grey(FLAT - 36));","+      p.fill(path, { col, alpha: grey(255), height: hg });","+      x += w;","+    }","+    y += h;","+  }","+}","+","+/* brick in its courses, each course half a brick over, a corner knocked off here and there */","+function bricks(p, R, cx, cy, S) {","+  const h = S * 0.062, w = S * 0.19, gap = S * 0.011;","+  const tones = [[150, 74, 54], [128, 62, 46], [160, 92, 66], [112, 58, 44], [140, 82, 62], [92, 56, 46]];","+  for (let row = 0, y = cy - S * 0.5; y < cy + S * 0.5; row++, y += h) {","+    for (let x = cx - S * 0.5 - (row % 2) * w * 0.5; x < cx + S * 0.5; x += w) {","+      const t = tones[Math.floor(R() * tones.length)], f = 0.85 + R() * 0.25, j = () => (R() - 0.5) * gap * 0.6;","+      const tone = (k) => `rgb(${(t[0] * f * k) | 0},${(t[1] * f * k) | 0},${(t[2] * f * k) | 0})`;","+      const path = new Path2D();","+      path.moveTo(x + gap / 2 + j(), y + gap / 2 + j()); path.lineTo(x + w - gap / 2 + j(), y + gap / 2 + j());","+      path.lineTo(x + w - gap / 2 + j(), y + h - gap / 2 + j()); path.lineTo(x + gap / 2 + j(), y + h - gap / 2 + j());","+      path.closePath();","+      p.fill(path, { col: tone(1), alpha: grey(255), height: grey(FLAT - 26 - R() * 6) });","+      if (R() < 0.35) p.fill(ragged(R, x + (R() < 0.5 ? gap : w - gap), y + (R() < 0.5 ? gap : h - gap), h * 0.4, 6, 0.4), { col: tone(0.7), height: grey(FLAT - 44) });","+    }","+  }","+}","+","+/* plaster blown off a wall down to what it was laid on, a few centimetres back: rubble stone in its","+   mortar (now and then brick), the break's edge pale (the plaster's own thickness) and proud of it,","+   flakes gone and cracks running out round it, its dust washed down the wall below. (The canvas's","+   rows run up the wall, so below is up the canvas.) */","+function plasterBreak(p, R, cx, cy, S) {","+  const brick = R() < 0.25, shape = new Path2D(), lobes = [];","+  for (let k = 0, m = 3 + Math.floor(R() * 3); k < m; k++) {","+    const r = S * (0.1 + R() * 0.085), rx = r * (1.2 + R() * 0.3), ry = r * (0.7 + R() * 0.3);","+    const x = cx + (R() - 0.5) * S * 0.3, y = cy + (R() - 0.5) * S * 0.18;","+    lobes.push([x, y, rx, ry]);","+    shape.addPath(ragged(R, x, y, rx, 26, 0.2, ry / rx));","+  }","+  const room = (x, y) => S * 0.47 - Math.hypot(x - cx, y - cy);","+  const edge = () => {","+    const [x, y, rx, ry] = lobes[Math.floor(R() * lobes.length)], a = R() * Math.PI * 2;","+    return [x + Math.cos(a) * rx, y + Math.sin(a) * ry, a];","+  };","+  // the plaster round it loosened and dirtied","+  const halo = p.alpha.createRadialGradient(cx, cy, S * 0.2, cx, cy, S * 0.47);","+  halo.addColorStop(0, grey(48)); halo.addColorStop(1, grey(0));","+  p.alpha.fillStyle = halo; p.alpha.fill(disc(cx, cy, S * 0.47));","+  // the dust of it washed down the wall","+  for (let k = 0; k < 7; k++) {","+    const [x, y, rx, ry] = lobes[Math.floor(R() * lobes.length)];","+    const sx = x + (R() - 0.5) * rx * 1.2, sy = y - ry * 0.7, len = Math.min(S * (0.08 + R() * 0.14), sy - (cy - S * 0.47));","+    if (len < S * 0.03) continue;","+    const path = new Path2D();","+    path.moveTo(sx, sy); path.lineTo(sx + (R() - 0.5) * S * 0.02, sy - len);","+    const fade = p.alpha.createLinearGradient(sx, sy, sx, sy - len);","+    fade.addColorStop(0, grey(60)); fade.addColorStop(1, grey(0));","+    p.stroke(path, { col: 'rgb(150,145,134)', alpha: fade }, S * (0.005 + R() * 0.01));","+  }","+  // cracks running out into what still holds, flakes gone round the edge","+  for (let k = 0, m = 4 + Math.floor(R() * 4); k < m; k++) {","+    const [x, y, a] = edge(), rm = room(x, y);","+    if (rm < S * 0.04) continue;","+    p.stroke(crack(R, x, y, a, Math.min(rm, S * (0.05 + R() * 0.11)), 6), { col: 'rgb(56,52,47)', alpha: grey(160), height: grey(FLAT - 24) }, S * (0.003 + R() * 0.003));","+  }","+  for (let k = 0; k < 16; k++) {","+    const [x, y, a] = edge(), d = S * (0.005 + R() * 0.03), fx = x + Math.cos(a) * d, fy = y + Math.sin(a) * d;","+    if (room(fx, fy) < S * 0.03) continue;","+    p.fill(ragged(R, fx, fy, S * (0.006 + R() * 0.014), 7, 0.4), { col: 'rgb(146,139,126)', alpha: grey(255), height: grey(FLAT - 14) });","+  }","+  // the break's edge: a hairline where the plaster came away, then the plaster's thickness, pale","+  // (stroked round every lobe: what falls inside the break is painted over next)","+  p.stroke(shape, { col: 'rgb(62,58,52)', alpha: grey(120), height: grey(FLAT - 26) }, S * 0.03);","+  p.stroke(shape, { col: 'rgb(198,191,178)', alpha: grey(255), height: grey(FLAT - 5) }, S * 0.018);","+  // and in it, set back, what it was laid on","+  const all = [p.col, p.alpha, p.height];","+  for (const g of all) { g.save(); g.clip(shape); }","+  const back = new Path2D();","+  back.rect(cx - S / 2, cy - S / 2, S, S);","+  p.fill(back, { col: 'rgb(118,111,98)', alpha: grey(255), height: grey(FLAT - 56) });","+  (brick ? bricks : rubble)(p, R, cx, cy, S);","+  for (const g of all) g.restore();","+}","+"," /* A kind's four variants as textures: the colour with how much of it shows, the relief as a","    normal map (`relief`: how steep a slope of the height comes out) and, for metal, roughness","    and metalness (green and blue). */"]},{"oldStart":434,"oldLines":7,"newStart":529,"newLines":10,"lines":["   return mat;"," }"," ","-export function createDecals({ max = 200, shared = null } = {}) {","+/* `pinned`: room for how many of each kind are put down for good with pin() (the walls' old damage,","+   damage.js), before the fighting starts; those never make way for new ones. Plaster breaks","+   ('spall') are only ever pinned. */","+export function createDecals({ max = 200, shared = null, pinned = {} } = {}) {","   const group = new THREE.Group();","   group.name = 'decals';","   const sets = {"]},{"oldStart":444,"oldLines":47,"newStart":542,"newLines":65,"lines":["     splat: decalSet(mudSplat, 3301, 'rgb(44,35,26)', 14),","     scorch: decalSet(scorchMark, 6, 'rgb(12,11,9)', 0),","   };","+  // a break a metre or more across: painted at twice the texels","+  if (pinned.spall) sets.spall = decalSet(plasterBreak, 1871, 'rgb(112,104,92)', 16, false, CELL * 2);","   const kinds = {};","   for (const k in sets) {","-    const cap = k === 'scorch' ? 24 : max;","+    const fixed = pinned[k] || 0, cap = (k === 'scorch' ? 24 : k === 'spall' ? 0 : max) + fixed;","     const geo = new THREE.PlaneGeometry(1, 1);","     const cells = new THREE.InstancedBufferAttribute(new Float32Array(cap * 2), 2);","     geo.setAttribute('aCell', cells);","     const m = new THREE.InstancedMesh(geo, decalMaterial(sets[k], shared), cap);","     m.count = 0;","     m.frustumCulled = false;","-    m.renderOrder = 2;","+    // the breaks under the holes: new shots land in old damage","+    m.renderOrder = k === 'spall' ? 1 : 2;","     m.receiveShadow = true;","     group.add(m);","-    kinds[k] = { mesh: m, cells, cursor: 0, n: 0, cap };","+    kinds[k] = { mesh: m, cells, cursor: 0, n: 0, cap, fixed, base: 0 };","   }","   const n = new THREE.Vector3(), up = new THREE.Vector3(), side = new THREE.Vector3();","   const mtx = new THREE.Matrix4(), turn = new THREE.Matrix4();"," ","-  /* A decal `size` across on a surface facing (nx, ny, nz): turned at random, or (along the","-     grain) with its up along the surface's. */","-  function add(kind, x, y, zz, nx, ny, nz, size, grain = false) {","-    const K = kinds[kind];","-    if (!K) return;","+  /* Decal i of a kind, `size` across on a surface facing (nx, ny, nz): turned at random, or (along","+     the grain) with its up along the surface's. */","+  function put(K, i, x, y, zz, nx, ny, nz, size, grain, R) {","     n.set(nx, ny, nz).normalize();","     // its up: the world's laid on the surface (on a floor, any)","     up.set(0, 1, 0).addScaledVector(n, -n.y);","     if (up.lengthSq() < 0.04) up.set(1, 0, 0).addScaledVector(n, -n.x);","     up.normalize();","     side.crossVectors(up, n);","-    mtx.makeBasis(side, up, n).multiply(turn.makeRotationZ(grain ? (Math.random() - 0.5) * 0.4 : Math.random() * Math.PI * 2));","+    mtx.makeBasis(side, up, n).multiply(turn.makeRotationZ(grain ? (R() - 0.5) * 0.4 : R() * Math.PI * 2));","     mtx.scale(side.set(size, size, 1));","     mtx.setPosition(x + n.x * 0.012, y + n.y * 0.012, zz + n.z * 0.012);","-    K.mesh.setMatrixAt(K.cursor, mtx);","-    const v = Math.floor(Math.random() * 4);","-    K.cells.setXY(K.cursor, (v % 2) * 0.5, (v >> 1) * 0.5);","-    K.cursor = (K.cursor + 1) % K.cap;","-    K.n = Math.min(K.cap, K.n + 1);","-    K.mesh.count = K.n;","+    K.mesh.setMatrixAt(i, mtx);","+    const v = Math.floor(R() * 4);","+    K.cells.setXY(i, (v % 2) * 0.5, (v >> 1) * 0.5);","     K.mesh.instanceMatrix.needsUpdate = true;","     K.cells.needsUpdate = true;","   }"," ","+  function add(kind, x, y, zz, nx, ny, nz, size, grain = false) {","+    const K = kinds[kind];","+    if (!K || K.cap === K.base) return;","+    put(K, K.cursor, x, y, zz, nx, ny, nz, size, grain, Math.random);","+    K.n = Math.max(K.n, K.cursor + 1);","+    K.cursor = K.cursor + 1 < K.cap ? K.cursor + 1 : K.base;","+    K.mesh.count = K.n;","+  }","+","+  /* One for good (before any add() of its kind); false once its kind's pinned room is full. */","+  function pin(kind, x, y, zz, nx, ny, nz, size, grain = false, R = Math.random) {","+    const K = kinds[kind];","+    if (!K || K.base >= K.fixed) return false;","+    put(K, K.base++, x, y, zz, nx, ny, nz, size, grain, R);","+    K.cursor = Math.max(K.cursor, K.base);","+    K.n = Math.max(K.n, K.base);","+    K.mesh.count = K.n;","+    return true;","+  }","+","   /* A bullet impact by surface. */","   function impact(x, y, zz, nx, ny, nz, surface) {","     if (surface === 'water' || surface === 'foliage' || surface === 'flesh') return;"]},{"oldStart":495,"oldLines":7,"newStart":611,"newLines":7,"lines":["     else add('stone', x, y, zz, nx, ny, nz, (surface === 'sandbag' ? 0.12 : 0.16) + r * 0.07);","   }"," ","-  function clear() { for (const K of Object.values(kinds)) { K.n = 0; K.cursor = 0; K.mesh.count = 0; } }","+  function clear() { for (const K of Object.values(kinds)) { K.n = K.base; K.cursor = K.base; K.mesh.count = K.n; } }"," ","-  return { group, add, impact, clear };","+  return { group, add, pin, impact, clear };"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/atmosphere.js"]}},"serverClassifierContext":{"request":"112d49b1-9b0b-4081-8466-c66b34a524c3","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"sourceToolAssistantUUID":"0930c4f7-bf7c-456b-9c59-591262c10e0b","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","versio