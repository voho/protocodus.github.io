he horizon is in the reflections\njs/flares.js:22:   low over the horizon, so houses, walls, soldiers and trees throw long hard\njs/flares.js:121:      G.audio?.distant?.('flare');\njs/levelBuild.js:4:      flak gun is levelled to the height at their centre.\njs/levelBuild.js:7:      to the instancer; some stay separate objects (the flak gun, which\njs/levelBuild.js:27:  if (/^(truck|jeep|barrel|flak|hedgehog|barbed|radio|jerrycan|ammo|lamp)/.test(name)) return 'metal';\njs/levelBuild.js:34:const SEPARATE = new Set(['flak38', 'radio_table']);\njs/flames.js:3:   Over every fire within 60 m (the burning truck, the house, the flak gun\njs/main.js:512:let fpsAcc = 0, fpsFrames = 0, fps = 0, distantTimer = 12, artyFlash = 0;\njs/main.js:609:    distantTimer -= dt;\njs/main.js:610:    if (distantTimer < 0) {\njs/main.js:616:        setTimeout(() => audio.distant('artillery'), km * 2900 / 3);\njs/main.js:617:      } else audio.distant('mg');\njs/main.js:618:      distantTimer = 12 + R() * 22;\njs/mission.js:2:   control hints, the charge on the flak gun, the score. */\njs/mission.js:11:    pickups: [], hintsShown: new Set(), flakDestroyed: false, charge: null,\njs/mission.js:66:  /* the charge on the flak gun */\njs/mission.js:68:    const flak = built.placed.get('flak');\njs/mission.js:69:    if (!flak) return;\njs/mission.js:70:    const a = flak.model.anchors.charge;\njs/mission.js:71:    let x = flak.x, y = flak.y + 1, z = flak.z;\njs/mission.js:73:      const c = Math.cos(flak.yaw), s = Math.sin(flak.yaw);\njs/mission.js:74:      x = flak.x + a[0] * c + a[2] * s; y = flak.y + a[1]; z = flak.z - a[0] * s + a[2] * c;\njs/mission.js:77:      M.flakDestroyed = true;\njs/mission.js:79:      if (flak.object) {\njs/mission.js:80:        flak.object.rotation.z = 0.35;\njs/mission.js:81:        flak.object.rotation.x = -0.15;\njs/mission.js:82:        flak.object.position.y -= 0.3;","is_error":false}]},"uuid":"c362a49b-f6ab-47a0-a926-b06044d50c77","timestamp":"2026-10-21T21:15