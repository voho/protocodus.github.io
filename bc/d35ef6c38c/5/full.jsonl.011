), 4.0);","   // seen by the light they catch: a drop out in the dark (it shows the dark sky) hardly at all,","   // glittering by a lamp, a fire or a flare","-  float a = edge * tail * vAlpha * uOpacity * (uUnlit + uFlash + boost * 1.5);","+  float a = edge * tail * vAlpha * uOpacity * (uUnlit + uFlash + boost * uCatch);","   gl_FragColor = vec4(uColor * (1.0 + uFlash * 3.0) + lit * 2.0, min(a, 0.9));"," }`;"," "]},{"oldStart":155,"oldLines":7,"newStart":155,"newLines":7,"lines":[" const SHEET_GLSL = /* glsl */ `"," ${PHASE_GLSL}"," uniform vec3 uColor, uVel, uSky;","-uniform float uTime, uOpacity, uFlash, uFog, uUnlit;","+uniform float uTime, uOpacity, uFlash, uFog, uUnlit, uCatch;"," uniform vec3 uLightPos[6];"," uniform vec3 uLightCol[6];"," float sHash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }"]},{"oldStart":193,"oldLines":7,"newStart":193,"newLines":7,"lines":[" }"," // how much of a streak shows by that light: out in the dark it shows the dark beyond it and hardly"," // shows at all, by a lamp, a fire, a flare or in a flash of lightning it glitters","-float sheetSeen(vec3 lit) { return uUnlit + uFlash + min(dot(lit, vec3(0.33)), 4.0) * 1.5; }","+float sheetSeen(vec3 lit) { return uUnlit + uFlash + min(dot(lit, vec3(0.33)), 4.0) * uCatch; }"," // and its colour"," vec3 sheetLit(vec3 lit) { return uColor * (0.3 + uFlash * 3.0) + lit * 2.0; }"," `;"]},{"oldStart":425,"oldLines":7,"newStart":425,"newLines":7,"lines":["     uWidth: { value: 0.006 },","     uColor: { value: new THREE.Color('#9aa4ad') },","     uOpacity: { value: 0.2 },","-    uUnlit: { value: 0.45 },","+    uUnlit: { value: 0.45 }, uCatch: { value: 4 },","     uFlash: { value: 0 },","     uLightPos: { value: Array.from({ length: 6 }, () => new THREE.Vector3(0, -1000, 0)) },","     uLightCol: { value: Array.from({ length: 6 }, () => new THREE.Vector3()) },"]},{"oldStart":447,"oldLines":7,"newStart":447,"newLines":7,"lines":["   const sheetUniforms = {","     uColor: rai