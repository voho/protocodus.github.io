sity: flick(s), range: s.range, score: s.intensity * s.range / (1 + d2), fog: s.fog ?? 1, noLight: !!s.noLight });\"\"\"\nnew=\"\"\"      cand.push({ x: wp.x, y: wp.y, z: wp.z, color: s.color, intensity: flick(s), range: s.range, score: s.intensity * s.range / (1 + d2), fog: s.fog ?? 1, cone: s.cone, noLight: !!s.noLight });\"\"\"\nassert old in s; s=s.replace(old,new,1)\nold=\"\"\"    if (shadowOf) active.push({ x: shadowLight.position.x, y: shadowLight.position.y, z: shadowLight.position.z, color: shadowOf.color, intensity: shadowLight.intensity, range: shadowOf.range, score: best });\n    if (shadowOf2) active.push({ x: shadowLight2.position.x, y: shadowLight2.position.y, z: shadowLight2.position.z, color: shadowOf2.color, intensity: shadowLight2.intensity, range: shadowOf2.range, score: best2, fog: shadowOf2.flash ? shadowOf2.fogNow : undefined });\"\"\"\nnew=\"\"\"    if (shadowOf) active.push({ x: shadowLight.position.x, y: shadowLight.position.y, z: shadowLight.position.z, color: shadowOf.color, intensity: shadowLight.intensity, range: shadowOf.range, score: best, fog: shadowOf.fog, cone: shadowOf.cone });\n    if (shadowOf2) active.push({ x: shadowLight2.position.x, y: shadowLight2.position.y, z: shadowLight2.position.z, color: shadowOf2.color, intensity: shadowLight2.intensity, range: shadowOf2.range, score: best2, fog: shadowOf2.flash ? shadowOf2.fogNow : shadowOf2.fog, cone: shadowOf2.cone });\"\"\"\nassert old in s; s=s.replace(old,new,1)\nopen(p,'w').write(s)\n\np='js/volumetric.js'\ns=open(p).read()\nold=\"\"\"uniform float uRange[MAX];\nuniform int uCount;\"\"\"\nnew=\"\"\"uniform float uRange[MAX];\nuniform float uCone[MAX];\nuniform int uCount;\"\"\"\nassert old in s; s=s.replace(old,new,1)\nold=\"\"\"    float h = sqrt(h2) + 0.35;                 // a soft core: no singularity at the bulb\n    float I = (atan((tb - t0) / h) - atan((ta - t0) / h)) / h;\"\"\"\nnew=\"\"\"    float h = sqrt(h2) + 0.35;                 // a soft core: no singularity at the bulb\n    float I;\n    if (uCone[i] > -1.5) {\n      // a lamp under its cap lights only the air below the cap's edge, most straight down: a bell\n      // of light in the rain, dark above it. The stretch is taken in pieces, each by the closed form,\n      // weighted by how far under the cap its middle lies\n      I = 0.0;\n      for (int k = 0; k < 6; k++) {\n        float s0 = mix(ta, tb, float(k) / 6.0), s1 = mix(ta, tb, float(k + 1) / 6.0);\n        vec3 p = uCam + dir * (0.5 * (s0 + s1)) - uPos[i];\n        float down = -p.y / max(length(p), 1e-3);\n        I += (atan((s1 - t0) / h) - atan((s0 - t0) / h)) / h * smoothstep(uCone[i], uCone[i] + 0.6, down);\n      }\n    } else {\n      I = (atan((tb - t0) / h) - atan((ta - t0) / h)) / h;\n    }\"\"\"\nassert old in s; s=s.replace(old,new,1)\nold=\"\"\"      uRange: { value: new Array(MAX).fill(1) },\"\"\"\nnew=\"\"\"      uRange: { value: new Array(MAX).fill(1) },\n      uCone: { value: new Array(MAX).fill(-2) },\"\"\"\nassert old in s; s=s.replace(old,new,1)\nold=\"\"\"        u.uRange.value[i] = l.range * 0.8;\"\"\"\nnew=\"\"\"        u.uRange.value[i] = l.range * 0.8;\n        u.uCone.value[i] = l.cone ?? -2;\"\"\"\nassert old in s; s=s.replace(old,new,1)\nold=\"\"\"    /* this frame's lights: [{x, y, z, color, intensity, range, fog}] (fog: how\n       much of it hangs in the air, 1 unless a light says otherwise) */\"\"\"\nnew=\"\"\"    /* this frame's lights: [{x, y, z, color, intensity, range, fog, cone}] (fog: how\n       much of it hangs in the air, 1 unless a light says otherwise; cone: a capped lamp's\n       cosine from straight down where its light in the air gives out) */\"\"\"\nassert old in s; s=s.replace(old,new,1)\nopen(p,'w').write(s)\n\np='js/levelBuild.js'\ns=open(p).read()\nold=\"\"\"        lamps.push(G.lights.addStatic({ x: a[0], y: a[1], z: a[2], color: '#ffb35c', intensity: 9, range: 14, flicker: 0.08, shadow: true }));\"\"\"\nnew=\"\"\"        lamps.push(G.lights.addStatic({ x: a[0], y: a[1], z: a[2], color: '#ffb35c', intensity: 9, range: 14, flicker: 0.08, shadow: true, cone: CAPPED }));\"\"\"\nassert old in s; s=s.replace(old,new,1)\nold=\"\"\"        lamps.push(G.lights.addStatic({ x: a[0], y: a[1], z: a[2], color: '#ffb35c', intensity: 6, range: 11, flicker: 0.08, shadow: true }));\"\"\"\nnew=\"\"\"        lamps.push(G.lights.addStatic({ x: a[0], y: a[1], z: a[2], color: '#ffb35c', intensity: 6, range: 11, flicker: 0.08, shadow: true, cone: CAPPED }));\"\"\"\nassert old in s; s=s.replace(old,new,1)\nold=\"\"\"      G.lights.addStatic({ x: a[0], y: a[1] + 1.2, z: a[2], color: '#ff8a3a', intensity: 22, range: 18, flicker: 0.45, shadow: true });\"\"\"\nnew=\"\"\"      G.lights.addStatic({ x: a[0], y: a[1] + 1.2, z: a[2], color: '#ff8a3a', intensity: 22, range: 18, flicker: 0.45, shadow: true, fog: FIRE_FOG });\"\"\"\nassert old in s; s=s.replace(old,new,1)\nold=\"\"\"const SEPARATE = new Set(['flak38', 'radio_table']);\"\"\"\nnew=\"\"\"const SEPARATE = new Set(['flak38', 'radio_table']);\n// the street lamps and the lanterns on the houses are capped: their light in the rain is a bell\n// under them (volumetric.js), given out a little above level\nexport const CAPPED = -0.1;\n// a fire lights everything round it, but its light in the air is held down so its flames stay the\n// brightest thing in it, standing out of their glow, not drowned in an orange fog\nexport const FIRE_FOG = 0.35;\"\"\"\nassert old in s; s=s.replace(old,new,1)\nopen(p,'w').write(s)\n\np='js/mission.js'\ns=open(p).read()\nold=\"\"\"      G.lights.addStatic({ x: flak.x, y: flak.y + 1.5, z: flak.z, color: '#ff8a3a', intensity: 18, range: 16, flicker: 0.45 });\"\"\"\nnew=\"\"\"      G.lights.addStatic({ x: flak.x, y: flak.y + 1.5, z: flak.z, color: '#ff8a3a', intensity: 18, range: 16, flicker: 0.45, fog: FIRE_FOG });\"\"\"\nassert old in s; s=s.replace(old,new,1)\nopen(p,'w').write(s)\nEOF\ngrep -n \"^import\" js/mission.js | head","description":"Add fog and cone factors to lights and the volumetric pass"},"caller":{"type":"direct"}}]}}
