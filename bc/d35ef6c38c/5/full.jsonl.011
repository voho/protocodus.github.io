: SPLASH_VERT, fragmentShader: CROWN_FRAG, uniforms: splashUniforms, transparent: true, depthWrite: false, fog: false });\njs/fireball.js:113:    transparent: true, depthWrite: false, blending: THREE.CustomBlending, fog: false,\njs/flares.js:52:  light.fog = 0.005;\njs/flares.js:76:    depthWrite: false, transparent: true, fog: true,\njs/main.js:142:  scene.fog = new THREE.FogExp2(fogColor, LEVEL.fog.density);\njs/main.js:168:  G.effects = createEffects({ fog: fogUniforms, camera, wet: shared.wet });\njs/main.js:171:  const sky = createSky({ fog: LEVEL.fog.color });\njs/main.js:223:  G.plumes = createPlumes(G.effects, { fog: fogUniforms });\njs/main.js:246:  const envSky = createSky({ fog: LEVEL.fog.color });\njs/sky.js:222:    side: THREE.BackSide, depthWrite: false, fog: false,\n    }\n    if (shadowOf2 && (!shadowLight2 || (shadowOf2.x - shadowOf.x) ** 2 + (shadowOf2.z - shadowOf.z) ** 2 < 16)) shadowOf2 = null;\n    // the flashes: how bright each is now\n    for (let i = flashes.length - 1; i >= 0; i--) {\n      const f = flashes[i];\n      f.age += dt;\n      if (f.age >= f.life) { flashes.splice(i, 1); continue; }\n      // a flash dies fast, then lingers a little\n      f.now = f.intensity * (1 - f.age / f.life) ** 2;\n      // one at the eye (the player's own muzzle) would lay its glow in the rain over the whole view\n      // for as long as it is held (frames; a real flash is over in a millisecond): near the eye\n      // little of that glow is kept\n      const dc = Math.hypot(f.x - cam.x, f.y - cam.y, f.z - cam.z);\n      const near = Math.min(1, Math.max(0, (dc - 1.5) / 2.5));\n      f.fogNow = f.fog * (0.15 + 0.85 * near * near * (3 - 2 * near));\n    }\n    };\n    place(shadowLight, shadowOf);\n    place(shadowLight2, shadowOf2);\n\n    cand.length = 0;\n    for (const f of flashes) {\n      if (f === shadowOf2) continue;\n      cand.push({ x: f.x, y: f.y, z: f.z, color: f.color, intensity: f.now, range: f.range, score: 1e9, fog: f.fogNow });\n    }\