1 cobble.webp\n-rw-r--r--@   1 vojta  wheel  429322 Oct 22 03:01 cobble_n.webp\n116:def per_cell(ident, seed, count=None):\n117-    rng = np.random.default_rng(seed)\n118-    vals = rng.random(int(ident.max()) + 1)\n119-    return vals[ident]\n120-\n121-\n122-def rect_layout(n, rows, cols, seed, offset_rows=True, jitter=0.0, widths=None, warp=None):\n123-    \"\"\"Row/column brick-like layout: returns (u, v) within each cell (0..1),\n124-    cell id, and distance to the cell edge in pixels (min of x and y).\n85:def smoothstep(a, b, x):\n86-    t = np.clip((x - a) / (b - a), 0.0, 1.0)\n87-    return t * t * (3 - 2 * t)\n88-\n89-\n105:def normal_from_height(h, strength):\n106-    \"\"\"Tangent-space normal (OpenGL convention, +Y up in the image = -row).\"\"\"\n107-    dx = (np.roll(h, -1, axis=1) - np.roll(h, 1, axis=1)) * 0.5\n108-    dy = (np.roll(h, 1, axis=0) - np.roll(h, -1, axis=0)) * 0.5\n109-    nx = -dx * strength\n110-    ny = -dy * strength\n111-    nz = np.ones_like(h)\n112-    l = np.sqrt(nx * nx + ny * ny + nz * nz)\n113-    return np.stack([nx / l, ny / l, nz / l], axis=-1)\n114-\n115-\n116-def per_cell(ident, seed, count=None):\n117-    rng = np.random.default_rng(seed)\n118-    vals = rng.random(int(ident.max()) + 1)\n119-    return vals[ident]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"f03a3c7c-307e-4feb-bdc1-1aecb7ecf3d5","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/pro