,"noOutputExpected":false,"gitOperation":{"branch":{"ref":"refs/heads/hedgerow-poc","action":"merged"}},"bashEditDiff":{"files":[{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/README.md","hunks":[{"oldStart":127,"oldLines":15,"newStart":127,"newLines":20,"lines":["   * `terrain.js` heightfield + splat material · `world.js` colliders, rays,","     walking · `vegetation.js` instanced trees and ground cover in up to","     three tiers: full model, a thinned `_mid` beyond ~22 m when the nature","-    set has one, the `_lod` impostor beyond the quality's near range","+    set has one, the `_lod` impostor beyond the quality's near range (those","+    distances, and the soldiers' 30 m, as they look through the view: down","+    the sights they reach 1.4 times further)","   * `player.js` (first person: your own animated body, the head folded","     away, the rifle shouldered; aiming turns the body and bends the spine","     until the sights lie along the view; the arms carry the rifle canted low","     at a sprint, up and aside at a wall, down out of sight while changing","-    weapons), `reload.js` (the reload's clip and magazine; in first person on","+    weapons), `viewmotion.js` (the springs on top: the rifle lags a quick","+    turn, kicks up with each shot and settles, the eye dips on a landing),","+    `reload.js` (the reload's clip and magazine; in first person on","     the shouldered rifle, tilted into view, the fresh one seating in the","     picture), `camera.js` (at the eyes, down the","-    sights when aiming; the over-the-shoulder rig for the death camera),","+    sights when aiming, flinching from a hit; the over-the-shoulder rig for","+    the death camera),","     `character.js` (rig, split upper/lower body animation, the upper body","     steadied on the gait in first person, the outfit's low-detail `_lod`","     mesh beyond 30 m), `ragdoll.js` (Verlet bodies driving the bones), `combat.js`"]},{"oldStart":423,"oldLines":7,"newStart":428,"newLines":9,"lines":["   `tests/distance-check.mjs` — the horizon treelines face the level, sit","   in the ground and leave the far village in sight;","   `tests/lod-check.mjs` — soldiers switch to low detail at a distance","-  (with a gap so they don't flicker), trees sort into full, mid and far;","+  (with a gap so they don't flicker), trees sort into full, mid and far,","+  and down the sights detail reaches as far as the narrower view makes","+  things look near;","   `tests/ai-check.mjs` — on the real level: every patrol route walkable, a","   patrol walks it, a distant shot is looked into, lost contact means a","   search and an ambush (hidden, facing his way, springing from cover), the"]},{"oldStart":436,"oldLines":7,"newStart":443,"newLines":8,"lines":["   still does (the gait's bob and twist steadied out of the upper body),","   aiming puts the front sight in the middle of the view, the fresh clip or","   magazine seats in the picture, the rifle is carried in the picture at a","-  sprint and out of it while changing weapons:","+  sprint and out of it while changing weapons, and the sway, kick and","+  landing dip stay within a few degrees and centimetres and settle:"," ","       node fun/hedgerow/tests/world-check.mjs","       node fun/hedgerow/tests/route-check.mjs"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/ai.js","hunks":[{"oldStart":1122,"oldLines":7,"newStart":1122,"newLines":7,"lines":["       // drawn only when in view and inside the fog; the low-detail mesh from LOD_FAR","       e.inView = dCam < 220 && inView(e);","       e.char.root.visible = e.inView;","-      e.char.setDistance(Math.hypot(e.pos.x - cam.x, e.pos.y - cam.y, e.pos.z - cam.z));","+      e.char.setDistance(Math.hypot(e.pos.x - cam.x, e.pos.y - cam.y, e.pos.z - cam.z) * (G.lodScale ?? 1));","       if (e.dead) {","         // a falling body keeps falling out of view; it comes to rest in seconds","         if (dCam < 220 && (e.inView || (e.char.ragdoll && !e.char.ragdoll.asleep))) e.char.update(dt, e.fixedY ?? G.world.groundAt(e.pos.x, e.pos.z, e.pos.y + 0.2));"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/camera.js","hunks":[{"oldStart":34,"oldLines":6,"newStart":34,"newLines":8,"lines":["     dir: new THREE.Vector3(0, 0, 1),","     bob: 0,","     roll: 0, sprintT: 0,","+    // first person: the head flinching from a hit (camera only; the aim stays)","+    flinchRoll: 0, flinchRollV: 0, flinchPitch: 0, flinchPitchV: 0,","   };","   const desired = new THREE.Vector3();","   const rightV = new THREE.Vector3();"]},{"oldStart":58,"oldLines":6,"newStart":60,"newLines":23,"lines":[" ","   rig.addShake = (amount) => { rig.shake = Math.min(1.5, rig.shake + amount); };"," ","+  /* A hit, first person: the head snaps away from the side it came from","+     (`side` > 0: from his left) and up a little, and comes back. */","+  rig.flinch = (side, amount = 1) => {","+    rig.flinchRollV += -Math.sign(side || 1) * 2.2 * amount;","+    rig.flinchPitchV += 1.1 * amount;","+  };","+  function settleFlinch(dt) {","+    for (let left = dt; left > 1e-6;) {","+      const h = Math.min(left, 1 / 240);","+      rig.flinchRollV += (-500 * rig.flinchRoll - 34 * rig.flinchRollV) * h;","+      rig.flinchPitchV += (-500 * rig.flinchPitch - 34 * rig.flinchPitchV) * h;","+      rig.flinchRoll += rig.flinchRollV * h;","+      rig.flinchPitch += rig.flinchPitchV * h;","+      left -= h;","+    }","+  }","+","   /* ---------- the death camera ---------- */","   const dc = { t: 0, started: false, from: new THREE.Vector3(), pos: new THREE.Vector3(), look: new THREE.Vector3() };","   const va = new THREE.Vector3(), vb = new THREE.Vector3(), vc = new THREE.Vector3(), vd = new THREE.Vector3();"]},{"oldStart":142,"oldLines":7,"newStart":161,"newLines":9,"lines":["     look.copy(desired).add(rig.dir);","     camera.lookAt(look);","     rig.roll = damp(rig.roll, clamp(strafe, -4, 4) * 0.008 * (1 - rig.aimT), 6, dt);","-    camera.rotateZ(rig.roll);","+    settleFlinch(dt);","+    camera.rotateZ(rig.roll + rig.flinchRoll);","+    camera.rotateX(rig.flinchPitch);","     // the over-the-shoulder orbit (death camera) starts from here, not 3 m back","     rig.dist = 0.3;","     const fov = lerp(rig.baseFov + CAMERA.sprintFov * rig.sprintT, CAMERA.fpAimFov * rig.baseFov / CAMERA.fov, rig.aimT);"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/config.js","hunks":[{"oldStart":50,"oldLines":6,"newStart":50,"newLines":7,"lines":["     recoil: 0.034, recoilYaw: 0.01, range: 260, sound: 'garand', tracer: false,","     // the sight line in the model (rear aperture, front post) and the eye behind it","     sight: { rear: [0, 0.089, 0.01], front: [0, 0.083, 0.76], relief: 0.16 }, reach: 0.95,","+    kick: 0.075,       // first person: how hard each shot throws the muzzle up (viewmotion.js)","   },","   thompson: {","     name: 'M1A1 Thompson', model: 'thompson', kind: 'smg',"]},{"oldStart":57,"oldLines":7,"newStart":58,"newLines":7,"lines":["     mag: 30, reserve: 180, reload: 2.5, prop: 'thompson_mag', propSize: [0.035, 0.26, 0.075], drops: true, seated: 'thompson_mag_seated',","     spreadHip: 0.05, spreadAim: 0.018, spreadMove: 0.03, bloom: 0.008, bloomDecay: 5,","     recoil: 0.012, recoilYaw: 0.008, range: 120, sound: 'thompson', tracer: false,","-    sight: { rear: [0, 0.121, 0.06], front: [0, 0.104, 0.44], relief: 0.12 }, reach: 0.7,","+    sight: { rear: [0, 0.121, 0.06], front: [0, 0.104, 0.44], relief: 0.12 }, reach: 0.7, kick: 0.03,","     // where the magazine model sits in the gun (weapons.glb, thompson_mag_seated)","     seatedAt: { p: [0, -0.13, 0.104], q: [-0.62089, -0.066765, 0.166366, 0.763129] },","   },"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js","hunks":[{"oldStart":