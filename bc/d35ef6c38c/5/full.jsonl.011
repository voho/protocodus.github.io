{"type":"api-request-blob","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","hash":"0d800c5c5b17717b70d5e3b5abf057a11de007d1812ef42932954567657b2e04","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01C6EHUXGBVERDjY6Ma4dTwU","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow && python3 -I - <<'EOF'\np='js/fill.js'\ns=open(p).read()\ns=s.rstrip('\\n')+'''\n\n/* The fires' light thrown back off the street and the walls round them: a warm fill that reaches\n   every side of what stands near a fire (most the side facing it, a tenth the side turned away),\n   unshadowed - it comes from all round - and gone by 20 m, so a wreck's shadow side and the street\n   behind it are not black. The fires are the four nearest the camera (x, y, z, size; size 0: none),\n   set each frame by updateSmoulder (materials.js), which also lights the smouldering char by them. */\nexport const FIRE_UNIFORMS = { uFires: { value: Array.from({ length: 4 }, () => new THREE.Vector4(0, -1000, 0, 0)) } };\nconst FIRE_BOUNCE_GLSL = /* glsl */ `\nuniform vec4 uFires[4];\nvec3 fireBounce(vec3 p, vec3 n) {\n  vec3 b = vec3(0.0);\n  for (int i = 0; i < 4; i++) {\n    vec4 f = uFires[i];\n    if (f.w <= 0.0) continue;\n    vec3 d = f.xyz + vec3(0.0, 0.8 * f.w, 0.0) - p;\n    float r2 = dot(d, d);\n    float wrap = 0.55 + 0.45 * dot(n, d * inversesqrt(r2 + 1e-4));\n    b += f.w * f.w * wrap / (r2 + 4.0) * (1.0 - smoothstep(100.0, 400.0, r2));\n  }\n  return b * vec3(1.0, 0.48, 0.2) * 4.0;\n}`;\n\n/* in a material's onBeforeCompile: pos and nrm, its world position and normal (GLSL expressions) */\nexport function addFireBounce(shader, pos, nrm) {\n  Object.assign(shader.uniforms, FIRE_UNIFORMS);\n  shader.fragmentShader = shader.fragmentShader\n    .replace('#include <common>', '#include <common>\\\\n' + FIRE_BOUNCE_GLSL)\n    .replace('#include <lights_fragment_end>', `#if defined( RE_IndirectDiffuse )\n      irradiance += fireBounce(${pos}, ${nrm});\n    #endif\n    #include <lights_fragment_end>`);\n}\n'''\nopen(p,'w').write(s)\n\np='js/materials.js'\ns=open(p).read()\nold=\"\"\"import { dimFillSpecular } from './fill.js';\"\"\"\nnew=\"\"\"import { dimFillSpecular, addFireBounce, FIRE_UNIFORMS } from './fill.js';\"\"\"\nassert s.count(old)==1; s=s.replace(old,new,1)\nold=\"\"\"/* what burns, and smoulders round its fire: the charred wood of a burning ruin (its char cracks\n   and glows), the metal of a burnt-out wreck (it glows a dull red with the heat) */\nconst SMOULDER = [[/^(ruin|beam_charred)/, 'wood'], [/^(truck_burnt|halftrack_wreck|jeep_wreck)/, 'metal']];\n/* the fires nearest the camera (x, y, z, size; size 0: none), for the smouldering (updateSmoulder) */\n/* value noise for the damp at the foot of a wall (hash12: terrain.js GLSL_HELPERS) */\nconst DAMP_GLSL = /* glsl */ `\n  float dampNoise(vec2 p) {\n    vec2 i = floor(p), f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x), mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);\n  }`;\n\nexport const SMOULDER_UNIFORMS = { uFires: { value: Array.from({ length: 4 }, () => new THREE.Vector4()) } };\"\"\"\nnew=\"\"\"/* value noise for the damp at the foot of a wall (hash12: terrain.js GLSL_HELPERS) */\nconst DAMP_GLSL = /* glsl */ `\n  float dampNoise(vec2 p) {\n    vec2 i = floor(p), f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x), mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);\n  }`;\n\n/* what burns, and smoulders round its fire: the charred wood of a burning ruin (its char cracks\n   and glows), the metal of a burnt-out wreck (it glows a dull red with the heat) */\nconst SMOULDER = [[/^(ruin|beam_charred)/, 'wood'], [/^(truck_burnt|halftrack_wreck|jeep_wreck)/, 'metal']];\n/* the fires nearest the camera (x, y, z, size; size 0: none), for the smouldering (updateSmoulder)\n   and the light they throw back off everything round them (fill.js addFireBounce) */\nexport const SMOULDER_UNIFORMS = FIRE_UNIFORMS;\"\"\"\nassert s.count(old)==1; s=s.replace(old,new,1)\nold=\"\"\"        .replace('#include <common>', `#include <common>\n        uniform vec4 uFires[4];\n        vec2 smHash2(vec2 p)\"\"\"\nnew=\"\"\"        .replace('#include <common>', `#include <common>\n        vec2 smHash2(vec2 p)\"\"\"\nassert s.count(old)==1; s=s.replace(old,new,1)\nold=\"\"\"    if (!glints) dimFillSpecular(shader);\n  };\n}\"\"\"\nnew=\"\"\"    addFireBounce(shader, 'vWPosM', 'normalize(vWNormalM)');\n    if (!glints) dimFillSpecular(shader);\n  };\n}\"\"\"\nassert s.count(old)==1; s=s.replace(old,new,1)\nold=\"\"\"      ...(smoulder ? SMOULDER_UNIFORMS : {}),\"\"\"\nnew=\"\"\"\"\"\"\nassert s.count(old)==1; s=s.replace(old+\"\\n\",new,1)\nopen(p,'w').write(s)\n\np='js/terrain.js'\ns=open(p).read()\nold=\"\"\"import { dimFillSpecular } from './fill.js';\"\"\"\nnew=\"\"\"import { dimFillSpecular, addFireBounce } from './fill.js';\"\"\"\nassert s.count(old)==1; s=s.replace(old,new,1)\nold=\"\"\"      .replace('#include <opaque_fragment>', `#include <opaque_fragment>\n        #ifdef OPAQUE\n          gl_FragColor.a = mirrorAlpha(roughnessFactor, uWet);\n        #endif`);\n    dimFillSpecular(shader);\"\"\"\nnew=\"\"\"      .replace('#include <opaque_fragment>', `#include <opaque_fragment>\n        #ifdef OPAQUE\n          gl_FragColor.a = mirrorAlpha(roughnessFactor, uWet);\n        #endif`);\n    addFireBounce(shader, 'vWPos', 'normalize(vWNormal)');\n    dimFillSpecular(shader);\"\"\"\nassert s.count(old)==1; s=s.replace(old,new,1)\nopen(p,'w').write(s)\nEOF\nfor f in fill materials terrain; do cp js/$f.js $TMPDIR/chk_$f.mjs; node --check $TMPDIR/chk_$f.mjs && echo \"$f ok\"; rm -f $TMPDIR/chk_$f.mjs; done; grep -n \"uFires\" js/materials.js | head","description":"Add the fires' warm bounce light to materials and terrain"},"caller":{"type":"direct"}}]}}
