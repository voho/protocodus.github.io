{"type":"api-request-blob","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","hash":"36c4a271dec528928f35d4cc036feb52856b9fcce902ba96fe1dd7ed75cbee65","message":{"role":"assistant","content":[{"type":"text","text":"Now the atlas, the shaders and the system plumbing:"},{"type":"tool_use","id":"toolu_01M99qGFQ3qsN55uiKa6HGee","name":"Bash","input":{"command":"cd /Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow && python3 - <<'PYEOF'\np = 'js/effects.js'\ns = open(p).read()\n\n# 1. header\nold_head = \"\"\"/* Hedgerow — particles: muzzle flashes, tracers, impacts, blood, smoke,\n   fire, explosions.\n\n   Two instanced sprite systems share one generated texture atlas: one\n   alpha-blended (smoke, dust, debris, water), one additive (fire, flashes,\n   sparks, tracers). Particles live in flat typed arrays on the CPU; each\n   frame the live ones are packed into the instance attributes. A sprite\n   with a stretch vector is drawn as a streak along it (tracers, sparks). */\"\"\"\nnew_head = \"\"\"/* Hedgerow — particles: muzzle flashes, tracers, impacts, blood, smoke,\n   fire, explosions.\n\n   Two instanced sprite systems share one generated texture atlas: one\n   alpha-blended (smoke, dust, debris, water), one additive (fire, flashes,\n   sparks, tracers). Particles live in flat typed arrays on the CPU; each\n   frame the live ones are packed into the instance attributes. A sprite\n   with a stretch vector is drawn as a streak along it (tracers, sparks,\n   earth thrown up by a blast).\n\n   Smoke, dust and spray are lit (at their corners) by the night's ambient\n   and the same eight lamps, fires and flashes the light pool picked, so the\n   smoke over a burning truck glows from below and a puff of gun smoke\n   flares with the shot. With the effects chain (`pass`, after the light in\n   the rain) the sprites are drawn over the finished scene and read its\n   depth: each fades out where it meets a wall or the ground instead of\n   cutting a hard line through it, and that fade is their depth test too.\n   Without it (low quality) they are drawn with the scene as before. */\"\"\"\nassert old_head in s; s = s.replace(old_head, new_head)\n\n# 2. noise + atlas at 256 px cells with noise-built smoke and broken-up flames\nold_atlas_start = \"\"\"function makeAtlas() {\n  const S = 128;\"\"\"\nnew_atlas_start = \"\"\"/* value noise and its octaves, for the smoke and flame cells */\nfunction makeNoise(seed) {\n  const R = rng(seed);\n  const perm = Array.from({ length: 256 }, (_, i) => i);\n  for (let i = 255; i > 0; i--) { const j = Math.floor(R() * (i + 1)); [perm[i], perm[j]] = [perm[j], perm[i]]; }\n  const V = Float32Array.from({ length: 256 }, () => R());\n  const h = (x, y) => V[perm[(perm[x & 255] + y) & 255]];\n  const noise = (x, y) => {\n    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;\n    const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);\n    const a = h(xi, yi), b = h(xi + 1, yi), c = h(xi, yi + 1), d = h(xi + 1, yi + 1);\n    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;\n  };\n  return (x, y, oct = 5) => {\n    let sum = 0, amp = 0.5, norm = 0;\n    for (let k = 0; k < oct; k++) { sum += noise(x, y) * amp; norm += amp; x *= 2.03; y *= 2.03; amp *= 0.5; }\n    return sum / norm;\n  };\n}\nconst smooth = (a, b, x) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };\n\nfunction makeAtlas() {\n  const S = 256;\"\"\"\nassert old_atlas_start in s; s = s.replace(old_atlas_start, new_atlas_start)\n\nold_lumpy = \"\"\"  // 1 lumpy smoke puff\n  {\n    const [x, y] = cell(1);\n    for (let k = 0; k < 18; k++) {\n      const a = R() * Math.PI * 2, r = R() * S * 0.22;\n      const cx = x + S / 2 + Math.cos(a) * r, cy = y + S / 2 + Math.sin(a) * r;\n      const rad = S * (0.14 + R() * 0.16);\n      const gr = g.createRadialGradient(cx, cy, 0, cx, cy, rad);\n      gr.addColorStop(0, 'rgba(255,255,255,0.35)'); gr.addColorStop(1, 'rgba(255,255,255,0)');\n      g.fillStyle = gr; g.fillRect(x, y, S, S);\n    }\n  }\"\"\"\nnew_lumpy = \"\"\"  // 1 billowing smoke: warped noise inside a lumpy outline, thicker in the middle\n  {\n    const [x, y] = cell(1);\n    const fbm = makeNoise(5);\n    const img = g.createImageData(S, S);\n    for (let j = 0; j < S; j++) for (let i = 0; i < S; i++) {\n      const u = i / S - 0.5, v = j / S - 0.5, r = Math.hypot(u, v);\n      const wx = fbm(u * 3 + 1.7, v * 3 + 9.2, 3), wy = fbm(u * 3 + 5.1, v * 3 + 2.3, 3);\n      const n = fbm(u * 4.5 + wx * 1.6, v * 4.5 + wy * 1.6);\n      const edge = 1 - smooth(0.16, 0.48, r + (n - 0.5) * 0.3);\n      const dens = edge * smooth(0.2, 0.7, n * 0.85 + edge * 0.45);\n      const o = (j * S + i) * 4, shade = 175 + 80 * n;\n      img.data[o] = img.data[o + 1] = img.data[o + 2] = shade;\n      img.data[o + 3] = Math.round(255 * dens * 0.9);\n    }\n    g.putImageData(img, x, y);\n  }\"\"\"\nassert old_lumpy in s; s = s.replace(old_lumpy, new_lumpy)\n\nold_flame = \"\"\"  // 7 flame tongue\n  {\n    const [x, y] = cell(7);\n    for (let k = 0; k < 10; k++) {\n      const cx = x + S / 2 + (R() - 0.5) * S * 0.3, cy = y + S * (0.45 + R() * 0.25);\n      const rad = S * (0.12 + R() * 0.15);\n      const gr = g.createRadialGradient(cx, cy, 0, cx, cy, rad);\n      gr.addColorStop(0, 'rgba(255,255,255,0.6)'); gr.addColorStop(1, 'rgba(255,255,255,0)');\n      g.fillStyle = gr; g.fillRect(x, y, S, S);\n    }\n  }\"\"\"\nnew_flame = \"\"\"  // 7 flame tongue, broken up by noise (licks, not a blob)\n  {\n    const [x, y] = cell(7);\n    for (let k = 0; k < 10; k++) {\n      const cx = x + S / 2 + (R() - 0.5) * S * 0.3, cy = y + S * (0.45 + R() * 0.25);\n      const rad = S * (0.12 + R() * 0.15);\n      const gr = g.createRadialGradient(cx, cy, 0, cx, cy, rad);\n      gr.addColorStop(0, 'rgba(255,255,255,0.6)'); gr.addColorStop(1, 'rgba(255,255,255,0)');\n      g.fillStyle = gr; g.fillRect(x, y, S, S);\n    }\n    const fbm = makeNoise(11);\n    const img = g.getImageData(x, y, S, S);\n    for (let j = 0; j < S; j++) for (let i = 0; i < S; i++) {\n      const n = fbm(i / S * 5, j / S * 2.5 + 3.1);\n      const o = (j * S + i) * 4;\n      img.data[o + 3] = Math.round(img.data[o + 3] * smooth(0.25, 0.65, n + (j / S - 0.5) * 0.35));\n    }\n    g.putImageData(img, x, y);\n  }\"\"\"\nassert old_flame in s; s = s.replace(old_flame, new_flame)\n\n# 3. shaders\nold_vert = s[s.index(\"const VERT = /* glsl */ `\"):s.index(\"function createSystem(\")]\nnew_vert = '''const VERT = /* glsl */ `\n#define LIGHTS 8\nattribute vec3 aPos;\nattribute vec4 aColor;\nattribute vec4 aMisc;      // size, rotation, cell, unused\nattribute vec3 aStretch;\nuniform float uFogDensity;\nuniform float uLit;        // 1: smoke and dust take the light; 0: fire and flashes make their own\nuniform vec3 uAmbient;\nuniform vec3 uLightPos[LIGHTS];\nuniform vec3 uLightCol[LIGHTS];\nuniform float uLightRange[LIGHTS];\nuniform int uLightCount;\nvarying vec2 vUv;\nvarying vec4 vColor;\nvarying float vFog;\nvarying float vDist;       // from the camera (view depth), for the soft edge\nvarying float vSoft;       // how deep the soft edge is\nvarying vec2 vProj;        // the projection's depth terms, to read the scene depth\nvoid main() {\n  float size = aMisc.x;\n  vec3 p = aPos;\n  vec3 wp;\n  vec2 q = uv - 0.5;\n  float sl = length(aStretch);\n  if (sl > 1e-4) {\n    vec3 axis = aStretch / sl;\n    vec3 toCam = normalize(cameraPosition - p);\n    vec3 side = normalize(cross(axis, toCam));\n    wp = p + side * q.x * size + axis * q.y * (sl + size);\n  } else {\n    float c = cos(aMisc.y), s = sin(aMisc.y);\n    vec2 r = vec2(q.x * c - q.y * s, q.x * s + q.y * c) * size;\n    vec3 right = vec3(viewMatrix[0][0], viewMatrix[1][0], viewMatrix[2][0]);\n    vec3 up = vec3(viewMatrix[0][1], viewMatrix[1][1], viewMatrix[2][1]);\n    wp = p + right * r.x + up * r.y;\n  }\n  float cellI = aMisc.z;\n  vUv = (vec2(mod(cellI, 4.0), 1.0 - floor(cellI / 4.0)) + uv) * vec2(0.25, 0.5);\n  vColor = aColor;\n  if (uLit > 0.5) {\n    // the night's light at this corner: the ambient (1 = as the colours were\n    // chosen in the dark) and the lamps, fires and flashes near, falling off\n    // like the scene's point lights, relative to that ambient\n    vec3 light = uAmbient;\n    for (int i = 0; i < LIGHTS; i++) {\n      if (i >= uLightCount) break;\n      vec3 L = uLightPos[i] - wp;\n      float d2 = dot(L, L), r = uLightRange[i];\n      float win = clamp(1.0 - d2 * d2 / (r * r * r * r), 0.0, 1.0);\n      light += uLightCol[i] * (win * win / max(d2, 0.3)) * 2.0;\n    }\n    vColor.rgb *= light;\n  }\n  vec4 mv = viewMatrix * vec4(wp, 1.0);\n  float d = -mv.z;\n  vFog = 1.0 - exp(-uFogDensity * uFogDensity * d * d);\n  vDist = d;\n  vSoft = max(size * 0.3, 0.06);\n  vProj = vec2(projectionMatrix[2][2], projectionMatrix[3][2]);\n  gl_Position = projectionMatrix * mv;\n}`;\n\nconst FRAG = /* glsl */ `\nuniform sampler2D tAtlas, tDepth;\nuniform vec3 uFogColor;\nuniform float uAdditive, uSoft;\nuniform vec2 uScreen;\nvarying vec2 vUv;\nvarying vec4 vColor;\nvarying float vFog;\nvarying float vDist;\nvarying float vSoft;\nvarying vec2 vProj;\nvoid main() {\n  vec4 t = texture2D(tAtlas, vUv);\n  float a = t.a * vColor.a;\n  // no sheet of smoke right in the lens\n  a *= smoothstep(0.25, 1.1, vDist);\n  if (uSoft > 0.5) {\n    // fade out where the sprite meets what the scene drew (and behind it: the depth test)\n    float zd = texture2D(tDepth, gl_FragCoord.xy * uScreen).x * 2.0 - 1.0;\n    a *= clamp((vProj.y / (zd + vProj.x) - vDist) / vSoft, 0.0, 1.0);\n  }\n  if (a < 0.003) discard;\n  vec3 col = vColor.rgb * t.rgb;\n  if (uAdditive > 0.5) {\n    gl_FragColor = vec4(col * a * (1.0 - vFog), 1.0);\n  } else {\n    gl_FragColor = vec4(mix(col, uFogColor, vFog), a);\n  }\n}`;\n\n'''\ns = s.replace(old_vert, new_vert)\n\nold_sys = \"\"\"function createSystem(max, atlas, additive, fog) {\"\"\"\nnew_sys = \"\"\"function createSystem(max, atlas, additive, fog, shared) {\"\"\"\nassert old_sys in s; s = s.replace(old_sys, new_sys)\nold_uni = \"\"\"    uniforms: { tAtlas: { value: atlas }, uFogColor: fog.color, uFogDensity: fog.density, uAdditive: { value: additive ? 1 : 0 } },\"\"\"\nnew_uni = \"\"\"    uniforms: { tAtlas: { value: atlas }, uFogColor: fog.color, uFogDensity: fog.density, uAdditive: { value: additive ? 1 : 0 }, uLit: { value: additive ? 0 : 1 }, ...shared },\"\"\"\nassert old_uni in s; s = s.replace(old_uni, new_uni)\nopen(p, 'w').write(s)\nprint('ok')\nPYEOF","description":"Rewrite the particle atlas, shaders and system setup"},"caller":{"type":"direct"}}]}}
