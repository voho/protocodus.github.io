...(quality.bloom ? [bloom] : []), grade]);\"\"\"\nassert old in s; s = s.replace(old, new)\nold = \"\"\"    G.effects.setLights(G.lights.active, 1 + flash * 0.9);\n    G.effects.pass.depth = volumetric?.uniforms.tDepth.value ?? null;\"\"\"\nnew = \"\"\"    G.effects.setLights(G.lights.active, 1 + flash * 0.9);\"\"\"\nassert old in s; s = s.replace(old, new)\nopen(p, 'w').write(s)\nprint('ok')\nPYEOF\nnode --check js/effects.js && node --check js/main.js && echo parsed","description":"Move the particle pass first in the chain"},"caller":{"type":"direct"}}]}}
