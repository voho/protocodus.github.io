{"parentUuid":"4ba96502-a2db-4abe-8fb0-eb120daf2a09","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgFS1tZ95wpDbYUatrTsk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TAPpcginASLBQdBSPLafWQ","name":"Read","input":{"file_path":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/grass.js"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1226,"cache_read_input_tokens":494427,"output_tokens":204,"output_tokens_details":{"thinking_tokens":77},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1226,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":204,"cache_read_input_tokens":494427,"cache_creation_input_tokens":1226,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1226},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01TAPpcginASLBQdBSPLafWQ":{"file_path":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/grass.js"}},"serverClassifierRequest":"3a47fa78-7fee-49cb-9e09-f598c6ed7b4d","apiBlockIndex":2,"requestId":"req_011CgFS1sTueq7s2b9e2V6v1","requestRef":"e2e0ff25-0819-40c0-a93d-5cc094ed4cb1","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"ab739359-7813-4e3e-b60f-bcf875e64831","timestamp":"2026-10-21T13:06:17.938Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-grass","slug":"shimmying-swimming-falcon"}
{"parentUuid":"ab739359-7813-4e3e-b60f-bcf875e64831","isSidechain":false,"promptId":"6d5c0a1d-fdd5-4db0-8cbd-a5c82a0adcb7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TAPpcginASLBQdBSPLafWQ","type":"tool_result","content":"1\t/* Hedgerow — meadow grass: tufts of blades by the tens of thousands, on the GPU.\n2\t\n3\t   One instanced draw of grass tufts round the camera, one per cell of a\n4\t   grid of world cells (snapped, so a tuft keeps its place as the patch\n5\t   follows the camera); each tuft is five thin blades fanning out of one\n6\t   root. Everything about a tuft and its blades — where in the cell, how\n7\t   tall, which way each faces and leans, its shade, now and then a dead\n8\t   straw-coloured stalk — comes from a hash of its cell; the ground under\n9\t   it (height, and how grassy it is) from a map made once from the terrain:\n10\t   the grass weight of the splat (a little in the forest), none on roads and\n11\t   mud, on steep banks, at the water or inside anything solid (houses, walls,\n12\t   sandbags). The wind leans every blade and sends gusts across the field in\n13\t   waves; the player parts the grass round his legs. Far tufts thin out (the\n14\t   ones left grow fuller, no blade thinner than about a pixel) and the patch\n15\t   fades away at its edge, where the scattered tufts and the ground's own\n16\t   texture take over. */\n17\t\n18\timport * as THREE from 'three';\n19\t\n20\tconst SEGS = 3, TUFT = 5;\n21\tconst smoothstep = (a, b, x) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };\n22\t\n23\t/* the ground map: R = height, G = how grassy (0..1), at the terrain's grid.\n24\t   The splat weights come from the terrain mesh, which has them at its\n25\t   vertices (every grid point in its fine chunks, every second one\n26\t   elsewhere); the points between are filled from their neighbours. Slope\n27\t   and water are judged at every point, from the heights. */\n28\tfunction groundMap(terrain, world, waterLevel) {\n29\t  const { H, nx, nz, minX, minZ, res } = terrain.grid;\n30\t  const dens = new Float32Array(nx * nz).fill(NaN);\n31\t  for (const chunk of terrain.group.children) {\n32\t    const g = chunk.geometry;\n33\t    const pos = g.attributes.position, spl = g.attributes.splat;\n34\t    if (!pos || !spl) continue;\n35\t    for (let v = 0; v < pos.count; v++) {\n36\t      const i = Math.round((pos.getX(v) - minX) / res), j = Math.round((pos.getZ(v) - minZ) / res);\n37\t      if (i < 0 || j < 0 || i >= nx || j >= nz) continue;\n38\t      const k = j * nx + i;\n39\t      if (Math.abs(pos.getY(v) - H[k]) > 0.01) continue;          // a skirt\n40\t      // grass, a little in the forest, none on the road\n41\t      dens[k] = (smoothstep(0.35, 0.8, spl.getY(v)) + spl.getZ(v) * 0.12) * (1 - Math.min(1, spl.getW(v) * 2));\n42\t    }\n43\t  }\n44\t  // between the coarse chunks' vertices: the average of the known neighbours (the\n45\t  // straight ones; the diagonal ones where both coordinates fall between)\n46\t  for (let j = 0; j < nz; j++) for (let i = 0; i < nx; i++) {\n47\t    const k = j * nx + i;\n48\t    if (!Number.isNaN(dens[k])) continue;\n49\t    let sum = 0, cnt = 0;\n50\t    for (const [di, dj] of [[-1, 0], [1, 0], [0, -1], [0, 1]]) {\n51\t      const a = i + di, b = j + dj;\n52\t      if (a < 0 || b < 0 || a >= nx || b >= nz) continue;\n53\t      const v = dens[b * nx + a];\n54\t      if (!Number.isNaN(v)) { sum += v; cnt++; }\n55\t    }\n56\t    if (!cnt) for (const [di, dj] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {\n57\t      const a = i + di, b = j + dj;\n58\t      if (a < 0 || b < 0 || a >= nx || b >= nz) continue;\n59\t      const v = dens[b * nx + a];\n60\t      if (!Number.isNaN(v)) { sum += v; cnt++; }\n61\t    }\n62\t    dens[k] = cnt ? sum / cnt : 0;\n63\t  }\n64\t  // none on steep banks, none at the water\n65\t  for (let j = 0; j < nz; j++) for (let i = 0; i < nx; i++) {\n66\t    const k = j * nx + i;\n67\t    if (dens[k] <= 0) continue;\n68\t    const hx = H[j * nx + Math.min(nx - 1, i + 1)] - H[j * nx + Math.max(0, i - 1)];\n69\t    const hz = H[Math.min(nz - 1, j + 1) * nx + i] - H[Math.max(0, j - 1) * nx + i];\n70\t    const slope = 1 - (2 * res) / Math.hypot(hx, 2 * res, hz);\n71\t    dens[k] *= (1 - smoothstep(0.25, 0.5, slope)) * smoothstep(0.1, 0.45, H[k] - waterLevel);\n72\t  }\n73\t  // nothing grows inside what is solid; a thin thing (a post, a plank, a\n74\t  // sandbag wall) clears at least the map's nearest points to it\n75\t  const reach = res * 0.72;\n76\t  for (const c of world.colliders) {\n77\t    if (c.type !== 'box' && c.type !== 'cyl') continue;\n78\t    if (!(c.flags & 1) || c.surface === 'foliage') continue;\n79\t    const ex = c.type === 'box' ? Math.max(c.hx + 0.1, reach) : 0, ez = c.type === 'box' ? Math.max(c.hz + 0.1, reach) : 0;\n80\t    const er = c.type === 'cyl' ? Math.max(c.r + 0.1, reach) : 0;\n81\t    const i0 = Math.max(0, Math.floor((c.minX - reach - minX) / res)), i1 = Math.min(nx - 1, Math.ceil((c.maxX + reach - minX) / res));\n82\t    const j0 = Math.max(0, Math.floor((c.minZ - reach - minZ) / res)), j1 = Math.min(nz - 1, Math.ceil((c.maxZ + reach - minZ) / res));\n83\t    for (let j = j0; j <= j1; j++) for (let i = i0; i <= i1; i++) {\n84\t      const k = j * nx + i;\n85\t      const x = minX + i * res, z = minZ + j * res;\n86\t      if (c.top - H[k] < 0.03 || c.bottom - H[k] > 1.0) continue;   // buried, or high above (a bridge deck)\n87\t      const rx = x - c.x, rz = z - c.z;\n88\t      const inside = c.type === 'box'\n89\t        ? Math.abs(rx * c.c - rz * c.s) <= ex && Math.abs(rx * c.s + rz * c.c) <= ez\n90\t        : rx * rx + rz * rz <= er * er;\n91\t      if (inside) dens[k] = 0;\n92\t    }\n93\t  }\n94\t  const data = new Uint16Array(nx * nz * 2);\n95\t  for (let k = 0; k < nx * nz; k++) {\n96\t    data[k * 2] = THREE.DataUtils.toHalfFloat(H[k]);\n97\t    data[k * 2 + 1] = THREE.DataUtils.toHalfFloat(dens[k]);\n98\t  }\n99\t  const tex = new THREE.DataTexture(data, nx, nz, THREE.RGFormat, THREE.HalfFloatType);\n100\t  tex.minFilter = tex.magFilter = THREE.LinearFilter;\n101\t  tex.needsUpdate = true;\n102\t  return { tex, min: new THREE.Vector2(minX, minZ), size: new THREE.Vector2((nx - 1) * res, (nz - 1) * res), texel: new THREE.Vector2(1 / nx, 1 / nz) };\n103\t}\n104\t\n105\texport function createGrass({ terrain, world, level, shared, n = 192, max = 192, spacing = 0.22 }) {\n106\t  // a tuft: TUFT blades, each a strip from the root (y = 0) to the point\n107\t  // (y = 1); x is the side, z which blade of the tuft\n108\t  const pos = [], idx = [];\n109\t  for (let b = 0; b < TUFT; b++) {\n110\t    const o = b * (SEGS * 2 + 1);\n111\t    for (let i = 0; i < SEGS; i++) pos.push(-1, i / SEGS, b, 1, i / SEGS, b);\n112\t    pos.push(0, 1, b);\n113\t    for (let i = 0; i < SEGS - 1; i++) { const a = o + i * 2; idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2); }\n114\t    idx.push(o + (SEGS - 1) * 2, o + (SEGS - 1) * 2 + 1, o + SEGS * 2);\n115\t  }\n116\t  const geo = new THREE.InstancedBufferGeometry();\n117\t  geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\n118\t  geo.setIndex(idx);\n119\t  // three draws as many instances as its instanced attributes allow: one dummy, for the most\n120\t  geo.setAttribute('aCell', new THREE.InstancedBufferAttribute(new Float32Array(max * max), 1));\n121\t  geo.instanceCount = n * n;\n122\t\n123\t  const map = groundMap(terrain, world, level.water?.level ?? -1e4);\n124\t  // the ground under the grass reads the same map (terrain.js)\n125\t  if (shared.grassMap) {\n126\t    shared.grassMap.value = map.tex;\n127\t    shared.grassMin.value.copy(map.min);\n128\t    shared.grassSize.value.copy(map.size);\n129\t    shared.grassR.value = n > 0 ? n * spacing * 0.5 : 0;\n130\t  }\n131\t  const uniforms = {\n132\t    tGround: { value: map.tex }, uMapMin: { value: map.min }, uMapSize: { value: map.size },\n133\t    uOrigin: { value: new THREE.Vector2() }, uN: { value: n }, uSpacing: { value: spacing },\n134\t    uRadius: { value: n * spacing * 0.5 }, uPlayer: { value: new THREE.Vector3(0, -1e4, 0) },\n135\t    uPixel: { value: 0.0015 },\n136\t    uWind: { value: new THREE.Vector2(1.4, 0.6).normalize() }, uTime: shared.time, uWet: shared.wet,\n137\t  };\n138\t  const mat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.62, metalness: 0, side: THREE.DoubleSide });\n139\t  mat.name = 'grass';\n140\t  mat.customProgramCacheKey = () => 'hedgerow-grass';\n141\t  mat.onBeforeCompile = (shader) => {\n142\t    Object.assign(shader.uniforms, uniforms);\n143\t    shader.vertexShader = shader.vertexShader\n144\t      .replace('#include <common>', `#include <common>\n145\t        uniform sampler2D tGround;\n146\t        uniform vec2 uMapMin, uMapSize, uOrigin, uWind;\n147\t        uniform float uN, uSpacing, uRadius, uTime, uPixel;\n148\t        uniform vec3 uPlayer;\n149\t        varying float vT;\n150\t        varying vec3 vShade;\n151\t        vec3 bladePos;\n152\t        vec4 hash4(vec2 c) {\n153\t          uvec4 v = uvec4(uvec2(ivec2(floor(c)) + 65536), 7u, 13u);\n154\t          v = v * 1664525u + 1013904223u;\n155\t          v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;\n156\t          v ^= v >> 16u;\n157\t          v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;\n158\t          return vec4(v) * (1.0 / 4294967295.0);\n159\t        }`)\n160\t      .replace('#include <beginnormal_vertex>', `\n161\t        // this tuft's cell and everything the hash of it says\n162\t        float id = float(gl_InstanceID);\n163\t        vec2 cell = uOrigin + vec2(mod(id, uN), floor(id / uN));\n164\t        vec4 h = hash4(cell);\n165\t        vec2 root = (cell + 0.5 + (h.xy - 0.5) * 1.4) * uSpacing;\n166\t        vec4 gd = texture2D(tGround, (root - uMapMin) / uMapSize);\n167\t        float dist = length(root - cameraPosition.xz);\n168\t        // far tufts thin out (the rest grow fuller), the patch fades at its edge\n169\t        float keep = mix(1.0, 0.35, smoothstep(6.0, uRadius, dist));\n170\t        float here = step(h.z, gd.y * keep);\n171\t        float tuftH = mix(0.3, 0.78, h.w * sqrt(h.w)) * (0.55 + 0.45 * gd.y) * here * (1.0 - smoothstep(uRadius * 0.6, uRadius * 0.95, dist));\n172\t        // further out a tuft is fewer, wider blades (the rest are under a pixel anyway)\n173\t        float blades = floor(mix(${TUFT}.5, 2.5, smoothstep(5.0, uRadius * 0.75, dist)));\n174\t        tuftH *= step(position.z, blades - 0.5);\n175\t        // this blade of the tuft: where it comes up, how tall, which way it faces\n176\t        vec4 b = hash4(cell + vec2(7919.0 * (position.z + 1.0), 104729.0));\n177\t        float ang = b.x * 6.2831853;\n178\t        vec2 off = vec2(cos(ang), sin(ang)) * (0.02 + 0.1 * sqrt(b.y));\n179\t        vec2 xz = root + off;\n180\t        float hgt = tuftH * mix(0.55, 1.0, b.z);\n181\t        float t = position.y;\n182\t        float yaw = b.w * 6.2831853;\n183\t        vec2 dir = vec2(cos(yaw), sin(yaw)), perp = vec2(-dir.y, dir.x);\n184\t        float w = mix(0.0035, 0.007, b.y) * (1.0 - t * 0.8) * inversesqrt(keep) * sqrt(${TUFT}.0 / blades);\n185\t        w = max(w, dist * uPixel * 0.5 * (1.0 - t * 0.8));\n186\t        // out of the tuft, the wind (gusts rolling across the field), a flutter\n187\t        float gust = 0.5 + 0.5 * sin(dot(root, uWind) * 0.3 - uTime * 1.7 + sin(dot(root, vec2(-uWind.y, uWind.x)) * 0.11) * 2.0);\n188\t        vec2 lean = normalize(off) * (0.25 + 0.45 * b.z) + uWind * (0.15 + 0.55 * gust * gust)\n189\t          + perp * sin(uTime * (2.0 + h.w) + b.x * 6.28) * 0.1;\n190\t        // parted round the player's legs\n191\t        vec2 away = xz - uPlayer.xz;\n192\t        float pd = length(away);\n193\t        lean += away / max(pd, 0.01) * (1.0 - smoothstep(0.15, 0.8, pd)) * step(abs(uPlayer.y - gd.x), 1.5) * 1.6;\n194\t        // bent along an arc (the lean sets how far over the tip is), keeping its length\n195\t        float lm = length(lean);\n196\t        vec2 ld = lean / max(lm, 1e-4);\n197\t        float th = min(lm * 0.85, 1.35);\n198\t        float arc = th * t;\n199\t        float bx = th > 1e-3 ? (1.0 - cos(arc)) / th : 0.0;\n200\t        float by = th > 1e-3 ? sin(arc) / th : t;\n201\t        bladePos = vec3(xz.x, gd.x, xz.y);\n202\t        bladePos.xz += perp * position.x * w + ld * bx * hgt;\n203\t        bladePos.y += by * hgt;\n204\t        // across the blade, rounded towards the sky (lit like the sward, not like planks)\n205\t        vec3 objectNormal = normalize(vec3(dir.x, 0.0, dir.y) * 0.3 + vec3(perp.x, 0.0, perp.y) * position.x * 0.25 + vec3(0.0, 1.0, 0.0));\n206\t        vT = t;\n207\t        vShade = vec3(h.w, b.z, step(0.9, b.y));\n208\t        #ifdef USE_TANGENT\n209\t          vec3 objectTangent = vec3(tangent.xyz);\n210\t        #endif`)\n211\t      .replace('#include <begin_vertex>', `vec3 transformed = bladePos;`);\n212\t    shader.fragmentShader = shader.fragmentShader\n213\t      .replace('#include <common>', `#include <common>\n214\t        uniform float uWet;\n215\t        varying float vT;\n216\t        varying vec3 vShade;`)\n217\t      .replace('#include <color_fragment>', `\n218\t        // dark green at the root (the sward shades it) to lighter, yellower tips; now and then a dead stalk\n219\t        vec3 g0 = mix(vec3(0.03, 0.05, 0.014), vec3(0.05, 0.07, 0.02), vShade.x);\n220\t        vec3 g1 = mix(vec3(0.09, 0.13, 0.035), vec3(0.15, 0.16, 0.06), vShade.y);\n221\t        vec3 col = mix(g0, g1, smoothstep(0.05, 1.0, vT));\n222\t        col = mix(col, vec3(0.2, 0.16, 0.08) * (0.6 + 0.4 * vT), vShade.z);\n223\t        diffuseColor.rgb = col * mix(0.45, 1.0, smoothstep(0.0, 0.4, vT)) * mix(1.0, 0.85, uWet);`)\n224\t      .replace('#include <roughnessmap_fragment>', `#include <roughnessmap_fragment>\n225\t        roughnessFactor = mix(roughnessFactor, 0.42, uWet);`)\n226\t      .replace('float faceDirection = gl_FrontFacing ? 1.0 : - 1.0;', 'float faceDirection = 1.0;');\n227\t  };\n228\t\n229\t  const mesh = new THREE.Mesh(geo, mat);\n230\t  mesh.name = 'grass';\n231\t  mesh.visible = n > 0;\n232\t  mesh.frustumCulled = false;\n233\t  mesh.receiveShadow = true;\n234\t  mesh.castShadow = false;\n235\t\n236\t  return {\n237\t    mesh,\n238\t    /* follow the camera (a pixel's size at a metre for a viewport `height` high); part the grass round the player */\n239\t    update(camera, player, height = 768) {\n240\t      const o = uniforms.uOrigin.value;\n241\t      o.set(Math.floor(camera.position.x / spacing) - n / 2, Math.floor(camera.position.z / spacing) - n / 2);\n242\t      uniforms.uPixel.value = 2 * Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2) / height;\n243\t      if (player) uniforms.uPlayer.value.copy(player);\n244\t    },\n245\t    setCount(m) {\n246\t      n = Math.min(m, max);\n247\t      geo.instanceCount = n * n;\n248\t      uniforms.uN.value = n;\n249\t      uniforms.uRadius.value = n * spacing * 0.5;\n250\t      if (shared.grassR) shared.grassR.value = n > 0 ? uniforms.uRadius.value : 0;\n251\t      mesh.visible = n > 0;\n252\t    },\n253\t    uniforms,\n254\t  };\n255\t}\n256\t"}]},"uuid":"a6ddb584-99b1-4f55-b25b-bfa78e67a9dd","timestamp":"2026-10-21T13:06:17.967Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/grass.js","content":"/* Hedgerow — meadow grass: tufts of blades by the tens of thousands, on the GPU.\n\n   One instanced draw of grass tufts round the camera, one per cell of a\n   grid of world cells (snapped, so a tuft keeps its place as the patch\n   follows the camera); each tuft is five thin blades fanning out of one\n   root. Everything about a tuft and its blades — where in the cell, how\n   tall, which way each faces and leans, its shade, now and then a dead\n   straw-coloured stalk — comes from a hash of its cell; the ground under\n   it (height, and how grassy it is) from a map made once from the terrain:\n   the grass weight of the splat (a little in the forest), none on roads and\n   mud, on steep banks, at the water or inside anything solid (houses, walls,\n   sandbags). The wind leans every blade and sends gusts across the field in\n   waves; the player parts the grass round his legs. Far tufts thin out (the\n   ones left grow fuller, no blade thinner than about a pixel) and the patch\n   fades away at its edge, where the scattered tufts and the ground's own\n   texture take over. */\n\nimport * as THREE from 'three';\n\nconst SEGS = 3, TUFT = 5;\nconst smoothstep = (a, b, x) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };\n\n/* the ground map: R = height, G = how grassy (0..1), at the terrain's grid.\n   The splat weights come from the terrain mesh, which has them at its\n   vertices (every grid point in its fine chunks, every second one\n   elsewhere); the points between are filled from their neighbours. Slope\n   and water are judged at every point, from the heights. */\nfunction groundMap(terrain, world, waterLevel) {\n  const { H, nx, nz, minX, minZ, res } = terrain.grid;\n  const dens = new Float32Array(nx * nz).fill(NaN);\n  for (const chunk of terrain.group.children) {\n    const g = chunk.geometry;\n    const pos = g.attributes.position, spl = g.attributes.splat;\n    if (!pos || !spl) continue;\n    for (let v = 0; v < pos.count; v++) {\n      const i = Math.round((pos.getX(v) - minX) / res), j = Math.round((pos.getZ(v) - minZ) / res);\n      if (i < 0 || j < 0 || i >= nx || j >= nz) continue;\n      const k = j * nx + i;\n      if (Math.abs(pos.getY(v) - H[k]) > 0.01) continue;          // a skirt\n      // grass, a little in the forest, none on the road\n      dens[k] = (smoothstep(0.35, 0.8, spl.getY(v)) + spl.getZ(v) * 0.12) * (1 - Math.min(1, spl.getW(v) * 2));\n    }\n  }\n  // between the coarse chunks' vertices: the average of the known neighbours (the\n  // straight ones; the diagonal ones where both coordinates fall between)\n  for (let j = 0; j < nz; j++) for (let i = 0; i < nx; i++) {\n    const k = j * nx + i;\n    if (!Number.isNaN(dens[k])) continue;\n    let sum = 0, cnt = 0;\n    for (const [di, dj] of [[-1, 0], [1, 0], [0, -1], [0, 1]]) {\n      const a = i + di, b = j + dj;\n      if (a < 0 || b < 0 || a >= nx || b >= nz) continue;\n      const v = dens[b * nx + a];\n      if (!Number.isNaN(v)) { sum += v; cnt++; }\n    }\n    if (!cnt) for (const [di, dj] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {\n      const a = i + di, b = j + dj;\n      if (a < 0 || b < 0 || a >= nx || b >= nz) continue;\n      const v = dens[b * nx + a];\n      if (!Number.isNaN(v)) { sum += v; cnt++; }\n    }\n    dens[k] = cnt ? sum / cnt : 0;\n  }\n  // none on steep banks, none at the water\n  for (let j = 0; j < nz; j++) for (let i = 0; i < nx; i++) {\n    const k = j * nx + i;\n    if (dens[k] <= 0) continue;\n    const hx = H[j * nx + Math.min(nx - 1, i + 1)] - H[j * nx + Math.max(0, i - 1)];\n    const hz = H[Math.min(nz - 1, j + 1) * nx + i] - H[Math.max(0, j - 1) * nx + i];\n    const slope = 1 - (2 * res) / Math.hypot(hx, 2 * res, hz);\n    dens[k] *= (1 - smoothstep(0.25, 0.5, slope)) * smoothstep(0.1, 0.45, H[k] - waterLevel);\n  }\n  // nothing grows inside what is solid; a thin thing (a post, a plank, a\n  // sandbag wall) clears at least the map's nearest points to it\n  const reach = res * 0.72;\n  for (const c of world.colliders) {\n    if (c.type !== 'box' && c.type !== 'cyl') continue;\n    if (!(c.flags & 1) || c.surface === 'foliage') continue;\n    const ex = c.type === 'box' ? Math.max(c.hx + 0.1, reach) : 0, ez = c.type === 'box' ? Math.max(c.hz + 0.1, reach) : 0;\n    const er = c.type === 'cyl' ? Math.max(c.r + 0.1, reach) : 0;\n    const i0 = Math.max(0, Math.floor((c.minX - reach - minX) / res)), i1 = Math.min(nx - 1, Math.ceil((c.maxX + reach - minX) / res));\n    const j0 = Math.max(0, Math.floor((c.minZ - reach - minZ) / res)), j1 = Math.min(nz - 1, Math.ceil((c.maxZ + reach - minZ) / res));\n    for (let j = j0; j <= j1; j++) for (let i = i0; i <= i1; i++) {\n      const k = j * nx + i;\n      const x = minX + i * res, z = minZ + j * res;\n      if (c.top - H[k] < 0.03 || c.bottom - H[k] > 1.0) continue;   // buried, or high above (a bridge deck)\n      const rx = x - c.x, rz = z - c.z;\n      const inside = c.type === 'box'\n        ? Math.abs(rx * c.c - rz * c.s) <= ex && Math.abs(rx * c.s + rz * c.c) <= ez\n        : rx * rx + rz * rz <= er * er;\n      if (inside) dens[k] = 0;\n    }\n  }\n  const data = new Uint16Array(nx * nz * 2);\n  for (let k = 0; k < nx * nz; k++) {\n    data[k * 2] = THREE.DataUtils.toHalfFloat(H[k]);\n    data[k * 2 + 1] = THREE.DataUtils.toHalfFloat(dens[k]);\n  }\n  const tex = new THREE.DataTexture(data, nx, nz, THREE.RGFormat, THREE.HalfFloatType);\n  tex.minFilter = tex.magFilter = THREE.LinearFilter;\n  tex.needsUpdate = true;\n  return { tex, min: new THREE.Vector2(minX, minZ), size: new THREE.Vector2((nx - 1) * res, (nz - 1) * res), texel: new THREE.Vector2(1 / nx, 1 / nz) };\n}\n\nexport function createGrass({ terrain, world, level, shared, n = 192, max = 192, spacing = 0.22 }) {\n  // a tuft: TUFT blades, each a strip from the root (y = 0) to the point\n  // (y = 1); x is the side, z which blade of the tuft\n  const pos = [], idx = [];\n  for (let b = 0; b < TUFT; b++) {\n    const o = b * (SEGS * 2 + 1);\n    for (let i = 0; i < SEGS; i++) pos.push(-1, i / SEGS, b, 1, i / SEGS, b);\n    pos.push(0, 1, b);\n    for (let i = 0; i < SEGS - 1; i++) { const a = o + i * 2; idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2); }\n    idx.push(o + (SEGS - 1) * 2, o + (SEGS - 1) * 2 + 1, o + SEGS * 2);\n  }\n  const geo = new THREE.InstancedBufferGeometry();\n  geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\n  geo.setIndex(idx);\n  // three draws as many instances as its instanced attributes allow: one dummy, for the most\n  geo.setAttribute('aCell', new THREE.InstancedBufferAttribute(new Float32Array(max * max), 1));\n  geo.instanceCount = n * n;\n\n  const map = groundMap(terrain, world, level.water?.level ?? -1e4);\n  // the ground under the grass reads the same map (terrain.js)\n  if (shared.grassMap) {\n    shared.grassMap.value = map.tex;\n    shared.grassMin.value.copy(map.min);\n    shared.grassSize.value.copy(map.size);\n    shared.grassR.value = n > 0 ? n * spacing * 0.5 : 0;\n  }\n  const uniforms = {\n    tGround: { value: map.tex }, uMapMin: { value: map.min }, uMapSize: { value: map.size },\n    uOrigin: { value: new THREE.Vector2() }, uN: { value: n }, uSpacing: { value: spacing },\n    uRadius: { value: n * spacing * 0.5 }, uPlayer: { value: new THREE.Vector3(0, -1e4, 0) },\n    uPixel: { value: 0.0015 },\n    uWind: { value: new THREE.Vector2(1.4, 0.6).normalize() }, uTime: shared.time, uWet: shared.wet,\n  };\n  const mat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.62, metalness: 0, side: THREE.DoubleSide });\n  mat.name = 'grass';\n  mat.customProgramCacheKey = () => 'hedgerow-grass';\n  mat.onBeforeCompile = (shader) => {\n    Object.assign(shader.uniforms, uniforms);\n    shader.vertexShader = shader.vertexShader\n      .replace('#include <common>', `#include <common>\n        uniform sampler2D tGround;\n        uniform vec2 uMapMin, uMapSize, uOrigin, uWind;\n        uniform float uN, uSpacing, uRadius, uTime, uPixel;\n        uniform vec3 uPlayer;\n        varying float vT;\n        varying vec3 vShade;\n        vec3 bladePos;\n        vec4 hash4(vec2 c) {\n          uvec4 v = uvec4(uvec2(ivec2(floor(c)) + 65536), 7u, 13u);\n          v = v * 1664525u + 1013904223u;\n          v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;\n          v ^= v >> 16u;\n          v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;\n          return vec4(v) * (1.0 / 4294967295.0);\n        }`)\n      .replace('#include <beginnormal_vertex>', `\n        // this tuft's cell and everything the hash of it says\n        float id = float(gl_InstanceID);\n        vec2 cell = uOrigin + vec2(mod(id, uN), floor(id / uN));\n        vec4 h = hash4(cell);\n        vec2 root = (cell + 0.5 + (h.xy - 0.5) * 1.4) * uSpacing;\n        vec4 gd = texture2D(tGround, (root - uMapMin) / uMapSize);\n        float dist = length(root - cameraPosition.xz);\n        // far tufts thin out (the rest grow fuller), the patch fades at its edge\n        float keep = mix(1.0, 0.35, smoothstep(6.0, uRadius, dist));\n        float here = step(h.z, gd.y * keep);\n        float tuftH = mix(0.3, 0.78, h.w * sqrt(h.w)) * (0.55 + 0.45 * gd.y) * here * (1.0 - smoothstep(uRadius * 0.6, uRadius * 0.95, dist));\n        // further out a tuft is fewer, wider blades (the rest are under a pixel anyway)\n        float blades = floor(mix(${TUFT}.5, 2.5, smoothstep(5.0, uRadius * 0.75, dist)));\n        tuftH *= step(position.z, blades - 0.5);\n        // this blade of the tuft: where it comes up, how tall, which way it faces\n        vec4 b = hash4(cell + vec2(7919.0 * (position.z + 1.0), 104729.0));\n        float ang = b.x * 6.2831853;\n        vec2 off = vec2(cos(ang), sin(ang)) * (0.02 + 0.1 * sqrt(b.y));\n        vec2 xz = root + off;\n        float hgt = tuftH * mix(0.55, 1.0, b.z);\n        float t = position.y;\n        float yaw = b.w * 6.2831853;\n        vec2 dir = vec2(cos(yaw), sin(yaw)), perp = vec2(-dir.y, dir.x);\n        float w = mix(0.0035, 0.007, b.y) * (1.0 - t * 0.8) * inversesqrt(keep) * sqrt(${TUFT}.0 / blades);\n        w = max(w, dist * uPixel * 0.5 * (1.0 - t * 0.8));\n        // out of the tuft, the wind (gusts rolling across the field), a flutter\n        float gust = 0.5 + 0.5 * sin(dot(root, uWind) * 0.3 - uTime * 1.7 + sin(dot(root, vec2(-uWind.y, uWind.x)) * 0.11) * 2.0);\n        vec2 lean = normalize(off) * (0.25 + 0.45 * b.z) + uWind * (0.15 + 0.55 * gust * gust)\n          + perp * sin(uTime * (2.0 + h.w) + b.x * 6.28) * 0.1;\n        // parted round the player's legs\n        vec2 away = xz - uPlayer.xz;\n        float pd = length(away);\n        lean += away / max(pd, 0.01) * (1.0 - smoothstep(0.15, 0.8, pd)) * step(abs(uPlayer.y - gd.x), 1.5) * 1.6;\n        // bent along an arc (the lean sets how far over the tip is), keeping its length\n        float lm = length(lean);\n        vec2 ld = lean / max(lm, 1e-4);\n        float th = min(lm * 0.85, 1.35);\n        float arc = th * t;\n        float bx = th > 1e-3 ? (1.0 - cos(arc)) / th : 0.0;\n        float by = th > 1e-3 ? sin(arc) / th : t;\n        bladePos = vec3(xz.x, gd.x, xz.y);\n        bladePos.xz += perp * position.x * w + ld * bx * hgt;\n        bladePos.y += by * hgt;\n        // across the blade, rounded towards the sky (lit like the sward, not like planks)\n        vec3 objectNormal = normalize(vec3(dir.x, 0.0, dir.y) * 0.3 + vec3(perp.x, 0.0, perp.y) * position.x * 0.25 + vec3(0.0, 1.0, 0.0));\n        vT = t;\n        vShade = vec3(h.w, b.z, step(0.9, b.y));\n        #ifdef USE_TANGENT\n          vec3 objectTangent = vec3(tangent.xyz);\n        #endif`)\n      .replace('#include <begin_vertex>', `vec3 transformed = bladePos;`);\n    shader.fragmentShader = shader.fragmentShader\n      .replace('#include <common>', `#include <common>\n        uniform float uWet;\n        varying float vT;\n        varying vec3 vShade;`)\n      .replace('#include <color_fragment>', `\n        // dark green at the root (the sward shades it) to lighter, yellower tips; now and then a dead stalk\n        vec3 g0 = mix(vec3(0.03, 0.05, 0.014), vec3(0.05, 0.07, 0.02), vShade.x);\n        vec3 g1 = mix(vec3(0.09, 0.13, 0.035), vec3(0.15, 0.16, 0.06), vShade.y);\n        vec3 col = mix(g0, g1, smoothstep(0.05, 1.0, vT));\n        col = mix(col, vec3(0.2, 0.16, 0.08) * (0.6 + 0.4 * vT), vShade.z);\n        diffuseColor.rgb = col * mix(0.45, 1.0, smoothstep(0.0, 0.4, vT)) * mix(1.0, 0.85, uWet);`)\n      .replace('#include <roughnessmap_fragment>', `#include <roughnessmap_fragment>\n        roughnessFactor = mix(roughnessFactor, 0.42, uWet);`)\n      .replace('float faceDirection = gl_FrontFacing ? 1.0 : - 1.0;', 'float faceDirection = 1.0;');\n  };\n\n  const mesh = new THREE.Mesh(geo, mat);\n  mesh.name = 'grass';\n  mesh.visible = n > 0;\n  mesh.frustumCulled = false;\n  mesh.receiveShadow = true;\n  mesh.castShadow = false;\n\n  return {\n    mesh,\n    /* follow the camera (a pixel's size at a metre for a viewport `height` high); part the grass round the player */\n    update(camera, player, height = 768) {\n      const o = uniforms.uOrigin.value;\n      o.set(Math.floor(camera.position.x / spacing) - n / 2, Math.floor(camera.position.z / spacing) - n / 2);\n      uniforms.uPixel.value = 2 * Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2) / height;\n      if (player) uniforms.uPlayer.value.copy(player);\n    },\n    setCount(m) {\n      n = Math.min(m, max);\n      geo.instanceCount = n * n;\n      uniforms.uN.value = n;\n      uniforms.uRadius.value = n * spacing * 0.5;\n      if (shared.grassR) shared.grassR.value = n > 0 ? uniforms.uRadius.value : 0;\n      mesh.visible = n > 0;\n    },\n    uniforms,\n  };\n}\n","numLines":256,"startLine":1,"totalLines":256}},"sourceToolAssistantUUID":"ab739359-7813-4e3e-b60f-bcf875e64831","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","sessionId":"c33bf617-35bd-4ff6-a907-5e7d748d7fbc","version":"2.1.304","gitBranch":"hedgerow-grass","slug":"shimmying-swimming-falcon"}
