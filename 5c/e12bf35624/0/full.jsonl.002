 if (P.crouch) move = hSpeed > 0.3 ? 'crouch_walk' : 'crouch_idle';\n442:    if (aiming || firingRecently) upper = P.crouch ? 'crouch_aim' : 'aim';\n443:    else if (P.crouch) upper = hSpeed > 0.3 ? 'crouch_walk' : 'crouch_idle';\n453:    // footsteps\n458:        const surf = P.wading > 0.05 ? 'water' : G.terrain.surfaceAt(P.pos.x, P.pos.z);\n459:        G.audio.footstep(P.pos.x, P.pos.y, P.pos.z, surf, P.crouch ? 0.5 : P.sprint ? 1.2 : 0.8, true);\n466:    P.visible = (P.crouch ? 0.55 : 1) * (hSpeed > 3 ? 1.15 : 1) * (firingRecently ? 1.6 : 1);\n468:    const eye = lerp(PLAYER.eye, PLAYER.crouchEye, P.crouchT);\n470:    G.hud.crosshair(lerp(w.spreadHip, w.spreadAim, G.rig.aimT) + P.spread + w.spreadMove * Math.min(1, hSpeed / 3), G.rig.aimT, G.camera.fov);\n471:    G.hud.stance(P.crouch ? 'Crouched' : P.sprint ? 'Sprinting' : P.wading > 0.3 ? 'Wading' : 'Standing');","is_error":false}]},"uuid":"6ef42405-a8f6-49c0-b740-c71771ac84ac","timestamp":"2026-10-21T12:35:46.039Z","toolUseResult":{"stdout":"5:   Walking, sprinting, crouching, wading, vaulting low cover and jumping\n24:    crouch: false, crouchT: 0, sprint: false, grounded: true,\n47:    P.crouch = false; P.crouchT = 0;\n122:    G.audio.switchWeapon();\n143:    G.audio.reload(P.weapon);\n157:      G.audio.dryFire();\n168:    let spread = lerp(w.spreadHip, w.spreadAim, G.rig.aimT) + w.spreadMove * moving * (P.crouch ? 0.5 : 1) + P.spread;\n169:    if (P.crouch) spread *= 0.75;\n199:      G.audio.garandPing();\n207:    G.rig.kick(w.recoil * (P.crouch ? 0.7 : 1) * lerp(1, 0.7, G.rig.aimT), (Math.random() - 0.5) * 2 * w.recoilYaw);\n289:    if (input.pressed('KeyC') || input.pressed('Control')) P.crouch = !P.crouch;\n302:    if (P.sprint && P.crouch) P.crouch = false;\n313:    let speed = P.crouch ? PLAYER.crouchWalk : P.sprint ? PLAYER.run : aiming ? PLAYER.aimWalk : PLAYER.walk;\n315:    if (P.reloading > 0 && !P.crouch) speed = Math.min(speed, PLAYER.walk * 0.8);\n317:    // vault / jump\n332:          let lan