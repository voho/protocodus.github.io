.x);","-        vec3 g1 = mix(vec3(0.07, 0.09, 0.028), vec3(0.11, 0.115, 0.04), vShade.y);","+        vec3 g0 = mix(vec3(0.03, 0.05, 0.014), vec3(0.05, 0.07, 0.02), vShade.x);","+        vec3 g1 = mix(vec3(0.09, 0.13, 0.035), vec3(0.15, 0.16, 0.06), vShade.y);","         vec3 col = mix(g0, g1, smoothstep(0.05, 1.0, vT));","-        col = mix(col, vec3(0.13, 0.105, 0.05) * (0.6 + 0.4 * vT), vShade.z);","-        diffuseColor.rgb = col * mix(0.4, 1.0, smoothstep(0.0, 0.45, vT)) * mix(1.0, 0.8, uWet);`)","+        col = mix(col, vec3(0.2, 0.16, 0.08) * (0.6 + 0.4 * vT), vShade.z);","+        diffuseColor.rgb = col * mix(0.45, 1.0, smoothstep(0.0, 0.4, vT)) * mix(1.0, 0.85, uWet);`)","       .replace('#include <roughnessmap_fragment>', `#include <roughnessmap_fragment>","         roughnessFactor = mix(roughnessFactor, 0.42, uWet);`)","       .replace('float faceDirection = gl_FrontFacing ? 1.0 : - 1.0;', 'float faceDirection = 1.0;');"]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/grass.js"]}},"serverClassifierContext":{"request":"1e122750-350e-493a-80d7-6486c824265d","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"}]}},"live_cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow","platform":"macos"}},"source