"]},{"oldStart":83,"oldLines":8,"newStart":82,"newLines":13,"lines":["     walking · `vegetation.js` instanced trees and ground cover in up to","     three tiers: full model, a thinned `_mid` beyond ~22 m when the nature","     set has one, the `_lod` impostor beyond the quality's near range","-  * `player.js`, `camera.js`, `character.js` (rig, split upper/lower body","-    animation, the outfit's low-detail `_lod` mesh beyond 30 m), `ragdoll.js` (Verlet bodies driving the bones), `combat.js`","+  * `player.js` (first person: your own animated body, the head folded","+    away, the rifle shouldered; aiming turns the body and bends the spine","+    until the sights lie along the view), `camera.js` (at the eyes, down the","+    sights when aiming; the over-the-shoulder rig for the death camera),","+    `character.js` (rig, split upper/lower body animation, the upper body","+    steadied on the gait in first person, the outfit's low-detail `_lod`","+    mesh beyond 30 m), `ragdoll.js` (Verlet bodies driving the bones), `combat.js`","     (hit volumes, grenades, charges, dropped magazines and rifles), `ai.js`","     (perception, cover, MG nests, sniper, reloads; patrols; sounds looked","     into; a lost player searched for where he was seen and ambushed along"]},{"oldStart":156,"oldLines":7,"newStart":160,"newLines":11,"lines":["   `tests/ai-check.mjs` — on the real level: every patrol route walkable, a","   patrol walks it, a distant shot is looked into, lost contact means a","   search and an ambush (hidden, facing his way, springing from cover), the","-  killer walks to the body, the death camera follows him:","+  killer walks to the body, the death camera follows him;","+  `tests/fp-check.mjs` — first person on the real rig and rifles: walking,","+  sprinting and crouching move the rifle in view no more than standing","+  still does (the gait's bob and twist steadied out of the upper body), and","+  aiming puts the front sight in the middle of the view:"," ","       node fun/hedgerow/tests/world-check.mjs","       node fun/hedgerow/tests/route-check.mjs"]},{"oldStart":165,"oldLines":6,"newStart":173,"newLines":7,"lines":["       node fun/hedgerow/tests/distance-check.mjs","       node fun/hedgerow/tests/lod-check.mjs","       node fun/hedgerow/tests/ai-check.mjs","+      node fun/hedgerow/tests/fp-check.mjs"," "," URL switches for testing: `?debug` (frame stats), `?god`, `?fly` (free"," camera; WASD, Q/E, Shift), `?at=x,z` (start elsewhere), `?go` (straight to"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/index.html","hunks":[{"oldStart":6,"oldLines":10,"newStart":6,"newLines":10,"lines":["   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">","   <title>Hedgerow — Saint-Clair at dusk</title>","   <meta name=\"description\"","-    content=\"A third-person Second World War shooter in the browser. Fight your way through a Norman village and the forest beyond it at dusk, in the rain.\">","+    content=\"A first-person Second World War shooter in the browser. Fight your way through a Norman village and the forest beyond it at dusk, in the rain.\">","   <meta name=\"theme-color\" content=\"#0b0d10\">","   <meta property=\"og:title\" content=\"Hedgerow — Saint-Clair at dusk\">","-  <meta property=\"og:description\" content=\"Third-person WW2 shooter in the browser: a village, a river and a forest at dusk, in the rain.\">","+  <meta property=\"og:description\" content=\"First-person WW2 shooter in the browser: a village, a river and a forest at dusk, in the rain.\">","   <meta property=\"og:type\" content=\"website\">","   <meta property=\"og:url\" content=\"https://protocodus.cz/fun/hedgerow/\">","   <link rel=\"canonical\" href=\"https://protocodus.cz/fun/hedgerow/\">"]},{"oldStart":121,"oldLines":7,"newStart":121,"newLines":6,"lines":["         <dt>1 / 2 / wheel</dt><dd>Rifle / submachine gun</dd>","         <dt>G</dt><dd>Throw grenade (hold to cook)</dd>","         <dt>E</dt><dd>Use: place charges, pick up</dd>","-        <dt>Q</dt><dd>Switch shoulder</dd>","         <dt>Esc</dt><dd>Pause</dd>","       </dl>","       <button type=\"button\" class=\"menu-item\" data-action=\"back\">Back</button>"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/assets.js","hunks":[{"oldStart":40,"oldLines":7,"newStart":40,"newLines":7,"lines":["   return v;"," }"," ","-function readSet(gltf, set, models) {","+export function readSet(gltf, set, models) {","   const root = gltf.scene;","   root.updateMatrixWorld(true);","   for (const node of root.children) {"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/camera.js","hunks":[{"oldStart":1,"oldLines":9,"newStart":1,"newLines":16,"lines":["-/* Hedgerow — the over-the-shoulder camera.","+/* Hedgerow — the camera."," ","-   Orbits a pivot just above the soldier's eyes, offset to one shoulder (Q","-   swaps), pulled in when aiming, and pushed forward by walls, trees and the","-   ground so it never ends up inside them. Recoil kicks the view and","-   recovers; shake comes from explosions and near misses.","+   First person (CAMERA.firstPerson): through the soldier's eyes. The eye","+   rides on his head as his body moves (so it bobs with his steps and dips","+   as he crouches), and when he aims it goes down the rifle's sight line, a","+   hand's breadth behind the rear sight; the view narrows to the sights and","+   widens a little at a sprint, and leans a touch into a strafe.","+","+   Over the shoulder (the death camera, and the old third-person view):","+   orbits a pivot just above the soldier's eyes, offset to one shoulder,","+   pulled in when aiming, and pushed forward by walls, trees and the ground","+   so it never ends up inside them. Recoil kicks the view and recovers;","+   shake comes from explosions and near misses."," ","    When the soldier dies the camera stays on the fall for a moment, then","    turns to the man who killed him, glides towards him (zoomed in while he"]},{"oldStart":26,"oldLines":6,"newStart":33,"newLines":7,"lines":["     pivot: new THREE.Vector3(),","     dir: new THREE.Vector3(0, 0, 1),","     bob: 0,","+    roll: 0, sprintT: 0,","   };","   const desired = new THREE.Vector3();","   const rightV = new THREE.Vector3();"]},{"oldStart":94,"oldLines":11,"newStart":102,"newLines":10,"lines":["   };","   rig.resetDeathCam = () => { dc.t = 0; dc.started = false; };"," ","-  /* `target`: the soldier's feet; `eye`: eye height for the stance. */","-  rig.update = (dt, target, eye, aiming, moveSpeed = 0) => {","+  /* the aim blend, the recoil recovering, the shake dying away */","+  function settle(dt, aiming, moveSpeed) {","     rig.aimT = damp(rig.aimT, aiming ? 1 : 0, 14, dt);","     rig.shoulderT = damp(rig.shoulderT, rig.shoulder, 10, dt);","-    // recoil recovers","     const rec = Math.exp(-9 * dt);","     rig.pitch += rig.kickPitch * (1 - rec) * 0.35;   // part of the kick stays (the player pulls down)","     rig.kickPitch *= rec;"]},{"oldStart":107,"oldLines":6,"newStart":114,"newLines":44,"lines":["     rig.shake *= Math.exp(-3.5 * dt);","     rig.shakeT += dt;","     rig.bob += dt * moveSpeed * 1.9;","+  }","+  function shakeAt(p) {","+    if (rig.shake <= 0.001) return;","+    const s = rig.shake * 0.12;","+    p.x += noise2(rig.shakeT * 23, 1.3) * s;","+    p.y += noise2(rig.shakeT * 21, 7.1) * s;","+    p.z += noise2(rig.shakeT * 25, 3.7) * s;","+  }","+","+  /* First person. `eye`: his eyes this frame; `sight`: where the eye goes","+     when aiming (behind the rear sight; null when the rifle is not up);","+     `strafe`: sideways speed (positive to his left), for the lean. */","+  rig.updateFirstPerson = (dt, eye, sight, aiming, { moveSpeed = 0, strafe = 0, sprint = false } = {}) => {","+    settle(dt, aiming && !!sight, moveSpeed);","+    rig.sprintT = damp(rig.sprintT, sprint ? 1 : 0, 6, dt);","+    rig.forward(rig.dir);","+    desired.copy(eye);","+    if (sight) desired.lerp(sight, smoothstep(0, 1, rig.aimT));","+    // a slight bob of the head with his steps (the body is steadied; less still down the sights)","+    const amp = 0.0018 * Math.min(moveSpeed, 5.5) * (1 - 0.75 * rig.aimT);","+    desired.y += Math.sin(rig.bob * 2) * amp;","+    desired.x += -Math.cos(rig.yaw) * Math.sin(rig.bob) * amp * 0.6;","+    desired.z += Math.sin(rig.yaw) * Math.sin(rig.bob) * amp * 0.6;","+    shakeAt(desired);","+    camera.position.copy(desired);","+    look.copy(desired).add(rig.dir);","+    camera.lookAt(look);","+    rig.roll = damp(rig.roll, clamp(strafe, -4, 4) * 0.008 * (1 - rig.aimT), 6, dt);","+    camera.rotateZ(rig.roll);","+    // the over-the-shoulder orbit (death camera) starts from here, not 3 m back","+    rig.dist = 0.3;","+    const fov = lerp(rig.baseFov + CAMERA.sprintFov * rig.sprintT, CAMERA.fpAimFov * rig.baseFov / CAMERA.fov, rig.aimT);","+    if (Math.abs(camera.fov - fov) > 0.01) { camera.fov = fov; camera.updateProjectionMatrix(); }","+  };","+","+  /* `target`: the soldier's feet; `eye`: eye height for the stance. */","+  rig.update = (dt, target, eye, aiming, moveSpeed = 0) => {","+    settle(dt, aiming, moveSpeed);"," ","     const dist = lerp(CAMERA.distance, CAMERA.aimDistance, rig.aimT);","     const shoulder = lerp(CAMERA.shoulder, CAMERA.aimShoulder, rig.aimT) * rig.shoulderT;"]},{"oldStart":132,"oldLines":13,"newStart":177,"newLines":7,"lines":["     if (world.water && world.water.contains(desired.x, desired.z)) g = Math.max(g, world.water.level + 0.3);","     if (desired.y < g) desired.y = g;"," ","-    // shake","-    if (rig.shake > 0.001) {","-      const s = rig.shake * 0.12;","-      desired.x += noise2(rig.shakeT * 23, 1.3) * s;","-      desired.y += noise2(rig.shakeT * 21, 7.1) * s;","-      desired.z += noise2(rig.shakeT * 25, 3.7) * s;","-    }","+    shakeAt(desired);","     camera.position.copy(desired);","     look.copy(desired).add(rig.dir);","     camera.lookAt(look);"]}]},{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/character.js","hunks":[{"oldStart":264,"oldLines":7,"newStart":264,"newLines":59,"lines":["   let lowerName = null, upperName = null, lowerAct = null, upperAct = null;","   let oneShot = null, oneShotEnd = 0, dead = false;","   let spineBase = null;       // the spine as the clips left it, before the aim pitch","+  let spinePosBase = null;","   let ragdoll = null;","+  let headHidden = false;","+  // first person: the pelvis (root and hips bones together) the upper body","+  // rides on, held at each gait's average instead of bobbing and twisting","+  // with every stride","+  let steadyQ = null, steadyP = null;","+  const tq = new THREE.Quaternion(), tqi = new THREE.Quaternion(), cq = new THREE.Quaternion(), cp = new THREE.Vector3();","+  const meanPelvis = new Map();","+  function pelvisMean(name) {","+    if (meanPelvis.has(name)) return meanPelvis.get(name);","+    const clip = clips.lower[name];","+    let out = null;","+    if (clip && bones.root && bones.hips) {","+      const at = (bone, key) => clip.tracks.find((t) => t.name === `${bone}.${key}`)?.createInterpolant() || null;","+      const rp = at('root', 'position'), rq = at('root', 'quaternion'), hp = at('hips', 'position'), hq = at('hips', 'quaternion');","+      const N = 48, p = new THREE.Vector3(), sum = new THREE.Vector4(), q = new THREE.Quaternion(), q1 = new THREE.Quaternion();","+      const v = new THREE.Vector3(), first = new THREE.Quaternion();","+      for (let i = 0; i < N; i++) {","+        const t = (clip.duration * i) / N;","+        q.copy(bones.root.quaternion); if (rq) q.fromArray(rq.evaluate(t));","+        q1.copy(bones.hips.quaternion); if (hq) q1.fromArray(hq.evaluate(t));","+        v.copy(bones.hips.position); if (hp) v.fromArray(hp.evaluate(t));","+        v.applyQuaternion(q);","+        if (rp) v.add(new THREE.Vector3().fromArray(rp.evaluate(t))); else v.add(bones.root.position);","+        p.add(v);","+        q.multiply(q1);","+        if (i === 0) first.copy(q);","+        const s = first.dot(q) < 0 ? -1 : 1;","+        sum.x += q.x * s; sum.y += q.y * s; sum.z += q.z * s; sum.w += q.w * s;","+      }","+      out = { p: p.divideScalar(N), q: new THREE.Quaternion(sum.x, sum.y, sum.z, sum.w).normalize() };","+    }","+    meanPelvis.set(name, out);","+    return out;","+  }","+  /* The spine re-seated as if the pelvis stood at the gait's average pose,","+     so the chest, arms and rifle (and the eyes) ride smoothly on the","+     walking legs; a change of gait (crouching, say) comes through quickly. */","+  function steadyUpper(dt) {","+    const r = bones.root, h = bones.hips, sp = bones.spine;","+    if (!r) return;","+    cq.multiplyQuaternions(r.quaternion, h.quaternion);","+    cp.copy(h.position).applyQuaternion(r.quaternion).add(r.position);","+    if (!steadyQ) { steadyQ = cq.clone(); steadyP = cp.clone(); }","+    const m = lowerName ? pelvisMean(lowerName) : null;","+    const k = 1 - Math.exp(-8 * dt);","+    steadyQ.slerp(m ? m.q : cq, k);","+    steadyP.lerp(m ? m.p : cp, k);","+    tqi.copy(cq).invert();","+    sp.position.applyQuaternion(steadyQ).add(steadyP).sub(cp).applyQuaternion(tqi);","+    sp.quaternion.premultiply(tq.copy(tqi).multiply(steadyQ));","+  }"," ","   function play(layer, name, fade = 0.2, timeScale = 1) {","     const a = act(layer, name);"]},{"oldStart":314,"oldLines":6,"newStart":366,"newLines":13,"lines":["     get socketL() { return socketL; },","     aimPitch: 0,","     lean: 0,","+    steady: false,      // first person: the upper body steadied on the gait","+","+    /* first person: the head (and the helmet on it) folded away from the eyes */","+    hideHead(on) {","+      headHidden = on;","+      if (!on && bones.head) bones.head.scale.setScalar(1);","+    },"," ","     /* Locomotion + upper body. `move` is a lower clip name, `upper` an","        upper clip name, `speed` scales the gait. */"]},{"oldStart":348,"oldLines":6,"newStart":407,"newLines":7,"lines":["       oneShot = null;","       if (world) {","         if (spineBase) bones.spine.quaternion.copy(spineBase);   // no aim pitch frozen in","+        if (spinePosBase) bones.spine.position.copy(spinePosBase);","         ragdoll = createRagdoll(bones, world, { velocity, impulses, root });","         if (ragdoll) { mixer.stopAllAction(); return; }","       }"]},{"oldStart":376,"oldLines":6,"newStart":436,"newLines":7,"lines":["       // the last frame, so a held pose would keep last frame's aim pitch and","       // the next pitch would stack on it: put the clip's pose back first.","       if (spineBase) bones.spine.quaternion.copy(spineBase);","+      if (spinePosBase) bones.spine.position.copy(spinePosBase);","       mixer.update(dt);","       if (oneShot && mixer.time >= oneShotEnd) {","         if (oneShot === 'throw') holdForThrow(false);"]},{"oldStart":384,"oldLines":12,"newStart":445,"newLines":23,"lines":["         play('upper', state._pendingUpper || 'idle', 0.2);","       }","       root.updateMatrixWorld(true);","-      if (bones.spine) (spineBase ||= new THREE.Quaternion()).copy(bones.spine.quaternion);","+      if (bones.spine) {","+        (spineBase ||= new THREE.Quaternion()).copy(bones.spine.quaternion);","+        (spinePosBase ||= new THREE.Vector3()).copy(bones.spine.position);","+      }","+      if (state.steady && !dead && bones.hips && bones.spine) {","+        steadyUpper(dt);","+        bones.spine.updateMatrixWorld(true);","+      }","       if (!dead && state.aimPitch && bones.spine) {","         // the rig's spine pitches about its local X; negative is up","         bones.spine.rotateX(-state.aimPitch);","         bones.spine.updateMatrixWorld(true);","       }","+      if (headHidden && bones.head) {","+        bones.head.scale.setScalar(0.001);","+        bones.head.updateMatrixWorld(true);","+      }","       if (ground != null) {","         shadow.position.set(root.position.x, ground + 0.03, root.position.z);","         shadow.visible = root.visible;"]}]}],"moreFiles":8,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/README.md","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/index.html","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/assets.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/camera.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/character.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/config.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/dof.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/hud.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/main.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/js/player.js","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/hedgerow/tests/fp-check.mjs","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/fun/index.html","/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass/index.html"]}},"serverClassifierContext":{"request":"bda18862-b02b-4f83-8f08-7e87480247bb","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow-grass","branch":"hedgerow-grass","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"pub