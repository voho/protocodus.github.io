{"parentUuid":"4bb12eb9-a298-4357-85dd-f01aaeeb80ac","isSidechain":false,"promptId":"ca86ac74-b393-4b38-8e69-5ddecc3498f5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TAtECuwpJkvgxMEGbFhknT","type":"tool_result","content":"1\t/* Hedgerow — procedural sound (Web Audio).\n2\t\n3\t   Nothing is downloaded: the rain bed, wind, thunder, gunfire, bullets\n4\t   cracking past, impacts, footsteps, reloads and explosions are built from\n5\t   filtered noise and short oscillator sweeps. World sounds are panned and\n6\t   attenuated by distance from the listener and lose their highs with\n7\t   distance; gunfire carries a short slap-back echo from the houses and the\n8\t   tree line. */\n9\t\n10\timport { rng } from './util.js';\n11\t\n12\texport function createAudio() {\n13\t  let ctx = null, master = null, sfx = null, amb = null, verb = null;\n14\t  let noiseBuf = null, brownBuf = null;\n15\t  let volume = 0.8;\n16\t  const R = rng(77);\n17\t  const listener = { x: 0, y: 0, z: 0, yaw: 0 };\n18\t  let rainGain = null, windGain = null, rainLP = null;\n19\t\n20\t  function init() {\n21\t    if (ctx) { if (ctx.state === 'suspended') ctx.resume(); return; }\n22\t    const AC = window.AudioContext || window.webkitAudioContext;\n23\t    if (!AC) return;\n24\t    ctx = new AC();\n25\t    master = ctx.createGain();\n26\t    master.gain.value = volume;\n27\t    const comp = ctx.createDynamicsCompressor();\n28\t    comp.threshold.value = -14; comp.knee.value = 10; comp.ratio.value = 4; comp.attack.value = 0.003; comp.release.value = 0.25;\n29\t    master.connect(comp).connect(ctx.destination);\n30\t    sfx = ctx.createGain(); sfx.connect(master);\n31\t    amb = ctx.createGain(); amb.connect(master);\n32\t    // outdoor slap-back: two short delays, filtered\n33\t    verb = ctx.createGain(); verb.gain.value = 0.32;\n34\t    const d1 = ctx.createDelay(1), d2 = ctx.createDelay(1);\n35\t    d1.delayTime.value = 0.11; d2.delayTime.value = 0.27;\n36\t    const f1 = ctx.createBiquadFilter(); f1.type = 'lowpass'; f1.frequency.value = 2200;\n37\t    const fb = ctx.createGain(); fb.gain.value = 0.3;\n38\t    verb.connect(f1); f1.connect(d1); f1.connect(d2);\n39\t    d1.connect(master); d2.connect(fb); fb.connect(d1); d2.connect(master);\n40\t\n41\t    const n = ctx.sampleRate * 2;\n42\t    noiseBuf = ctx.createBuffer(1, n, ctx.sampleRate);\n43\t    const ch = noiseBuf.getChannelData(0);\n44\t    for (let i = 0; i < n; i++) ch[i] = R() * 2 - 1;\n45\t    brownBuf = ctx.createBuffer(1, n, ctx.sampleRate);\n46\t    const bc = brownBuf.getChannelData(0);\n47\t    let last = 0;\n48\t    for (let i = 0; i < n; i++) { last = (last + 0.02 * (R() * 2 - 1)) / 1.02; bc[i] = last * 3.5; }\n49\t    startAmbience();\n50\t  }\n51\t\n52\t  function noise(brown = false) {\n53\t    const s = ctx.createBufferSource();\n54\t    s.buffer = brown ? brownBuf : noiseBuf;\n55\t    s.loop = true;\n56\t    s.loopStart = R() * 1.5;\n57\t    return s;\n58\t  }\n59\t\n60\t  function startAmbience() {\n61\t    // rain: broadband hiss + patter\n62\t    const r = noise();\n63\t    rainLP = ctx.createBiquadFilter(); rainLP.type = 'lowpass'; rainLP.frequency.value = 5200;\n64\t    const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 400;\n65\t    rainGain = ctx.createGain(); rainGain.gain.value = 0.16;\n66\t    r.connect(hp).connect(rainLP).connect(rainGain).connect(amb);\n67\t    r.start(0, R());\n68\t    const r2 = noise();\n69\t    const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1400; bp.Q.value = 0.6;\n70\t    const g2 = ctx.createGain(); g2.gain.value = 0.07;\n71\t    r2.connect(bp).connect(g2).connect(amb);\n72\t    r2.start(0, R());\n73\t    // wind\n74\t    const w = noise(true);\n75\t    const wl = ctx.createBiquadFilter(); wl.type = 'lowpass'; wl.frequency.value = 380;\n76\t    windGain = ctx.createGain(); windGain.gain.value = 0.18;\n77\t    w.connect(wl).connect(windGain).connect(amb);\n78\t    w.start(0, R());\n79\t    // slow gust modulation\n80\t    const lfo = ctx.createOscillator(); lfo.frequency.value = 0.07;\n81\t    const lg = ctx.createGain(); lg.gain.value = 0.08;\n82\t    lfo.connect(lg).connect(windGain.gain);\n83\t    lfo.start();\n84\t  }\n85\t\n86\t  /* Spatial chain for a sound at a world position. Returns the input node\n87\t     or null when it is too far to hear. */\n88\t  function spatial(x, y, z, { ref = 6, max = 400, echo = 0, lowpassFar = true } = {}) {\n89\t    const dx = x - listener.x, dy = y - listener.y, dz = z - listener.z;\n90\t    const d = Math.hypot(dx, dy, dz);\n91\t    if (d > max) return null;\n92\t    const g = ctx.createGain();\n93\t    g.gain.value = Math.min(1.5, ref / Math.max(ref, d) ** 1.0) * (1 - d / max);\n94\t    const pan = ctx.createStereoPanner();\n95\t    // angle relative to the listener's facing\n96\t    const ang = Math.atan2(dx, dz) - listener.yaw;\n97\t    pan.pan.value = Math.max(-1, Math.min(1, -Math.sin(ang) * Math.min(1, d / 3)));\n98\t    let head = g;\n99\t    if (lowpassFar) {\n100\t      const lp = ctx.createBiquadFilter(); lp.type = 'lowpass';\n101\t      lp.frequency.value = Math.max(700, 16000 / (1 + d / 18));\n102\t      g.connect(lp); lp.connect(pan);\n103\t    } else g.connect(pan);\n104\t    pan.connect(sfx);\n105\t    if (echo > 0) {\n106\t      const e = ctx.createGain(); e.gain.value = echo * Math.min(1, 0.4 + d / 60);\n107\t      pan.connect(e); e.connect(verb);\n108\t    }\n109\t    return head;\n110\t  }\n111\t\n112\t  function env(gainNode, t0, attack, peak, decay, curve = 'exp') {\n113\t    const g = gainNode.gain;\n114\t    g.setValueAtTime(0.0001, t0);\n115\t    g.linearRampToValueAtTime(peak, t0 + attack);\n116\t    if (curve === 'exp') g.exponentialRampToValueAtTime(0.0001, t0 + attack + decay);\n117\t    else g.linearRampToValueAtTime(0, t0 + attack + decay);\n118\t  }\n119\t\n120\t  function burst(out, t, { dur = 0.2, peak = 1, type = 'lowpass', freq = 3000, q = 0.7, sweepTo = null, brown = false, attack = 0.002 } = {}) {\n121\t    const s = noise(brown);\n122\t    const f = ctx.createBiquadFilter(); f.type = type; f.frequency.setValueAtTime(freq, t); f.Q.value = q;\n123\t    if (sweepTo) f.frequency.exponentialRampToValueAtTime(sweepTo, t + dur);\n124\t    const g = ctx.createGain();\n125\t    env(g, t, attack, peak, dur);\n126\t    s.connect(f).connect(g).connect(out);\n127\t    s.start(t, R() * 1.5);\n128\t    s.stop(t + dur + attack + 0.05);\n129\t  }\n130\t\n131\t  function tone(out, t, { f0 = 120, f1 = 40, dur = 0.2, peak = 1, type = 'sine' } = {}) {\n132\t    const o = ctx.createOscillator(); o.type = type;\n133\t    o.frequency.setValueAtTime(f0, t);\n134\t    o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), t + dur);\n135\t    const g = ctx.createGain();\n136\t    env(g, t, 0.003, peak, dur);\n137\t    o.connect(g).connect(out);\n138\t    o.start(t); o.stop(t + dur + 0.05);\n139\t  }\n140\t\n141\t  /* ---------- weapons ---------- */\n142\t\n143\t  const GUN = {\n144\t    garand: { crack: 1.0, freq: 2600, body: 1.1, low: 95, dur: 0.22, echo: 0.9 },\n145\t    thompson: { crack: 0.7, freq: 1800, body: 0.9, low: 80, dur: 0.14, echo: 0.6 },\n146\t    kar98k: { crack: 1.0, freq: 2400, body: 1.1, low: 90, dur: 0.24, echo: 0.9 },\n147\t    mp40: { crack: 0.65, freq: 1700, body: 0.8, low: 85, dur: 0.12, echo: 0.55 },\n148\t    mg42: { crack: 0.75, freq: 2100, body: 0.9, low: 75, dur: 0.1, echo: 0.6 },\n149\t  };\n150\t\n151\t  function gunshot(kind, x, y, z, { player = false } = {}) {\n152\t    if (!ctx) return;\n153\t    const p = GUN[kind] || GUN.kar98k;\n154\t    const t = ctx.currentTime + 0.001;\n155\t    const out = player ? sfx : spatial(x, y, z, { ref: 8, max: 600, echo: p.echo });\n156\t    if (!out) return;\n157\t    let o = out;\n158\t    if (player) {\n159\t      const g = ctx.createGain(); g.gain.value = 0.9; g.connect(sfx);\n160\t      const e = ctx.createGain(); e.gain.value = p.echo * 0.6; g.connect(e); e.connect(verb);\n161\t      o = g;\n162\t    }\n163\t    burst(o, t, { dur: p.dur * 0.35, peak: p.crack, type: 'highpass', freq: p.freq, q: 0.5 });\n164\t    burst(o, t, { dur: p.dur, peak: p.body * 0.9, type: 'lowpass', freq: 1800, sweepTo: 300, q: 0.8 });\n165\t    tone(o, t, { f0: p.low * 1.6, f1: p.low * 0.4, dur: p.dur * 0.9, peak: p.body * 0.9 });\n166\t  }\n167\t\n168\t  function garandPing() {\n169\t    if (!ctx) return;\n170\t    const t = ctx.currentTime + 0.06;\n171\t    for (const [f, a] of [[2760, 0.16], [4150, 0.08], [5800, 0.04]]) {\n172\t      const o = ctx.createOscillator(); o.type = 'sine'; o.frequency.value = f;\n173\t      const g = ctx.createGain(); env(g, t, 0.002, a, 0.5);\n174\t      o.connect(g).connect(sfx); o.start(t); o.stop(t + 0.6);\n175\t    }\n176\t  }\n177\t\n178\t  function dryFire() {\n179\t    if (!ctx) return;\n180\t    burst(sfx, ctx.currentTime, { dur: 0.03, peak: 0.25, type: 'bandpass', freq: 3500, q: 2 });\n181\t  }\n182\t\n183\t  /* Reload clicks: the player's own, or someone else's at a position. */\n184\t  function reload(kind, at = null) {\n185\t    if (!ctx) return;\n186\t    const out = at ? spatial(at.x, at.y + 1.2, at.z, { ref: 2, max: 30 }) : sfx;\n187\t    if (!out) return;\n188\t    const t = ctx.currentTime;\n189\t    const clicks = kind === 'garand' ? [0.2, 0.75, 1.45, 1.85] : [0.25, 0.85, 1.6, 2.05];\n190\t    clicks.forEach((dt, i) => burst(out, t + dt, { dur: 0.05, peak: 0.25 + (i === clicks.length - 1 ? 0.15 : 0), type: 'bandpass', freq: 2200 + i * 500, q: 3 }));\n191\t  }\n192\t\n193\t  function switchWeapon() {\n194\t    if (!ctx) return;\n195\t    const t = ctx.currentTime;\n196\t    burst(sfx, t, { dur: 0.08, peak: 0.15, type: 'bandpass', freq: 900, q: 1.5 });\n197\t    burst(sfx, t + 0.12, { dur: 0.04, peak: 0.2, type: 'bandpass', freq: 2600, q: 3 });\n198\t  }\n199\t\n200\t  /* A bullet passing close: a sharp supersonic crack and a whip. */\n201\t  function whizz(x, y, z, closeness = 1) {\n202\t    if (!ctx) return;\n203\t    const out = spatial(x, y, z, { ref: 2, max: 30, lowpassFar: false });\n204\t    if (!out) return;\n205\t    const t = ctx.currentTime;\n206\t    burst(out, t, { dur: 0.05, peak: 0.6 * closeness, type: 'highpass', freq: 3500, q: 0.7 });\n207\t    burst(out, t + 0.01, { dur: 0.12, peak: 0.3 * closeness, type: 'bandpass', freq: 5000, sweepTo: 1500, q: 2 });\n208\t  }\n209\t\n210\t  function impact(x, y, z, surface) {\n211\t    if (!ctx) return;\n212\t    const out = spatial(x, y, z, { ref: 3, max: 80 });\n213\t    if (!out) return;\n214\t    const t = ctx.currentTime;\n215\t    if (surface === 'metal') {\n216\t      tone(out, t, { f0: 1800 + R() * 900, f1: 1400, dur: 0.18, peak: 0.25, type: 'triangle' });\n217\t      burst(out, t, { dur: 0.04, peak: 0.3, type: 'highpass', freq: 3000 });\n218\t    } else if (surface === 'water') {\n219\t      burst(out, t, { dur: 0.18, peak: 0.35, type: 'bandpass', freq: 1200, sweepTo: 600, q: 1 });\n220\t    } else if (surface === 'wood') {\n221\t      burst(out, t, { dur: 0.08, peak: 0.4, type: 'bandpass', freq: 900, q: 1.5 });\n222\t    } else if (surface === 'flesh') {\n223\t      burst(out, t, { dur: 0.08, peak: 0.45, type: 'lowpass', freq: 700, q: 1 });\n224\t    } else if (surface === 'stone' || surface === 'cobble' || surface === 'concrete') {\n225\t      burst(out, t, { dur: 0.06, peak: 0.4, type: 'bandpass', freq: 2400, q: 1.2 });\n226\t    } else {\n227\t      burst(out, t, { dur: 0.1, peak: 0.35, type: 'lowpass', freq: 600, q: 0.7 });\n228\t    }\n229\t  }\n230\t\n231\t  function explosion(x, y, z, scale = 1) {\n232\t    if (!ctx) return;\n233\t    const out = spatial(x, y, z, { ref: 12, max: 900, echo: 1.2 });\n234\t    if (!out) return;\n235\t    const t = ctx.currentTime;\n236\t    burst(out, t, { dur: 0.25, peak: 1.4 * scale, type: 'lowpass', freq: 5000, sweepTo: 800 });\n237\t    burst(out, t, { dur: 1.8, peak: 1.2 * scale, type: 'lowpass', freq: 600, sweepTo: 80, brown: true });\n238\t    tone(out, t, { f0: 70, f1: 25, dur: 1.2, peak: 1.4 * scale });\n239\t    // debris patter\n240\t    for (let i = 0; i < 6; i++) burst(out, t + 0.5 + R() * 1.2, { dur: 0.05, peak: 0.12, type: 'bandpass', freq: 1500 + R() * 2000, q: 2 });\n241\t  }\n242\t\n243\t  function thunder({ delay = 3, power = 1 } = {}) {\n244\t    if (!ctx) return;\n245\t    const t = ctx.currentTime + delay;\n246\t    const g = ctx.createGain(); g.connect(amb);\n247\t    if (power > 1.2) burst(g, t, { dur: 0.35, peak: 0.9 * power, type: 'lowpass', freq: 3000, sweepTo: 400 });\n248\t    for (let i = 0; i < 5; i++) {\n249\t      burst(g, t + i * (0.35 + R() * 0.6), { dur: 1.6 + R() * 2.2, peak: (0.55 - i * 0.07) * power, type: 'lowpass', freq: 380 - i * 40, sweepTo: 60, brown: true, attack: 0.15 });\n250\t    }\n251\t  }\n252\t\n253\t  /* Distant war: artillery thumps and far machine-gun bursts. */\n254\t  function distant(kind) {\n255\t    if (!ctx) return;\n256\t    const t = ctx.currentTime;\n257\t    const g = ctx.createGain(); g.gain.value = 0.35; g.connect(amb);\n258\t    if (kind === 'artillery') {\n259\t      tone(g, t, { f0: 55, f1: 28, dur: 1.5, peak: 0.6 });\n260\t      burst(g, t, { dur: 2.2, peak: 0.4, type: 'lowpass', freq: 220, sweepTo: 60, brown: true, attack: 0.05 });\n261\t    } else {\n262\t      const n = 6 + Math.floor(R() * 10);\n263\t      for (let i = 0; i < n; i++) burst(g, t + i * 0.055, { dur: 0.06, peak: 0.18, type: 'lowpass', freq: 900, q: 0.7 });\n264\t    }\n265\t  }\n266\t\n267\t  function footstep(x, y, z, surface, loud = 1, player = false) {\n268\t    if (!ctx) return;\n269\t    const out = player ? sfx : spatial(x, y, z, { ref: 2, max: 40 });\n270\t    if (!out) return;\n271\t    const t = ctx.currentTime;\n272\t    const gain = (player ? 0.22 : 0.3) * loud;\n273\t    if (surface === 'water') {\n274\t      burst(out, t, { dur: 0.22, peak: gain * 1.4, type: 'bandpass', freq: 900, sweepTo: 400, q: 0.9 });\n275\t    } else if (surface === 'mud' || surface === 'forest' || surface === 'grass') {\n276\t      burst(out, t, { dur: 0.12, peak: gain, type: 'lowpass', freq: 650, q: 1.2 });\n277\t      burst(out, t + 0.03, { dur: 0.08, peak: gain * 0.4, type: 'bandpass', freq: 1800, q: 2 });\n278\t    } else {\n279\t      burst(out, t, { dur: 0.06, peak: gain * 1.1, type: 'bandpass', freq: 1300, q: 1.5 });\n280\t    }\n281\t  }\n282\t\n283\t  function pin() {\n284\t    if (!ctx) return;\n285\t    const t = ctx.currentTime;\n286\t    burst(sfx, t, { dur: 0.04, peak: 0.3, type: 'bandpass', freq: 3200, q: 4 });\n287\t    tone(sfx, t + 0.05, { f0: 3000, f1: 2500, dur: 0.15, peak: 0.08, type: 'triangle' });\n288\t  }\n289\t\n290\t  function grenadeBounce(x, y, z) {\n291\t    if (!ctx) return;\n292\t    const out = spatial(x, y, z, { ref: 3, max: 40 });\n293\t    if (!out) return;\n294\t    burst(out, ctx.currentTime, { dur: 0.05, peak: 0.3, type: 'bandpass', freq: 1100, q: 2 });\n295\t  }\n296\t\n297\t  function ui(kind = 'click') {\n298\t    if (!ctx) return;\n299\t    const t = ctx.currentTime;\n300\t    if (kind === 'objective') {\n301\t      tone(sfx, t, { f0: 440, f1: 440, dur: 0.25, peak: 0.12, type: 'triangle' });\n302\t      tone(sfx, t + 0.18, { f0: 660, f1: 660, dur: 0.4, peak: 0.12, type: 'triangle' });\n303\t    } else if (kind === 'checkpoint') {\n304\t      tone(sfx, t, { f0: 520, f1: 520, dur: 0.3, peak: 0.08, type: 'triangle' });\n305\t    } else if (kind === 'pickup') {\n306\t      burst(sfx, t, { dur: 0.06, peak: 0.25, type: 'bandpass', freq: 1800, q: 2 });\n307\t      tone(sfx, t + 0.04, { f0: 900, f1: 1200, dur: 0.12, peak: 0.06, type: 'triangle' });\n308\t    } else if (kind === 'hit') {\n309\t      burst(sfx, t, { dur: 0.03, peak: 0.18, type: 'bandpass', freq: 2800, q: 3 });\n310\t    } else if (kind === 'kill') {\n311\t      tone(sfx, t, { f0: 1600, f1: 1300, dur: 0.09, peak: 0.07, type: 'triangle' });\n312\t    } else if (kind === 'hurt') {\n313\t      burst(sfx, t, { dur: 0.15, peak: 0.45, type: 'lowpass', freq: 500, q: 1 });\n314\t      tone(sfx, t, { f0: 90, f1: 60, dur: 0.2, peak: 0.4 });\n315\t    } else if (kind === 'beep') {\n316\t      tone(sfx, t, { f0: 1200, f1: 1200, dur: 0.08, peak: 0.1, type: 'square' });\n317\t    }\n318\t  }\n319\t\n320\t  return {\n321\t    init,\n322\t    get ready() { return !!ctx; },\n323\t    setVolume(v) { volume = v; if (master) master.gain.value = v; },\n324\t    setListener(x, y, z, yaw) { listener.x = x; listener.y = y; listener.z = z; listener.yaw = yaw; },\n325\t    setRain(a, indoor = false) {\n326\t      if (!rainGain) return;\n327\t      rainGain.gain.value = 0.16 * a;\n328\t      rainLP.frequency.value = indoor ? 900 : 5200;\n329\t    },\n330\t    suspend() { ctx?.suspend(); },\n331\t    resume() { ctx?.resume(); },\n332\t    gunshot, garandPing, dryFire, reload, switchWeapon, whizz, impact, explosion, thunder, distant,\n333\t    footstep, pin, grenadeBounce, ui,\n334\t  };\n335\t}\n336\t"}]},"uuid":"6e8c9d1e-eed1-47e7-a0cf-467211e912ac","timestamp":"2026-10-21T12:35:09.062Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow/js/audio.js","content":"/* Hedgerow — procedural sound (Web Audio).\n\n   Nothing is downloaded: the rain bed, wind, thunder, gunfire, bullets\n   cracking past, impacts, footsteps, reloads and explosions are built from\n   filtered noise and short oscillator sweeps. World sounds are panned and\n   attenuated by distance from the listener and lose their highs with\n   distance; gunfire carries a short slap-back echo from the houses and the\n   tree line. */\n\nimport { rng } from './util.js';\n\nexport function createAudio() {\n  let ctx = null, master = null, sfx = null, amb = null, verb = null;\n  let noiseBuf = null, brownBuf = null;\n  let volume = 0.8;\n  const R = rng(77);\n  const listener = { x: 0, y: 0, z: 0, yaw: 0 };\n  let rainGain = null, windGain = null, rainLP = null;\n\n  function init() {\n    if (ctx) { if (ctx.state === 'suspended') ctx.resume(); return; }\n    const AC = window.AudioContext || window.webkitAudioContext;\n    if (!AC) return;\n    ctx = new AC();\n    master = ctx.createGain();\n    master.gain.value = volume;\n    const comp = ctx.createDynamicsCompressor();\n    comp.threshold.value = -14; comp.knee.value = 10; comp.ratio.value = 4; comp.attack.value = 0.003; comp.release.value = 0.25;\n    master.connect(comp).connect(ctx.destination);\n    sfx = ctx.createGain(); sfx.connect(master);\n    amb = ctx.createGain(); amb.connect(master);\n    // outdoor slap-back: two short delays, filtered\n    verb = ctx.createGain(); verb.gain.value = 0.32;\n    const d1 = ctx.createDelay(1), d2 = ctx.createDelay(1);\n    d1.delayTime.value = 0.11; d2.delayTime.value = 0.27;\n    const f1 = ctx.createBiquadFilter(); f1.type = 'lowpass'; f1.frequency.value = 2200;\n    const fb = ctx.createGain(); fb.gain.value = 0.3;\n    verb.connect(f1); f1.connect(d1); f1.connect(d2);\n    d1.connect(master); d2.connect(fb); fb.connect(d1); d2.connect(master);\n\n    const n = ctx.sampleRate * 2;\n    noiseBuf = ctx.createBuffer(1, n, ctx.sampleRate);\n    const ch = noiseBuf.getChannelData(0);\n    for (let i = 0; i < n; i++) ch[i] = R() * 2 - 1;\n    brownBuf = ctx.createBuffer(1, n, ctx.sampleRate);\n    const bc = brownBuf.getChannelData(0);\n    let last = 0;\n    for (let i = 0; i < n; i++) { last = (last + 0.02 * (R() * 2 - 1)) / 1.02; bc[i] = last * 3.5; }\n    startAmbience();\n  }\n\n  function noise(brown = false) {\n    const s = ctx.createBufferSource();\n    s.buffer = brown ? brownBuf : noiseBuf;\n    s.loop = true;\n    s.loopStart = R() * 1.5;\n    return s;\n  }\n\n  function startAmbience() {\n    // rain: broadband hiss + patter\n    const r = noise();\n    rainLP = ctx.createBiquadFilter(); rainLP.type = 'lowpass'; rainLP.frequency.value = 5200;\n    const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 400;\n    rainGain = ctx.createGain(); rainGain.gain.value = 0.16;\n    r.connect(hp).connect(rainLP).connect(rainGain).connect(amb);\n    r.start(0, R());\n    const r2 = noise();\n    const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1400; bp.Q.value = 0.6;\n    const g2 = ctx.createGain(); g2.gain.value = 0.07;\n    r2.connect(bp).connect(g2).connect(amb);\n    r2.start(0, R());\n    // wind\n    const w = noise(true);\n    const wl = ctx.createBiquadFilter(); wl.type = 'lowpass'; wl.frequency.value = 380;\n    windGain = ctx.createGain(); windGain.gain.value = 0.18;\n    w.connect(wl).connect(windGain).connect(amb);\n    w.start(0, R());\n    // slow gust modulation\n    const lfo = ctx.createOscillator(); lfo.frequency.value = 0.07;\n    const lg = ctx.createGain(); lg.gain.value = 0.08;\n    lfo.connect(lg).connect(windGain.gain);\n    lfo.start();\n  }\n\n  /* Spatial chain for a sound at a world position. Returns the input node\n     or null when it is too far to hear. */\n  function spatial(x, y, z, { ref = 6, max = 400, echo = 0, lowpassFar = true } = {}) {\n    const dx = x - listener.x, dy = y - listener.y, dz = z - listener.z;\n    const d = Math.hypot(dx, dy, dz);\n    if (d > max) return null;\n    const g = ctx.createGain();\n    g.gain.value = Math.min(1.5, ref / Math.max(ref, d) ** 1.0) * (1 - d / max);\n    const pan = ctx.createStereoPanner();\n    // angle relative to the listener's facing\n    const ang = Math.atan2(dx, dz) - listener.yaw;\n    pan.pan.value = Math.max(-1, Math.min(1, -Math.sin(ang) * Math.min(1, d / 3)));\n    let head = g;\n    if (lowpassFar) {\n      const lp = ctx.createBiquadFilter(); lp.type = 'lowpass';\n      lp.frequency.value = Math.max(700, 16000 / (1 + d / 18));\n      g.connect(lp); lp.connect(pan);\n    } else g.connect(pan);\n    pan.connect(sfx);\n    if (echo > 0) {\n      const e = ctx.createGain(); e.gain.value = echo * Math.min(1, 0.4 + d / 60);\n      pan.connect(e); e.connect(verb);\n    }\n    return head;\n  }\n\n  function env(gainNode, t0, attack, peak, decay, curve = 'exp') {\n    const g = gainNode.gain;\n    g.setValueAtTime(0.0001, t0);\n    g.linearRampToValueAtTime(peak, t0 + attack);\n    if (curve === 'exp') g.exponentialRampToValueAtTime(0.0001, t0 + attack + decay);\n    else g.linearRampToValueAtTime(0, t0 + attack + decay);\n  }\n\n  function burst(out, t, { dur = 0.2, peak = 1, type = 'lowpass', freq = 3000, q = 0.7, sweepTo = null, brown = false, attack = 0.002 } = {}) {\n    const s = noise(brown);\n    const f = ctx.createBiquadFilter(); f.type = type; f.frequency.setValueAtTime(freq, t); f.Q.value = q;\n    if (sweepTo) f.frequency.exponentialRampToValueAtTime(sweepTo, t + dur);\n    const g = ctx.createGain();\n    env(g, t, attack, peak, dur);\n    s.connect(f).connect(g).connect(out);\n    s.start(t, R() * 1.5);\n    s.stop(t + dur + attack + 0.05);\n  }\n\n  function tone(out, t, { f0 = 120, f1 = 40, dur = 0.2, peak = 1, type = 'sine' } = {}) {\n    const o = ctx.createOscillator(); o.type = type;\n    o.frequency.setValueAtTime(f0, t);\n    o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), t + dur);\n    const g = ctx.createGain();\n    env(g, t, 0.003, peak, dur);\n    o.connect(g).connect(out);\n    o.start(t); o.stop(t + dur + 0.05);\n  }\n\n  /* ---------- weapons ---------- */\n\n  const GUN = {\n    garand: { crack: 1.0, freq: 2600, body: 1.1, low: 95, dur: 0.22, echo: 0.9 },\n    thompson: { crack: 0.7, freq: 1800, body: 0.9, low: 80, dur: 0.14, echo: 0.6 },\n    kar98k: { crack: 1.0, freq: 2400, body: 1.1, low: 90, dur: 0.24, echo: 0.9 },\n    mp40: { crack: 0.65, freq: 1700, body: 0.8, low: 85, dur: 0.12, echo: 0.55 },\n    mg42: { crack: 0.75, freq: 2100, body: 0.9, low: 75, dur: 0.1, echo: 0.6 },\n  };\n\n  function gunshot(kind, x, y, z, { player = false } = {}) {\n    if (!ctx) return;\n    const p = GUN[kind] || GUN.kar98k;\n    const t = ctx.currentTime + 0.001;\n    const out = player ? sfx : spatial(x, y, z, { ref: 8, max: 600, echo: p.echo });\n    if (!out) return;\n    let o = out;\n    if (player) {\n      const g = ctx.createGain(); g.gain.value = 0.9; g.connect(sfx);\n      const e = ctx.createGain(); e.gain.value = p.echo * 0.6; g.connect(e); e.connect(verb);\n      o = g;\n    }\n    burst(o, t, { dur: p.dur * 0.35, peak: p.crack, type: 'highpass', freq: p.freq, q: 0.5 });\n    burst(o, t, { dur: p.dur, peak: p.body * 0.9, type: 'lowpass', freq: 1800, sweepTo: 300, q: 0.8 });\n    tone(o, t, { f0: p.low * 1.6, f1: p.low * 0.4, dur: p.dur * 0.9, peak: p.body * 0.9 });\n  }\n\n  function garandPing() {\n    if (!ctx) return;\n    const t = ctx.currentTime + 0.06;\n    for (const [f, a] of [[2760, 0.16], [4150, 0.08], [5800, 0.04]]) {\n      const o = ctx.createOscillator(); o.type = 'sine'; o.frequency.value = f;\n      const g = ctx.createGain(); env(g, t, 0.002, a, 0.5);\n      o.connect(g).connect(sfx); o.start(t); o.stop(t + 0.6);\n    }\n  }\n\n  function dryFire() {\n    if (!ctx) return;\n    burst(sfx, ctx.currentTime, { dur: 0.03, peak: 0.25, type: 'bandpass', freq: 3500, q: 2 });\n  }\n\n  /* Reload clicks: the player's own, or someone else's at a position. */\n  function reload(kind, at = null) {\n    if (!ctx) return;\n    const out = at ? spatial(at.x, at.y + 1.2, at.z, { ref: 2, max: 30 }) : sfx;\n    if (!out) return;\n    const t = ctx.currentTime;\n    const clicks = kind === 'garand' ? [0.2, 0.75, 1.45, 1.85] : [0.25, 0.85, 1.6, 2.05];\n    clicks.forEach((dt, i) => burst(out, t + dt, { dur: 0.05, peak: 0.25 + (i === clicks.length - 1 ? 0.15 : 0), type: 'bandpass', freq: 2200 + i * 500, q: 3 }));\n  }\n\n  function switchWeapon() {\n    if (!ctx) return;\n    const t = ctx.currentTime;\n    burst(sfx, t, { dur: 0.08, peak: 0.15, type: 'bandpass', freq: 900, q: 1.5 });\n    burst(sfx, t + 0.12, { dur: 0.04, peak: 0.2, type: 'bandpass', freq: 2600, q: 3 });\n  }\n\n  /* A bullet passing close: a sharp supersonic crack and a whip. */\n  function whizz(x, y, z, closeness = 1) {\n    if (!ctx) return;\n    const out = spatial(x, y, z, { ref: 2, max: 30, lowpassFar: false });\n    if (!out) return;\n    const t = ctx.currentTime;\n    burst(out, t, { dur: 0.05, peak: 0.6 * closeness, type: 'highpass', freq: 3500, q: 0.7 });\n    burst(out, t + 0.01, { dur: 0.12, peak: 0.3 * closeness, type: 'bandpass', freq: 5000, sweepTo: 1500, q: 2 });\n  }\n\n  function impact(x, y, z, surface) {\n    if (!ctx) return;\n    const out = spatial(x, y, z, { ref: 3, max: 80 });\n    if (!out) return;\n    const t = ctx.currentTime;\n    if (surface === 'metal') {\n      tone(out, t, { f0: 1800 + R() * 900, f1: 1400, dur: 0.18, peak: 0.25, type: 'triangle' });\n      burst(out, t, { dur: 0.04, peak: 0.3, type: 'highpass', freq: 3000 });\n    } else if (surface === 'water') {\n      burst(out, t, { dur: 0.18, peak: 0.35, type: 'bandpass', freq: 1200, sweepTo: 600, q: 1 });\n    } else if (surface === 'wood') {\n      burst(out, t, { dur: 0.08, peak: 0.4, type: 'bandpass', freq: 900, q: 1.5 });\n    } else if (surface === 'flesh') {\n      burst(out, t, { dur: 0.08, peak: 0.45, type: 'lowpass', freq: 700, q: 1 });\n    } else if (surface === 'stone' || surface === 'cobble' || surface === 'concrete') {\n      burst(out, t, { dur: 0.06, peak: 0.4, type: 'bandpass', freq: 2400, q: 1.2 });\n    } else {\n      burst(out, t, { dur: 0.1, peak: 0.35, type: 'lowpass', freq: 600, q: 0.7 });\n    }\n  }\n\n  function explosion(x, y, z, scale = 1) {\n    if (!ctx) return;\n    const out = spatial(x, y, z, { ref: 12, max: 900, echo: 1.2 });\n    if (!out) return;\n    const t = ctx.currentTime;\n    burst(out, t, { dur: 0.25, peak: 1.4 * scale, type: 'lowpass', freq: 5000, sweepTo: 800 });\n    burst(out, t, { dur: 1.8, peak: 1.2 * scale, type: 'lowpass', freq: 600, sweepTo: 80, brown: true });\n    tone(out, t, { f0: 70, f1: 25, dur: 1.2, peak: 1.4 * scale });\n    // debris patter\n    for (let i = 0; i < 6; i++) burst(out, t + 0.5 + R() * 1.2, { dur: 0.05, peak: 0.12, type: 'bandpass', freq: 1500 + R() * 2000, q: 2 });\n  }\n\n  function thunder({ delay = 3, power = 1 } = {}) {\n    if (!ctx) return;\n    const t = ctx.currentTime + delay;\n    const g = ctx.createGain(); g.connect(amb);\n    if (power > 1.2) burst(g, t, { dur: 0.35, peak: 0.9 * power, type: 'lowpass', freq: 3000, sweepTo: 400 });\n    for (let i = 0; i < 5; i++) {\n      burst(g, t + i * (0.35 + R() * 0.6), { dur: 1.6 + R() * 2.2, peak: (0.55 - i * 0.07) * power, type: 'lowpass', freq: 380 - i * 40, sweepTo: 60, brown: true, attack: 0.15 });\n    }\n  }\n\n  /* Distant war: artillery thumps and far machine-gun bursts. */\n  function distant(kind) {\n    if (!ctx) return;\n    const t = ctx.currentTime;\n    const g = ctx.createGain(); g.gain.value = 0.35; g.connect(amb);\n    if (kind === 'artillery') {\n      tone(g, t, { f0: 55, f1: 28, dur: 1.5, peak: 0.6 });\n      burst(g, t, { dur: 2.2, peak: 0.4, type: 'lowpass', freq: 220, sweepTo: 60, brown: true, attack: 0.05 });\n    } else {\n      const n = 6 + Math.floor(R() * 10);\n      for (let i = 0; i < n; i++) burst(g, t + i * 0.055, { dur: 0.06, peak: 0.18, type: 'lowpass', freq: 900, q: 0.7 });\n    }\n  }\n\n  function footstep(x, y, z, surface, loud = 1, player = false) {\n    if (!ctx) return;\n    const out = player ? sfx : spatial(x, y, z, { ref: 2, max: 40 });\n    if (!out) return;\n    const t = ctx.currentTime;\n    const gain = (player ? 0.22 : 0.3) * loud;\n    if (surface === 'water') {\n      burst(out, t, { dur: 0.22, peak: gain * 1.4, type: 'bandpass', freq: 900, sweepTo: 400, q: 0.9 });\n    } else if (surface === 'mud' || surface === 'forest' || surface === 'grass') {\n      burst(out, t, { dur: 0.12, peak: gain, type: 'lowpass', freq: 650, q: 1.2 });\n      burst(out, t + 0.03, { dur: 0.08, peak: gain * 0.4, type: 'bandpass', freq: 1800, q: 2 });\n    } else {\n      burst(out, t, { dur: 0.06, peak: gain * 1.1, type: 'bandpass', freq: 1300, q: 1.5 });\n    }\n  }\n\n  function pin() {\n    if (!ctx) return;\n    const t = ctx.currentTime;\n    burst(sfx, t, { dur: 0.04, peak: 0.3, type: 'bandpass', freq: 3200, q: 4 });\n    tone(sfx, t + 0.05, { f0: 3000, f1: 2500, dur: 0.15, peak: 0.08, type: 'triangle' });\n  }\n\n  function grenadeBounce(x, y, z) {\n    if (!ctx) return;\n    const out = spatial(x, y, z, { ref: 3, max: 40 });\n    if (!out) return;\n    burst(out, ctx.currentTime, { dur: 0.05, peak: 0.3, type: 'bandpass', freq: 1100, q: 2 });\n  }\n\n  function ui(kind = 'click') {\n    if (!ctx) return;\n    const t = ctx.currentTime;\n    if (kind === 'objective') {\n      tone(sfx, t, { f0: 440, f1: 440, dur: 0.25, peak: 0.12, type: 'triangle' });\n      tone(sfx, t + 0.18, { f0: 660, f1: 660, dur: 0.4, peak: 0.12, type: 'triangle' });\n    } else if (kind === 'checkpoint') {\n      tone(sfx, t, { f0: 520, f1: 520, dur: 0.3, peak: 0.08, type: 'triangle' });\n    } else if (kind === 'pickup') {\n      burst(sfx, t, { dur: 0.06, peak: 0.25, type: 'bandpass', freq: 1800, q: 2 });\n      tone(sfx, t + 0.04, { f0: 900, f1: 1200, dur: 0.12, peak: 0.06, type: 'triangle' });\n    } else if (kind === 'hit') {\n      burst(sfx, t, { dur: 0.03, peak: 0.18, type: 'bandpass', freq: 2800, q: 3 });\n    } else if (kind === 'kill') {\n      tone(sfx, t, { f0: 1600, f1: 1300, dur: 0.09, peak: 0.07, type: 'triangle' });\n    } else if (kind === 'hurt') {\n      burst(sfx, t, { dur: 0.15, peak: 0.45, type: 'lowpass', freq: 500, q: 1 });\n      tone(sfx, t, { f0: 90, f1: 60, dur: 0.2, peak: 0.4 });\n    } else if (kind === 'beep') {\n      tone(sfx, t, { f0: 1200, f1: 1200, dur: 0.08, peak: 0.1, type: 'square' });\n    }\n  }\n\n  return {\n    init,\n    get ready() { return !!ctx; },\n    setVolume(v) { volume = v; if (master) master.gain.value = v; },\n    setListener(x, y, z, yaw) { listener.x = x; listener.y = y; listener.z = z; listener.yaw = yaw; },\n    setRain(a, indoor = false) {\n      if (!rainGain) return;\n      rainGain.gain.value = 0.16 * a;\n      rainLP.frequency.value = indoor ? 900 : 5200;\n    },\n    suspend() { ctx?.suspend(); },\n    resume() { ctx?.resume(); },\n    gunshot, garandPing, dryFire, reload, switchWeapon, whizz, impact, explosion, thunder, distant,\n    footstep, pin, grenadeBounce, ui,\n  };\n}\n","numLines":336,"startLine":1,"totalLines":336}},"sourceToolAssistantUUID":"4bb12eb9-a298-4357-85dd-f01aaeeb80ac","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","sessionId":"8712e5cb-5c17-4f78-8159-fe8e322bd52d","version":"2.1.304","gitBranch":"hedgerow-poc","slug":"shimmying-swimming-falcon"}
