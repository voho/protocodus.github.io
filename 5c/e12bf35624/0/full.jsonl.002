reak;\n    }\n    let surface = hit ? hit.surface : null;\n    if (terrain && !opts.noTerrain) {\n      const tt = terrain.raycast(ox, oy, oz, dx, dy, dz, best);\n      if (tt < best) {\n        best = tt; hit = 'terrain';\n        const x = ox + dx * tt, z = oz + dz * tt;\n        const nn = terrain.normal(x, z);\n        bnx = nn[0]; bny = nn[1]; bnz = nn[2];\n        surface = terrain.surfaceAt(x, z);\n      }\n    }\n    if (water && !opts.noWater && mask & SHOT) {\n      // the water surface stops bullets visually (a splash) only\n      if (dy < -1e-4) {\n        const tt = (water.level - oy) / dy;\n        if (tt > 0 && tt < best && water.contains(ox + dx * tt, oz + dz * tt)) {\n          const ground = terrain ? terrain.height(ox + dx * tt, oz + dz * tt) : -Infinity;\n          if (ground < water.level) {\n            best = tt; hit = 'water'; bnx = 0; bny = 1; bnz = 0; surface = 'water';\n          }\n        }\n      }\n    }\n    if (!hit) return null;\n    return {\n      t: best, x: ox + dx * best, y: oy + dy * best, z: oz + dz * best,\n      nx: bnx, ny: bny, nz: bnz, collider: hit, surface,\n    };\n  }\n\njs/ai.js:36:import * as THREE from 'three';\njs/ai.js:37:import { ENEMY, ENEMY_WEAPONS, GRENADE, GAIT } from './config.js';\njs/ai.js:38:import { clamp, damp, dampAngle, rng, wrapAngle, lerp } from './util.js';\njs/ai.js:39:import { createCharacter, mergedSoldier, randomFace } from './character.js';\njs/ai.js:40:import { startReload as reloadSequence } from './reload.js';\njs/ai.js:41:import { MOVE, SHOT, SIGHT } from './world.js';\njs/ai.js:42:import { createNav } from './nav.js';\njs/player.js:9:import * as THREE from 'three';\njs/player.js:10:import { PLAYER, WEAPONS, GRENADE, GAIT } from './config.js';\njs/player.js:11:import { clamp, damp, dampAngle, lerp, wrapAngle } from './util.js';\njs/player.js:12:import { createCharacter } from './character.js';\njs/player.js:13:import { rayEnemies } from './combat.js';\njs/player.js:14:import { instantiat