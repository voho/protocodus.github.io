nd((x, z) => G.terrain.height(x, z));\n519:    G.effects.update(dt, { x: 1.4, z: 0.6 }, camera.position);\n544:      `veg ${vs.inst} inst ${(vs.tris / 1000).toFixed(0)}k  fx ${G.effects.count}\\n` +\n7:   windows, fires (flickering), and short flashes from muzzles and\n20:export function createLighting(scene, { pool = 8, shadows = true, shadowSize = 512 } = {}) {\n51:  const flashes = [];       // {x,y,z,color,intensity,range,life,age}\n63:  function flash(x, y, z, color = '#ffb060', intensity = 30, range = 14, life = 0.06) {\n64:    if (flashes.length > 12) flashes.shift();\n65:    flashes.push({ x, y, z, color: new THREE.Color(color), intensity, range, life, age: 0 });\n69:  const active = [];\n103:    for (let i = flashes.length - 1; i >= 0; i--) {\n104:      const f = flashes[i];\n106:      if (f.age >= f.life) { flashes.splice(i, 1); continue; }\n117:    active.length = 0;\n119:    if (shadowOf) active.push({ x: shadowOf.x, y: shadowOf.y, z: shadowOf.z, color: shadowOf.color, intensity: shadowLight.intensity, range: shadowOf.range, score: best });\n120:    for (let i = 0; active.length < 8 && i < cand.length; i++) active.push(cand[i]);\n132:  return { hemi, key, rim, addStatic, flash, update, statics, active, shadowLight, get shadowOf() { return shadowOf; } };","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"be8f4ab4-fb33-4a20-9845-4d541731f164","context":{"git_state":{"cwd":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow/fun/hedgerow","root":"/Users/vojta/Dev/protocodus.github.io/.claude/worktrees/hedgerow","branch":"hedgerow-poc","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"voho/protocodus.github.io","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"voho/protocodus.