+    // The console can play any division while host keys follow Keyboard and
+    // Pedal Keys. A physical pallet rises only after both routes let go.
+    void SetDivisionKey(int division, int note, bool pressed, int velocity) {
+        if (division < 0 || division >= kDivisions || note < kFirstNote || note >= kFirstNote + kDivisionKeys[division]) return;
+        const auto d = static_cast<std::size_t>(division), n = static_cast<std::size_t>(note);
+        if (directKeys[d][n] == pressed) return;
+        directKeys[d][n] = pressed;
+        if (sent[d][n]) return;
+        if (pressed) engine.KeyDown(division, note, velocity);
+        else engine.KeyUp(division, note, velocity);
+    }
+
     void AllKeysUp() {
