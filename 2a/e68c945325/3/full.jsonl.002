{"parentUuid":"90a18141-8e92-47d9-96d2-4152f185aa1e","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfNrHg2NofvdYWYnJiHta","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TMMtZdSLEsU4cBe5YJT4Zv","name":"Read","input":{"file_path":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","limit":400},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2514,"cache_read_input_tokens":244538,"output_tokens":504,"output_tokens_details":{"thinking_tokens":400},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2514,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":504,"cache_read_input_tokens":244538,"cache_creation_input_tokens":2514,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2514},"type":"message"}],"speed":"standard"},"input_transformations":[{"type":"thinking_dropped","path":"messages.2.content.0","reason":"prefix_binding_mismatch"}],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01TMMtZdSLEsU4cBe5YJT4Zv":{"file_path":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","limit":400}},"apiBlockIndex":1,"requestId":"req_011CfNrHYVwHcyBkDjBj1fbm","type":"assistant","uuid":"9add3ff6-621f-411c-846a-71d393288bd6","timestamp":"2026-09-24T19:54:20.073Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/vojta/Dev/protocodus.github.io/fun/alpen","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
{"parentUuid":"9add3ff6-621f-411c-846a-71d393288bd6","isSidechain":false,"promptId":"c41cd6de-57c3-441a-96f7-ed621873bfe7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TMMtZdSLEsU4cBe5YJT4Zv","type":"tool_result","content":"1\t/* The rider.\n2\t\n3\t   This is a velocity vector on a surface, not a speed along a track, and\n4\t   almost everything that makes the game feel like snowboarding falls out of\n5\t   that one decision:\n6\t\n7\t   • Gravity is resolved on the slope tangent, so the hill accelerates you\n8\t     by being steep and slows you by being banked. Riding up the side of the\n9\t     corridor costs speed and gives it back on the way down, for free,\n10\t     because that is just what the vector does.\n11\t\n12\t   • The edge holds sideways up to a fixed grip and slides past it. A carve\n13\t     inside the limit keeps its momentum and only pays edge friction; a turn\n14\t     asked for beyond the limit washes out, throws powder and scrubs speed.\n15\t     Turning is therefore something you spend speed on, which is what makes\n16\t     going fast a decision rather than a default.\n17\t\n18\t   • Jumps are not triggered. Every step projects the rider's ballistic path\n19\t     ninety milliseconds forward and asks where the ground will be there. If\n20\t     the hill has dropped away, the current speed is handed to the local\n21\t     surface tangent and released. A kicker's lip, the crest of a roller, the\n22\t     top of a quarterpipe and the edge of a cliff all launch by the same rule:\n23\t     twice the speed means twice every component of launch velocity.\n24\t\n25\t   • The legs are a spring. It compresses under load and extends when the\n26\t     load comes off, which drives the crouch, the camera height, and — if it\n27\t     happens to be extending as you leave the ground — a little extra pop.\n28\t     Pumping a roller works, and nobody had to write pumping.\n29\t\n30\t   Three things about that were more claim than fact, and this file is mostly\n31\t   the correction of them.\n32\t\n33\t   Momentum was being propped up. A rider under 6 m/s got a flat forward\n34\t   shove regardless of which way the ground went, a tuck pumped whether the\n35\t   hill was falling away or standing up in front of it, and the edge bled so\n36\t   little that nothing you did ever really cost anything. So the mountain\n37\t   read as flat however it was shaped, and riding up a bank was free. Every\n38\t   one of those pushes now has to agree with the ground before it is allowed\n39\t   to happen, and climbing takes an honest scrub on top of the g·sin θ that\n40\t   gravity was already charging.\n41\t\n42\t   Air used to weaken gravity through the apex to manufacture hang time. That\n43\t   made a jump's acceleration depend on where it was in the arc and stopped\n44\t   speed, tangent and gravity from predicting the result. The rider now keeps\n45\t   the ramp's tangent velocity and receives the same downward acceleration on\n46\t   every airborne step. The game gravity is deliberately brisk; its direction\n47\t   and consistency are not negotiable.\n48\t\n49\t   And a fall was a timer. Whatever put you down, you slid for 1.35 seconds\n50\t   and stood up. Now it is a body: the speed that went into the tree comes\n51\t   back out as height and tumble, and the rider is ballistic until the snow\n52\t   has finished with them — so a spill at walking pace is over in a second\n53\t   and catching a trunk at 150 km/h throws you a long way down the hill. */\n54\t\n55\timport { RIDER } from './config.js';\n56\timport { normalFrom } from './terrain.js';\n57\t\n58\t\n59\tconst TAU = Math.PI * 2;\n60\t\n61\tconst wrapPi = (a) => {\n62\t  let r = (a + Math.PI) % TAU;\n63\t  if (r < 0) r += TAU;\n64\t  return r - Math.PI;\n65\t};\n66\t\n67\tconst clamp = (v, a, b) => (v < a ? a : v > b ? b : v);\n68\tconst approach = (v, target, rate, dt) => v + (target - v) * (1 - Math.exp(-rate * dt));\n69\tconst momentumStability = (speed) => {\n70\t  const u = clamp(\n71\t    (speed - RIDER.stabilityFrom)\n72\t    / Math.max(1e-5, RIDER.stabilityFull - RIDER.stabilityFrom),\n73\t    0, 1,\n74\t  );\n75\t  // Ease out: composure arrives as soon as the board has real momentum, then\n76\t  // settles gently into its maximum instead of switching on near top speed.\n77\t  return u * (2 - u);\n78\t};\n79\t\n80\t/* A centred height-field normal is correct until the surface deliberately\n81\t   ends. At a kicker lip its forward sample is already on the snow below, so\n82\t   the finite difference invents a near-vertical wall just before the edge and\n83\t   projects the rider's momentum into nothing.\n84\t\n85\t   When the next 35 cm drops much further than the trailing surface rose, use\n86\t   a one-sided derivative along travel instead. The cross-slope derivative\n87\t   remains centred, so carving across a lip still reads the ramp's real camber.\n88\t   The launch look-ahead then sees the missing ground and does its own job. */\n89\tconst CONTACT_EPS = 0.35;\n90\tfunction trailingNormalFrom(fn, x, z, vel, out) {\n91\t  const speed = Math.hypot(vel.x, vel.z);\n92\t  if (speed < 0.25) return normalFrom(fn, x, z, out);\n93\t\n94\t  const fx = vel.x / speed;\n95\t  const fz = vel.z / speed;\n96\t  const rx = -fz;\n97\t  const rz = fx;\n98\t  const h0 = fn(x, z);\n99\t  const behind = fn(x - fx * CONTACT_EPS, z - fz * CONTACT_EPS);\n100\t  const right = fn(x + rx * CONTACT_EPS, z + rz * CONTACT_EPS);\n101\t  const left = fn(x - rx * CONTACT_EPS, z - rz * CONTACT_EPS);\n102\t  const dForward = (h0 - behind) / CONTACT_EPS;\n103\t  const dRight = (right - left) / (2 * CONTACT_EPS);\n104\t  const dx = fx * dForward + rx * dRight;\n105\t  const dz = fz * dForward + rz * dRight;\n106\t  return out.set(-dx, 1, -dz).normalize();\n107\t}\n108\t\n109\tfunction ridingNormalFrom(fn, x, z, vel, out, contact = null) {\n110\t  if (contact) contact.edgeAhead = false;\n111\t  normalFrom(fn, x, z, out);\n112\t  const speed = Math.hypot(vel.x, vel.z);\n113\t  if (speed < 0.25) return out;\n114\t\n115\t  const fx = vel.x / speed;\n116\t  const fz = vel.z / speed;\n117\t  const h0 = fn(x, z);\n118\t  const ahead = fn(x + fx * CONTACT_EPS, z + fz * CONTACT_EPS);\n119\t  const behind = fn(x - fx * CONTACT_EPS, z - fz * CONTACT_EPS);\n120\t  const trailingRise = h0 - behind;\n121\t  if (contact) {\n122\t    const scan = RIDER.lipCommitDistance;\n123\t    const scanAhead = fn(x + fx * scan, z + fz * scan);\n124\t    const tangentAhead = h0 + trailingRise * (scan / CONTACT_EPS);\n125\t    contact.edgeAhead = tangentAhead - scanAhead > 0.45;\n126\t  }\n127\t  // Compare against continuation of the trailing tangent. This separates a\n128\t  // real lip from an ordinary downhill pitch, however steep that pitch is.\n129\t  if (h0 + trailingRise - ahead <= 0.45) return out;\n130\t  if (contact) contact.edgeAhead = true;\n131\t\n132\t  return trailingNormalFrom(fn, x, z, vel, out);\n133\t}\n134\t\n135\t/* The snow still owns contact through the exact normal above, but steering a\n136\t   1.8-metre board from a single 70-centimetre terrain chord makes speed feel\n137\t   progressively more nervous: at 48 m/s almost the entire sample is replaced\n138\t   every 120 Hz tick. This second normal is only for handling and presentation.\n139\t   Its fore/aft chord grows towards the board's physical length with momentum;\n140\t   the lateral chord stays narrow so camber and the player's edge remain live.\n141\t   A detected lip never uses it — ramp support and takeoff stay on the raw\n142\t   trailing tangent. */\n143\tfunction handlingNormalFrom(fn, x, z, vel, support, out, contact = null) {\n144\t  const speed = Math.hypot(vel.x, vel.z);\n145\t  const stable = momentumStability(speed);\n146\t  if (contact) contact.footprint = CONTACT_EPS * 2;\n147\t  if (stable <= 1e-5 || contact?.edgeAhead || speed < 0.25) {\n148\t    return out.copy(support);\n149\t  }\n150\t\n151\t  const fx = vel.x / speed;\n152\t  const fz = vel.z / speed;\n153\t  const rx = -fz;\n154\t  const rz = fx;\n155\t  const along = CONTACT_EPS\n156\t    + (RIDER.contactHalfLength - CONTACT_EPS) * stable;\n157\t  const across = CONTACT_EPS;\n158\t  const ahead = fn(x + fx * along, z + fz * along);\n159\t  const behind = fn(x - fx * along, z - fz * along);\n160\t  const right = fn(x + rx * across, z + rz * across);\n161\t  const left = fn(x - rx * across, z - rz * across);\n162\t  const dForward = (ahead - behind) / (2 * along);\n163\t  const dRight = (right - left) / (2 * across);\n164\t  const dx = fx * dForward + rx * dRight;\n165\t  const dz = fz * dForward + rz * dRight;\n166\t  if (contact) contact.footprint = along * 2;\n167\t  return out.set(-dx, 1, -dz).normalize();\n168\t}\n169\t\n170\t/* Landing outcomes, in order of how much they cost */\n171\texport const CLEAN = 0;\n172\texport const SKETCHY = 1;\n173\texport const BAIL = 2;\n174\t\n175\t/* The three reaches, indexing `RIDER.grabs`. Named rather than numbered\n176\t   because the pose book in `riderModel.js` indexes the same table and a bare\n177\t   2 in two files is how a nose grab quietly becomes a method. */\n178\texport const GRAB_INDY = 0;\n179\texport const GRAB_NOSE = 1;\n180\texport const GRAB_METHOD = 2;\n181\t\n182\t// What the board stands on when the world cannot say: plain groomed piste.\n183\t// Hoisted so the hot path never carries an object literal.\n184\tconst GROOMED_FALLBACK = { rock: 0, groomed: 1, ice: 0, powder: 0 };\n185\t\n186\texport class Rider {\n187\t  /* `world.height(x, z)` is the hill plus whatever kickers sit on it.\n188\t     `world.canStall(x, z)`, when supplied, distinguishes a committed wall\n189\t     climb from ordinary rideable piste. */\n190\t  constructor(THREE, world) {\n191\t    this.THREE = THREE;\n192\t    this.world = world;\n193\t\n194\t    this.pos = new THREE.Vector3();\n195\t    this.vel = new THREE.Vector3();\n196\t    this.normal = new THREE.Vector3(0, 1, 0);\n197\t    this.heading = new THREE.Vector3(0, 0, -1);\n198\t    this.right = new THREE.Vector3(1, 0, 0);\n199\t\n200\t    this._n = new THREE.Vector3();\n201\t    this._supportN = new THREE.Vector3();\n202\t    this._launchN = new THREE.Vector3();\n203\t    this._h = new THREE.Vector3();\n204\t    this._r = new THREE.Vector3();\n205\t    this._g = new THREE.Vector3();\n206\t    this._p = new THREE.Vector3();\n207\t    this._flow = new THREE.Vector3(0, 0, -1);\n208\t    this._flowRight = new THREE.Vector3(1, 0, 0);\n209\t    this._contact = { edgeAhead: false, footprint: CONTACT_EPS * 2 };\n210\t    this.UP = new THREE.Vector3(0, 1, 0);\n211\t\n212\t    this.events = {\n213\t      launch: [], land: [], fall: [], rise: [], impact: [],\n214\t      pump: [], push: [], butter: [], perfectPop: [],\n215\t    };\n216\t\n217\t    this.reset(0);\n218\t  }\n219\t\n220\t  on(name, fn) {\n221\t    this.events[name].push(fn);\n222\t    return this;\n223\t  }\n224\t\n225\t  emit(name, a, b) {\n226\t    const list = this.events[name];\n227\t    // An event nobody registered must be a no-op, not a TypeError: this runs\n228\t    // inside the physics step, where one bad name used to crash the frame —\n229\t    // `perfectPop` fired on exactly the pop it was named after and its list\n230\t    // was missing from the registry above.\n231\t    if (!list) return;\n232\t    for (let i = 0; i < list.length; i++) list[i](a, b);\n233\t  }\n234\t\n235\t  reset(z = 0, x = null) {\n236\t    const posX = x !== null ? x : 0;\n237\t    this.pos.set(posX, this.world.height(posX, z), z);\n238\t    this.vel.set(0, 0, -10);\n239\t    this.yaw = 0;\n240\t    this.flip = 0;\n241\t    this.roll = 0;\n242\t    this.grounded = true;\n243\t    this.state = 'ride';\n244\t    /* The board frame goes back to the spawn's own facts. Left alone it\n245\t       carried the previous run's last surface — a restart out of a crash\n246\t       against the containment wall drew its first frame (and aimed the\n247\t       chase camera) with the rig still banked on the wall's normal until\n248\t       the first physics step happened to run. And \"the spawn's own facts\"\n249\t       means the actual slope, not world-up: the piste's base grade alone\n250\t       is ~17°, and on the zero-step render frames that are routine at\n251\t       144 Hz+ a flat frame drew the board through the hill and made the\n252\t       boom read the ground behind the rider as an obstruction. Same\n253\t       central difference the step itself uses, same heading projection. */\n254\t    const eps = 0.35;\n255\t    const dhx = (this.world.height(posX + eps, z)\n256\t      - this.world.height(posX - eps, z)) / (2 * eps);\n257\t    const dhz = (this.world.height(posX, z + eps)\n258\t      - this.world.height(posX, z - eps)) / (2 * eps);\n259\t    this.normal.set(-dhx, 1, -dhz).normalize();\n260\t    this.heading.set(0, 0, -1)\n261\t      .addScaledVector(this.normal, this.normal.z).normalize();\n262\t    this.right.crossVectors(this.heading, this.normal).normalize();\n263\t\n264\t    this.compression = 0;\n265\t    this.compressionVel = 0;\n266\t    this.extension = 0;      // how far off the snow the board is floating\n267\t    this.gLoad = 1;\n268\t\n269\t    this.charge = 0;\n270\t    this.charging = false;\n271\t    this._latePopAllowed = false;\n272\t    this._jumpBuffer = 0;\n273\t    this._bufferCharge = 0;\n274\t    this.tucking = false;\n275\t    this.pushing = false;       // rear foot is out of the binding and skating\n276\t    this.pushPhase = 0;         // 0..1 authored cycle, shared by physics and rig\n277\t    this.pushStroke = 0;        // completed plants in this run, for diagnostics\n278\t    this.brake = 0;           // 0..1 pressure in the skidded braking edge\n279\t    this.brakeSide = 1;       // side chosen when S begins, held through the stop\n280\t    this.spinVel = 0;\n281\t    this.flipVel = 0;\n282\t\n283\t    this.airTime = 0;\n284\t    this.spinAccum = 0;\n285\t    this.flipAccum = 0;\n286\t    this.grabTime = 0;\n287\t    this.grab = 0;           // 0..1, how far into the grab pose\n288\t    this.grabbing = false;\n289\t    this.grabKind = 0;       // which of RIDER.grabs the hand went for\n290\t    this.press = 0;          // 0..1 pressure into a nose or tail press\n291\t    this.pressNose = false;  // …whether the rider called it a nose press…\n292\t    this.pressEnd = 1;       // …and which end of the *board* that froze onto\n293\t    this.pressTime = 0;\n294\t    this.pressSpin = 0;      // radians the board has come round on that end\n295\t    this.switchStance = false;\n296\t    this.stallTimer = 0;     // how long the board has been too slow for the pitch\n297\t    this.edge = 0;           // radians the board is rolled up onto its edge\n298\t    this.bend = 0;           // g of load the ground's own curvature is adding\n299\t    this._lastGrad = 0;      // last step's gradient along travel, for its rate\n300\t    this._bendReady = false;\n301\t    this.balance = 1;        // 1 when the body is where the turn needs it\n302\t    this.leanErr = 0;        // signed: + is under-leaned, − is over-leaned\n303\t    this.slide = 0;          // m/s of sideways wash, for spray and sound\n304\t    this.lateral = 0;        // signed, so the spray knows which way to fly\n305\t    this.carveLoad = 0;      // 0..1, how hard the edge is working\n306\t    this.climbRate = 0;      // m/s of height being gained, for the HUD and the scrub\n307\t    this.offPiste = 0;       // 0..1, how deep into the unpisted boundary snow\n308\t    this.lipPop = false;     // was the last launch popped on the lip\n309\t    this.takeoffSpeed = 0;   // speed committed to the current trick\n310\t    this.fallTimer = 0;\n311\t    this.fallElapsed = 0;\n312\t    this.airborne = false;   // during a tumble: flying, rather than sliding\n313\t    this.grace = 1.2;\n314\t    this.tumble = 0;\n315\t    this.startZ = z;\n316\t    this.startY = this.pos.y;\n317\t    if (z === 0 || this.summitY === undefined) {\n318\t      this.summitY = this.pos.y;\n319\t    }\n320\t    this.landing = null;     // set for one frame after a landing\n321\t    this.flowDrive = 0;      // how much meter the powered tuck may spend\n322\t    this.yawGlide = 0;       // presentation-only remainder of a landing snap\n323\t    this.flipGlide = 0;      // …and the same for the board's landed pitch\n324\t    this.contactFootprint = CONTACT_EPS * 2;\n325\t    this._handlingReady = false;\n326\t  }\n327\t\n328\t  get speed() {\n329\t    return this.vel.length();\n330\t  }\n331\t\n332\t  get distance() {\n333\t    return Math.max(0, -this.pos.z);\n334\t  }\n335\t\n336\t  get legDistance() {\n337\t    return Math.max(0, this.startZ - this.pos.z);\n338\t  }\n339\t\n340\t  /* Metres of descent, which on a mountain is the more interesting of the two\n341\t     and was the one the read-out did not have. A kilometre of this run is a\n342\t     little under three hundred metres of drop, and that is the number a rider\n343\t     actually quotes about a day. */\n344\t  get drop() {\n345\t    return Math.max(0, (this.summitY !== undefined ? this.summitY : this.startY) - this.pos.y);\n346\t  }\n347\t\n348\t  get boardForward() {\n349\t    const hx = Math.sin(this.yaw);\n350\t    const hz = -Math.cos(this.yaw);\n351\t    const into = hx * this.normal.x + hz * this.normal.z;\n352\t    const tx = hx - this.normal.x * into;\n353\t    const ty = -this.normal.y * into;\n354\t    const tz = hz - this.normal.z * into;\n355\t    const len = Math.hypot(tx, ty, tz) || 1;\n356\t    const signed = (this.vel.x * tx + this.vel.y * ty + this.vel.z * tz) / len;\n357\t    return signed * (this.switchStance ? -1 : 1);\n358\t  }\n359\t\n360\t  /* The course is endless rather than circular: -Z is always towards the next\n361\t     piece of mountain. Projecting that direction onto the local surface gives\n362\t     us a frame that follows banks and walls without ever mistaking a U-turn\n363\t     for another valid downhill line. */\n364\t  courseFrame(n) {\n365\t    this._flow.set(0, 0, -1);\n366\t    this._flow.addScaledVector(n, -this._flow.dot(n));\n367\t    if (this._flow.lengthSq() < 1e-6) this._flow.set(0, 0, -1);\n368\t    else this._flow.normalize();\n369\t    this._flowRight.copy(this._flow).cross(n);\n370\t    if (this._flowRight.lengthSq() < 1e-6) this._flowRight.set(1, 0, 0);\n371\t    else this._flowRight.normalize();\n372\t    return this._flow;\n373\t  }\n374\t\n375\t  /* Preserve tangential speed but keep its direction inside the forward half\n376\t     of the course. This is a guard rail for exceptional impulses, steep\n377\t     landing projections and near-zero gravity assists; ordinary carving stays\n378\t     comfortably inside it and is untouched. */\n379\t  limitCourseVelocity(v, n, limit) {\n380\t    const flow = this.courseFrame(n);\n381\t    const along = v.dot(flow);\n382\t    const across = v.dot(this._flowRight);\n383\t    const speed = Math.hypot(along, across);\n384\t    if (speed < 1e-5) return false;\n385\t    const angle = Math.atan2(across, along);\n386\t    const fixed = clamp(angle, -limit, limit);\n387\t    if (Math.abs(fixed - angle) < 1e-5) return false;\n388\t    v.copy(flow).multiplyScalar(Math.cos(fixed) * speed)\n389\t      .addScaledVector(this._flowRight, Math.sin(fixed) * speed);\n390\t    return true;\n391\t  }\n392\t\n393\t  /* `yaw` is the nose of the board; in switch the direction of travel is its\n394\t     tail. Clamp that stance-adjusted heading, not the raw nose, so regular and\n395\t     switch controls obey exactly the same course rule. */\n396\t  limitCourseYaw(n, limit, dt = Infinity) {\n397\t    const flow = this.courseFrame(n);\n398\t    const courseYaw = Math.atan2(flow.x, -flow.z);\n399\t    const stanceOffset = this.switchStance ? Math.PI : 0;\n400\t    const travelYaw = this.yaw - stanceOffset;"}]},"uuid":"0c8a9448-078b-404b-b04a-b2785340f71c","timestamp":"2026-09-24T19:54:20.116Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","content":"/* The rider.\n\n   This is a velocity vector on a surface, not a speed along a track, and\n   almost everything that makes the game feel like snowboarding falls out of\n   that one decision:\n\n   • Gravity is resolved on the slope tangent, so the hill accelerates you\n     by being steep and slows you by being banked. Riding up the side of the\n     corridor costs speed and gives it back on the way down, for free,\n     because that is just what the vector does.\n\n   • The edge holds sideways up to a fixed grip and slides past it. A carve\n     inside the limit keeps its momentum and only pays edge friction; a turn\n     asked for beyond the limit washes out, throws powder and scrubs speed.\n     Turning is therefore something you spend speed on, which is what makes\n     going fast a decision rather than a default.\n\n   • Jumps are not triggered. Every step projects the rider's ballistic path\n     ninety milliseconds forward and asks where the ground will be there. If\n     the hill has dropped away, the current speed is handed to the local\n     surface tangent and released. A kicker's lip, the crest of a roller, the\n     top of a quarterpipe and the edge of a cliff all launch by the same rule:\n     twice the speed means twice every component of launch velocity.\n\n   • The legs are a spring. It compresses under load and extends when the\n     load comes off, which drives the crouch, the camera height, and — if it\n     happens to be extending as you leave the ground — a little extra pop.\n     Pumping a roller works, and nobody had to write pumping.\n\n   Three things about that were more claim than fact, and this file is mostly\n   the correction of them.\n\n   Momentum was being propped up. A rider under 6 m/s got a flat forward\n   shove regardless of which way the ground went, a tuck pumped whether the\n   hill was falling away or standing up in front of it, and the edge bled so\n   little that nothing you did ever really cost anything. So the mountain\n   read as flat however it was shaped, and riding up a bank was free. Every\n   one of those pushes now has to agree with the ground before it is allowed\n   to happen, and climbing takes an honest scrub on top of the g·sin θ that\n   gravity was already charging.\n\n   Air used to weaken gravity through the apex to manufacture hang time. That\n   made a jump's acceleration depend on where it was in the arc and stopped\n   speed, tangent and gravity from predicting the result. The rider now keeps\n   the ramp's tangent velocity and receives the same downward acceleration on\n   every airborne step. The game gravity is deliberately brisk; its direction\n   and consistency are not negotiable.\n\n   And a fall was a timer. Whatever put you down, you slid for 1.35 seconds\n   and stood up. Now it is a body: the speed that went into the tree comes\n   back out as height and tumble, and the rider is ballistic until the snow\n   has finished with them — so a spill at walking pace is over in a second\n   and catching a trunk at 150 km/h throws you a long way down the hill. */\n\nimport { RIDER } from './config.js';\nimport { normalFrom } from './terrain.js';\n\n\nconst TAU = Math.PI * 2;\n\nconst wrapPi = (a) => {\n  let r = (a + Math.PI) % TAU;\n  if (r < 0) r += TAU;\n  return r - Math.PI;\n};\n\nconst clamp = (v, a, b) => (v < a ? a : v > b ? b : v);\nconst approach = (v, target, rate, dt) => v + (target - v) * (1 - Math.exp(-rate * dt));\nconst momentumStability = (speed) => {\n  const u = clamp(\n    (speed - RIDER.stabilityFrom)\n    / Math.max(1e-5, RIDER.stabilityFull - RIDER.stabilityFrom),\n    0, 1,\n  );\n  // Ease out: composure arrives as soon as the board has real momentum, then\n  // settles gently into its maximum instead of switching on near top speed.\n  return u * (2 - u);\n};\n\n/* A centred height-field normal is correct until the surface deliberately\n   ends. At a kicker lip its forward sample is already on the snow below, so\n   the finite difference invents a near-vertical wall just before the edge and\n   projects the rider's momentum into nothing.\n\n   When the next 35 cm drops much further than the trailing surface rose, use\n   a one-sided derivative along travel instead. The cross-slope derivative\n   remains centred, so carving across a lip still reads the ramp's real camber.\n   The launch look-ahead then sees the missing ground and does its own job. */\nconst CONTACT_EPS = 0.35;\nfunction trailingNormalFrom(fn, x, z, vel, out) {\n  const speed = Math.hypot(vel.x, vel.z);\n  if (speed < 0.25) return normalFrom(fn, x, z, out);\n\n  const fx = vel.x / speed;\n  const fz = vel.z / speed;\n  const rx = -fz;\n  const rz = fx;\n  const h0 = fn(x, z);\n  const behind = fn(x - fx * CONTACT_EPS, z - fz * CONTACT_EPS);\n  const right = fn(x + rx * CONTACT_EPS, z + rz * CONTACT_EPS);\n  const left = fn(x - rx * CONTACT_EPS, z - rz * CONTACT_EPS);\n  const dForward = (h0 - behind) / CONTACT_EPS;\n  const dRight = (right - left) / (2 * CONTACT_EPS);\n  const dx = fx * dForward + rx * dRight;\n  const dz = fz * dForward + rz * dRight;\n  return out.set(-dx, 1, -dz).normalize();\n}\n\nfunction ridingNormalFrom(fn, x, z, vel, out, contact = null) {\n  if (contact) contact.edgeAhead = false;\n  normalFrom(fn, x, z, out);\n  const speed = Math.hypot(vel.x, vel.z);\n  if (speed < 0.25) return out;\n\n  const fx = vel.x / speed;\n  const fz = vel.z / speed;\n  const h0 = fn(x, z);\n  const ahead = fn(x + fx * CONTACT_EPS, z + fz * CONTACT_EPS);\n  const behind = fn(x - fx * CONTACT_EPS, z - fz * CONTACT_EPS);\n  const trailingRise = h0 - behind;\n  if (contact) {\n    const scan = RIDER.lipCommitDistance;\n    const scanAhead = fn(x + fx * scan, z + fz * scan);\n    const tangentAhead = h0 + trailingRise * (scan / CONTACT_EPS);\n    contact.edgeAhead = tangentAhead - scanAhead > 0.45;\n  }\n  // Compare against continuation of the trailing tangent. This separates a\n  // real lip from an ordinary downhill pitch, however steep that pitch is.\n  if (h0 + trailingRise - ahead <= 0.45) return out;\n  if (contact) contact.edgeAhead = true;\n\n  return trailingNormalFrom(fn, x, z, vel, out);\n}\n\n/* The snow still owns contact through the exact normal above, but steering a\n   1.8-metre board from a single 70-centimetre terrain chord makes speed feel\n   progressively more nervous: at 48 m/s almost the entire sample is replaced\n   every 120 Hz tick. This second normal is only for handling and presentation.\n   Its fore/aft chord grows towards the board's physical length with momentum;\n   the lateral chord stays narrow so camber and the player's edge remain live.\n   A detected lip never uses it — ramp support and takeoff stay on the raw\n   trailing tangent. */\nfunction handlingNormalFrom(fn, x, z, vel, support, out, contact = null) {\n  const speed = Math.hypot(vel.x, vel.z);\n  const stable = momentumStability(speed);\n  if (contact) contact.footprint = CONTACT_EPS * 2;\n  if (stable <= 1e-5 || contact?.edgeAhead || speed < 0.25) {\n    return out.copy(support);\n  }\n\n  const fx = vel.x / speed;\n  const fz = vel.z / speed;\n  const rx = -fz;\n  const rz = fx;\n  const along = CONTACT_EPS\n    + (RIDER.contactHalfLength - CONTACT_EPS) * stable;\n  const across = CONTACT_EPS;\n  const ahead = fn(x + fx * along, z + fz * along);\n  const behind = fn(x - fx * along, z - fz * along);\n  const right = fn(x + rx * across, z + rz * across);\n  const left = fn(x - rx * across, z - rz * across);\n  const dForward = (ahead - behind) / (2 * along);\n  const dRight = (right - left) / (2 * across);\n  const dx = fx * dForward + rx * dRight;\n  const dz = fz * dForward + rz * dRight;\n  if (contact) contact.footprint = along * 2;\n  return out.set(-dx, 1, -dz).normalize();\n}\n\n/* Landing outcomes, in order of how much they cost */\nexport const CLEAN = 0;\nexport const SKETCHY = 1;\nexport const BAIL = 2;\n\n/* The three reaches, indexing `RIDER.grabs`. Named rather than numbered\n   because the pose book in `riderModel.js` indexes the same table and a bare\n   2 in two files is how a nose grab quietly becomes a method. */\nexport const GRAB_INDY = 0;\nexport const GRAB_NOSE = 1;\nexport const GRAB_METHOD = 2;\n\n// What the board stands on when the world cannot say: plain groomed piste.\n// Hoisted so the hot path never carries an object literal.\nconst GROOMED_FALLBACK = { rock: 0, groomed: 1, ice: 0, powder: 0 };\n\nexport class Rider {\n  /* `world.height(x, z)` is the hill plus whatever kickers sit on it.\n     `world.canStall(x, z)`, when supplied, distinguishes a committed wall\n     climb from ordinary rideable piste. */\n  constructor(THREE, world) {\n    this.THREE = THREE;\n    this.world = world;\n\n    this.pos = new THREE.Vector3();\n    this.vel = new THREE.Vector3();\n    this.normal = new THREE.Vector3(0, 1, 0);\n    this.heading = new THREE.Vector3(0, 0, -1);\n    this.right = new THREE.Vector3(1, 0, 0);\n\n    this._n = new THREE.Vector3();\n    this._supportN = new THREE.Vector3();\n    this._launchN = new THREE.Vector3();\n    this._h = new THREE.Vector3();\n    this._r = new THREE.Vector3();\n    this._g = new THREE.Vector3();\n    this._p = new THREE.Vector3();\n    this._flow = new THREE.Vector3(0, 0, -1);\n    this._flowRight = new THREE.Vector3(1, 0, 0);\n    this._contact = { edgeAhead: false, footprint: CONTACT_EPS * 2 };\n    this.UP = new THREE.Vector3(0, 1, 0);\n\n    this.events = {\n      launch: [], land: [], fall: [], rise: [], impact: [],\n      pump: [], push: [], butter: [], perfectPop: [],\n    };\n\n    this.reset(0);\n  }\n\n  on(name, fn) {\n    this.events[name].push(fn);\n    return this;\n  }\n\n  emit(name, a, b) {\n    const list = this.events[name];\n    // An event nobody registered must be a no-op, not a TypeError: this runs\n    // inside the physics step, where one bad name used to crash the frame —\n    // `perfectPop` fired on exactly the pop it was named after and its list\n    // was missing from the registry above.\n    if (!list) return;\n    for (let i = 0; i < list.length; i++) list[i](a, b);\n  }\n\n  reset(z = 0, x = null) {\n    const posX = x !== null ? x : 0;\n    this.pos.set(posX, this.world.height(posX, z), z);\n    this.vel.set(0, 0, -10);\n    this.yaw = 0;\n    this.flip = 0;\n    this.roll = 0;\n    this.grounded = true;\n    this.state = 'ride';\n    /* The board frame goes back to the spawn's own facts. Left alone it\n       carried the previous run's last surface — a restart out of a crash\n       against the containment wall drew its first frame (and aimed the\n       chase camera) with the rig still banked on the wall's normal until\n       the first physics step happened to run. And \"the spawn's own facts\"\n       means the actual slope, not world-up: the piste's base grade alone\n       is ~17°, and on the zero-step render frames that are routine at\n       144 Hz+ a flat frame drew the board through the hill and made the\n       boom read the ground behind the rider as an obstruction. Same\n       central difference the step itself uses, same heading projection. */\n    const eps = 0.35;\n    const dhx = (this.world.height(posX + eps, z)\n      - this.world.height(posX - eps, z)) / (2 * eps);\n    const dhz = (this.world.height(posX, z + eps)\n      - this.world.height(posX, z - eps)) / (2 * eps);\n    this.normal.set(-dhx, 1, -dhz).normalize();\n    this.heading.set(0, 0, -1)\n      .addScaledVector(this.normal, this.normal.z).normalize();\n    this.right.crossVectors(this.heading, this.normal).normalize();\n\n    this.compression = 0;\n    this.compressionVel = 0;\n    this.extension = 0;      // how far off the snow the board is floating\n    this.gLoad = 1;\n\n    this.charge = 0;\n    this.charging = false;\n    this._latePopAllowed = false;\n    this._jumpBuffer = 0;\n    this._bufferCharge = 0;\n    this.tucking = false;\n    this.pushing = false;       // rear foot is out of the binding and skating\n    this.pushPhase = 0;         // 0..1 authored cycle, shared by physics and rig\n    this.pushStroke = 0;        // completed plants in this run, for diagnostics\n    this.brake = 0;           // 0..1 pressure in the skidded braking edge\n    this.brakeSide = 1;       // side chosen when S begins, held through the stop\n    this.spinVel = 0;\n    this.flipVel = 0;\n\n    this.airTime = 0;\n    this.spinAccum = 0;\n    this.flipAccum = 0;\n    this.grabTime = 0;\n    this.grab = 0;           // 0..1, how far into the grab pose\n    this.grabbing = false;\n    this.grabKind = 0;       // which of RIDER.grabs the hand went for\n    this.press = 0;          // 0..1 pressure into a nose or tail press\n    this.pressNose = false;  // …whether the rider called it a nose press…\n    this.pressEnd = 1;       // …and which end of the *board* that froze onto\n    this.pressTime = 0;\n    this.pressSpin = 0;      // radians the board has come round on that end\n    this.switchStance = false;\n    this.stallTimer = 0;     // how long the board has been too slow for the pitch\n    this.edge = 0;           // radians the board is rolled up onto its edge\n    this.bend = 0;           // g of load the ground's own curvature is adding\n    this._lastGrad = 0;      // last step's gradient along travel, for its rate\n    this._bendReady = false;\n    this.balance = 1;        // 1 when the body is where the turn needs it\n    this.leanErr = 0;        // signed: + is under-leaned, − is over-leaned\n    this.slide = 0;          // m/s of sideways wash, for spray and sound\n    this.lateral = 0;        // signed, so the spray knows which way to fly\n    this.carveLoad = 0;      // 0..1, how hard the edge is working\n    this.climbRate = 0;      // m/s of height being gained, for the HUD and the scrub\n    this.offPiste = 0;       // 0..1, how deep into the unpisted boundary snow\n    this.lipPop = false;     // was the last launch popped on the lip\n    this.takeoffSpeed = 0;   // speed committed to the current trick\n    this.fallTimer = 0;\n    this.fallElapsed = 0;\n    this.airborne = false;   // during a tumble: flying, rather than sliding\n    this.grace = 1.2;\n    this.tumble = 0;\n    this.startZ = z;\n    this.startY = this.pos.y;\n    if (z === 0 || this.summitY === undefined) {\n      this.summitY = this.pos.y;\n    }\n    this.landing = null;     // set for one frame after a landing\n    this.flowDrive = 0;      // how much meter the powered tuck may spend\n    this.yawGlide = 0;       // presentation-only remainder of a landing snap\n    this.flipGlide = 0;      // …and the same for the board's landed pitch\n    this.contactFootprint = CONTACT_EPS * 2;\n    this._handlingReady = false;\n  }\n\n  get speed() {\n    return this.vel.length();\n  }\n\n  get distance() {\n    return Math.max(0, -this.pos.z);\n  }\n\n  get legDistance() {\n    return Math.max(0, this.startZ - this.pos.z);\n  }\n\n  /* Metres of descent, which on a mountain is the more interesting of the two\n     and was the one the read-out did not have. A kilometre of this run is a\n     little under three hundred metres of drop, and that is the number a rider\n     actually quotes about a day. */\n  get drop() {\n    return Math.max(0, (this.summitY !== undefined ? this.summitY : this.startY) - this.pos.y);\n  }\n\n  get boardForward() {\n    const hx = Math.sin(this.yaw);\n    const hz = -Math.cos(this.yaw);\n    const into = hx * this.normal.x + hz * this.normal.z;\n    const tx = hx - this.normal.x * into;\n    const ty = -this.normal.y * into;\n    const tz = hz - this.normal.z * into;\n    const len = Math.hypot(tx, ty, tz) || 1;\n    const signed = (this.vel.x * tx + this.vel.y * ty + this.vel.z * tz) / len;\n    return signed * (this.switchStance ? -1 : 1);\n  }\n\n  /* The course is endless rather than circular: -Z is always towards the next\n     piece of mountain. Projecting that direction onto the local surface gives\n     us a frame that follows banks and walls without ever mistaking a U-turn\n     for another valid downhill line. */\n  courseFrame(n) {\n    this._flow.set(0, 0, -1);\n    this._flow.addScaledVector(n, -this._flow.dot(n));\n    if (this._flow.lengthSq() < 1e-6) this._flow.set(0, 0, -1);\n    else this._flow.normalize();\n    this._flowRight.copy(this._flow).cross(n);\n    if (this._flowRight.lengthSq() < 1e-6) this._flowRight.set(1, 0, 0);\n    else this._flowRight.normalize();\n    return this._flow;\n  }\n\n  /* Preserve tangential speed but keep its direction inside the forward half\n     of the course. This is a guard rail for exceptional impulses, steep\n     landing projections and near-zero gravity assists; ordinary carving stays\n     comfortably inside it and is untouched. */\n  limitCourseVelocity(v, n, limit) {\n    const flow = this.courseFrame(n);\n    const along = v.dot(flow);\n    const across = v.dot(this._flowRight);\n    const speed = Math.hypot(along, across);\n    if (speed < 1e-5) return false;\n    const angle = Math.atan2(across, along);\n    const fixed = clamp(angle, -limit, limit);\n    if (Math.abs(fixed - angle) < 1e-5) return false;\n    v.copy(flow).multiplyScalar(Math.cos(fixed) * speed)\n      .addScaledVector(this._flowRight, Math.sin(fixed) * speed);\n    return true;\n  }\n\n  /* `yaw` is the nose of the board; in switch the direction of travel is its\n     tail. Clamp that stance-adjusted heading, not the raw nose, so regular and\n     switch controls obey exactly the same course rule. */\n  limitCourseYaw(n, limit, dt = Infinity) {\n    const flow = this.courseFrame(n);\n    const courseYaw = Math.atan2(flow.x, -flow.z);\n    const stanceOffset = this.switchStance ? Math.PI : 0;\n    const travelYaw = this.yaw - stanceOffset;","numLines":400,"startLine":1,"totalLines":2415}},"sourceToolAssistantUUID":"9add3ff6-621f-411c-846a-71d393288bd6","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/vojta/Dev/protocodus.github.io/fun/alpen","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
