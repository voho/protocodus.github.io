","     // share of one of them guessed at."]}]}],"moreFiles":0,"changedFiles":["/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/riderModel.js"]}},"sourceToolAssistantUUID":"70d843a8-9418-47e8-915e-11ff02582098","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/vojta/Dev/protocodus.github.io/fun/alpen","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
