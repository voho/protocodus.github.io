{"parentUuid":"a8edc102-22fa-4456-9d60-54649b65a423","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfNrkX38NYhsGxkHda2qx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UVv5Dc1v9tkT272f4mFSwU","name":"Read","input":{"file_path":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/camera.js"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5610,"cache_read_input_tokens":371367,"output_tokens":680,"output_tokens_details":{"thinking_tokens":598},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":5610,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":680,"cache_read_input_tokens":371367,"cache_creation_input_tokens":5610,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5610},"type":"message"}],"speed":"standard"},"input_transformations":[{"type":"thinking_dropped","path":"messages.2.content.0","reason":"prefix_binding_mismatch"}],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01UVv5Dc1v9tkT272f4mFSwU":{"file_path":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/camera.js"}},"apiBlockIndex":1,"requestId":"req_011CfNrkNi5Yteys1m19N5Jw","type":"assistant","uuid":"78d6472e-b4c0-4b37-b266-af259e674fbf","timestamp":"2026-09-24T20:00:26.443Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-vscode","cwd":"REDACTED","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
{"parentUuid":"78d6472e-b4c0-4b37-b266-af259e674fbf","isSidechain":false,"promptId":"c41cd6de-57c3-441a-96f7-ed621873bfe7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UVv5Dc1v9tkT272f4mFSwU","type":"tool_result","content":"1\t/* The chase camera, which is most of what the player actually feels.\n2\t\n3\t   Three ideas hold it together.\n4\t\n5\t   It follows where the rider is *going*, not where the board is pointing.\n6\t   When the edge lets go and the board swings sideways, the camera stays\n7\t   behind the direction of travel — so you watch your own board slide out in\n8\t   front of you, which is the single most legible way to show a drift.\n9\t\n10\t   It rides the rider's suspension. The camera's height is tied to the leg\n11\t   spring, so a landing drops it and lets it back up, and a hard carve squats\n12\t   it. The screen moves because the rider's body moved, not because a shake\n13\t   was scheduled.\n14\t\n15\t   And it lags with a spring rather than a lerp, so it overshoots slightly on\n16\t   a direction change and settles — which reads as weight. A lerp reads as a\n17\t   camera on a stick.\n18\t\n19\t   Three things have been added since, all of them because the mountain and\n20\t   the rider changed underneath it.\n21\t\n22\t   A landing punches the frame open. The legs were already taking the hit and\n23\t   the shake was already firing, but the lens said nothing, and a landing is\n24\t   the loudest moment the game has. The punch is deliberately applied *after*\n25\t   the field of view has been smoothed rather than to the value being smoothed\n26\t   towards: a target that takes three tenths of a second to reach is a zoom,\n27\t   not a punch.\n28\t\n29\t   The air frame grows with the flight. A jump used to be over inside a\n30\t   second and a camera that sat a little further back covered it. Hang time is\n31\t   roughly double what it was, and over two seconds the old framing put the\n32\t   rider dead centre with the landing somewhere below the bottom edge — which\n33\t   is precisely the information they need and precisely what they could not\n34\t   see. So the boom keeps extending, the camera keeps lifting, and the look\n35\t   point keeps sinking towards the ground for as long as the rider is off it.\n36\t\n37\t   And the floor is no longer one sample and one clamp. That was fine while\n38\t   the ground beside the piste was flat; it is now walled with quarterpipes\n39\t   that riders are meant to ride up, and coming back down one the chase\n40\t   position sits *up the wall behind the rider*, where a clamp lifted the\n41\t   camera over the lip to look down at a rider who had become a dot in the\n42\t   bottom of a bowl. The wall is now treated the way a tree already was:\n43\t   shorten the boom rather than climb, because pulling in keeps the rider the\n44\t   same size on screen and climbing does not. */\n45\t\n46\timport { CAMERA, RENDER, RIDER } from './config.js';\n47\t\n48\tconst clamp = (v, a, b) => (v < a ? a : v > b ? b : v);\n49\t\n50\t/* How far the ground at (x, z) stands above the tangent plane the rider is\n51\t   standing on — the plane through `rider.pos` with `rider.normal` as its\n52\t   normal. Zero on an open pitch however steep it is, a metre or so over a\n53\t   mogul field, and metres up the side of anything built. It is a free\n54\t   function rather than a closure over the frame so the camera can ask it\n55\t   half a dozen times a frame without allocating anything. */\n56\tconst aboveSlope = (world, rider, ny, x, z) => world.height(x, z) - rider.pos.y\n57\t  + (rider.normal.x * (x - rider.pos.x) + rider.normal.z * (z - rider.pos.z)) / ny;\n58\t\n59\t/* The air frame, written here rather than in config because none of it is a\n60\t   new idea — it is the shape of `airHeight` and `lookAhead` over a long\n61\t   flight, and it only means anything next to the values it modifies. */\n62\tconst AIR_OPEN = 1.5;     // seconds of hang over which the air frame opens fully\n63\tconst AIR_PULL = 3.6;     // extra metres of boom at full opening\n64\tconst AIR_LIFT = 1.8;     // and of height\n65\tconst AIR_REACH = 4.5;    // metres further ahead the look point is thrown\n66\tconst AIR_SINK = 2.9;     // and how far it drops towards the landing\n67\tconst AIR_FOV = 5;        // degrees the frame opens back up over a long flight\n68\t\n69\t/* How much of the ground's own bank the frame takes on.\n70\t\n71\t   The share is small and the cap is smaller, because a rolled frame stops\n72\t   reading as a bank and starts reading as a broken horizon somewhere around\n73\t   twelve degrees. The dead zone is what keeps the piste steady: a mogul face\n74\t   is a few degrees of tilt and it is not a bank, and without the dead zone\n75\t   every roller in the run wobbled the horizon.\n76\t\n77\t   Note where the sign comes from. The carve roll below is expressed in the\n78\t   rider's own lean, and this is not: it is the ground's normal measured\n79\t   against the camera's own right-hand axis, so the frame tips towards the\n80\t   hill it is actually looking at rather than towards whichever way a\n81\t   convention happens to point. */\n82\tconst BANK_SHARE = 0.34;\n83\tconst BANK_DEAD = 0.13;   // sine of the tilt below which the ground is just lumpy\n84\tconst BANK_MAX = 0.20;    // radians ≈ 11°\n85\tconst BANK_RATE = 4.0;    // per second — a wall arrives, it does not snap\n86\t\n87\tconst FLOOR = 1.5;        // metres of clearance the camera keeps over the snow\n88\t// How far the ground behind the rider may stand above the slope the rider is\n89\t// on before the camera stops trying to sit on top of it. Two and a half\n90\t// metres covers every roller, mogul and cliff lip the generator makes; a\n91\t// quarterpipe is more than twice it, and a tree is not the camera's problem\n92\t// here because trees are handled by the sightline walk.\n93\tconst CLIMB = 2.6;\n94\t\n95\t/* When collision pulls the live boom right in, its independently smoothed\n96\t   look point cannot stay several metres down-course: on a portrait frame that\n97\t   aims past the rider altogether. Normal framing is untouched above START;\n98\t   below FULL the only honest composition is to look at the rider until the\n99\t   boom has room to open again. */\n100\tconst SHORT_LOOK_START = 0.72;\n101\tconst SHORT_LOOK_FULL = 0.55;\n102\tconst SHORT_PORTRAIT_FOV = 16;\n103\tconst SHORT_PORTRAIT_FOV_MAX = 82;\n104\tconst SHORT_PORTRAIT_WIDE = 1.1;\n105\tconst SHORT_PORTRAIT_RANGE = 0.6;\n106\tconst TREE_MIN_BOOM = 0.30;\n107\tconst TREE_SUBJECT_START = 0.34;\n108\tconst TREE_SUBJECT_RESCAN = 0.58;\n109\tconst TREE_SAMPLE_STEP = 0.075;\n110\tconst TREE_GUARD = 0.035;\n111\tconst TREE_NEAR_RADIUS = 0.7;\n112\tconst TREE_LENS_RADIUS = 4.4;\n113\tconst TREE_PULL_RATE = 18;\n114\tconst TREE_RELEASE_RATE = 3.2;\n115\t\n116\t/* How much of the boom is clear along one bearing.\n117\t\n118\t   `world.blocked` reports trunk circles, but the lens has to stay out of the\n119\t   much wider crown. The clearance therefore grows from a small subject-side\n120\t   margin to a foliage-sized lens margin. A coarse walk finds the first hit,\n121\t   then a short binary search places its boundary continuously; using the\n122\t   coarse sample itself is what made the old camera change distance in visible\n123\t   steps as a tree crossed the sightline. */\n124\t/* A free function rather than a closure over the frame — the same rule\n125\t   `aboveSlope` follows and for the same reason: the walk below asks this up\n126\t   to fourteen times a frame, and a fresh closure per frame is exactly the\n127\t   steady GC churn the rest of the file is written to avoid. */\n128\tconst treeBlockedAt = (world, rider, dx, dz, t) => {\n129\t  const cx = rider.pos.x + dx * t;\n130\t  const cz = rider.pos.z + dz * t;\n131\t  const near = clamp((t - TREE_SUBJECT_START) / (1 - TREE_SUBJECT_START), 0, 1);\n132\t  const shaped = near * near * (3 - 2 * near);\n133\t  const foliage = TREE_NEAR_RADIUS\n134\t    + shaped * (TREE_LENS_RADIUS - TREE_NEAR_RADIUS);\n135\t  return world.blocked(cx, cz, foliage);\n136\t};\n137\t\n138\tconst treeClearFraction = (world, rider, point) => {\n139\t  if (!world.blocked) return 1;\n140\t\n141\t  const dx = point.x - rider.pos.x;\n142\t  const dz = point.z - rider.pos.z;\n143\t  if (dx * dx + dz * dz < 0.01) return 1;\n144\t\n145\t  let previous = TREE_SUBJECT_START;\n146\t  let wasBlocked = treeBlockedAt(world, rider, dx, dz, previous);\n147\t\n148\t  /* A crown already touching the rider cannot be fixed by moving the camera.\n149\t     Ignore that innermost overlap, but start again soon enough to catch a\n150\t     second tree or the same crown surrounding the lens. */\n151\t  if (wasBlocked) {\n152\t    previous = TREE_SUBJECT_RESCAN;\n153\t    wasBlocked = treeBlockedAt(world, rider, dx, dz, previous);\n154\t    if (wasBlocked) return Math.max(TREE_MIN_BOOM, previous - 0.10);\n155\t  }\n156\t\n157\t  const count = Math.ceil((1 - previous) / TREE_SAMPLE_STEP);\n158\t  let lastClear = previous;\n159\t  for (let i = 1; i <= count; i++) {\n160\t    const t = Math.min(1, previous + i * TREE_SAMPLE_STEP);\n161\t    if (!treeBlockedAt(world, rider, dx, dz, t)) {\n162\t      lastClear = t;\n163\t      continue;\n164\t    }\n165\t\n166\t    let lo = Math.max(TREE_MIN_BOOM, lastClear);\n167\t    let hi = t;\n168\t    for (let j = 0; j < 5; j++) {\n169\t      const mid = (lo + hi) * 0.5;\n170\t      if (treeBlockedAt(world, rider, dx, dz, mid)) hi = mid;\n171\t      else lo = mid;\n172\t    }\n173\t    return Math.max(TREE_MIN_BOOM, lo - TREE_GUARD);\n174\t  }\n175\t  return 1;\n176\t};\n177\t\n178\tconst shortenBoom = (world, rider, point, fraction) => {\n179\t  if (fraction >= 0.999) return;\n180\t  point.x = rider.pos.x + (point.x - rider.pos.x) * fraction;\n181\t  point.z = rider.pos.z + (point.z - rider.pos.z) * fraction;\n182\t  point.y = Math.max(point.y, world.height(point.x, point.z) + FLOOR);\n183\t};\n184\t\n185\texport function createChaseCamera(THREE, camera) {\n186\t  const at = new THREE.Vector3();\n187\t  const look = new THREE.Vector3();\n188\t  const want = new THREE.Vector3();\n189\t  const wantLook = new THREE.Vector3();\n190\t  const dir = new THREE.Vector3();\n191\t  const flat = new THREE.Vector3();\n192\t  const tmp = new THREE.Vector3();\n193\t  const riderLook = new THREE.Vector3();\n194\t\n195\t  let started = false;\n196\t  let shake = 0;\n197\t  let fov = RENDER.fov;\n198\t  let punch = 0;\n199\t  let roll = 0;\n200\t  let bank = 0;\n201\t  let seed = 0;\n202\t  let treeBoom = 1;\n203\t  /* The air frame's own crossfade. `rider.state` flips in one physics step,\n204\t     and everything the boolean used to gate — boom, height, look sink, lag,\n205\t     lens, bank, chatter — changed target in the same frame, which read as\n206\t     the camera catching on something at every touchdown. The blend eases\n207\t     in fast enough to open with a real jump and out slow enough that a\n208\t     landing settles instead of snapping; the two memories hold the flight's\n209\t     last opening and sink so the descent of the frame is from where the\n210\t     flight actually left it, not from a target that collapsed to zero the\n211\t     moment `airTime` reset. */\n212\t  let airBlend = 0;\n213\t  let hangMem = 0;\n214\t  let sinkMem = 0;\n215\t\n216\t  function kick(amount) {\n217\t    shake = Math.min(2.4, shake + amount);\n218\t  }\n219\t\n220\t  /* The visual half of the thump the legs are already taking. Weighed\n221\t     against `softImpact`, which is the physics' own idea of a landing that\n222\t     has stopped being free — so the frame and the body agree about what a\n223\t     heavy landing is instead of each having a private opinion. */\n224\t  function land(impact) {\n225\t    const w = Math.min(1, impact / (RIDER.softImpact * 1.4));\n226\t    punch = Math.min(CAMERA.landFov * 1.3, punch + CAMERA.landFov * w);\n227\t    kick(Math.min(1.8, impact * 0.09));\n228\t  }\n229\t\n230\t  function update(rider, dt, world) {\n231\t    const speed = rider.speed;\n232\t    const ratio = clamp(speed / 42, 0, 1);\n233\t    // A flight, not merely an absence of ground: a wipeout also leaves the\n234\t    // ground, and framing the tumble with the flight's opened boom and lens\n235\t    // made every crash look like a soaring air.\n236\t    const air = rider.state === 'air';\n237\t    const tuck = rider.tucking ? 1 : 0;\n238\t    airBlend += ((air ? 1 : 0) - airBlend)\n239\t      * (1 - Math.exp(-(air ? 9 : 6.5) * dt));\n240\t    if (airBlend < 0.002) airBlend = 0;\n241\t    // Eased rather than linear, so the frame opens promptly off a small\n242\t    // roller and still has somewhere left to go through a long flight\n243\t    if (air) {\n244\t      const hang = clamp(rider.airTime / AIR_OPEN, 0, 1);\n245\t      hangMem = hang * (2 - hang);\n246\t      sinkMem = Math.min(2.0, Math.max(0, -rider.vel.y) * 0.11);\n247\t    }\n248\t    const airT = airBlend * hangMem;\n249\t\n250\t    // Which way the run is actually heading: mostly the velocity, a little\n251\t    // the board. Pure velocity swims about at low speed; pure heading hides\n252\t    // every slide the rider makes — so trust in the velocity fades in over\n253\t    // 1.5–3.5 m/s instead of switching at 3. The hard switch sat exactly in\n254\t    // the band where board and travel diverge most, and crossing it during\n255\t    // a scrubbing stop swung the whole frame one way and back in two steps.\n256\t    const stanceYaw = rider.yaw - (rider.switchStance ? Math.PI : 0);\n257\t    flat.set(rider.vel.x, 0, rider.vel.z);\n258\t    const travel = flat.length();\n259\t    tmp.set(Math.sin(stanceYaw), 0, -Math.cos(stanceYaw));\n260\t    if (travel < 1e-4) {\n261\t      flat.copy(tmp);\n262\t    } else {\n263\t      const trust = clamp((travel - 1.5) / 2, 0, 1);\n264\t      flat.multiplyScalar(1 / travel).lerp(tmp, 1 - trust).normalize();\n265\t    }\n266\t    // In flight the board may spin several times while its landing line\n267\t    // stays fixed. Remove its steering influence as the air frame opens.\n268\t    const velocityBias = CAMERA.velocityBias + (1 - CAMERA.velocityBias) * airBlend;\n269\t    dir.copy(flat).multiplyScalar(velocityBias)\n270\t      .addScaledVector(tmp, 1 - velocityBias).normalize();\n271\t\n272\t    /* The punch also pulls the boom in a fraction. Widening the lens alone\n273\t       reads as a lens event; a lens that widens *while the camera lunges\n274\t       half a metre closer* reads as an impact, because that pairing is what\n275\t       a real operator caught by surprise does. It rides the punch's own\n276\t       decay, so the ease-out needs no clock of its own. */\n277\t    const back = CAMERA.distance + ratio * 1.6 + tuck * CAMERA.tuckPull + airT * AIR_PULL\n278\t      - punch * 0.075;\n279\t    const up = CAMERA.height\n280\t      + (CAMERA.airHeight - CAMERA.height) * airBlend + airT * AIR_LIFT\n281\t      - rider.compression * 0.85\n282\t      - tuck * CAMERA.tuckDrop;\n283\t\n284\t    want.copy(rider.pos).addScaledVector(dir, -back);\n285\t    want.y = rider.pos.y + up;\n286\t\n287\t    /* Never let the hill come between the camera and the rider — and never\n288\t       let it shove the camera up a wall to manage it either.\n289\t\n290\t       The measurement that makes this work is `aboveSlope`: how far the\n291\t       ground stands over the tangent plane the rider is on, which is\n292\t       exactly what `rider.normal` describes. Measuring against the *rider*\n293\t       instead would be useless, because the camera sits behind the rider and\n294\t       behind is uphill: on a 25° pitch the ground under the chase position is\n295\t       nearly four metres higher than the rider, and it should be, and the\n296\t       camera should ride up with it. Measured against the plane that same\n297\t       pitch is zero, a mogul is under a metre, and a quarterpipe is six —\n298\t       which is the only distinction that was ever wanted here.\n299\t\n300\t       Past the allowance the boom comes in rather than climbing, walked back\n301\t       in a few steps exactly like the sightline test below. Pulling in keeps\n302\t       the rider the same size on screen; climbing turns them into a dot in\n303\t       the bottom of a bowl. */\n304\t    const ny = Math.max(0.25, rider.normal.y);\n305\t    if (aboveSlope(world, rider, ny, want.x, want.z) > CLIMB) {\n306\t      /* Coarse walk to bracket the wall, then a short bisection to place\n307\t         its boundary continuously — the same refinement the tree sightline\n308\t         already earned. Using the coarse sample alone stepped the boom in\n309\t         visible 19% jumps as a quarterpipe rose behind the rider. */\n310\t      let clear = 0.3;\n311\t      let blocked = 1.0;\n312\t      for (let t = 0.86; t >= 0.29; t -= 0.19) {\n313\t        const cx = rider.pos.x + (want.x - rider.pos.x) * t;\n314\t        const cz = rider.pos.z + (want.z - rider.pos.z) * t;\n315\t        if (aboveSlope(world, rider, ny, cx, cz) <= CLIMB) { clear = t; break; }\n316\t        blocked = t;\n317\t      }\n318\t      for (let j = 0; j < 4; j++) {\n319\t        const mid = (clear + blocked) * 0.5;\n320\t        const cx = rider.pos.x + (want.x - rider.pos.x) * mid;\n321\t        const cz = rider.pos.z + (want.z - rider.pos.z) * mid;\n322\t        if (aboveSlope(world, rider, ny, cx, cz) <= CLIMB) clear = mid;\n323\t        else blocked = mid;\n324\t      }\n325\t      want.x = rider.pos.x + (want.x - rider.pos.x) * clear;\n326\t      want.z = rider.pos.z + (want.z - rider.pos.z) * clear;\n327\t    }\n328\t\n329\t    /* A tree changes boom length, never bearing. The former can be damped;\n330\t       the latter was previously chosen from several discrete orbit angles,\n331\t       and a single clearance threshold could therefore throw the camera\n332\t       seventy degrees sideways in one frame. Pull in promptly, release more\n333\t       slowly, and let the ordinary chase spring carry both transitions. */\n334\t    /* One pass over the solids for the whole boom, instead of one per\n335\t       probe. See `beginBlockedSpan` in main.js — the shortlist is a\n336\t       conservative superset, so the answer is unchanged. */\n337\t    if (world.beginBlockedSpan) {\n338\t      world.beginBlockedSpan(rider.pos.x, rider.pos.z, want.x, want.z,\n339\t        TREE_LENS_RADIUS);\n340\t    }\n341\t    const treeLimit = treeClearFraction(world, rider, want);\n342\t    if (world.endBlockedSpan) world.endBlockedSpan();\n343\t    if (!started) {\n344\t      treeBoom = treeLimit;\n345\t    } else {\n346\t      const rate = treeLimit < treeBoom ? TREE_PULL_RATE : TREE_RELEASE_RATE;\n347\t      treeBoom += (treeLimit - treeBoom) * (1 - Math.exp(-rate * dt));\n348\t    }\n349\t    shortenBoom(world, rider, want, treeBoom);\n350\t\n351\t    const floor = world.height(want.x, want.z) + FLOOR;\n352\t    if (want.y < floor) want.y = floor;\n353\t\n354\t    wantLook.copy(rider.pos)\n355\t      .addScaledVector(dir, CAMERA.lookAhead * (0.6 + 0.4 * ratio) + airT * AIR_REACH);\n356\t    // In the air the look point sinks towards the snow the rider is falling\n357\t    // at — partly with the flight, and partly with how fast they are coming\n358\t    // down, so a long float looks ahead and a plummet looks under itself\n359\t    const drop = airBlend * (1.2 + sinkMem) + airT * AIR_SINK;\n360\t    wantLook.y = rider.pos.y + 1.1 - drop;\n361\t\n362\t    if (!started) {\n363\t      started = true;\n364\t      at.copy(want);\n365\t      look.copy(wantLook);\n366\t    }\n367\t\n368\t    const baseLag = CAMERA.lag + (CAMERA.airLag - CAMERA.lag) * airBlend;\n369\t    const followError = CAMERA.maxFollowError\n370\t      + (CAMERA.maxAirFollowError - CAMERA.maxFollowError) * airBlend;\n371\t    // A first-order chase trails steady motion by roughly speed / lag. Near\n372\t    // the 250 m/s flow cap a fixed response would put the camera far behind\n373\t    // the rider. The ordinary range keeps its tuned\n374\t    // spring; only extreme speed raises the response enough to bound that\n375\t    // additional separation.\n376\t    const lag = Math.max(baseLag, speed / followError);\n377\t    const k = 1 - Math.exp(-lag * dt);\n378\t    at.lerp(want, k);\n379\t    look.lerp(wantLook, 1 - Math.exp(-(lag + 2) * dt));\n380\t\n381\t    /* Keep a collision-shortened camera aimed at the subject rather than at\n382\t       the downhill point chosen for a full-length boom. The smoothstep makes\n383\t       both ends of the correction continuous, and the existing look lag\n384\t       eases back to normal framing once the obstruction clears. */\n385\t    const liveBack = Math.hypot(at.x - rider.pos.x, at.z - rider.pos.z);\n386\t    let shortLook = 1 - clamp(\n387\t      (liveBack / Math.max(0.001, back) - SHORT_LOOK_FULL)\n388\t        / (SHORT_LOOK_START - SHORT_LOOK_FULL),\n389\t      0, 1,\n390\t    );\n391\t    if (shortLook > 0) {\n392\t      shortLook = shortLook * shortLook * (3 - 2 * shortLook);\n393\t      riderLook.copy(rider.pos);\n394\t      riderLook.y += 1.1;\n395\t      look.lerp(riderLook, shortLook);\n396\t    }\n397\t\n398\t    // --- shake ------------------------------------------------------------\n399\t    // Two sources, both earned: the ground chattering under the board at\n400\t    // speed, and whatever just hit the rider. Neither happens in the air.\n401\t    const chatter = rider.state === 'fall'\n402\t      ? 0\n403\t      : (1 - airBlend) * ratio * ratio * CAMERA.shake * (0.5 + 0.5 * rider.carveLoad);\n404\t    shake = Math.max(0, shake - dt * 4.5);\n405\t    const amp = (chatter + shake) * 0.06;\n406\t    seed += dt * 47;\n407\t    const sx = Math.sin(seed * 1.7) * Math.sin(seed * 0.53);\n408\t    const sy = Math.sin(seed * 2.3 + 1.3) * Math.sin(seed * 0.71);\n409\t\n410\t    camera.position.copy(at);\n411\t    camera.position.x += sx * amp;\n412\t    camera.position.y += sy * amp;\n413\t    // The desired boom can be clear while its smoothed path crosses a bank.\n414\t    // Keep the actual lens above that path too, including landing shake.\n415\t    camera.position.y = Math.max(camera.position.y,\n416\t      world.height(camera.position.x, camera.position.z) + FLOOR);\n417\t    camera.lookAt(look);\n418\t\n419\t    /* How much the ground under the board tilts across the frame: the\n420\t       surface normal against the camera's own right-hand axis, which for a\n421\t       horizontal forward vector f is (-f.z, 0, f.x). One on a vertical wall,\n422\t       zero straight down a fall line, and a tenth or so over a mogul — which\n423\t       is why the dead zone is there. It is held at zero in the air, where\n424\t       `rider.normal` is a memory of the lip rather than a report on the\n425\t       ground, and eased at all times so a quarterpipe arrives rather than\n426\t       snaps. */\n427\t    const tilt = (1 - airBlend)\n428\t      * (rider.normal.z * dir.x - rider.normal.x * dir.z);\n429\t    const graded = Math.sign(tilt) * Math.max(0, Math.abs(tilt) - BANK_DEAD) / (1 - BANK_DEAD);\n430\t    bank += (graded - bank) * (1 - Math.exp(-BANK_RATE * dt));\n431\t\n432\t    // Roll the frame a little into the carve, and a little onto the wall.\n433\t    // Small — past about ten degrees it stops reading as lean and starts\n434\t    // reading as a broken horizon. A tumble is not a carve: `rider.roll` is\n435\t    // only written by riding and flying, so through a fall it holds the last\n436\t    // carve's lean, and the frame stayed banked for the whole wipeout.\n437\t    const carveRoll = rider.state === 'fall' || rider.state === 'rise' ? 0 : rider.roll;\n438\t    const wantRoll = -carveRoll * CAMERA.roll\n439\t      - clamp(bank * BANK_SHARE, -BANK_MAX, BANK_MAX)\n440\t      + sx * amp * 0.06;\n441\t    roll += (wantRoll - roll) * (1 - Math.exp(-5 * dt));\n442\t    camera.rotateZ(roll);\n443\t\n444\t    // Speed opens the lens for parallax while the post stack darkens only the\n445\t    // periphery. The small tuck correction holds the over-the-shoulder focus\n446\t    // without collapsing back into the old telephoto view. A long flight opens\n447\t    // out again to keep the landing in view, and a hard touchdown still gets\n448\t    // its brief lens punch.\n449\t    const wantFov = RENDER.fov\n450\t      + (RENDER.fovAtSpeed - RENDER.fov) * ratio * ratio\n451\t      + tuck * CAMERA.tuckFov\n452\t      + airBlend * -3 + airT * AIR_FOV;\n453\t    fov += (wantFov - fov) * (1 - Math.exp(-3.5 * dt));\n454\t    punch *= Math.exp(-CAMERA.landFovDecay * dt);\n455\t    if (punch < 0.02) punch = 0;\n456\t    /* Terrain or foliage can shorten the horizontal boom. On a portrait\n457\t       frame that close view needs a little more vertical room; keep the\n458\t       compensation modest and bounded, exactly zero by a near-square aspect,\n459\t       so collision response never turns into a second zoom event. */\n460\t    const portrait = clamp(\n461\t      (SHORT_PORTRAIT_WIDE - camera.aspect) / SHORT_PORTRAIT_RANGE,\n462\t      0, 1,\n463\t    );\n464\t    const shown = Math.min(\n465\t      SHORT_PORTRAIT_FOV_MAX,\n466\t      fov + punch + shortLook * portrait * SHORT_PORTRAIT_FOV,\n467\t    );\n468\t    if (Math.abs(camera.fov - shown) > 0.01) {\n469\t      camera.fov = shown;\n470\t      camera.updateProjectionMatrix();\n471\t    }\n472\t  }\n473\t\n474\t  function reset() {\n475\t    started = false;\n476\t    shake = 0;\n477\t    fov = RENDER.fov;\n478\t    punch = 0;\n479\t    roll = 0;\n480\t    bank = 0;\n481\t    treeBoom = 1;\n482\t    airBlend = 0;\n483\t    hangMem = 0;\n484\t    sinkMem = 0;\n485\t  }\n486\t\n487\t  return { update, kick, land, reset, get shake() { return shake; } };\n488\t}\n489\t"}]},"uuid":"865e8889-525d-401c-9495-08cad32c0c67","timestamp":"2026-09-24T20:00:26.468Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/camera.js","content":"/* The chase camera, which is most of what the player actually feels.\n\n   Three ideas hold it together.\n\n   It follows where the rider is *going*, not where the board is pointing.\n   When the edge lets go and the board swings sideways, the camera stays\n   behind the direction of travel — so you watch your own board slide out in\n   front of you, which is the single most legible way to show a drift.\n\n   It rides the rider's suspension. The camera's height is tied to the leg\n   spring, so a landing drops it and lets it back up, and a hard carve squats\n   it. The screen moves because the rider's body moved, not because a shake\n   was scheduled.\n\n   And it lags with a spring rather than a lerp, so it overshoots slightly on\n   a direction change and settles — which reads as weight. A lerp reads as a\n   camera on a stick.\n\n   Three things have been added since, all of them because the mountain and\n   the rider changed underneath it.\n\n   A landing punches the frame open. The legs were already taking the hit and\n   the shake was already firing, but the lens said nothing, and a landing is\n   the loudest moment the game has. The punch is deliberately applied *after*\n   the field of view has been smoothed rather than to the value being smoothed\n   towards: a target that takes three tenths of a second to reach is a zoom,\n   not a punch.\n\n   The air frame grows with the flight. A jump used to be over inside a\n   second and a camera that sat a little further back covered it. Hang time is\n   roughly double what it was, and over two seconds the old framing put the\n   rider dead centre with the landing somewhere below the bottom edge — which\n   is precisely the information they need and precisely what they could not\n   see. So the boom keeps extending, the camera keeps lifting, and the look\n   point keeps sinking towards the ground for as long as the rider is off it.\n\n   And the floor is no longer one sample and one clamp. That was fine while\n   the ground beside the piste was flat; it is now walled with quarterpipes\n   that riders are meant to ride up, and coming back down one the chase\n   position sits *up the wall behind the rider*, where a clamp lifted the\n   camera over the lip to look down at a rider who had become a dot in the\n   bottom of a bowl. The wall is now treated the way a tree already was:\n   shorten the boom rather than climb, because pulling in keeps the rider the\n   same size on screen and climbing does not. */\n\nimport { CAMERA, RENDER, RIDER } from './config.js';\n\nconst clamp = (v, a, b) => (v < a ? a : v > b ? b : v);\n\n/* How far the ground at (x, z) stands above the tangent plane the rider is\n   standing on — the plane through `rider.pos` with `rider.normal` as its\n   normal. Zero on an open pitch however steep it is, a metre or so over a\n   mogul field, and metres up the side of anything built. It is a free\n   function rather than a closure over the frame so the camera can ask it\n   half a dozen times a frame without allocating anything. */\nconst aboveSlope = (world, rider, ny, x, z) => world.height(x, z) - rider.pos.y\n  + (rider.normal.x * (x - rider.pos.x) + rider.normal.z * (z - rider.pos.z)) / ny;\n\n/* The air frame, written here rather than in config because none of it is a\n   new idea — it is the shape of `airHeight` and `lookAhead` over a long\n   flight, and it only means anything next to the values it modifies. */\nconst AIR_OPEN = 1.5;     // seconds of hang over which the air frame opens fully\nconst AIR_PULL = 3.6;     // extra metres of boom at full opening\nconst AIR_LIFT = 1.8;     // and of height\nconst AIR_REACH = 4.5;    // metres further ahead the look point is thrown\nconst AIR_SINK = 2.9;     // and how far it drops towards the landing\nconst AIR_FOV = 5;        // degrees the frame opens back up over a long flight\n\n/* How much of the ground's own bank the frame takes on.\n\n   The share is small and the cap is smaller, because a rolled frame stops\n   reading as a bank and starts reading as a broken horizon somewhere around\n   twelve degrees. The dead zone is what keeps the piste steady: a mogul face\n   is a few degrees of tilt and it is not a bank, and without the dead zone\n   every roller in the run wobbled the horizon.\n\n   Note where the sign comes from. The carve roll below is expressed in the\n   rider's own lean, and this is not: it is the ground's normal measured\n   against the camera's own right-hand axis, so the frame tips towards the\n   hill it is actually looking at rather than towards whichever way a\n   convention happens to point. */\nconst BANK_SHARE = 0.34;\nconst BANK_DEAD = 0.13;   // sine of the tilt below which the ground is just lumpy\nconst BANK_MAX = 0.20;    // radians ≈ 11°\nconst BANK_RATE = 4.0;    // per second — a wall arrives, it does not snap\n\nconst FLOOR = 1.5;        // metres of clearance the camera keeps over the snow\n// How far the ground behind the rider may stand above the slope the rider is\n// on before the camera stops trying to sit on top of it. Two and a half\n// metres covers every roller, mogul and cliff lip the generator makes; a\n// quarterpipe is more than twice it, and a tree is not the camera's problem\n// here because trees are handled by the sightline walk.\nconst CLIMB = 2.6;\n\n/* When collision pulls the live boom right in, its independently smoothed\n   look point cannot stay several metres down-course: on a portrait frame that\n   aims past the rider altogether. Normal framing is untouched above START;\n   below FULL the only honest composition is to look at the rider until the\n   boom has room to open again. */\nconst SHORT_LOOK_START = 0.72;\nconst SHORT_LOOK_FULL = 0.55;\nconst SHORT_PORTRAIT_FOV = 16;\nconst SHORT_PORTRAIT_FOV_MAX = 82;\nconst SHORT_PORTRAIT_WIDE = 1.1;\nconst SHORT_PORTRAIT_RANGE = 0.6;\nconst TREE_MIN_BOOM = 0.30;\nconst TREE_SUBJECT_START = 0.34;\nconst TREE_SUBJECT_RESCAN = 0.58;\nconst TREE_SAMPLE_STEP = 0.075;\nconst TREE_GUARD = 0.035;\nconst TREE_NEAR_RADIUS = 0.7;\nconst TREE_LENS_RADIUS = 4.4;\nconst TREE_PULL_RATE = 18;\nconst TREE_RELEASE_RATE = 3.2;\n\n/* How much of the boom is clear along one bearing.\n\n   `world.blocked` reports trunk circles, but the lens has to stay out of the\n   much wider crown. The clearance therefore grows from a small subject-side\n   margin to a foliage-sized lens margin. A coarse walk finds the first hit,\n   then a short binary search places its boundary continuously; using the\n   coarse sample itself is what made the old camera change distance in visible\n   steps as a tree crossed the sightline. */\n/* A free function rather than a closure over the frame — the same rule\n   `aboveSlope` follows and for the same reason: the walk below asks this up\n   to fourteen times a frame, and a fresh closure per frame is exactly the\n   steady GC churn the rest of the file is written to avoid. */\nconst treeBlockedAt = (world, rider, dx, dz, t) => {\n  const cx = rider.pos.x + dx * t;\n  const cz = rider.pos.z + dz * t;\n  const near = clamp((t - TREE_SUBJECT_START) / (1 - TREE_SUBJECT_START), 0, 1);\n  const shaped = near * near * (3 - 2 * near);\n  const foliage = TREE_NEAR_RADIUS\n    + shaped * (TREE_LENS_RADIUS - TREE_NEAR_RADIUS);\n  return world.blocked(cx, cz, foliage);\n};\n\nconst treeClearFraction = (world, rider, point) => {\n  if (!world.blocked) return 1;\n\n  const dx = point.x - rider.pos.x;\n  const dz = point.z - rider.pos.z;\n  if (dx * dx + dz * dz < 0.01) return 1;\n\n  let previous = TREE_SUBJECT_START;\n  let wasBlocked = treeBlockedAt(world, rider, dx, dz, previous);\n\n  /* A crown already touching the rider cannot be fixed by moving the camera.\n     Ignore that innermost overlap, but start again soon enough to catch a\n     second tree or the same crown surrounding the lens. */\n  if (wasBlocked) {\n    previous = TREE_SUBJECT_RESCAN;\n    wasBlocked = treeBlockedAt(world, rider, dx, dz, previous);\n    if (wasBlocked) return Math.max(TREE_MIN_BOOM, previous - 0.10);\n  }\n\n  const count = Math.ceil((1 - previous) / TREE_SAMPLE_STEP);\n  let lastClear = previous;\n  for (let i = 1; i <= count; i++) {\n    const t = Math.min(1, previous + i * TREE_SAMPLE_STEP);\n    if (!treeBlockedAt(world, rider, dx, dz, t)) {\n      lastClear = t;\n      continue;\n    }\n\n    let lo = Math.max(TREE_MIN_BOOM, lastClear);\n    let hi = t;\n    for (let j = 0; j < 5; j++) {\n      const mid = (lo + hi) * 0.5;\n      if (treeBlockedAt(world, rider, dx, dz, mid)) hi = mid;\n      else lo = mid;\n    }\n    return Math.max(TREE_MIN_BOOM, lo - TREE_GUARD);\n  }\n  return 1;\n};\n\nconst shortenBoom = (world, rider, point, fraction) => {\n  if (fraction >= 0.999) return;\n  point.x = rider.pos.x + (point.x - rider.pos.x) * fraction;\n  point.z = rider.pos.z + (point.z - rider.pos.z) * fraction;\n  point.y = Math.max(point.y, world.height(point.x, point.z) + FLOOR);\n};\n\nexport function createChaseCamera(THREE, camera) {\n  const at = new THREE.Vector3();\n  const look = new THREE.Vector3();\n  const want = new THREE.Vector3();\n  const wantLook = new THREE.Vector3();\n  const dir = new THREE.Vector3();\n  const flat = new THREE.Vector3();\n  const tmp = new THREE.Vector3();\n  const riderLook = new THREE.Vector3();\n\n  let started = false;\n  let shake = 0;\n  let fov = RENDER.fov;\n  let punch = 0;\n  let roll = 0;\n  let bank = 0;\n  let seed = 0;\n  let treeBoom = 1;\n  /* The air frame's own crossfade. `rider.state` flips in one physics step,\n     and everything the boolean used to gate — boom, height, look sink, lag,\n     lens, bank, chatter — changed target in the same frame, which read as\n     the camera catching on something at every touchdown. The blend eases\n     in fast enough to open with a real jump and out slow enough that a\n     landing settles instead of snapping; the two memories hold the flight's\n     last opening and sink so the descent of the frame is from where the\n     flight actually left it, not from a target that collapsed to zero the\n     moment `airTime` reset. */\n  let airBlend = 0;\n  let hangMem = 0;\n  let sinkMem = 0;\n\n  function kick(amount) {\n    shake = Math.min(2.4, shake + amount);\n  }\n\n  /* The visual half of the thump the legs are already taking. Weighed\n     against `softImpact`, which is the physics' own idea of a landing that\n     has stopped being free — so the frame and the body agree about what a\n     heavy landing is instead of each having a private opinion. */\n  function land(impact) {\n    const w = Math.min(1, impact / (RIDER.softImpact * 1.4));\n    punch = Math.min(CAMERA.landFov * 1.3, punch + CAMERA.landFov * w);\n    kick(Math.min(1.8, impact * 0.09));\n  }\n\n  function update(rider, dt, world) {\n    const speed = rider.speed;\n    const ratio = clamp(speed / 42, 0, 1);\n    // A flight, not merely an absence of ground: a wipeout also leaves the\n    // ground, and framing the tumble with the flight's opened boom and lens\n    // made every crash look like a soaring air.\n    const air = rider.state === 'air';\n    const tuck = rider.tucking ? 1 : 0;\n    airBlend += ((air ? 1 : 0) - airBlend)\n      * (1 - Math.exp(-(air ? 9 : 6.5) * dt));\n    if (airBlend < 0.002) airBlend = 0;\n    // Eased rather than linear, so the frame opens promptly off a small\n    // roller and still has somewhere left to go through a long flight\n    if (air) {\n      const hang = clamp(rider.airTime / AIR_OPEN, 0, 1);\n      hangMem = hang * (2 - hang);\n      sinkMem = Math.min(2.0, Math.max(0, -rider.vel.y) * 0.11);\n    }\n    const airT = airBlend * hangMem;\n\n    // Which way the run is actually heading: mostly the velocity, a little\n    // the board. Pure velocity swims about at low speed; pure heading hides\n    // every slide the rider makes — so trust in the velocity fades in over\n    // 1.5–3.5 m/s instead of switching at 3. The hard switch sat exactly in\n    // the band where board and travel diverge most, and crossing it during\n    // a scrubbing stop swung the whole frame one way and back in two steps.\n    const stanceYaw = rider.yaw - (rider.switchStance ? Math.PI : 0);\n    flat.set(rider.vel.x, 0, rider.vel.z);\n    const travel = flat.length();\n    tmp.set(Math.sin(stanceYaw), 0, -Math.cos(stanceYaw));\n    if (travel < 1e-4) {\n      flat.copy(tmp);\n    } else {\n      const trust = clamp((travel - 1.5) / 2, 0, 1);\n      flat.multiplyScalar(1 / travel).lerp(tmp, 1 - trust).normalize();\n    }\n    // In flight the board may spin several times while its landing line\n    // stays fixed. Remove its steering influence as the air frame opens.\n    const velocityBias = CAMERA.velocityBias + (1 - CAMERA.velocityBias) * airBlend;\n    dir.copy(flat).multiplyScalar(velocityBias)\n      .addScaledVector(tmp, 1 - velocityBias).normalize();\n\n    /* The punch also pulls the boom in a fraction. Widening the lens alone\n       reads as a lens event; a lens that widens *while the camera lunges\n       half a metre closer* reads as an impact, because that pairing is what\n       a real operator caught by surprise does. It rides the punch's own\n       decay, so the ease-out needs no clock of its own. */\n    const back = CAMERA.distance + ratio * 1.6 + tuck * CAMERA.tuckPull + airT * AIR_PULL\n      - punch * 0.075;\n    const up = CAMERA.height\n      + (CAMERA.airHeight - CAMERA.height) * airBlend + airT * AIR_LIFT\n      - rider.compression * 0.85\n      - tuck * CAMERA.tuckDrop;\n\n    want.copy(rider.pos).addScaledVector(dir, -back);\n    want.y = rider.pos.y + up;\n\n    /* Never let the hill come between the camera and the rider — and never\n       let it shove the camera up a wall to manage it either.\n\n       The measurement that makes this work is `aboveSlope`: how far the\n       ground stands over the tangent plane the rider is on, which is\n       exactly what `rider.normal` describes. Measuring against the *rider*\n       instead would be useless, because the camera sits behind the rider and\n       behind is uphill: on a 25° pitch the ground under the chase position is\n       nearly four metres higher than the rider, and it should be, and the\n       camera should ride up with it. Measured against the plane that same\n       pitch is zero, a mogul is under a metre, and a quarterpipe is six —\n       which is the only distinction that was ever wanted here.\n\n       Past the allowance the boom comes in rather than climbing, walked back\n       in a few steps exactly like the sightline test below. Pulling in keeps\n       the rider the same size on screen; climbing turns them into a dot in\n       the bottom of a bowl. */\n    const ny = Math.max(0.25, rider.normal.y);\n    if (aboveSlope(world, rider, ny, want.x, want.z) > CLIMB) {\n      /* Coarse walk to bracket the wall, then a short bisection to place\n         its boundary continuously — the same refinement the tree sightline\n         already earned. Using the coarse sample alone stepped the boom in\n         visible 19% jumps as a quarterpipe rose behind the rider. */\n      let clear = 0.3;\n      let blocked = 1.0;\n      for (let t = 0.86; t >= 0.29; t -= 0.19) {\n        const cx = rider.pos.x + (want.x - rider.pos.x) * t;\n        const cz = rider.pos.z + (want.z - rider.pos.z) * t;\n        if (aboveSlope(world, rider, ny, cx, cz) <= CLIMB) { clear = t; break; }\n        blocked = t;\n      }\n      for (let j = 0; j < 4; j++) {\n        const mid = (clear + blocked) * 0.5;\n        const cx = rider.pos.x + (want.x - rider.pos.x) * mid;\n        const cz = rider.pos.z + (want.z - rider.pos.z) * mid;\n        if (aboveSlope(world, rider, ny, cx, cz) <= CLIMB) clear = mid;\n        else blocked = mid;\n      }\n      want.x = rider.pos.x + (want.x - rider.pos.x) * clear;\n      want.z = rider.pos.z + (want.z - rider.pos.z) * clear;\n    }\n\n    /* A tree changes boom length, never bearing. The former can be damped;\n       the latter was previously chosen from several discrete orbit angles,\n       and a single clearance threshold could therefore throw the camera\n       seventy degrees sideways in one frame. Pull in promptly, release more\n       slowly, and let the ordinary chase spring carry both transitions. */\n    /* One pass over the solids for the whole boom, instead of one per\n       probe. See `beginBlockedSpan` in main.js — the shortlist is a\n       conservative superset, so the answer is unchanged. */\n    if (world.beginBlockedSpan) {\n      world.beginBlockedSpan(rider.pos.x, rider.pos.z, want.x, want.z,\n        TREE_LENS_RADIUS);\n    }\n    const treeLimit = treeClearFraction(world, rider, want);\n    if (world.endBlockedSpan) world.endBlockedSpan();\n    if (!started) {\n      treeBoom = treeLimit;\n    } else {\n      const rate = treeLimit < treeBoom ? TREE_PULL_RATE : TREE_RELEASE_RATE;\n      treeBoom += (treeLimit - treeBoom) * (1 - Math.exp(-rate * dt));\n    }\n    shortenBoom(world, rider, want, treeBoom);\n\n    const floor = world.height(want.x, want.z) + FLOOR;\n    if (want.y < floor) want.y = floor;\n\n    wantLook.copy(rider.pos)\n      .addScaledVector(dir, CAMERA.lookAhead * (0.6 + 0.4 * ratio) + airT * AIR_REACH);\n    // In the air the look point sinks towards the snow the rider is falling\n    // at — partly with the flight, and partly with how fast they are coming\n    // down, so a long float looks ahead and a plummet looks under itself\n    const drop = airBlend * (1.2 + sinkMem) + airT * AIR_SINK;\n    wantLook.y = rider.pos.y + 1.1 - drop;\n\n    if (!started) {\n      started = true;\n      at.copy(want);\n      look.copy(wantLook);\n    }\n\n    const baseLag = CAMERA.lag + (CAMERA.airLag - CAMERA.lag) * airBlend;\n    const followError = CAMERA.maxFollowError\n      + (CAMERA.maxAirFollowError - CAMERA.maxFollowError) * airBlend;\n    // A first-order chase trails steady motion by roughly speed / lag. Near\n    // the 250 m/s flow cap a fixed response would put the camera far behind\n    // the rider. The ordinary range keeps its tuned\n    // spring; only extreme speed raises the response enough to bound that\n    // additional separation.\n    const lag = Math.max(baseLag, speed / followError);\n    const k = 1 - Math.exp(-lag * dt);\n    at.lerp(want, k);\n    look.lerp(wantLook, 1 - Math.exp(-(lag + 2) * dt));\n\n    /* Keep a collision-shortened camera aimed at the subject rather than at\n       the downhill point chosen for a full-length boom. The smoothstep makes\n       both ends of the correction continuous, and the existing look lag\n       eases back to normal framing once the obstruction clears. */\n    const liveBack = Math.hypot(at.x - rider.pos.x, at.z - rider.pos.z);\n    let shortLook = 1 - clamp(\n      (liveBack / Math.max(0.001, back) - SHORT_LOOK_FULL)\n        / (SHORT_LOOK_START - SHORT_LOOK_FULL),\n      0, 1,\n    );\n    if (shortLook > 0) {\n      shortLook = shortLook * shortLook * (3 - 2 * shortLook);\n      riderLook.copy(rider.pos);\n      riderLook.y += 1.1;\n      look.lerp(riderLook, shortLook);\n    }\n\n    // --- shake ------------------------------------------------------------\n    // Two sources, both earned: the ground chattering under the board at\n    // speed, and whatever just hit the rider. Neither happens in the air.\n    const chatter = rider.state === 'fall'\n      ? 0\n      : (1 - airBlend) * ratio * ratio * CAMERA.shake * (0.5 + 0.5 * rider.carveLoad);\n    shake = Math.max(0, shake - dt * 4.5);\n    const amp = (chatter + shake) * 0.06;\n    seed += dt * 47;\n    const sx = Math.sin(seed * 1.7) * Math.sin(seed * 0.53);\n    const sy = Math.sin(seed * 2.3 + 1.3) * Math.sin(seed * 0.71);\n\n    camera.position.copy(at);\n    camera.position.x += sx * amp;\n    camera.position.y += sy * amp;\n    // The desired boom can be clear while its smoothed path crosses a bank.\n    // Keep the actual lens above that path too, including landing shake.\n    camera.position.y = Math.max(camera.position.y,\n      world.height(camera.position.x, camera.position.z) + FLOOR);\n    camera.lookAt(look);\n\n    /* How much the ground under the board tilts across the frame: the\n       surface normal against the camera's own right-hand axis, which for a\n       horizontal forward vector f is (-f.z, 0, f.x). One on a vertical wall,\n       zero straight down a fall line, and a tenth or so over a mogul — which\n       is why the dead zone is there. It is held at zero in the air, where\n       `rider.normal` is a memory of the lip rather than a report on the\n       ground, and eased at all times so a quarterpipe arrives rather than\n       snaps. */\n    const tilt = (1 - airBlend)\n      * (rider.normal.z * dir.x - rider.normal.x * dir.z);\n    const graded = Math.sign(tilt) * Math.max(0, Math.abs(tilt) - BANK_DEAD) / (1 - BANK_DEAD);\n    bank += (graded - bank) * (1 - Math.exp(-BANK_RATE * dt));\n\n    // Roll the frame a little into the carve, and a little onto the wall.\n    // Small — past about ten degrees it stops reading as lean and starts\n    // reading as a broken horizon. A tumble is not a carve: `rider.roll` is\n    // only written by riding and flying, so through a fall it holds the last\n    // carve's lean, and the frame stayed banked for the whole wipeout.\n    const carveRoll = rider.state === 'fall' || rider.state === 'rise' ? 0 : rider.roll;\n    const wantRoll = -carveRoll * CAMERA.roll\n      - clamp(bank * BANK_SHARE, -BANK_MAX, BANK_MAX)\n      + sx * amp * 0.06;\n    roll += (wantRoll - roll) * (1 - Math.exp(-5 * dt));\n    camera.rotateZ(roll);\n\n    // Speed opens the lens for parallax while the post stack darkens only the\n    // periphery. The small tuck correction holds the over-the-shoulder focus\n    // without collapsing back into the old telephoto view. A long flight opens\n    // out again to keep the landing in view, and a hard touchdown still gets\n    // its brief lens punch.\n    const wantFov = RENDER.fov\n      + (RENDER.fovAtSpeed - RENDER.fov) * ratio * ratio\n      + tuck * CAMERA.tuckFov\n      + airBlend * -3 + airT * AIR_FOV;\n    fov += (wantFov - fov) * (1 - Math.exp(-3.5 * dt));\n    punch *= Math.exp(-CAMERA.landFovDecay * dt);\n    if (punch < 0.02) punch = 0;\n    /* Terrain or foliage can shorten the horizontal boom. On a portrait\n       frame that close view needs a little more vertical room; keep the\n       compensation modest and bounded, exactly zero by a near-square aspect,\n       so collision response never turns into a second zoom event. */\n    const portrait = clamp(\n      (SHORT_PORTRAIT_WIDE - camera.aspect) / SHORT_PORTRAIT_RANGE,\n      0, 1,\n    );\n    const shown = Math.min(\n      SHORT_PORTRAIT_FOV_MAX,\n      fov + punch + shortLook * portrait * SHORT_PORTRAIT_FOV,\n    );\n    if (Math.abs(camera.fov - shown) > 0.01) {\n      camera.fov = shown;\n      camera.updateProjectionMatrix();\n    }\n  }\n\n  function reset() {\n    started = false;\n    shake = 0;\n    fov = RENDER.fov;\n    punch = 0;\n    roll = 0;\n    bank = 0;\n    treeBoom = 1;\n    airBlend = 0;\n    hangMem = 0;\n    sinkMem = 0;\n  }\n\n  return { update, kick, land, reset, get shake() { return shake; } };\n}\n","numLines":489,"startLine":1,"totalLines":489}},"sourceToolAssistantUUID":"78d6472e-b4c0-4b37-b266-af259e674fbf","userType":"external","entrypoint":"claude-vscode","cwd":"REDACTED","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
