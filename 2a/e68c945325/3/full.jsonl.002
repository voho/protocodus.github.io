{"parentUuid":"c2926ef6-e46d-4d65-ac00-f5b6efe6c6b5","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfNrJzcqWxJChySHVCeoY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DwfvTejGnenzE2u4DwECos","name":"Read","input":{"file_path":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","offset":1400,"limit":520},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11674,"cache_read_input_tokens":266428,"output_tokens":126,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":11674,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":126,"cache_read_input_tokens":266428,"cache_creation_input_tokens":11674,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11674},"type":"message"}],"speed":"standard"},"input_transformations":[{"type":"thinking_dropped","path":"messages.2.content.0","reason":"prefix_binding_mismatch"}],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01DwfvTejGnenzE2u4DwECos":{"file_path":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","offset":1400,"limit":520}},"apiBlockIndex":0,"requestId":"req_011CfNrJrwynAhdWJTsXw31y","type":"assistant","uuid":"5fbf10c2-88ea-4aed-8f1a-1cfe16f44fa9","timestamp":"2026-09-24T19:54:34.007Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/vojta/Dev/protocodus.github.io/fun/alpen","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
{"parentUuid":"5fbf10c2-88ea-4aed-8f1a-1cfe16f44fa9","isSidechain":false,"promptId":"c41cd6de-57c3-441a-96f7-ed621873bfe7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DwfvTejGnenzE2u4DwECos","type":"tool_result","content":"1400\t       1 m/s of vertical and the jump was smaller than a walking pace one.\n1401\t\n1402\t       Sampling the integration step as well as the longer horizon fixes it.\n1403\t       The rest of the sweep is spaced in metres, not in four increasingly\n1404\t       long time slices, so a fast rider cannot step over a patch of support\n1405\t       between samples. While any point on the near path still stands above\n1406\t       the ballistic arc, the hill blocks release. An unmarked natural roller\n1407\t       must then remain clear for part of a board length; a detected kicker or\n1408\t       cliff edge already has that proof and releases directly. */\n1409\t    const HZ = 0.09;\n1410\t    let clearance = -Infinity;\n1411\t    let blocked = false;\n1412\t    let clearRun = 0;\n1413\t    let longestClearRun = 0;\n1414\t    const startT = Math.min(dt, HZ);\n1415\t    const sweepLength = horizontalSpeed * Math.max(0, HZ - startT);\n1416\t    const segments = Math.min(\n1417\t      RIDER.launchSampleMax,\n1418\t      Math.max(3, Math.ceil(sweepLength / RIDER.launchSampleSpacing)),\n1419\t    );\n1420\t    let previousDistance = horizontalSpeed * startT;\n1421\t    for (let k = 0; k <= segments; k++) {\n1422\t      const t = startT + (HZ - startT) * (k / segments);\n1423\t      const distance = horizontalSpeed * t;\n1424\t      const ground = this.world.height(pos.x + vel.x * t, pos.z + vel.z * t);\n1425\t      const ballistic = pos.y + predictorVy * t - 0.5 * RIDER.gravity * t * t;\n1426\t      const gap = ballistic - ground;\n1427\t      if (gap > clearance) clearance = gap;\n1428\t      /* Nothing after this point can change the answer. Both readers of\n1429\t         this sweep test `!blocked` first — see `launching` below — so once\n1430\t         the ground has come up through the arc, `clearance` and\n1431\t         `longestClearRun` are provably unread and the remaining samples are\n1432\t         world height lookups nobody asks about. On the groomed ribbon that\n1433\t         is the whole loop collapsing at the first sample. */\n1434\t      if (gap < -RIDER.launchObstruction) { blocked = true; break; }\n1435\t      if (gap > RIDER.launchGap) {\n1436\t        if (k > 0) clearRun += distance - previousDistance;\n1437\t        if (clearRun > longestClearRun) longestClearRun = clearRun;\n1438\t      } else {\n1439\t        clearRun = 0;\n1440\t      }\n1441\t      previousDistance = distance;\n1442\t    }\n1443\t\n1444\t    /* Popping, and popping at the right moment.\n1445\t\n1446\t       The clearance above is read *before* the pop is resolved, which is\n1447\t       what makes the timing bonus possible: it says how close the ground\n1448\t       already is to letting go. A pop released while the hill is on the edge\n1449\t       of launching — the lip of a kicker, the crest of a roller, the top of\n1450\t       a wall — is worth half again as much as the same pop released halfway\n1451\t       up the ramp. It is the one piece of timing the sport actually asks of\n1452\t       you, and the old jump had no opinion about it at all. */\n1453\t    let pop = 0;\n1454\t    this.lipPop = false;\n1455\t    if (!input.jump && (this.charging || this._jumpBuffer > 0)) {\n1456\t      const held = this.charging ? this.charge : this._bufferCharge;\n1457\t      this._jumpBuffer = 0;\n1458\t      pop = RIDER.popMin + (RIDER.popMax - RIDER.popMin) * held;\n1459\t      if (!blocked && clearance > -0.25) {\n1460\t        pop *= RIDER.lipBonus;\n1461\t        this.lipPop = true;\n1462\t      } else if (this.bend > RIDER.pumpFrom) {\n1463\t        /* …or it is a pump, and this is the same extension doing the other\n1464\t           thing legs can do with it.\n1465\t\n1466\t           The condition is the whole idea. The branch above is a lip: the\n1467\t           ground is on the point of letting go, there is nothing left to push\n1468\t           against, and everything the legs have goes into height. Here the\n1469\t           ground is bending the other way — pressing the board into the snow —\n1470\t           and an extension against that load is work done along the direction\n1471\t           of travel, which is speed. A rider crossing a compression is not\n1472\t           jumping out of it; they are standing up through it and coming out\n1473\t           the far side faster, and that is most of what riding terrain is.\n1474\t\n1475\t           The pop is spent rather than added to, so a player cannot have both.\n1476\t           Timing the release to the ground is the skill, and the read-out for\n1477\t           whether they got it right is the speed itself. */\n1478\t        const load = clamp(\n1479\t          (this.bend - RIDER.pumpFrom) / Math.max(1e-3, RIDER.bendMax - RIDER.pumpFrom),\n1480\t          0, 1,\n1481\t        );\n1482\t        const drive = RIDER.pumpSpeed * held * load;\n1483\t        const flat = Math.hypot(vel.x, vel.z);\n1484\t        if (flat > 1e-3 && drive > 0.05) {\n1485\t          vel.x += (vel.x / flat) * drive;\n1486\t          vel.z += (vel.z / flat) * drive;\n1487\t          this.emit('pump', drive);\n1488\t        }\n1489\t        pop = 0;\n1490\t      }\n1491\t      this.charging = false;\n1492\t      this.charge = 0;\n1493\t      this.compressionVel = -14;\n1494\t    }\n1495\t\n1496\t    const requiredSupportLoss = this._contact.edgeAhead\n1497\t      ? 0\n1498\t      : Math.min(\n1499\t        RIDER.launchSupportLength,\n1500\t        sweepLength * RIDER.launchSupportShare,\n1501\t      );\n1502\t    const launching = !blocked && clearance > RIDER.launchGap\n1503\t      && longestClearRun >= requiredSupportLoss && this.grounded;\n1504\t\n1505\t    /* A confirmed release uses the chord entirely behind the board. This is\n1506\t       the last piece of speed scaling: a centred normal straddling a smooth\n1507\t       lip changes with the exact fixed-step crossing point and can make a\n1508\t       slightly faster entry leave at a slightly lower angle. The trailing\n1509\t       tangent cannot look over the edge, so speed alone scales every launch\n1510\t       component. An ollie that is not also a natural release uses the exact\n1511\t       support normal for the same reason. */\n1512\t    const launchNormal = launching\n1513\t      ? trailingNormalFrom(\n1514\t        this.world.height, pos.x, pos.z, vel, this._launchN,\n1515\t      )\n1516\t      : support;\n1517\t    let moveX = vel.x;\n1518\t    let moveY = surfaceVy;\n1519\t    let moveZ = vel.z;\n1520\t    if (launching) {\n1521\t      const launchSpeed = vel.length();\n1522\t      const intoLaunch = vel.dot(launchNormal);\n1523\t      const tx = vel.x - launchNormal.x * intoLaunch;\n1524\t      const ty = vel.y - launchNormal.y * intoLaunch;\n1525\t      const tz = vel.z - launchNormal.z * intoLaunch;\n1526\t      const tangentSpeed = Math.hypot(tx, ty, tz);\n1527\t      if (launchSpeed > 1e-5 && tangentSpeed > 1e-5) {\n1528\t        const scale = launchSpeed / tangentSpeed;\n1529\t        moveX = tx * scale;\n1530\t        moveY = ty * scale;\n1531\t        moveZ = tz * scale;\n1532\t      }\n1533\t    }\n1534\t    pos.x += moveX * dt;\n1535\t    pos.z += moveZ * dt;\n1536\t\n1537\t    if (launching || pop > 0) {\n1538\t      // This step carried the board along the ramp tangent. Continue that\n1539\t      // tangent through the lip instead of moving x/z while leaving y behind;\n1540\t      // the first airborne state is then already separated from the ramp.\n1541\t      pos.y += moveY * dt;\n1542\t      // The configured pop already represents the legs' work. Reading the\n1543\t      // just-reset spring velocity here added 7.7 m/s to every tap.\n1544\t      this.takeOff(pop, launchNormal);\n1545\t    } else {\n1546\t      const gy = this.world.height(pos.x, pos.z);\n1547\t      this.extension = 0;\n1548\t      pos.y = gy;\n1549\t      // This is the tangent's real vertical component, not a launch impulse.\n1550\t      // Capping it would become an indirect total-speed cap on steep terrain\n1551\t      // once the powered tuck reaches extreme velocity.\n1552\t      vel.y = surfaceVy;\n1553\t    }\n1554\t\n1555\t    /* The lean, which is no longer a look.\n1556\t\n1557\t       A rider holding a turn has to incline until the resultant of gravity\n1558\t       and the corner runs down the line of their legs, or they fall over —\n1559\t       so the angle is atan(lateral / g) and there is nothing to choose. It\n1560\t       used to be a constant times the key being pressed, which meant a gentle\n1561\t       turn and a turn at the very edge of traction leaned the same amount and\n1562\t       the body told you nothing. Now the inclination *is* the read-out: lean\n1563\t       and grip are the same number seen from two ends, and a rider laid over\n1564\t       at fifty degrees is a rider with nothing left. It still gets there\n1565\t       late, because a body has mass. */\n1566\t    /* The true balance angle, and how much of it is actually shown.\n1567\t\n1568\t       atan(lateral / g) is what the body has to do to stay up, and at the\n1569\t       limit of grip against this game's 22 m/s² gravity that is fifty\n1570\t       degrees. It is correct and it reads as broken: a rider laid flat over\n1571\t       the snow while the heading comes round at fifteen degrees a second\n1572\t       looks like a man falling sideways down a hill that happens to also be\n1573\t       turning, which is exactly the complaint — \"he leans onto his side and\n1574\t       carries on in the same direction\".\n1575\t\n1576\t       The reason is that a real carve at fifty degrees of inclination is a\n1577\t       fast, tight arc, and this one cannot be, because the turn rate is\n1578\t       capped by grip and the speeds here are arcade. So the lean is shown at\n1579\t       a fraction of the truth: enough to say which way the weight has gone,\n1580\t       not so much that the body is writing a cheque the path does not cash.\n1581\t\n1582\t       Balance is measured against the *shown* angle rather than the true one,\n1583\t       which is not a fudge — it is the only self-consistent choice. Measured\n1584\t       against the true angle the body could never arrive, the mismatch would\n1585\t       be permanent, and the rider would fall over halfway through every\n1586\t       properly-executed carve. */\n1587\t    const need = Math.atan2(carve, RIDER.gravity);\n1588\t    const shown = Math.min(need, RIDER.lean);\n1589\t    const target = -side * shown;\n1590\t\n1591\t    /* …and how far the body is from where it needs to be, which is balance.\n1592\t\n1593\t       Measured before the roll is advanced, so it is the gap the rider is\n1594\t       actually standing in rather than the one they are about to close. The\n1595\t       sign is kept because the two ways of losing it are different events —\n1596\t       positive is the load arriving before the body and trying to throw them\n1597\t       over the outside edge, negative is a body further in than the snow can\n1598\t       hold up — even though for now they cost the same thing. */\n1599\t    /* Smooth the error so a single terrain sample cannot flash the grip.\n1600\t\n1601\t       Balance is feedback and traction, not a second invisible crash test.\n1602\t       A normal edge change holds this filtered error open after the rendered\n1603\t       body has already caught up; the old timer therefore put the rider down\n1604\t       on a mathematically planar slope with zero sideways slide. Low balance\n1605\t       still reduces `gripNow` on the next step, visibly washing the board out\n1606\t       and scrubbing speed. Only readable events — impact, a bad landing or a\n1607\t       true uphill stall — own the fall state. */\n1608\t    // Direction matters here. Comparing magnitudes made a rider leaning hard\n1609\t    // into the old turn look perfectly balanced during an edge change. The\n1610\t    // signed target-to-body gap reaches twice the shown lean in that case, so\n1611\t    // the balance readout and the available grip both reflect the transition.\n1612\t    this.leanErr = approach(this.leanErr, target - this.roll, 5.5, dt);\n1613\t    // At low speed about eight degrees of mismatch is enough to soften the\n1614\t    // edge. Momentum widens only this transient tolerance: it stops a routine\n1615\t    // fast edge change from deleting forty per cent of the grip, while the\n1616\t    // sidecut and surface grip above still own the steady-state turn radius.\n1617\t    const baseBalanceWindow = Math.min(RIDER.balanceWindow, RIDER.lean * 0.25);\n1618\t    const balanceWindow = baseBalanceWindow\n1619\t      * (1 + (RIDER.speedBalanceWindow - 1) * stable);\n1620\t    /* Faded in over 3–5 m/s rather than switched at 4. The old ternary was a\n1621\t       cliff: crossing 4 m/s with an open lean error snapped `balance` from 1\n1622\t       to its true value in one step, and `balanceGrip` turned that into a\n1623\t       forty-per-cent grip step mid-scrub — felt as a twitch in exactly the\n1624\t       slow, deliberate manoeuvre least able to absorb one. */\n1625\t    const balanceIn = clamp((speed - 3) / 2, 0, 1);\n1626\t    this.balance = 1 - balanceIn\n1627\t      * (1 - clamp(1 - Math.abs(this.leanErr) / balanceWindow, 0, 1));\n1628\t\n1629\t    this.roll = approach(this.roll, target, RIDER.leanRate, dt);\n1630\t  }\n1631\t\n1632\t  /* Takeoff is a release, not an impulse invented by the ramp.\n1633\t\n1634\t     Ground contact may have accumulated tiny normal components while gravity,\n1635\t     carving and the height field were integrated. Remove those at the lip,\n1636\t     then restore the exact speed on the surface tangent. The ramp therefore\n1637\t     decides direction and momentum decides magnitude: doubling entry speed\n1638\t     doubles both horizontal and vertical launch velocity.\n1639\t\n1640\t     A deliberate ollie (or the legs unloading naturally) is the only extra\n1641\t     impulse. It points between the board's outward normal and world-up so it\n1642\t     clears both ordinary kickers and steep walls without rewriting the base\n1643\t     tangent launch. */\n1644\t  takeOff(pop, n) {\n1645\t    const launchSpeed = this.vel.length();\n1646\t    const tangent = this._p.copy(this.vel).addScaledVector(n, -this.vel.dot(n));\n1647\t    const tangentSpeed = tangent.length();\n1648\t    if (launchSpeed > 1e-5 && tangentSpeed > 1e-5) {\n1649\t      this.vel.copy(tangent).multiplyScalar(launchSpeed / tangentSpeed);\n1650\t    }\n1651\t\n1652\t    const p = this._p.copy(n).add(this.UP).normalize();\n1653\t    this.grounded = false;\n1654\t    this.state = 'air';\n1655\t    // The gradient the bend is differentiating is only meaningful across two\n1656\t    // consecutive steps on the same surface. Every departure from the snow\n1657\t    // breaks that chain, and a stale one comes back as a curvature spike the\n1658\t    // width of a lip.\n1659\t    this._bendReady = false;\n1660\t    if (pop > 0) this.vel.addScaledVector(p, pop);\n1661\t    // Scoring and telemetry read the momentum the ramp received, not the\n1662\t    // optional leg impulse added afterwards.\n1663\t    this.takeoffSpeed = launchSpeed;\n1664\t    this.airTime = 0;\n1665\t    this.spinAccum = 0;\n1666\t    this.flipAccum = 0;\n1667\t    this.flip = 0;\n1668\t    this.grabTime = 0;\n1669\t    this.grabbing = false;\n1670\t    // Preserve the real yaw rate the edge had at the lip. Air control can add\n1671\t    // to it or bleed it away, but takeoff itself should not erase momentum.\n1672\t    this.flipVel = 0;\n1673\t    // Keep a held charge across a natural lip. Releasing a fraction late\n1674\t    // should still pop, and a second airborne press must never double-jump.\n1675\t    this._latePopAllowed = pop <= 0;\n1676\t    if (pop > 0) {\n1677\t      this.charging = false;\n1678\t      this.charge = 0;\n1679\t    }\n1680\t    this.emit('launch', this.vel.y);\n1681\t    if (this.lipPop && pop > 0) {\n1682\t      this.emit('perfectPop');\n1683\t    }\n1684\t    /* A press that was still on the snow the moment the snow left is a press\n1685\t       that finished, so it is judged here rather than being carried into the\n1686\t       air where it would be rolled into the jump's own rotation.\n1687\t\n1688\t       AFTER THE LAUNCH, and the order is load-bearing rather than incidental.\n1689\t       Leaving the ground retires the last jump's verdict — the launch handler\n1690\t       clears the banner so the new air has the read-out to itself — so a\n1691\t       butter judged before that put its callout up and had it wiped in the\n1692\t       same physics step. The points were paid and the player was never told\n1693\t       what for, which on the one trick that ends by accident is exactly the\n1694\t       moment they most need telling. */\n1695\t    this.releasePress();\n1696\t  }\n1697\t\n1698\t  /* The press, closed out. Called wherever the board can stop being on the\n1699\t     snow under a rider's feet — a lip, a tree — so that a butter is always\n1700\t     judged exactly once and nothing can carry its accumulated rotation into\n1701\t     whatever happens next. */\n1702\t  releasePress() {\n1703\t    if (this.pressTime > 0) this.emit('butter', Math.abs(this.pressSpin), this.pressTime);\n1704\t    this.press = 0;\n1705\t    this.pressTime = 0;\n1706\t    this.pressSpin = 0;\n1707\t  }\n1708\t\n1709\t  /* --- in the air ---------------------------------------------------- */\n1710\t\n1711\t  airStep(dt, input) {\n1712\t    const { pos, vel } = this;\n1713\t    // Ground steering eases at the input layer; air spin already eases via\n1714\t    // spinVel. A release must reach that damping and landing help immediately.\n1715\t    const turn = input.turnIntent ?? input.turn;\n1716\t    this.airTime += dt;\n1717\t    if (input.jump) {\n1718\t      this.charging = true;\n1719\t      this.charge = Math.min(1, this.charge + dt / RIDER.chargeTime);\n1720\t    } else if (this.charging) {\n1721\t      if (this._latePopAllowed && this.airTime <= RIDER.lipWindow) {\n1722\t        const pop = (RIDER.popMin + (RIDER.popMax - RIDER.popMin) * this.charge)\n1723\t          * RIDER.lipBonus;\n1724\t        this.vel.addScaledVector(this._p.copy(this.normal).add(this.UP).normalize(), pop);\n1725\t        this._latePopAllowed = false;\n1726\t        this.lipPop = true;\n1727\t        this.compressionVel = -14;\n1728\t        this.emit('perfectPop');\n1729\t      } else {\n1730\t        // A release just before touchdown is kept for the next grounded\n1731\t        // step. Older presses expire, so a long air cannot queue a surprise.\n1732\t        this._jumpBuffer = 0.14;\n1733\t        this._bufferCharge = this.charge;\n1734\t      }\n1735\t      this.charging = false;\n1736\t      this.charge = 0;\n1737\t    }\n1738\t    this.pushing = false;\n1739\t    this.brake = approach(this.brake, 0, RIDER.brakeRelease, dt);\n1740\t    this.tucking = !!input.tuck && !input.brake && this.brake < 0.05;\n1741\t    this.slide = 0;\n1742\t    this.carveLoad = 0;\n1743\t    this.climbRate = 0;\n1744\t    // Air is air, wherever it is over. Deep snow only exists under a board.\n1745\t    this.offPiste = 0;\n1746\t    // Nothing is pressing on the board in the air, so the legs are allowed to\n1747\t    // find their own length rather than holding the last compression they saw\n1748\t    this.bend = approach(this.bend, 0, 9, dt);\n1749\t\n1750\t    // Gravity is constant through the complete arc. Aerodynamic drag only\n1751\t    // trims horizontal travel here, so it cannot create an apex float or\n1752\t    // weaken the downward acceleration the player is judging.\n1753\t    const startVy = vel.y;\n1754\t    vel.y -= RIDER.gravity * dt;\n1755\t    // A tuck reduces drag; it cannot propel the board without snow to push\n1756\t    // against. Takeoff momentum now predicts the landing distance.\n1757\t    const airDrag = 1 / (1 + RIDER.drag * (this.tucking ? 0.16 : 0.45)\n1758\t      * vel.length() * dt);\n1759\t    vel.x *= airDrag;\n1760\t    vel.z *= airDrag;\n1761\t\n1762\t    // Spin. It winds up rather than snapping on, so a 180 and a 900 are\n1763\t    // different amounts of commitment rather than different key presses.\n1764\t    const wantSpin = turn * RIDER.spinRate * (1 + this.grab * 0.14);\n1765\t    const spinResponse = Math.abs(turn) < 0.05 ? RIDER.spinRamp * 2.2 : RIDER.spinRamp;\n1766\t    this.spinVel = approach(this.spinVel, wantSpin, spinResponse, dt);\n1767\t    this.yaw += this.spinVel * dt;\n1768\t    this.spinAccum += this.spinVel * dt;\n1769\t\n1770\t    /* Flip, on its own key, so it can be corked into a spin — and it goes\n1771\t       whichever way the weight is going.\n1772\t\n1773\t       E on its own throws the shoulders back and the board over the head,\n1774\t       which is a backflip and is what E has always done. Held with S it goes\n1775\t       the other way: S is the key that sits the weight back everywhere else\n1776\t       in this game, and letting go of that while the body is already folded\n1777\t       is precisely how a front flip starts. One key, two rotations, and the\n1778\t       modifier means the same thing it means on the snow. */\n1779\t    const wantFlip = input.trickFlip\n1780\t      ? (input.brake ? RIDER.flipRate : -RIDER.flipRate)\n1781\t      : 0;\n1782\t    this.flipVel = approach(this.flipVel, wantFlip,\n1783\t      RIDER.spinRamp * (input.trickFlip ? 1.4 : 2.4), dt);\n1784\t    this.flip += this.flipVel * dt;\n1785\t    this.flipAccum += this.flipVel * dt;\n1786\t\n1787\t    /* Grab: the only trick that is worth more the longer you hold it, the\n1788\t       only one that asks you to let go before the snow arrives, and now the\n1789\t       only one with more than one shape.\n1790\t\n1791\t       Which shape is decided once, at the moment the hand leaves the knee,\n1792\t       and then held — a grab is one reach and not a menu to scroll through in\n1793\t       the air. W is already forward and S is already back, so the body\n1794\t       position the rider is holding for every other reason is the body\n1795\t       position that picks it: folded over the nose, sat back into a method,\n1796\t       or neither, which is a hand dropped straight onto the toe edge. */\n1797\t    this.grabbing = !!input.trickGrab;\n1798\t    if (this.grabbing) {\n1799\t      if (this.grabTime <= 0) {\n1800\t        this.grabKind = input.tuck ? GRAB_NOSE : input.brake ? GRAB_METHOD : GRAB_INDY;\n1801\t      }\n1802\t      this.grabTime += dt;\n1803\t    }\n1804\t    this.grab = approach(this.grab, this.grabbing ? 1 : 0, 11, dt);\n1805\t\n1806\t    // A little drift, for picking a landing line. It is relative to the line\n1807\t    // of travel, not to the spinning board, so D keeps moving screen-right\n1808\t    // during a 360 and behaves identically in regular and switch stance.\n1809\t    const steer = turn * RIDER.airSteer;\n1810\t    const horizontal = Math.hypot(vel.x, vel.z);\n1811\t    if (horizontal > 0.5) {\n1812\t      const rightX = -vel.z / horizontal;\n1813\t      const rightZ = vel.x / horizontal;\n1814\t      vel.x += rightX * steer * dt;\n1815\t      vel.z += rightZ * steer * dt;\n1816\t    } else {\n1817\t      const travelYaw = this.yaw - (this.switchStance ? Math.PI : 0);\n1818\t      vel.x += Math.cos(travelYaw) * steer * dt;\n1819\t      vel.z += Math.sin(travelYaw) * steer * dt;\n1820\t    }\n1821\t\n1822\t    /* And the weather's own hand. With no edge in the snow an airborne board\n1823\t       is a sail: the storm's surface wind leans on the flight, calm days\n1824\t       imperceptibly, a blizzard by enough to move a long air's landing by a\n1825\t       board length or two. The ground never takes this — grip owns it. */\n1826\t    const windX = this.world.windX || 0;\n1827\t    const windZ = this.world.windZ || 0;\n1828\t    if (windX !== 0 || windZ !== 0) {\n1829\t      vel.x += windX * RIDER.windAir * dt;\n1830\t      vel.z += windZ * RIDER.windAir * dt;\n1831\t    }\n1832\t\n1833\t    pos.x += vel.x * dt;\n1834\t    // Trapezoidal integration is exact for constant acceleration, so the\n1835\t    // simulated centre of mass stays on y = y0 + vy0·t - ½g·t² instead of\n1836\t    // accumulating the semi-implicit Euler error over a long jump.\n1837\t    pos.y += (startVy + vel.y) * 0.5 * dt;\n1838\t    pos.z += vel.z * dt;\n1839\t\n1840\t    this.roll = approach(this.roll, turn * 0.22, 6, dt);\n1841\t\n1842\t    const gy = this.world.height(pos.x, pos.z);\n1843\t\n1844\t    // Estimate contact against the slope we are approaching. Vertical fall\n1845\t    // speed alone assisted far too early on a steep landing and too late on\n1846\t    // a rising face. One nearby height sample keeps the estimate inexpensive.\n1847\t    if (this.airTime > RIDER.minJudgedAir\n1848\t      && (Math.abs(turn) < 0.05 || !input.trickFlip)) {\n1849\t      const ahead = this.world.height(pos.x + vel.x * 0.08, pos.z + vel.z * 0.08);\n1850\t      const closing = (ahead - gy) / 0.08 - vel.y;\n1851\t      const gap = Math.max(0, pos.y - gy);\n1852\t      const toGround = (Math.sqrt(closing * closing + 2 * RIDER.gravity * gap)\n1853\t        - closing) / RIDER.gravity;\n1854\t      if (closing > 0 && toGround < RIDER.assistTime) {\n1855\t        const assist = 1 - Math.exp(-RIDER.assistRate * dt);\n1856\t        if (Math.abs(turn) < 0.05) {\n1857\t          const travelYaw = Math.atan2(vel.x, -vel.z);\n1858\t          const off = wrapPi(this.yaw - travelYaw);\n1859\t          const target = Math.abs(off) > Math.PI / 2 ? travelYaw + Math.PI : travelYaw;\n1860\t          this.yaw += wrapPi(target - this.yaw) * assist;\n1861\t        }\n1862\t        const pitchError = wrapPi(this.flip);\n1863\t        // Only finish an almost-complete flip after release. Half a flip\n1864\t        // still needs commitment; the assist cannot turn it into a landing.\n1865\t        if (!input.trickFlip && Math.abs(this.flipAccum) > Math.PI\n1866\t          && Math.abs(pitchError) < RIDER.landPitchWindow * 1.5) {\n1867\t          this.flip -= pitchError * assist;\n1868\t        }\n1869\t      }\n1870\t    }\n1871\t\n1872\t    if (pos.y <= gy) {\n1873\t      // The launch look-ahead deliberately commits just before a lip. Without\n1874\t      // a tiny contact window the following air tick sees the last centimetres\n1875\t      // of that same ramp above the board and calls it a landing. Only accept\n1876\t      // snow that the rider is actually moving into; a separating contact is\n1877\t      // positional overlap, not an impact.\n1878\t      const contact = ridingNormalFrom(\n1879\t        this.world.height, pos.x, pos.z, vel, this._n,\n1880\t      );\n1881\t      const approaching = vel.dot(contact) < -0.02;\n1882\t      // …or buried, whichever comes first. A rising contact is normally\n1883\t      // refused so a pop off an uphill transition is not taken back — but\n1884\t      // ground that climbs faster than the rider does turns that refusal\n1885\t      // into a rider inside the mountain, one step at a time. See\n1886\t      // `RIDER.buryDepth`.\n1887\t      const descending = vel.y <= 0 || gy - pos.y > RIDER.buryDepth;\n1888\t      if (this.airTime >= RIDER.launchContactGrace && descending && approaching) {\n1889\t        pos.y = gy;\n1890\t        this.land();\n1891\t      } else {\n1892\t        // Separating or rising contact is not a landing. Keep the ballistic\n1893\t        // position untouched; snapping it above the snow injected height into\n1894\t        // every high-speed takeoff.\n1895\t        this.extension = Math.max(0, pos.y - gy);\n1896\t      }\n1897\t    } else {\n1898\t      this.extension = pos.y - gy;\n1899\t    }\n1900\t  }\n1901\t\n1902\t  /* --- the moment it matters ----------------------------------------- */\n1903\t\n1904\t  land() {\n1905\t    const { vel } = this;\n1906\t    // A touchdown at the centimetre before a lip must use the ramp face, not\n1907\t    // a centred sample that includes the vertical drop behind it.\n1908\t    const n = this._n;\n1909\t    ridingNormalFrom(this.world.height, this.pos.x, this.pos.z, vel, n);\n1910\t    this.normal.copy(n);\n1911\t    this._handlingReady = true;\n1912\t    this._bendReady = false;\n1913\t    const impact = Math.max(0, -vel.dot(n));\n1914\t\n1915\t    // Judge the direction that will actually leave the landing. Classifying\n1916\t    // the airborne vector and projecting it afterwards could turn a perfectly\n1917\t    // ordinary touchdown around on a steep face while leaving the stance flag\n1918\t    // unchanged.\n1919\t    const landedVel = this._p.copy(vel).addScaledVector(n, -vel.dot(n));"}]},"uuid":"959490bb-a8dc-4e15-8113-36899e741a78","timestamp":"2026-09-24T19:54:34.348Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","content":"       1 m/s of vertical and the jump was smaller than a walking pace one.\n\n       Sampling the integration step as well as the longer horizon fixes it.\n       The rest of the sweep is spaced in metres, not in four increasingly\n       long time slices, so a fast rider cannot step over a patch of support\n       between samples. While any point on the near path still stands above\n       the ballistic arc, the hill blocks release. An unmarked natural roller\n       must then remain clear for part of a board length; a detected kicker or\n       cliff edge already has that proof and releases directly. */\n    const HZ = 0.09;\n    let clearance = -Infinity;\n    let blocked = false;\n    let clearRun = 0;\n    let longestClearRun = 0;\n    const startT = Math.min(dt, HZ);\n    const sweepLength = horizontalSpeed * Math.max(0, HZ - startT);\n    const segments = Math.min(\n      RIDER.launchSampleMax,\n      Math.max(3, Math.ceil(sweepLength / RIDER.launchSampleSpacing)),\n    );\n    let previousDistance = horizontalSpeed * startT;\n    for (let k = 0; k <= segments; k++) {\n      const t = startT + (HZ - startT) * (k / segments);\n      const distance = horizontalSpeed * t;\n      const ground = this.world.height(pos.x + vel.x * t, pos.z + vel.z * t);\n      const ballistic = pos.y + predictorVy * t - 0.5 * RIDER.gravity * t * t;\n      const gap = ballistic - ground;\n      if (gap > clearance) clearance = gap;\n      /* Nothing after this point can change the answer. Both readers of\n         this sweep test `!blocked` first — see `launching` below — so once\n         the ground has come up through the arc, `clearance` and\n         `longestClearRun` are provably unread and the remaining samples are\n         world height lookups nobody asks about. On the groomed ribbon that\n         is the whole loop collapsing at the first sample. */\n      if (gap < -RIDER.launchObstruction) { blocked = true; break; }\n      if (gap > RIDER.launchGap) {\n        if (k > 0) clearRun += distance - previousDistance;\n        if (clearRun > longestClearRun) longestClearRun = clearRun;\n      } else {\n        clearRun = 0;\n      }\n      previousDistance = distance;\n    }\n\n    /* Popping, and popping at the right moment.\n\n       The clearance above is read *before* the pop is resolved, which is\n       what makes the timing bonus possible: it says how close the ground\n       already is to letting go. A pop released while the hill is on the edge\n       of launching — the lip of a kicker, the crest of a roller, the top of\n       a wall — is worth half again as much as the same pop released halfway\n       up the ramp. It is the one piece of timing the sport actually asks of\n       you, and the old jump had no opinion about it at all. */\n    let pop = 0;\n    this.lipPop = false;\n    if (!input.jump && (this.charging || this._jumpBuffer > 0)) {\n      const held = this.charging ? this.charge : this._bufferCharge;\n      this._jumpBuffer = 0;\n      pop = RIDER.popMin + (RIDER.popMax - RIDER.popMin) * held;\n      if (!blocked && clearance > -0.25) {\n        pop *= RIDER.lipBonus;\n        this.lipPop = true;\n      } else if (this.bend > RIDER.pumpFrom) {\n        /* …or it is a pump, and this is the same extension doing the other\n           thing legs can do with it.\n\n           The condition is the whole idea. The branch above is a lip: the\n           ground is on the point of letting go, there is nothing left to push\n           against, and everything the legs have goes into height. Here the\n           ground is bending the other way — pressing the board into the snow —\n           and an extension against that load is work done along the direction\n           of travel, which is speed. A rider crossing a compression is not\n           jumping out of it; they are standing up through it and coming out\n           the far side faster, and that is most of what riding terrain is.\n\n           The pop is spent rather than added to, so a player cannot have both.\n           Timing the release to the ground is the skill, and the read-out for\n           whether they got it right is the speed itself. */\n        const load = clamp(\n          (this.bend - RIDER.pumpFrom) / Math.max(1e-3, RIDER.bendMax - RIDER.pumpFrom),\n          0, 1,\n        );\n        const drive = RIDER.pumpSpeed * held * load;\n        const flat = Math.hypot(vel.x, vel.z);\n        if (flat > 1e-3 && drive > 0.05) {\n          vel.x += (vel.x / flat) * drive;\n          vel.z += (vel.z / flat) * drive;\n          this.emit('pump', drive);\n        }\n        pop = 0;\n      }\n      this.charging = false;\n      this.charge = 0;\n      this.compressionVel = -14;\n    }\n\n    const requiredSupportLoss = this._contact.edgeAhead\n      ? 0\n      : Math.min(\n        RIDER.launchSupportLength,\n        sweepLength * RIDER.launchSupportShare,\n      );\n    const launching = !blocked && clearance > RIDER.launchGap\n      && longestClearRun >= requiredSupportLoss && this.grounded;\n\n    /* A confirmed release uses the chord entirely behind the board. This is\n       the last piece of speed scaling: a centred normal straddling a smooth\n       lip changes with the exact fixed-step crossing point and can make a\n       slightly faster entry leave at a slightly lower angle. The trailing\n       tangent cannot look over the edge, so speed alone scales every launch\n       component. An ollie that is not also a natural release uses the exact\n       support normal for the same reason. */\n    const launchNormal = launching\n      ? trailingNormalFrom(\n        this.world.height, pos.x, pos.z, vel, this._launchN,\n      )\n      : support;\n    let moveX = vel.x;\n    let moveY = surfaceVy;\n    let moveZ = vel.z;\n    if (launching) {\n      const launchSpeed = vel.length();\n      const intoLaunch = vel.dot(launchNormal);\n      const tx = vel.x - launchNormal.x * intoLaunch;\n      const ty = vel.y - launchNormal.y * intoLaunch;\n      const tz = vel.z - launchNormal.z * intoLaunch;\n      const tangentSpeed = Math.hypot(tx, ty, tz);\n      if (launchSpeed > 1e-5 && tangentSpeed > 1e-5) {\n        const scale = launchSpeed / tangentSpeed;\n        moveX = tx * scale;\n        moveY = ty * scale;\n        moveZ = tz * scale;\n      }\n    }\n    pos.x += moveX * dt;\n    pos.z += moveZ * dt;\n\n    if (launching || pop > 0) {\n      // This step carried the board along the ramp tangent. Continue that\n      // tangent through the lip instead of moving x/z while leaving y behind;\n      // the first airborne state is then already separated from the ramp.\n      pos.y += moveY * dt;\n      // The configured pop already represents the legs' work. Reading the\n      // just-reset spring velocity here added 7.7 m/s to every tap.\n      this.takeOff(pop, launchNormal);\n    } else {\n      const gy = this.world.height(pos.x, pos.z);\n      this.extension = 0;\n      pos.y = gy;\n      // This is the tangent's real vertical component, not a launch impulse.\n      // Capping it would become an indirect total-speed cap on steep terrain\n      // once the powered tuck reaches extreme velocity.\n      vel.y = surfaceVy;\n    }\n\n    /* The lean, which is no longer a look.\n\n       A rider holding a turn has to incline until the resultant of gravity\n       and the corner runs down the line of their legs, or they fall over —\n       so the angle is atan(lateral / g) and there is nothing to choose. It\n       used to be a constant times the key being pressed, which meant a gentle\n       turn and a turn at the very edge of traction leaned the same amount and\n       the body told you nothing. Now the inclination *is* the read-out: lean\n       and grip are the same number seen from two ends, and a rider laid over\n       at fifty degrees is a rider with nothing left. It still gets there\n       late, because a body has mass. */\n    /* The true balance angle, and how much of it is actually shown.\n\n       atan(lateral / g) is what the body has to do to stay up, and at the\n       limit of grip against this game's 22 m/s² gravity that is fifty\n       degrees. It is correct and it reads as broken: a rider laid flat over\n       the snow while the heading comes round at fifteen degrees a second\n       looks like a man falling sideways down a hill that happens to also be\n       turning, which is exactly the complaint — \"he leans onto his side and\n       carries on in the same direction\".\n\n       The reason is that a real carve at fifty degrees of inclination is a\n       fast, tight arc, and this one cannot be, because the turn rate is\n       capped by grip and the speeds here are arcade. So the lean is shown at\n       a fraction of the truth: enough to say which way the weight has gone,\n       not so much that the body is writing a cheque the path does not cash.\n\n       Balance is measured against the *shown* angle rather than the true one,\n       which is not a fudge — it is the only self-consistent choice. Measured\n       against the true angle the body could never arrive, the mismatch would\n       be permanent, and the rider would fall over halfway through every\n       properly-executed carve. */\n    const need = Math.atan2(carve, RIDER.gravity);\n    const shown = Math.min(need, RIDER.lean);\n    const target = -side * shown;\n\n    /* …and how far the body is from where it needs to be, which is balance.\n\n       Measured before the roll is advanced, so it is the gap the rider is\n       actually standing in rather than the one they are about to close. The\n       sign is kept because the two ways of losing it are different events —\n       positive is the load arriving before the body and trying to throw them\n       over the outside edge, negative is a body further in than the snow can\n       hold up — even though for now they cost the same thing. */\n    /* Smooth the error so a single terrain sample cannot flash the grip.\n\n       Balance is feedback and traction, not a second invisible crash test.\n       A normal edge change holds this filtered error open after the rendered\n       body has already caught up; the old timer therefore put the rider down\n       on a mathematically planar slope with zero sideways slide. Low balance\n       still reduces `gripNow` on the next step, visibly washing the board out\n       and scrubbing speed. Only readable events — impact, a bad landing or a\n       true uphill stall — own the fall state. */\n    // Direction matters here. Comparing magnitudes made a rider leaning hard\n    // into the old turn look perfectly balanced during an edge change. The\n    // signed target-to-body gap reaches twice the shown lean in that case, so\n    // the balance readout and the available grip both reflect the transition.\n    this.leanErr = approach(this.leanErr, target - this.roll, 5.5, dt);\n    // At low speed about eight degrees of mismatch is enough to soften the\n    // edge. Momentum widens only this transient tolerance: it stops a routine\n    // fast edge change from deleting forty per cent of the grip, while the\n    // sidecut and surface grip above still own the steady-state turn radius.\n    const baseBalanceWindow = Math.min(RIDER.balanceWindow, RIDER.lean * 0.25);\n    const balanceWindow = baseBalanceWindow\n      * (1 + (RIDER.speedBalanceWindow - 1) * stable);\n    /* Faded in over 3–5 m/s rather than switched at 4. The old ternary was a\n       cliff: crossing 4 m/s with an open lean error snapped `balance` from 1\n       to its true value in one step, and `balanceGrip` turned that into a\n       forty-per-cent grip step mid-scrub — felt as a twitch in exactly the\n       slow, deliberate manoeuvre least able to absorb one. */\n    const balanceIn = clamp((speed - 3) / 2, 0, 1);\n    this.balance = 1 - balanceIn\n      * (1 - clamp(1 - Math.abs(this.leanErr) / balanceWindow, 0, 1));\n\n    this.roll = approach(this.roll, target, RIDER.leanRate, dt);\n  }\n\n  /* Takeoff is a release, not an impulse invented by the ramp.\n\n     Ground contact may have accumulated tiny normal components while gravity,\n     carving and the height field were integrated. Remove those at the lip,\n     then restore the exact speed on the surface tangent. The ramp therefore\n     decides direction and momentum decides magnitude: doubling entry speed\n     doubles both horizontal and vertical launch velocity.\n\n     A deliberate ollie (or the legs unloading naturally) is the only extra\n     impulse. It points between the board's outward normal and world-up so it\n     clears both ordinary kickers and steep walls without rewriting the base\n     tangent launch. */\n  takeOff(pop, n) {\n    const launchSpeed = this.vel.length();\n    const tangent = this._p.copy(this.vel).addScaledVector(n, -this.vel.dot(n));\n    const tangentSpeed = tangent.length();\n    if (launchSpeed > 1e-5 && tangentSpeed > 1e-5) {\n      this.vel.copy(tangent).multiplyScalar(launchSpeed / tangentSpeed);\n    }\n\n    const p = this._p.copy(n).add(this.UP).normalize();\n    this.grounded = false;\n    this.state = 'air';\n    // The gradient the bend is differentiating is only meaningful across two\n    // consecutive steps on the same surface. Every departure from the snow\n    // breaks that chain, and a stale one comes back as a curvature spike the\n    // width of a lip.\n    this._bendReady = false;\n    if (pop > 0) this.vel.addScaledVector(p, pop);\n    // Scoring and telemetry read the momentum the ramp received, not the\n    // optional leg impulse added afterwards.\n    this.takeoffSpeed = launchSpeed;\n    this.airTime = 0;\n    this.spinAccum = 0;\n    this.flipAccum = 0;\n    this.flip = 0;\n    this.grabTime = 0;\n    this.grabbing = false;\n    // Preserve the real yaw rate the edge had at the lip. Air control can add\n    // to it or bleed it away, but takeoff itself should not erase momentum.\n    this.flipVel = 0;\n    // Keep a held charge across a natural lip. Releasing a fraction late\n    // should still pop, and a second airborne press must never double-jump.\n    this._latePopAllowed = pop <= 0;\n    if (pop > 0) {\n      this.charging = false;\n      this.charge = 0;\n    }\n    this.emit('launch', this.vel.y);\n    if (this.lipPop && pop > 0) {\n      this.emit('perfectPop');\n    }\n    /* A press that was still on the snow the moment the snow left is a press\n       that finished, so it is judged here rather than being carried into the\n       air where it would be rolled into the jump's own rotation.\n\n       AFTER THE LAUNCH, and the order is load-bearing rather than incidental.\n       Leaving the ground retires the last jump's verdict — the launch handler\n       clears the banner so the new air has the read-out to itself — so a\n       butter judged before that put its callout up and had it wiped in the\n       same physics step. The points were paid and the player was never told\n       what for, which on the one trick that ends by accident is exactly the\n       moment they most need telling. */\n    this.releasePress();\n  }\n\n  /* The press, closed out. Called wherever the board can stop being on the\n     snow under a rider's feet — a lip, a tree — so that a butter is always\n     judged exactly once and nothing can carry its accumulated rotation into\n     whatever happens next. */\n  releasePress() {\n    if (this.pressTime > 0) this.emit('butter', Math.abs(this.pressSpin), this.pressTime);\n    this.press = 0;\n    this.pressTime = 0;\n    this.pressSpin = 0;\n  }\n\n  /* --- in the air ---------------------------------------------------- */\n\n  airStep(dt, input) {\n    const { pos, vel } = this;\n    // Ground steering eases at the input layer; air spin already eases via\n    // spinVel. A release must reach that damping and landing help immediately.\n    const turn = input.turnIntent ?? input.turn;\n    this.airTime += dt;\n    if (input.jump) {\n      this.charging = true;\n      this.charge = Math.min(1, this.charge + dt / RIDER.chargeTime);\n    } else if (this.charging) {\n      if (this._latePopAllowed && this.airTime <= RIDER.lipWindow) {\n        const pop = (RIDER.popMin + (RIDER.popMax - RIDER.popMin) * this.charge)\n          * RIDER.lipBonus;\n        this.vel.addScaledVector(this._p.copy(this.normal).add(this.UP).normalize(), pop);\n        this._latePopAllowed = false;\n        this.lipPop = true;\n        this.compressionVel = -14;\n        this.emit('perfectPop');\n      } else {\n        // A release just before touchdown is kept for the next grounded\n        // step. Older presses expire, so a long air cannot queue a surprise.\n        this._jumpBuffer = 0.14;\n        this._bufferCharge = this.charge;\n      }\n      this.charging = false;\n      this.charge = 0;\n    }\n    this.pushing = false;\n    this.brake = approach(this.brake, 0, RIDER.brakeRelease, dt);\n    this.tucking = !!input.tuck && !input.brake && this.brake < 0.05;\n    this.slide = 0;\n    this.carveLoad = 0;\n    this.climbRate = 0;\n    // Air is air, wherever it is over. Deep snow only exists under a board.\n    this.offPiste = 0;\n    // Nothing is pressing on the board in the air, so the legs are allowed to\n    // find their own length rather than holding the last compression they saw\n    this.bend = approach(this.bend, 0, 9, dt);\n\n    // Gravity is constant through the complete arc. Aerodynamic drag only\n    // trims horizontal travel here, so it cannot create an apex float or\n    // weaken the downward acceleration the player is judging.\n    const startVy = vel.y;\n    vel.y -= RIDER.gravity * dt;\n    // A tuck reduces drag; it cannot propel the board without snow to push\n    // against. Takeoff momentum now predicts the landing distance.\n    const airDrag = 1 / (1 + RIDER.drag * (this.tucking ? 0.16 : 0.45)\n      * vel.length() * dt);\n    vel.x *= airDrag;\n    vel.z *= airDrag;\n\n    // Spin. It winds up rather than snapping on, so a 180 and a 900 are\n    // different amounts of commitment rather than different key presses.\n    const wantSpin = turn * RIDER.spinRate * (1 + this.grab * 0.14);\n    const spinResponse = Math.abs(turn) < 0.05 ? RIDER.spinRamp * 2.2 : RIDER.spinRamp;\n    this.spinVel = approach(this.spinVel, wantSpin, spinResponse, dt);\n    this.yaw += this.spinVel * dt;\n    this.spinAccum += this.spinVel * dt;\n\n    /* Flip, on its own key, so it can be corked into a spin — and it goes\n       whichever way the weight is going.\n\n       E on its own throws the shoulders back and the board over the head,\n       which is a backflip and is what E has always done. Held with S it goes\n       the other way: S is the key that sits the weight back everywhere else\n       in this game, and letting go of that while the body is already folded\n       is precisely how a front flip starts. One key, two rotations, and the\n       modifier means the same thing it means on the snow. */\n    const wantFlip = input.trickFlip\n      ? (input.brake ? RIDER.flipRate : -RIDER.flipRate)\n      : 0;\n    this.flipVel = approach(this.flipVel, wantFlip,\n      RIDER.spinRamp * (input.trickFlip ? 1.4 : 2.4), dt);\n    this.flip += this.flipVel * dt;\n    this.flipAccum += this.flipVel * dt;\n\n    /* Grab: the only trick that is worth more the longer you hold it, the\n       only one that asks you to let go before the snow arrives, and now the\n       only one with more than one shape.\n\n       Which shape is decided once, at the moment the hand leaves the knee,\n       and then held — a grab is one reach and not a menu to scroll through in\n       the air. W is already forward and S is already back, so the body\n       position the rider is holding for every other reason is the body\n       position that picks it: folded over the nose, sat back into a method,\n       or neither, which is a hand dropped straight onto the toe edge. */\n    this.grabbing = !!input.trickGrab;\n    if (this.grabbing) {\n      if (this.grabTime <= 0) {\n        this.grabKind = input.tuck ? GRAB_NOSE : input.brake ? GRAB_METHOD : GRAB_INDY;\n      }\n      this.grabTime += dt;\n    }\n    this.grab = approach(this.grab, this.grabbing ? 1 : 0, 11, dt);\n\n    // A little drift, for picking a landing line. It is relative to the line\n    // of travel, not to the spinning board, so D keeps moving screen-right\n    // during a 360 and behaves identically in regular and switch stance.\n    const steer = turn * RIDER.airSteer;\n    const horizontal = Math.hypot(vel.x, vel.z);\n    if (horizontal > 0.5) {\n      const rightX = -vel.z / horizontal;\n      const rightZ = vel.x / horizontal;\n      vel.x += rightX * steer * dt;\n      vel.z += rightZ * steer * dt;\n    } else {\n      const travelYaw = this.yaw - (this.switchStance ? Math.PI : 0);\n      vel.x += Math.cos(travelYaw) * steer * dt;\n      vel.z += Math.sin(travelYaw) * steer * dt;\n    }\n\n    /* And the weather's own hand. With no edge in the snow an airborne board\n       is a sail: the storm's surface wind leans on the flight, calm days\n       imperceptibly, a blizzard by enough to move a long air's landing by a\n       board length or two. The ground never takes this — grip owns it. */\n    const windX = this.world.windX || 0;\n    const windZ = this.world.windZ || 0;\n    if (windX !== 0 || windZ !== 0) {\n      vel.x += windX * RIDER.windAir * dt;\n      vel.z += windZ * RIDER.windAir * dt;\n    }\n\n    pos.x += vel.x * dt;\n    // Trapezoidal integration is exact for constant acceleration, so the\n    // simulated centre of mass stays on y = y0 + vy0·t - ½g·t² instead of\n    // accumulating the semi-implicit Euler error over a long jump.\n    pos.y += (startVy + vel.y) * 0.5 * dt;\n    pos.z += vel.z * dt;\n\n    this.roll = approach(this.roll, turn * 0.22, 6, dt);\n\n    const gy = this.world.height(pos.x, pos.z);\n\n    // Estimate contact against the slope we are approaching. Vertical fall\n    // speed alone assisted far too early on a steep landing and too late on\n    // a rising face. One nearby height sample keeps the estimate inexpensive.\n    if (this.airTime > RIDER.minJudgedAir\n      && (Math.abs(turn) < 0.05 || !input.trickFlip)) {\n      const ahead = this.world.height(pos.x + vel.x * 0.08, pos.z + vel.z * 0.08);\n      const closing = (ahead - gy) / 0.08 - vel.y;\n      const gap = Math.max(0, pos.y - gy);\n      const toGround = (Math.sqrt(closing * closing + 2 * RIDER.gravity * gap)\n        - closing) / RIDER.gravity;\n      if (closing > 0 && toGround < RIDER.assistTime) {\n        const assist = 1 - Math.exp(-RIDER.assistRate * dt);\n        if (Math.abs(turn) < 0.05) {\n          const travelYaw = Math.atan2(vel.x, -vel.z);\n          const off = wrapPi(this.yaw - travelYaw);\n          const target = Math.abs(off) > Math.PI / 2 ? travelYaw + Math.PI : travelYaw;\n          this.yaw += wrapPi(target - this.yaw) * assist;\n        }\n        const pitchError = wrapPi(this.flip);\n        // Only finish an almost-complete flip after release. Half a flip\n        // still needs commitment; the assist cannot turn it into a landing.\n        if (!input.trickFlip && Math.abs(this.flipAccum) > Math.PI\n          && Math.abs(pitchError) < RIDER.landPitchWindow * 1.5) {\n          this.flip -= pitchError * assist;\n        }\n      }\n    }\n\n    if (pos.y <= gy) {\n      // The launch look-ahead deliberately commits just before a lip. Without\n      // a tiny contact window the following air tick sees the last centimetres\n      // of that same ramp above the board and calls it a landing. Only accept\n      // snow that the rider is actually moving into; a separating contact is\n      // positional overlap, not an impact.\n      const contact = ridingNormalFrom(\n        this.world.height, pos.x, pos.z, vel, this._n,\n      );\n      const approaching = vel.dot(contact) < -0.02;\n      // …or buried, whichever comes first. A rising contact is normally\n      // refused so a pop off an uphill transition is not taken back — but\n      // ground that climbs faster than the rider does turns that refusal\n      // into a rider inside the mountain, one step at a time. See\n      // `RIDER.buryDepth`.\n      const descending = vel.y <= 0 || gy - pos.y > RIDER.buryDepth;\n      if (this.airTime >= RIDER.launchContactGrace && descending && approaching) {\n        pos.y = gy;\n        this.land();\n      } else {\n        // Separating or rising contact is not a landing. Keep the ballistic\n        // position untouched; snapping it above the snow injected height into\n        // every high-speed takeoff.\n        this.extension = Math.max(0, pos.y - gy);\n      }\n    } else {\n      this.extension = pos.y - gy;\n    }\n  }\n\n  /* --- the moment it matters ----------------------------------------- */\n\n  land() {\n    const { vel } = this;\n    // A touchdown at the centimetre before a lip must use the ramp face, not\n    // a centred sample that includes the vertical drop behind it.\n    const n = this._n;\n    ridingNormalFrom(this.world.height, this.pos.x, this.pos.z, vel, n);\n    this.normal.copy(n);\n    this._handlingReady = true;\n    this._bendReady = false;\n    const impact = Math.max(0, -vel.dot(n));\n\n    // Judge the direction that will actually leave the landing. Classifying\n    // the airborne vector and projecting it afterwards could turn a perfectly\n    // ordinary touchdown around on a steep face while leaving the stance flag\n    // unchanged.\n    const landedVel = this._p.copy(vel).addScaledVector(n, -vel.dot(n));","numLines":520,"startLine":1400,"totalLines":2415}},"sourceToolAssistantUUID":"5fbf10c2-88ea-4aed-8f1a-1cfe16f44fa9","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/vojta/Dev/protocodus.github.io/fun/alpen","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
