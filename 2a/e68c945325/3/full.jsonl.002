{"parentUuid":"db169d42-50cc-492f-be62-f8c888e9da13","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfNrJKRQo57U5kwQege1y","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01F1HZU7bRQFbJ85qC3CrbDe","name":"Read","input":{"file_path":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","offset":400,"limit":500},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8383,"cache_read_input_tokens":247052,"output_tokens":125,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8383,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":125,"cache_read_input_tokens":247052,"cache_creation_input_tokens":8383,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8383},"type":"message"}],"speed":"standard"},"input_transformations":[{"type":"thinking_dropped","path":"messages.2.content.0","reason":"prefix_binding_mismatch"}],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01F1HZU7bRQFbJ85qC3CrbDe":{"file_path":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","offset":400,"limit":500}},"apiBlockIndex":0,"requestId":"req_011CfNrJ8xMmRnsiRDc9pRnx","type":"assistant","uuid":"664bdac6-e100-4df6-b7e1-0d1e702121bd","timestamp":"2026-09-24T19:54:25.024Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/vojta/Dev/protocodus.github.io/fun/alpen","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
{"parentUuid":"664bdac6-e100-4df6-b7e1-0d1e702121bd","isSidechain":false,"promptId":"c41cd6de-57c3-441a-96f7-ed621873bfe7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F1HZU7bRQFbJ85qC3CrbDe","type":"tool_result","content":"400\t    const travelYaw = this.yaw - stanceOffset;\n401\t    const off = wrapPi(travelYaw - courseYaw);\n402\t    const fixed = clamp(off, -limit, limit);\n403\t    if (Math.abs(fixed - off) < 1e-5) return false;\n404\t    // Same bounded pull-back as the skid clamp, and for the same reason: a\n405\t    // press release shrinks `limit` in one frame, and the board should come\n406\t    // back to course over a few steps rather than in one write.\n407\t    const corr = wrapPi(courseYaw + fixed + stanceOffset - this.yaw);\n408\t    const maxCorr = RIDER.skidRecover * dt;\n409\t    this.yaw += clamp(corr, -maxCorr, maxCorr);\n410\t    return true;\n411\t  }\n412\t\n413\t  /* ------------------------------------------------------------------ */\n414\t\n415\t  step(dt, input) {\n416\t    this.landing = null;\n417\t    this._jumpBuffer = Math.max(0, this._jumpBuffer - dt);\n418\t    this.grace = Math.max(0, this.grace - dt);\n419\t    /* The rendered pose's share of the last landing snap, draining. Purely\n420\t       visual — see where it is written in `land` and read in main's view\n421\t       swap — so nothing in this step may consult it. */\n422\t    this.yawGlide *= Math.exp(-RIDER.glideRate * dt);\n423\t    if (Math.abs(this.yawGlide) < 0.002) this.yawGlide = 0;\n424\t    this.flipGlide *= Math.exp(-RIDER.glideRate * dt);\n425\t    if (Math.abs(this.flipGlide) < 0.002) this.flipGlide = 0;\n426\t\n427\t    // Getting up is part of going down, so both states run the recovery\n428\t    // step. Dispatching only on 'fall' stopped the timer the moment\n429\t    // `fallStep` promoted itself to 'rise' — the rider went back to normal\n430\t    // physics while the model still had them face-down.\n431\t    if (this.state === 'fall' || this.state === 'rise') return this.fallStep(dt);\n432\t    if (this.grounded) this.groundStep(dt, input);\n433\t    else this.airStep(dt, input);\n434\t    this.springStep(dt);\n435\t  }\n436\t\n437\t  /* --- on the snow --------------------------------------------------- */\n438\t\n439\t  groundStep(dt, input) {\n440\t    const { pos, vel } = this;\n441\t    /* A snowboard stops across its travel, not by acquiring generic drag.\n442\t\n443\t       Choose one side at the start of the press and keep it. Changing sides\n444\t       halfway through a speed check would ask the board to cross 154° through\n445\t       its direction of travel; a rider instead releases and sets the other\n446\t       edge. A/D can choose the side, an existing carve continues naturally,\n447\t       and a straight-line press defaults to the stance's heel side. */\n448\t    if (input.brake && this.brake < 0.02) {\n449\t      this.brakeSide = Math.abs(input.turn) > 0.08\n450\t        ? Math.sign(input.turn)\n451\t        : Math.abs(this.edge) > 0.02\n452\t          ? Math.sign(this.edge)\n453\t          : (this.switchStance ? -1 : 1);\n454\t    }\n455\t    this.brake = approach(\n456\t      this.brake, input.brake ? 1 : 0,\n457\t      input.brake ? RIDER.brakeEngage : RIDER.brakeRelease, dt,\n458\t    );\n459\t    const braking = this.brake;\n460\t    const brakeActive = braking > 0.02;\n461\t\n462\t    /* THE PRESS. Q on the snow does what Q in the air does — it puts the\n463\t       board where the hands are — and on the snow that means standing on one\n464\t       end of it and letting the other one come out of the running surface.\n465\t\n466\t       W chooses the nose because W means forward everywhere else in this\n467\t       game; without it the weight goes back onto the tail, which is the press\n468\t       anybody does without thinking about it. A speed check cancels it\n469\t       outright: there is no version of a butter that is also a rider setting\n470\t       an edge across the hill to stop.\n471\t\n472\t       The pressure ramps rather than switching, and everything the press\n473\t       affects is scaled by it, so a tap is a shift of weight and a hold is a\n474\t       trick. `pressSpin` is the only bookkeeping — how much the board has\n475\t       actually come round since the nose or the tail went light — and it is\n476\t       what the run is paid for when the press ends. */\n477\t    const wantPress = !!input.trickGrab && !input.brake && !input.jump\n478\t      && !this.pushing && this.speed > 1.2;\n479\t    if (wantPress && this.press < 0.02) {\n480\t      this.pressNose = !!input.tuck;\n481\t      /* …and which *physical* end of the board that is, frozen here.\n482\t\n483\t         \"Nose\" is a fact about the rider — it is whichever end is leading —\n484\t         and a butter is the one manoeuvre that changes which end that is\n485\t         halfway through itself. Left to be re-derived from the live stance,\n486\t         the drawn press eased through flat and stood the rider up on the\n487\t         opposite end at the moment the rotation passed ninety degrees, which\n488\t         is precisely the thing the mechanic is defined as not doing: the\n489\t         board rotates on one buried contact point. So the stance at capture\n490\t         is folded in once, and −1 is the board's own −Z end for ever after. */\n491\t      this.pressEnd = (input.tuck ? -1 : 1) * (this.switchStance ? -1 : 1);\n492\t      this.pressSpin = 0;\n493\t      this.pressTime = 0;\n494\t    }\n495\t    this.press = approach(this.press, wantPress ? 1 : 0,\n496\t      wantPress ? RIDER.pressRate : RIDER.pressRelease, dt);\n497\t    const pressing = this.press > 0.02;\n498\t    if (pressing) this.pressTime += dt;\n499\t    else if (this.pressTime > 0) {\n500\t      // The press has settled back onto both contact points. Whatever it\n501\t      // carried round is the trick, and it is judged once, here.\n502\t      this.emit('butter', Math.abs(this.pressSpin), this.pressTime);\n503\t      this.pressTime = 0;\n504\t      this.pressSpin = 0;\n505\t    }\n506\t\n507\t    /* …and the tuck comes off while one is on, which is why the press is\n508\t       resolved first.\n509\t\n510\t       W means two things at once here — it is the powered tuck and it is the\n511\t       nose selector — and holding it with Q used to give both. The powered\n512\t       floor is applied after friction and after the press's own plough, so a\n513\t       nose press accelerated at seven and a half metres per second squared\n514\t       while a tail press slowed down, which made the modifier that picks the\n515\t       nose strictly better than not pressing the key. That is a mechanic\n516\t       paying for itself.\n517\t\n518\t       Refusing the combination is also the more honest statement: a tuck is a\n519\t       body folded over the board and a press is a body standing on one end of\n520\t       it, and nobody has ever been in both. So W still chooses the nose, and\n521\t       for as long as the press is on it chooses nothing else. */\n522\t    this.tucking = !!input.tuck && !input.brake && braking < 0.05\n523\t      && !pressing;\n524\t    // Capture the W baseline before the new contact plane removes any velocity\n525\t    // pointing into it. Otherwise a sharp terrain-normal change can make the\n526\t    // displayed speed dip before the powered floor for this step is formed.\n527\t    const poweredEntrySpeed = this.tucking ? vel.length() : 0;\n528\t    const support = ridingNormalFrom(\n529\t      this.world.height, pos.x, pos.z, vel, this._supportN, this._contact,\n530\t    );\n531\t    const handling = handlingNormalFrom(\n532\t      this.world.height, pos.x, pos.z, vel, support, this._n, this._contact,\n533\t    );\n534\t    const stable = momentumStability(Math.hypot(vel.x, vel.z));\n535\t    if (!this._handlingReady || this._contact.edgeAhead) {\n536\t      this.normal.copy(handling);\n537\t      this._handlingReady = true;\n538\t    } else {\n539\t      const response = RIDER.handlingResponseMin\n540\t        + (RIDER.handlingResponseMax - RIDER.handlingResponseMin) * stable;\n541\t      this.normal.lerp(handling, 1 - Math.exp(-dt / response)).normalize();\n542\t    }\n543\t    this.contactFootprint = this._contact.footprint;\n544\t    const n = this.normal;\n545\t\n546\t    // Anything pointing into the slope is absorbed by the snow. What it was\n547\t    // worth is remembered — it is the load the legs have to take.\n548\t    const into = vel.dot(support);\n549\t    if (into < 0) {\n550\t      vel.addScaledVector(support, -into);\n551\t      if (into < -2) this.emit('impact', -into);\n552\t      this.compressionVel += Math.min(-into, 26) * 0.5;\n553\t    } else {\n554\t      vel.addScaledVector(support, -into);\n555\t    }\n556\t    const enteringSpeed = vel.length();\n557\t\n558\t    /* Turn the old invisible crawl assist into an action the rider performs.\n559\t\n560\t       Hysteresis keeps the foot from flickering in and out around one exact\n561\t       speed. Once a cycle has begun it is allowed to finish even if gravity\n562\t       or W carries the board past `pushStop`; braking, a jump request, strong\n563\t       steering or the lip itself aborts it immediately because none of those\n564\t       is a moment in which a rear foot belongs loose beside the board. */\n565\t    const canPush = !brakeActive && !input.jump\n566\t      && Math.abs(input.turn || 0) < 0.72 && !this._contact.edgeAhead;\n567\t    if (!canPush) {\n568\t      this.pushing = false;\n569\t    } else if (!this.pushing && enteringSpeed < RIDER.pushStart) {\n570\t      this.pushing = true;\n571\t      this.pushPhase = 0;\n572\t    }\n573\t    const finishPush = this.pushing && enteringSpeed >= RIDER.pushStop;\n574\t\n575\t    // W is a powered tuck. This is a speed floor rather than a\n576\t    // one-off force: snow friction, a traverse, or an extreme drag value can\n577\t    // never quietly create another terminal velocity. Gravity and clean\n578\t    // terrain can still add more than the floor, so the mountain remains part\n579\t    // of the acceleration instead of being overwritten by it.\n580\t    /* …and how hard, which is what the flow meter is spent on. `flowDrive`\n581\t       is written once a step by `stepFlow` in main.js: a full meter is the\n582\t       whole powered tuck this has always been, an empty one is a third of\n583\t       it. The floor still cannot create a second terminal velocity — it is\n584\t       still a floor, and gravity and a clean line still beat it — but the\n585\t       speed it guarantees is now something the run has to have earned. */\n586\t    const drive = 0.34 + 0.66 * Math.min(1, Math.max(0, this.flowDrive));\n587\t    const poweredSpeed = this.tucking\n588\t      ? poweredEntrySpeed + RIDER.tuckAcceleration * drive * dt\n589\t      : 0;\n590\t\n591\t    // Gravity, resolved on the tangent. This is the whole engine: steep is\n592\t    // fast, banked is slow, and neither needed a special case.\n593\t    const g = this._g.set(0, -RIDER.gravity, 0);\n594\t    const gn = g.dot(support);\n595\t    vel.x += (g.x - support.x * gn) * dt;\n596\t    vel.y += (g.y - support.y * gn) * dt;\n597\t    vel.z += (g.z - support.z * gn) * dt;\n598\t\n599\t    /* How hard the rider is climbing, in metres of height per second.\n600\t\n601\t       The surface gradient falls straight out of the normal — for a height\n602\t       field, n ∝ (−∂h/∂x, 1, −∂h/∂z) — so this is the rate the ground under\n603\t       the rider is rising along the direction they are actually travelling.\n604\t       Positive is uphill. Everything below that has an opinion about the\n605\t       hill's direction reads this rather than guessing from the heading. */\n606\t    const ny = Math.max(0.2, support.y);\n607\t    this.climbRate = (-support.x * vel.x - support.z * vel.z) / ny;\n608\t\n609\t    /* THE BEND — how hard the shape of the ground is pressing the board into\n610\t       the snow, over and above the one g gravity was already charging.\n611\t\n612\t       A path that follows a curved surface at v metres a second is being\n613\t       accelerated towards the centre of that curve at v²·κ, and the only thing\n614\t       available to do the accelerating is the snow. So a hollow presses, a\n615\t       crest lifts, and the whole of it is one number.\n616\t\n617\t       κ comes from the gradient along the direction of travel, differentiated\n618\t       *per metre of ground covered* rather than per second. That distinction is\n619\t       the entire correctness of this: per second, a rider accelerating down a\n620\t       straight pitch shows a gradient-along-travel that appears to be changing,\n621\t       and the term would invent a crest out of nothing but the speeding up.\n622\t       Per metre it is a property of the hill and the heading alone, and the\n623\t       speed re-enters where the physics actually puts it — squared.\n624\t\n625\t       It is measured on `this.normal`, the board-length handling normal, and\n626\t       not on the raw contact one. That is not a shortcut either: a snowboard is\n627\t       a metre and a half of stiff composite and it genuinely does bridge the\n628\t       six-metre chatter octave rather than tracing it. The normal has already\n629\t       been filtered over the board's own footprint, so what comes out is the\n630\t       curvature the board can actually feel. */\n631\t    const flatSpeed = Math.hypot(vel.x, vel.z);\n632\t    let bendG = 0;\n633\t    if (flatSpeed > 0.6) {\n634\t      const gradAlong = -(n.x * vel.x + n.z * vel.z)\n635\t        / (flatSpeed * Math.max(0.2, n.y));\n636\t      const ds = flatSpeed * dt;\n637\t      if (this._bendReady && ds > 1e-4) {\n638\t        const shape = 1 + gradAlong * gradAlong;\n639\t        const kappa = ((gradAlong - this._lastGrad) / ds) / (shape * Math.sqrt(shape));\n640\t        bendG = (flatSpeed * flatSpeed * kappa) / RIDER.gravity;\n641\t      }\n642\t      this._lastGrad = gradAlong;\n643\t      this._bendReady = true;\n644\t    } else {\n645\t      this._bendReady = false;\n646\t    }\n647\t    this.bend = approach(this.bend,\n648\t      clamp(bendG, RIDER.bendMin, RIDER.bendMax), RIDER.bendSmooth, dt);\n649\t\n650\t    /* And how far out of bounds they are, which is a property of the ground\n651\t       rather than of the rider: zero anywhere on the run and on the\n652\t       quarterpipe transition, one once the board is well into the unpisted\n653\t       snow banked against the containment wall. See `RIDER.wallSpan`. */\n654\t    const beyond = this.world.beyond ? this.world.beyond(pos.x, pos.z) : -1;\n655\t    this.offPiste = beyond > 0 ? clamp(beyond / RIDER.wallSpan, 0, 1) : 0;\n656\t\n657\t    /* Stalling.\n658\t\n659\t       A snowboard is not a climbing tool. Run out of speed pointing up\n660\t       something steep and you do not coast gently to a halt — the board\n661\t       stops tracking, the edge that was holding you across the hill has\n662\t       nothing left to hold it with, and you go over. Below `stallSlope` the\n663\t       rider is allowed to grind down to nothing and skate away again. A\n664\t       steep failure is only a fall where\n665\t       the world marks it as one — the quarterpipe and outer wall in this\n666\t       game. Procedural banks inside the groomed piste can still steal all the\n667\t       speed, but they let the board wash downhill instead of firing a hidden\n668\t       wipeout timer. */\n669\t    const carrying = vel.length();\n670\t    const climbSin = carrying > 0.4 ? clamp(this.climbRate / carrying, 0, 1) : 0;\n671\t    const needed = Math.min(RIDER.stallCap,\n672\t      RIDER.stallSpeed * (climbSin / RIDER.stallSlope));\n673\t    /* …and it can only happen to a rider who still had something to lose.\n674\t\n675\t       Without a floor on the speed this rule locks the game up, and it does\n676\t       it silently. A rider who stalls on a wall goes down, gets up crawling\n677\t       at half a metre a second, is still pointed at the same wall, and stalls\n678\t       again inside a third of a second — and again, and again. Observed: four\n679\t       kilometres an hour for twenty-four seconds, the board slowly sliding\n680\t       backwards, no way out of it and nothing on screen to say why.\n681\t\n682\t       A stall is the failure of a rider who was *carrying* speed up something\n683\t       too steep for it. Below `stallMinSpeed` there is no momentum left to\n684\t       fail: the recovery skate is already walking them back down the fall\n685\t       line, and knocking them over on the way is not a\n686\t       physical event, it is a trap. */\n687\t    const canStall = this.world.canStall?.(pos.x, pos.z) ?? true;\n688\t    if (canStall && !this._contact.edgeAhead\n689\t      && carrying > RIDER.stallMinSpeed\n690\t      && climbSin > RIDER.stallSlope && carrying < needed) {\n691\t      this.stallTimer += dt;\n692\t    } else {\n693\t      this.stallTimer = 0;\n694\t    }\n695\t    if (this.stallTimer > RIDER.stallTime && this.grace <= 0) {\n696\t      this.stallTimer = 0;\n697\t      this.fall('stall', 0);\n698\t      return;\n699\t    }\n700\t\n701\t    // Board frame on the slope\n702\t    const h = this._h.set(Math.sin(this.yaw), 0, -Math.cos(this.yaw));\n703\t    h.addScaledVector(n, -h.dot(n)).normalize();\n704\t    const r = this._r.copy(h).cross(n).normalize();\n705\t    this.heading.copy(h);\n706\t    this.right.copy(r);\n707\t\n708\t    let vFwd = vel.dot(h);\n709\t    let vLat = vel.dot(r);\n710\t    const speed = Math.hypot(vFwd, vLat);\n711\t    /* How far over the board can physically go, which is not a preference.\n712\t\n713\t       The sidecut says a turn of radius sidecut/sin(edge) needs v²·sin(edge)\n714\t       /sidecut of lateral grip. Turn that around and the most edge the snow\n715\t       can actually support at this speed is\n716\t\n717\t           sin(edge) ≤ grip · sidecut / v²\n718\t\n719\t       — and past it the rider is not turning harder, they are falling over\n720\t       sideways. A real rider's body enforces this without them thinking about\n721\t       it: you simply cannot lay a board down at 150 km/h the way you can at\n722\t       20, because there is nothing holding you up at that angle.\n723\t\n724\t       Leaving it out was a real bug and a bad one. At 30 m/s the rider could\n725\t       roll to sixty-six degrees and demand 101 m/s² of grip against the 27\n726\t       that exists, and the 74 m/s² of spill went straight into the wash-out —\n727\t       so *any* committed turn scrubbed a hundred and eight km/h down to nine\n728\t       in under two seconds and then stalled the rider for having no speed\n729\t       left. Every carve was a handbrake.\n730\t\n731\t       `edgeReach` lets it be overdriven by a few per cent, which is where the\n732\t       edge starts to slip and throw powder without letting go — the narrow\n733\t       band the whole handling model lives in. */\n734\t    // Fresh storm snow supports a wider, calmer line instead of letting the\n735\t    // same clear-weather target over-drive a suddenly weaker edge.\n736\t    /* …and off the piste entirely there is very little edge to have. Deep\n737\t       wind-loaded snow does not hold a carved traverse: the board sinks,\n738\t       washes out and goes down the fall line, which on the containment wall\n739\t       points back at the run. See `RIDER.wallWash`. */\n740\t    const surf = this.world.surfaceAt?.(pos.x, pos.z) || GROOMED_FALLBACK;\n741\t    const matGrip = surf.groomed * 1.0 + surf.powder * 1.25 + surf.ice * 0.65 + surf.rock * 0.70;\n742\t    const surfaceGrip = RIDER.grip * (this.world.grip ?? 1) * matGrip\n743\t      * (1 - RIDER.wallWash * this.offPiste);\n744\t\n745\t    /* THE CARVE.\n746\t\n747\t       The board does not turn because it is being steered. It turns because\n748\t       it has a sidecut — the edges are arcs — and once it is tilted up onto\n749\t       one of them and pressed into the snow, that arc is the path it is\n750\t       obliged to follow:\n751\t\n752\t           R = sidecut / sin(edge angle)\n753\t\n754\t       Lay it flat and the arc is enormous and the board runs straight. Roll\n755\t       it over and the radius collapses towards the sidecut itself. The\n756\t       rider's only input is how far over they put it, which is exactly what\n757\t       it is in the sport.\n758\t\n759\t       Everything that used to be asserted now falls out of that. Holding a\n760\t       radius R at v metres a second needs v²/R of lateral grip, so the same\n761\t       edge angle that draws a clean arc at 40 km/h asks four times as much of\n762\t       the snow at 80 and tears out — and the rider discovers on their own\n763\t       that a fast line has to be a wide line, instead of being told so by a\n764\t       cap on the turn rate. The old model reached the same conclusion by\n765\t       decree; this one reaches it by geometry, and the difference is legible\n766\t       in the hands because the board now resists in proportion to how much\n767\t       you are asking of it rather than simply refusing past a threshold. */\n768\t    /* Balance is part of the grip, and it is last frame's balance because it\n769\t       cannot be this frame's: the mismatch is measured against a lean that is\n770\t       computed from the carve, and the carve is computed from the grip. One\n771\t       step of 1/120 s is not a lag anyone can feel, and it is the difference\n772\t       between a solvable loop and a circular one. */\n773\t    // The edge only bites because the board is moving — see `gripSpeed`. This\n774\t    // is what stops a crawling rider from standing sideways on a wall.\n775\t    const engaged = RIDER.gripLow\n776\t      + (1 - RIDER.gripLow) * clamp(speed / RIDER.gripSpeed, 0, 1);\n777\t    /* …and how hard the ground is pressing the board into the snow.\n778\t\n779\t       Friction is proportional to normal force, which is the least negotiable\n780\t       statement in this file, and until `bend` existed the normal force was a\n781\t       constant plus the corner. Now a compression genuinely holds an edge that\n782\t       the same edge on a rollover cannot, and the player finds out the way a\n783\t       rider does: the turn you set up at the bottom of the roller comes round,\n784\t       and the identical input over the crest washes out. It is the first thing\n785\t       in the model that makes *where* on the terrain you turn matter at all. */\n786\t    const loadGrip = clamp(1 + this.bend * RIDER.loadGrip,\n787\t      RIDER.loadGripMin, RIDER.loadGripMax);\n788\t    const gripNow = surfaceGrip * engaged * loadGrip\n789\t      * (1 - braking * 0.55)\n790\t      * (this.tucking ? RIDER.tuckGrip : 1)\n791\t      // Half the effective edge is in the air during a press, and it is the\n792\t      // reason a butter and a carve are two different things you cannot do at\n793\t      // once — not a rule saying so, just an edge that is not in the snow.\n794\t      * (1 - RIDER.pressGrip * this.press)\n795\t      * (1 - RIDER.balanceGrip + RIDER.balanceGrip * this.balance);\n796\t\n797\t    /* The edge the rider is *allowed* to set, measured against the grip they\n798\t       will actually have — not against the nominal grip of dry snow.\n799\t\n800\t       This was the loop that made a fast turn feel unpredictable, and it fed\n801\t       itself. The ceiling was computed from `RIDER.grip` while the edge was\n802\t       held against `gripNow`, which is reduced by the tuck, by the brake, by\n803\t       soft snow and — the one that closes the circle — by balance. So the\n804\t       moment balance dipped, the rider was still permitted to ask for the\n805\t       full-grip edge angle while only a fraction of that grip existed. The\n806\t       excess spilled into the wash-out, the wash-out cost more balance, the\n807\t       gap widened, and the whole thing ran away: measured with the key held\n808\t       steady, the edge oscillated between one degree and twenty-one and the\n809\t       run dumped a hundred and two km/h down to twenty-three in half a\n810\t       second, having done nothing at all for the second and a half before it.\n811\t\n812\t       Asking against the grip that exists is the fix, and it is also the more\n813\t       honest statement of the model: a rider does not lay the board over as\n814\t       far on soft snow, on a tuck, or when they are already fighting for\n815\t       balance. `edgeReach` is then the only overdrive there is, and it is a\n816\t       tenth — which is the narrow band a wash-out is supposed to live in. */\n817\t    const holdable = Math.asin(clamp(\n818\t      (gripNow * RIDER.sidecut) / Math.max(1, speed * speed), 0, 1,\n819\t    ));\n820\t    const edgeCeiling = Math.min(RIDER.edgeMax, holdable * RIDER.edgeReach);\n821\t\n822\t    const edgeControl = clamp(input.turn, -1, 1) * (1 - braking)\n823\t      + this.brakeSide * RIDER.brakeEdge * braking;\n824\t    const wantEdge = edgeControl * edgeCeiling\n825\t      * (this.tucking ? RIDER.tuckTurn : 1);\n826\t    this.edge = approach(this.edge, wantEdge, RIDER.edgeRate, dt);\n827\t\n828\t    const sinEdge = Math.abs(Math.sin(this.edge));\n829\t    // What the sidecut is asking the hill for, in m/s² of lateral pull\n830\t    const demand = (speed * speed * sinEdge) / RIDER.sidecut;\n831\t    const carve = Math.min(demand, gripNow);\n832\t    const spill = demand - carve;\n833\t    const side = Math.sign(this.edge) || 0;\n834\t\n835\t    // The board turns at whatever the edge actually managed to hold. Keep\n836\t    // that real yaw rate for the lip: leaving a carve should carry a small\n837\t    // amount of angular momentum into the air instead of starting every jump\n838\t    // from an artificial zero.\n839\t    let lipYawRate = side * (carve / Math.max(3, speed));\n840\t\n841\t    /* …plus the skid-steer that a sidecut cannot provide.\n842\t\n843\t       The carve's turn rate is proportional to speed, so on its own it decays\n844\t       to nothing exactly when the rider most needs to bring the nose round —\n845\t       and that was a dead end rather than a difficulty: hold a turn, carve\n846\t       onto a traverse, and there is no term left that can rotate the board\n847\t       back down the fall line. Gravity has no component along a board pointed\n848\t       across the hill, so the rider simply stopped, sideways, permanently.\n849\t\n850\t       Below `pivotSpeed` the board can be skidded round instead, which is\n851\t       what anybody does at walking pace, and it fades out completely once\n852\t       there is enough speed for the edge to do the job properly. */\n853\t    const pivot = RIDER.pivotRate * (1 - clamp(speed / RIDER.pivotSpeed, 0, 1));\n854\t    if (pivot > 0) lipYawRate += input.turn * pivot;\n855\t\n856\t    // Where the board was pointing before any of the rules below moved it.\n857\t    // The press is paid against this, once, after all of them have had their\n858\t    // say — see the note beside `pressSpin` further down.\n859\t    const stepYaw = this.yaw;\n860\t\n861\t    /* …and the press hands back a second one that has nothing to do with\n862\t       speed at all. That is the whole point of standing on one end of the\n863\t       board: with the other end unweighted there is no buried edge left to\n864\t       resist a rotation, so the board spins under a rider who is otherwise\n865\t       going in a perfectly straight line. It is the only steering authority\n866\t       in the model that does not come from the sidecut or from a skid, and it\n867\t       is what makes a butter possible at ninety km/h as well as at ten. */\n868\t    if (this.press > 0.02) lipYawRate += input.turn * RIDER.pressPivot * this.press;\n869\t\n870\t    this.yaw += lipYawRate * dt;\n871\t    // A speed check kicks the tail around towards a transverse target. The\n872\t    // rate closes smoothly near it, and pressure scales both the target and\n873\t    // the authority so tapping S produces a check rather than a full stop.\n874\t    // Gated on speed *over the ground*, not tangent speed. High on a wall\n875\t    // the tangent speed is mostly vertical, and `atan2` over a near-zero\n876\t    // horizontal velocity is a compass with no needle — the pivot used to\n877\t    // yank the yaw towards whatever it happened to read.\n878\t    if (brakeActive && Math.hypot(vel.x, vel.z) > 0.35) {\n879\t      const travelYaw = Math.atan2(vel.x, -vel.z);\n880\t      const stanceYaw = travelYaw + (this.switchStance ? Math.PI : 0);\n881\t      const brakeYaw = stanceYaw + this.brakeSide * RIDER.brakeAngle * braking;\n882\t      const yawError = wrapPi(brakeYaw - this.yaw);\n883\t      const pivotRate = clamp(yawError / 0.32, -1, 1)\n884\t        * RIDER.brakePivot * braking;\n885\t      this.yaw += pivotRate * dt;\n886\t      lipYawRate += pivotRate;\n887\t    }\n888\t    this.spinVel = lipYawRate;\n889\t\n890\t    /* With no input the board settles back in line with where the rider is\n891\t       actually travelling, so a nudge does not leave you sideways forever.\n892\t\n893\t       The speed gate used to be 1 m/s, which meant it was still running while\n894\t       the rider was almost stationary — and since each skate stroke sends a\n895\t       stopped rider downhill along the tangent, the two together quietly\n896\t       rotated the board to face down the fall line whenever you came to a\n897\t       stop. From the outside that reads as the rider refusing to stand still\n898\t       and pointing himself downhill on his own. Above 3.5 m/s the board is\n899\t       genuinely tracking and lining it up with the direction of travel is"}]},"uuid":"53f86ede-8097-41d1-92b3-1b12aa117928","timestamp":"2026-09-24T19:54:25.436Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/vojta/Dev/protocodus.github.io/fun/alpen/js/rider.js","content":"    const travelYaw = this.yaw - stanceOffset;\n    const off = wrapPi(travelYaw - courseYaw);\n    const fixed = clamp(off, -limit, limit);\n    if (Math.abs(fixed - off) < 1e-5) return false;\n    // Same bounded pull-back as the skid clamp, and for the same reason: a\n    // press release shrinks `limit` in one frame, and the board should come\n    // back to course over a few steps rather than in one write.\n    const corr = wrapPi(courseYaw + fixed + stanceOffset - this.yaw);\n    const maxCorr = RIDER.skidRecover * dt;\n    this.yaw += clamp(corr, -maxCorr, maxCorr);\n    return true;\n  }\n\n  /* ------------------------------------------------------------------ */\n\n  step(dt, input) {\n    this.landing = null;\n    this._jumpBuffer = Math.max(0, this._jumpBuffer - dt);\n    this.grace = Math.max(0, this.grace - dt);\n    /* The rendered pose's share of the last landing snap, draining. Purely\n       visual — see where it is written in `land` and read in main's view\n       swap — so nothing in this step may consult it. */\n    this.yawGlide *= Math.exp(-RIDER.glideRate * dt);\n    if (Math.abs(this.yawGlide) < 0.002) this.yawGlide = 0;\n    this.flipGlide *= Math.exp(-RIDER.glideRate * dt);\n    if (Math.abs(this.flipGlide) < 0.002) this.flipGlide = 0;\n\n    // Getting up is part of going down, so both states run the recovery\n    // step. Dispatching only on 'fall' stopped the timer the moment\n    // `fallStep` promoted itself to 'rise' — the rider went back to normal\n    // physics while the model still had them face-down.\n    if (this.state === 'fall' || this.state === 'rise') return this.fallStep(dt);\n    if (this.grounded) this.groundStep(dt, input);\n    else this.airStep(dt, input);\n    this.springStep(dt);\n  }\n\n  /* --- on the snow --------------------------------------------------- */\n\n  groundStep(dt, input) {\n    const { pos, vel } = this;\n    /* A snowboard stops across its travel, not by acquiring generic drag.\n\n       Choose one side at the start of the press and keep it. Changing sides\n       halfway through a speed check would ask the board to cross 154° through\n       its direction of travel; a rider instead releases and sets the other\n       edge. A/D can choose the side, an existing carve continues naturally,\n       and a straight-line press defaults to the stance's heel side. */\n    if (input.brake && this.brake < 0.02) {\n      this.brakeSide = Math.abs(input.turn) > 0.08\n        ? Math.sign(input.turn)\n        : Math.abs(this.edge) > 0.02\n          ? Math.sign(this.edge)\n          : (this.switchStance ? -1 : 1);\n    }\n    this.brake = approach(\n      this.brake, input.brake ? 1 : 0,\n      input.brake ? RIDER.brakeEngage : RIDER.brakeRelease, dt,\n    );\n    const braking = this.brake;\n    const brakeActive = braking > 0.02;\n\n    /* THE PRESS. Q on the snow does what Q in the air does — it puts the\n       board where the hands are — and on the snow that means standing on one\n       end of it and letting the other one come out of the running surface.\n\n       W chooses the nose because W means forward everywhere else in this\n       game; without it the weight goes back onto the tail, which is the press\n       anybody does without thinking about it. A speed check cancels it\n       outright: there is no version of a butter that is also a rider setting\n       an edge across the hill to stop.\n\n       The pressure ramps rather than switching, and everything the press\n       affects is scaled by it, so a tap is a shift of weight and a hold is a\n       trick. `pressSpin` is the only bookkeeping — how much the board has\n       actually come round since the nose or the tail went light — and it is\n       what the run is paid for when the press ends. */\n    const wantPress = !!input.trickGrab && !input.brake && !input.jump\n      && !this.pushing && this.speed > 1.2;\n    if (wantPress && this.press < 0.02) {\n      this.pressNose = !!input.tuck;\n      /* …and which *physical* end of the board that is, frozen here.\n\n         \"Nose\" is a fact about the rider — it is whichever end is leading —\n         and a butter is the one manoeuvre that changes which end that is\n         halfway through itself. Left to be re-derived from the live stance,\n         the drawn press eased through flat and stood the rider up on the\n         opposite end at the moment the rotation passed ninety degrees, which\n         is precisely the thing the mechanic is defined as not doing: the\n         board rotates on one buried contact point. So the stance at capture\n         is folded in once, and −1 is the board's own −Z end for ever after. */\n      this.pressEnd = (input.tuck ? -1 : 1) * (this.switchStance ? -1 : 1);\n      this.pressSpin = 0;\n      this.pressTime = 0;\n    }\n    this.press = approach(this.press, wantPress ? 1 : 0,\n      wantPress ? RIDER.pressRate : RIDER.pressRelease, dt);\n    const pressing = this.press > 0.02;\n    if (pressing) this.pressTime += dt;\n    else if (this.pressTime > 0) {\n      // The press has settled back onto both contact points. Whatever it\n      // carried round is the trick, and it is judged once, here.\n      this.emit('butter', Math.abs(this.pressSpin), this.pressTime);\n      this.pressTime = 0;\n      this.pressSpin = 0;\n    }\n\n    /* …and the tuck comes off while one is on, which is why the press is\n       resolved first.\n\n       W means two things at once here — it is the powered tuck and it is the\n       nose selector — and holding it with Q used to give both. The powered\n       floor is applied after friction and after the press's own plough, so a\n       nose press accelerated at seven and a half metres per second squared\n       while a tail press slowed down, which made the modifier that picks the\n       nose strictly better than not pressing the key. That is a mechanic\n       paying for itself.\n\n       Refusing the combination is also the more honest statement: a tuck is a\n       body folded over the board and a press is a body standing on one end of\n       it, and nobody has ever been in both. So W still chooses the nose, and\n       for as long as the press is on it chooses nothing else. */\n    this.tucking = !!input.tuck && !input.brake && braking < 0.05\n      && !pressing;\n    // Capture the W baseline before the new contact plane removes any velocity\n    // pointing into it. Otherwise a sharp terrain-normal change can make the\n    // displayed speed dip before the powered floor for this step is formed.\n    const poweredEntrySpeed = this.tucking ? vel.length() : 0;\n    const support = ridingNormalFrom(\n      this.world.height, pos.x, pos.z, vel, this._supportN, this._contact,\n    );\n    const handling = handlingNormalFrom(\n      this.world.height, pos.x, pos.z, vel, support, this._n, this._contact,\n    );\n    const stable = momentumStability(Math.hypot(vel.x, vel.z));\n    if (!this._handlingReady || this._contact.edgeAhead) {\n      this.normal.copy(handling);\n      this._handlingReady = true;\n    } else {\n      const response = RIDER.handlingResponseMin\n        + (RIDER.handlingResponseMax - RIDER.handlingResponseMin) * stable;\n      this.normal.lerp(handling, 1 - Math.exp(-dt / response)).normalize();\n    }\n    this.contactFootprint = this._contact.footprint;\n    const n = this.normal;\n\n    // Anything pointing into the slope is absorbed by the snow. What it was\n    // worth is remembered — it is the load the legs have to take.\n    const into = vel.dot(support);\n    if (into < 0) {\n      vel.addScaledVector(support, -into);\n      if (into < -2) this.emit('impact', -into);\n      this.compressionVel += Math.min(-into, 26) * 0.5;\n    } else {\n      vel.addScaledVector(support, -into);\n    }\n    const enteringSpeed = vel.length();\n\n    /* Turn the old invisible crawl assist into an action the rider performs.\n\n       Hysteresis keeps the foot from flickering in and out around one exact\n       speed. Once a cycle has begun it is allowed to finish even if gravity\n       or W carries the board past `pushStop`; braking, a jump request, strong\n       steering or the lip itself aborts it immediately because none of those\n       is a moment in which a rear foot belongs loose beside the board. */\n    const canPush = !brakeActive && !input.jump\n      && Math.abs(input.turn || 0) < 0.72 && !this._contact.edgeAhead;\n    if (!canPush) {\n      this.pushing = false;\n    } else if (!this.pushing && enteringSpeed < RIDER.pushStart) {\n      this.pushing = true;\n      this.pushPhase = 0;\n    }\n    const finishPush = this.pushing && enteringSpeed >= RIDER.pushStop;\n\n    // W is a powered tuck. This is a speed floor rather than a\n    // one-off force: snow friction, a traverse, or an extreme drag value can\n    // never quietly create another terminal velocity. Gravity and clean\n    // terrain can still add more than the floor, so the mountain remains part\n    // of the acceleration instead of being overwritten by it.\n    /* …and how hard, which is what the flow meter is spent on. `flowDrive`\n       is written once a step by `stepFlow` in main.js: a full meter is the\n       whole powered tuck this has always been, an empty one is a third of\n       it. The floor still cannot create a second terminal velocity — it is\n       still a floor, and gravity and a clean line still beat it — but the\n       speed it guarantees is now something the run has to have earned. */\n    const drive = 0.34 + 0.66 * Math.min(1, Math.max(0, this.flowDrive));\n    const poweredSpeed = this.tucking\n      ? poweredEntrySpeed + RIDER.tuckAcceleration * drive * dt\n      : 0;\n\n    // Gravity, resolved on the tangent. This is the whole engine: steep is\n    // fast, banked is slow, and neither needed a special case.\n    const g = this._g.set(0, -RIDER.gravity, 0);\n    const gn = g.dot(support);\n    vel.x += (g.x - support.x * gn) * dt;\n    vel.y += (g.y - support.y * gn) * dt;\n    vel.z += (g.z - support.z * gn) * dt;\n\n    /* How hard the rider is climbing, in metres of height per second.\n\n       The surface gradient falls straight out of the normal — for a height\n       field, n ∝ (−∂h/∂x, 1, −∂h/∂z) — so this is the rate the ground under\n       the rider is rising along the direction they are actually travelling.\n       Positive is uphill. Everything below that has an opinion about the\n       hill's direction reads this rather than guessing from the heading. */\n    const ny = Math.max(0.2, support.y);\n    this.climbRate = (-support.x * vel.x - support.z * vel.z) / ny;\n\n    /* THE BEND — how hard the shape of the ground is pressing the board into\n       the snow, over and above the one g gravity was already charging.\n\n       A path that follows a curved surface at v metres a second is being\n       accelerated towards the centre of that curve at v²·κ, and the only thing\n       available to do the accelerating is the snow. So a hollow presses, a\n       crest lifts, and the whole of it is one number.\n\n       κ comes from the gradient along the direction of travel, differentiated\n       *per metre of ground covered* rather than per second. That distinction is\n       the entire correctness of this: per second, a rider accelerating down a\n       straight pitch shows a gradient-along-travel that appears to be changing,\n       and the term would invent a crest out of nothing but the speeding up.\n       Per metre it is a property of the hill and the heading alone, and the\n       speed re-enters where the physics actually puts it — squared.\n\n       It is measured on `this.normal`, the board-length handling normal, and\n       not on the raw contact one. That is not a shortcut either: a snowboard is\n       a metre and a half of stiff composite and it genuinely does bridge the\n       six-metre chatter octave rather than tracing it. The normal has already\n       been filtered over the board's own footprint, so what comes out is the\n       curvature the board can actually feel. */\n    const flatSpeed = Math.hypot(vel.x, vel.z);\n    let bendG = 0;\n    if (flatSpeed > 0.6) {\n      const gradAlong = -(n.x * vel.x + n.z * vel.z)\n        / (flatSpeed * Math.max(0.2, n.y));\n      const ds = flatSpeed * dt;\n      if (this._bendReady && ds > 1e-4) {\n        const shape = 1 + gradAlong * gradAlong;\n        const kappa = ((gradAlong - this._lastGrad) / ds) / (shape * Math.sqrt(shape));\n        bendG = (flatSpeed * flatSpeed * kappa) / RIDER.gravity;\n      }\n      this._lastGrad = gradAlong;\n      this._bendReady = true;\n    } else {\n      this._bendReady = false;\n    }\n    this.bend = approach(this.bend,\n      clamp(bendG, RIDER.bendMin, RIDER.bendMax), RIDER.bendSmooth, dt);\n\n    /* And how far out of bounds they are, which is a property of the ground\n       rather than of the rider: zero anywhere on the run and on the\n       quarterpipe transition, one once the board is well into the unpisted\n       snow banked against the containment wall. See `RIDER.wallSpan`. */\n    const beyond = this.world.beyond ? this.world.beyond(pos.x, pos.z) : -1;\n    this.offPiste = beyond > 0 ? clamp(beyond / RIDER.wallSpan, 0, 1) : 0;\n\n    /* Stalling.\n\n       A snowboard is not a climbing tool. Run out of speed pointing up\n       something steep and you do not coast gently to a halt — the board\n       stops tracking, the edge that was holding you across the hill has\n       nothing left to hold it with, and you go over. Below `stallSlope` the\n       rider is allowed to grind down to nothing and skate away again. A\n       steep failure is only a fall where\n       the world marks it as one — the quarterpipe and outer wall in this\n       game. Procedural banks inside the groomed piste can still steal all the\n       speed, but they let the board wash downhill instead of firing a hidden\n       wipeout timer. */\n    const carrying = vel.length();\n    const climbSin = carrying > 0.4 ? clamp(this.climbRate / carrying, 0, 1) : 0;\n    const needed = Math.min(RIDER.stallCap,\n      RIDER.stallSpeed * (climbSin / RIDER.stallSlope));\n    /* …and it can only happen to a rider who still had something to lose.\n\n       Without a floor on the speed this rule locks the game up, and it does\n       it silently. A rider who stalls on a wall goes down, gets up crawling\n       at half a metre a second, is still pointed at the same wall, and stalls\n       again inside a third of a second — and again, and again. Observed: four\n       kilometres an hour for twenty-four seconds, the board slowly sliding\n       backwards, no way out of it and nothing on screen to say why.\n\n       A stall is the failure of a rider who was *carrying* speed up something\n       too steep for it. Below `stallMinSpeed` there is no momentum left to\n       fail: the recovery skate is already walking them back down the fall\n       line, and knocking them over on the way is not a\n       physical event, it is a trap. */\n    const canStall = this.world.canStall?.(pos.x, pos.z) ?? true;\n    if (canStall && !this._contact.edgeAhead\n      && carrying > RIDER.stallMinSpeed\n      && climbSin > RIDER.stallSlope && carrying < needed) {\n      this.stallTimer += dt;\n    } else {\n      this.stallTimer = 0;\n    }\n    if (this.stallTimer > RIDER.stallTime && this.grace <= 0) {\n      this.stallTimer = 0;\n      this.fall('stall', 0);\n      return;\n    }\n\n    // Board frame on the slope\n    const h = this._h.set(Math.sin(this.yaw), 0, -Math.cos(this.yaw));\n    h.addScaledVector(n, -h.dot(n)).normalize();\n    const r = this._r.copy(h).cross(n).normalize();\n    this.heading.copy(h);\n    this.right.copy(r);\n\n    let vFwd = vel.dot(h);\n    let vLat = vel.dot(r);\n    const speed = Math.hypot(vFwd, vLat);\n    /* How far over the board can physically go, which is not a preference.\n\n       The sidecut says a turn of radius sidecut/sin(edge) needs v²·sin(edge)\n       /sidecut of lateral grip. Turn that around and the most edge the snow\n       can actually support at this speed is\n\n           sin(edge) ≤ grip · sidecut / v²\n\n       — and past it the rider is not turning harder, they are falling over\n       sideways. A real rider's body enforces this without them thinking about\n       it: you simply cannot lay a board down at 150 km/h the way you can at\n       20, because there is nothing holding you up at that angle.\n\n       Leaving it out was a real bug and a bad one. At 30 m/s the rider could\n       roll to sixty-six degrees and demand 101 m/s² of grip against the 27\n       that exists, and the 74 m/s² of spill went straight into the wash-out —\n       so *any* committed turn scrubbed a hundred and eight km/h down to nine\n       in under two seconds and then stalled the rider for having no speed\n       left. Every carve was a handbrake.\n\n       `edgeReach` lets it be overdriven by a few per cent, which is where the\n       edge starts to slip and throw powder without letting go — the narrow\n       band the whole handling model lives in. */\n    // Fresh storm snow supports a wider, calmer line instead of letting the\n    // same clear-weather target over-drive a suddenly weaker edge.\n    /* …and off the piste entirely there is very little edge to have. Deep\n       wind-loaded snow does not hold a carved traverse: the board sinks,\n       washes out and goes down the fall line, which on the containment wall\n       points back at the run. See `RIDER.wallWash`. */\n    const surf = this.world.surfaceAt?.(pos.x, pos.z) || GROOMED_FALLBACK;\n    const matGrip = surf.groomed * 1.0 + surf.powder * 1.25 + surf.ice * 0.65 + surf.rock * 0.70;\n    const surfaceGrip = RIDER.grip * (this.world.grip ?? 1) * matGrip\n      * (1 - RIDER.wallWash * this.offPiste);\n\n    /* THE CARVE.\n\n       The board does not turn because it is being steered. It turns because\n       it has a sidecut — the edges are arcs — and once it is tilted up onto\n       one of them and pressed into the snow, that arc is the path it is\n       obliged to follow:\n\n           R = sidecut / sin(edge angle)\n\n       Lay it flat and the arc is enormous and the board runs straight. Roll\n       it over and the radius collapses towards the sidecut itself. The\n       rider's only input is how far over they put it, which is exactly what\n       it is in the sport.\n\n       Everything that used to be asserted now falls out of that. Holding a\n       radius R at v metres a second needs v²/R of lateral grip, so the same\n       edge angle that draws a clean arc at 40 km/h asks four times as much of\n       the snow at 80 and tears out — and the rider discovers on their own\n       that a fast line has to be a wide line, instead of being told so by a\n       cap on the turn rate. The old model reached the same conclusion by\n       decree; this one reaches it by geometry, and the difference is legible\n       in the hands because the board now resists in proportion to how much\n       you are asking of it rather than simply refusing past a threshold. */\n    /* Balance is part of the grip, and it is last frame's balance because it\n       cannot be this frame's: the mismatch is measured against a lean that is\n       computed from the carve, and the carve is computed from the grip. One\n       step of 1/120 s is not a lag anyone can feel, and it is the difference\n       between a solvable loop and a circular one. */\n    // The edge only bites because the board is moving — see `gripSpeed`. This\n    // is what stops a crawling rider from standing sideways on a wall.\n    const engaged = RIDER.gripLow\n      + (1 - RIDER.gripLow) * clamp(speed / RIDER.gripSpeed, 0, 1);\n    /* …and how hard the ground is pressing the board into the snow.\n\n       Friction is proportional to normal force, which is the least negotiable\n       statement in this file, and until `bend` existed the normal force was a\n       constant plus the corner. Now a compression genuinely holds an edge that\n       the same edge on a rollover cannot, and the player finds out the way a\n       rider does: the turn you set up at the bottom of the roller comes round,\n       and the identical input over the crest washes out. It is the first thing\n       in the model that makes *where* on the terrain you turn matter at all. */\n    const loadGrip = clamp(1 + this.bend * RIDER.loadGrip,\n      RIDER.loadGripMin, RIDER.loadGripMax);\n    const gripNow = surfaceGrip * engaged * loadGrip\n      * (1 - braking * 0.55)\n      * (this.tucking ? RIDER.tuckGrip : 1)\n      // Half the effective edge is in the air during a press, and it is the\n      // reason a butter and a carve are two different things you cannot do at\n      // once — not a rule saying so, just an edge that is not in the snow.\n      * (1 - RIDER.pressGrip * this.press)\n      * (1 - RIDER.balanceGrip + RIDER.balanceGrip * this.balance);\n\n    /* The edge the rider is *allowed* to set, measured against the grip they\n       will actually have — not against the nominal grip of dry snow.\n\n       This was the loop that made a fast turn feel unpredictable, and it fed\n       itself. The ceiling was computed from `RIDER.grip` while the edge was\n       held against `gripNow`, which is reduced by the tuck, by the brake, by\n       soft snow and — the one that closes the circle — by balance. So the\n       moment balance dipped, the rider was still permitted to ask for the\n       full-grip edge angle while only a fraction of that grip existed. The\n       excess spilled into the wash-out, the wash-out cost more balance, the\n       gap widened, and the whole thing ran away: measured with the key held\n       steady, the edge oscillated between one degree and twenty-one and the\n       run dumped a hundred and two km/h down to twenty-three in half a\n       second, having done nothing at all for the second and a half before it.\n\n       Asking against the grip that exists is the fix, and it is also the more\n       honest statement of the model: a rider does not lay the board over as\n       far on soft snow, on a tuck, or when they are already fighting for\n       balance. `edgeReach` is then the only overdrive there is, and it is a\n       tenth — which is the narrow band a wash-out is supposed to live in. */\n    const holdable = Math.asin(clamp(\n      (gripNow * RIDER.sidecut) / Math.max(1, speed * speed), 0, 1,\n    ));\n    const edgeCeiling = Math.min(RIDER.edgeMax, holdable * RIDER.edgeReach);\n\n    const edgeControl = clamp(input.turn, -1, 1) * (1 - braking)\n      + this.brakeSide * RIDER.brakeEdge * braking;\n    const wantEdge = edgeControl * edgeCeiling\n      * (this.tucking ? RIDER.tuckTurn : 1);\n    this.edge = approach(this.edge, wantEdge, RIDER.edgeRate, dt);\n\n    const sinEdge = Math.abs(Math.sin(this.edge));\n    // What the sidecut is asking the hill for, in m/s² of lateral pull\n    const demand = (speed * speed * sinEdge) / RIDER.sidecut;\n    const carve = Math.min(demand, gripNow);\n    const spill = demand - carve;\n    const side = Math.sign(this.edge) || 0;\n\n    // The board turns at whatever the edge actually managed to hold. Keep\n    // that real yaw rate for the lip: leaving a carve should carry a small\n    // amount of angular momentum into the air instead of starting every jump\n    // from an artificial zero.\n    let lipYawRate = side * (carve / Math.max(3, speed));\n\n    /* …plus the skid-steer that a sidecut cannot provide.\n\n       The carve's turn rate is proportional to speed, so on its own it decays\n       to nothing exactly when the rider most needs to bring the nose round —\n       and that was a dead end rather than a difficulty: hold a turn, carve\n       onto a traverse, and there is no term left that can rotate the board\n       back down the fall line. Gravity has no component along a board pointed\n       across the hill, so the rider simply stopped, sideways, permanently.\n\n       Below `pivotSpeed` the board can be skidded round instead, which is\n       what anybody does at walking pace, and it fades out completely once\n       there is enough speed for the edge to do the job properly. */\n    const pivot = RIDER.pivotRate * (1 - clamp(speed / RIDER.pivotSpeed, 0, 1));\n    if (pivot > 0) lipYawRate += input.turn * pivot;\n\n    // Where the board was pointing before any of the rules below moved it.\n    // The press is paid against this, once, after all of them have had their\n    // say — see the note beside `pressSpin` further down.\n    const stepYaw = this.yaw;\n\n    /* …and the press hands back a second one that has nothing to do with\n       speed at all. That is the whole point of standing on one end of the\n       board: with the other end unweighted there is no buried edge left to\n       resist a rotation, so the board spins under a rider who is otherwise\n       going in a perfectly straight line. It is the only steering authority\n       in the model that does not come from the sidecut or from a skid, and it\n       is what makes a butter possible at ninety km/h as well as at ten. */\n    if (this.press > 0.02) lipYawRate += input.turn * RIDER.pressPivot * this.press;\n\n    this.yaw += lipYawRate * dt;\n    // A speed check kicks the tail around towards a transverse target. The\n    // rate closes smoothly near it, and pressure scales both the target and\n    // the authority so tapping S produces a check rather than a full stop.\n    // Gated on speed *over the ground*, not tangent speed. High on a wall\n    // the tangent speed is mostly vertical, and `atan2` over a near-zero\n    // horizontal velocity is a compass with no needle — the pivot used to\n    // yank the yaw towards whatever it happened to read.\n    if (brakeActive && Math.hypot(vel.x, vel.z) > 0.35) {\n      const travelYaw = Math.atan2(vel.x, -vel.z);\n      const stanceYaw = travelYaw + (this.switchStance ? Math.PI : 0);\n      const brakeYaw = stanceYaw + this.brakeSide * RIDER.brakeAngle * braking;\n      const yawError = wrapPi(brakeYaw - this.yaw);\n      const pivotRate = clamp(yawError / 0.32, -1, 1)\n        * RIDER.brakePivot * braking;\n      this.yaw += pivotRate * dt;\n      lipYawRate += pivotRate;\n    }\n    this.spinVel = lipYawRate;\n\n    /* With no input the board settles back in line with where the rider is\n       actually travelling, so a nudge does not leave you sideways forever.\n\n       The speed gate used to be 1 m/s, which meant it was still running while\n       the rider was almost stationary — and since each skate stroke sends a\n       stopped rider downhill along the tangent, the two together quietly\n       rotated the board to face down the fall line whenever you came to a\n       stop. From the outside that reads as the rider refusing to stand still\n       and pointing himself downhill on his own. Above 3.5 m/s the board is\n       genuinely tracking and lining it up with the direction of travel is","numLines":500,"startLine":400,"totalLines":2415}},"sourceToolAssistantUUID":"664bdac6-e100-4df6-b7e1-0d1e702121bd","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/vojta/Dev/protocodus.github.io/fun/alpen","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
