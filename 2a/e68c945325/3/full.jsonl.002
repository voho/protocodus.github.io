rouch: 0.115,      // metres the hips ride below standing, always, on snow\n309:     `airTuck` is the third, and it is the one that had the sign wrong.\n311:     `hipPerStretch` *raised* the hips and left him hanging off the board with\n317:  thumpDrop: 0.26,    // metres a landing folds him, on the thump's own clock\n318:  popRise: 0.09,      // and how far the pop stands him up out of the stance\n319:  airTuck: 0.29,      // metres the knees come up once he is off the snow\n1446:    twist: 0, lean: 0, comp: 0, pop: 0, thump: 0, tumbleLag: 0, wash: 0, press: 0,\n1565:      + FLEX.pop * s.pop\n1566:      - FLEX.thump * s.thump,\n1846:      - squat * POSE.hipPerSquat + stretch * POSE.hipPerStretch\n1851:      - POSE.airTuck * s.air + POSE.popRise * s.pop - POSE.thumpDrop * s.thump\n1895:      floor = Math.max(floor, bo.y - socket.y + POSE.hipFold);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"499e4763-cef7-4385-be12-08caf5a8bc1a","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/vojta/Dev/protocodus.github.io/fun/alpen","sessionId":"f31fbc8b-fac8-4283-8f36-bb5424b19347","version":"2.1.281","gitBranch":"main","slug":"enchanted-prancing-stroustrup"}
